+    // indicator does nothing, on purpose.
+    //
+    // 1x is ALWAYS the main camera, not "whichever one is selected": if zoom
+    // meant a different thing depending on where you are, it would mean nothing.
+
+    // The widest camera, identified by its device tree node.
+    //
+    // This is the ONLY thing specific to this phone, and it is unavoidable: libcamera
+    // exposes neither focal length nor field of view. Of this phone's
+    // cameras only Model and Location are known, and there are TWO rear ones. The list
+    // order is no good either: it changes between boots.
+    readonly property string wideAngleNode: "camera@21"
+    readonly property string mainNode: "camera@1a"
+
+    // How much wider the wide angle sees. PROVISIONAL AND UNMEASURED: it is the
+    // field of view ratio between the two rear cameras and libcamera does not
+    // expose it. See camera/measure-wide-factor.
+    readonly property real wideAngleFactor: 0.6
+    readonly property real zoomMax: 8.0
+
+    // Margin for comparing against 1x.
+    //
+    // IT IS NEEDED. The zoom comes from an exponential, so at 1x it is
+    // 0.99999998 and a plain "< 1.0" fell into the wide angle branch:
+    // the camera showed up as wide angle reading 1.0x.
+    readonly property real epsilon: 0.005
+
+    // The values the zoom snaps to: the wide angle limit and the
+    // integers. They are the ones people look for -"give me 2x"- and the ones the ruler
+    // labels, so the number and the tick always match.
+    readonly property var stops: [wideAngleFactor, 1, 2, 3, 4, 5, 6, 7, 8]
+
+    // The magnet is RELATIVE, not absolute.
+    //
+    // A fixed margin of, say, 0.05 is quite noticeable at 1x -it is 5%- and is
+    // imperceptible at 8x, where it is 0.6%. In relative terms, snapping costs
+    // the same over the whole range, which is what makes it feel even.
+    readonly property real iman: 0.05
+
+    // Dead zone: while inside the magnet the value stays PINNED
+    // at the stop. Without that the number wobbles around 2.0 and never feels
+    // like it has snapped to anything.
+    function snap(z) {
+        for (const stop of stops) {
+            if (stop < zoomMin - epsilon || stop > zoomMax + epsilon) {
+                continue;
+            }
+            if (Math.abs(z - stop) / stop < iman) {
+                return stop;
+            }
+        }
+        return z;
+    }
+
+    property real zoomAsked: 1.0
+
+    function idOfNode(node) {
+        for (const id of root.camera.cameraDeviceIds) {
+            if (id.indexOf(node) !== -1) {
+                return id;
+            }
+        }
+        return "";
+    }
+
+    readonly property bool hasWideAngle: idOfNode(wideAngleNode) !== ""
+    readonly property bool onRear: root.camera.cameraDevice.indexOf(mainNode) !== -1
+                                      || root.camera.cameraDevice.indexOf(wideAngleNode) !== -1
+    readonly property real zoomMin: (onRear && hasWideAngle) ? wideAngleFactor : 1.0
+
+    function applyZoom() {
+        if (!onRear) {
+            viewfinder.scale = Math.max(1.0, zoomAsked);
+            return;
+        }
+        const wantsWide = hasWideAngle && zoomAsked < 1.0 - epsilon;
+        const target = idOfNode(wantsWide ? wideAngleNode : mainNode);
+        if (target !== "" && root.camera.cameraDevice !== target) {
+            if (root.camera.busy) {
+                // It is retried when it stops being so. Without this, a change
+                // requested while the camera starts was lost FOREVER, and
+                // the app stayed on wide angle reading 1.0x.
+                retry.running = true;
+            } else {
+                root.camera.cameraDevice = target;
+            }
+        }
+        const base = wantsWide ? wideAngleFactor : 1.0;
+        viewfinder.scale = Math.max(1.0, zoomAsked / base);
+    }
+
+    Timer {
+        id: retry
+        interval: 200
+        repeat: true
+        onTriggered: {
+            if (!root.camera.busy) {
+                running = false;
+                root.applyZoom();
+            }
+        }
+    }
+
+    onZoomAskedChanged: applyZoom()
+
+    // And also at startup: the camera may come set to the wide angle from
+    // a previous session, and then there is no zoom change to trigger
+    // the correction.
+    Component.onCompleted: applyZoom()
+
+    Connections {
+        target: root.camera
+
+        function onCameraDeviceChanged() {
+            // When switching to the front camera with the flip button, zoom returns to 1x:
+            // inheriting a 4x without knowing why is disconcerting.
+            if (!root.onRear) {
+                if (root.zoomAsked !== 1.0) {
+                    root.zoomAsked = 1.0;
+                }
+                return;
+            }
+            // And if somebody leaves us on a rear camera that does not match the
+            // current zoom, it is corrected. It is needed: the application RESTORES the camera
+            // from the previous session AFTER Component.onCompleted runs,
+            // so it started on wide angle reading 1.0x and the startup
+            // correction came too early to be of any use.
+            //
+            // There is no loop: applyZoom only assigns when the camera is not already
+            // the right one, so on the second pass it does nothing.
+            root.applyZoom();
+        }
+    }
