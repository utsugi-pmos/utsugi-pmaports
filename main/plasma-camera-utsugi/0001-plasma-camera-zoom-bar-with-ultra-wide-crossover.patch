+    //
+    // El 1x es SIEMPRE la camara principal, no "la que este puesta": si el zoom
+    // significara una cosa distinta segun donde estes, no significaria nada.
+
+    // La camara mas ancha, identificada por su nodo del device tree.
+    //
+    // Esto es LO UNICO especifico de este telefono, y es inevitable: libcamera
+    // no publica distancia focal ni campo de vision. De las camaras de este
+    // movil solo se sabe Model y Location, y hay DOS traseras. El orden de la
+    // lista tampoco vale: cambia entre arranques.
+    readonly property string nodoGranAngular: "camera@21"
+    readonly property string nodoPrincipal: "camera@1a"
+
+    // Cuanto mas ancho ve el gran angular. PROVISIONAL Y SIN MEDIR: es la
+    // relacion de campo de vision entre las dos traseras y libcamera no la
+    // publica. Ver camara/medir-el-factor-del-gran-angular.
+    readonly property real factorGranAngular: 0.6
+    readonly property real zoomMaximo: 8.0
+
+    // Margen para comparar con el 1x.
+    //
+    // HACE FALTA. El zoom sale de una exponencial, asi que en el 1x vale
+    // 0,99999998 y un "< 1.0" a secas se metia en la rama del gran angular:
+    // la camara aparecia en gran angular marcando 1,0x.
+    readonly property real epsilon: 0.005
+
+    // Los valores a los que el zoom se pega: el tope del gran angular y los
+    // enteros. Son los que la gente busca -"ponme 2x"- y los que la regla
+    // rotula, asi que el numero y la marca coinciden siempre.
+    readonly property var topes: [factorGranAngular, 1, 2, 3, 4, 5, 6, 7, 8]
+
+    // El iman es RELATIVO, no absoluto.
+    //
+    // Un margen fijo de, digamos, 0,05 se nota bien en el 1x -es un 5%- y es
+    // imperceptible en el 8x, donde vale un 0,6%. En relativo, pegarse cuesta
+    // lo mismo en todo el recorrido, que es lo que hace que se sienta parejo.
+    readonly property real iman: 0.05
+
+    // Zona muerta: mientras se esta dentro del iman el valor se queda CLAVADO
+    // en el tope. Sin eso el numero tiembla alrededor del 2,0 y no da la
+    // sensacion de haberse enganchado a nada.
+    function pegar(z) {
+        for (const tope of topes) {
+            if (tope < zoomMinimo - epsilon || tope > zoomMaximo + epsilon) {
+                continue;
+            }
+            if (Math.abs(z - tope) / tope < iman) {
+                return tope;
+            }
+        }
+        return z;
+    }
+
+    property real zoomPedido: 1.0
+
+    function idDeNodo(nodo) {
+        for (const id of root.camera.cameraDeviceIds) {
+            if (id.indexOf(nodo) !== -1) {
+                return id;
+            }
+        }
+        return "";
+    }
+
+    readonly property bool hayGranAngular: idDeNodo(nodoGranAngular) !== ""
+    readonly property bool enTrasera: root.camera.cameraDevice.indexOf(nodoPrincipal) !== -1
+                                      || root.camera.cameraDevice.indexOf(nodoGranAngular) !== -1
+    readonly property real zoomMinimo: (enTrasera && hayGranAngular) ? factorGranAngular : 1.0
+
+    function aplicarZoom() {
+        if (!enTrasera) {
+            viewfinder.scale = Math.max(1.0, zoomPedido);
+            return;
+        }
+        const quiereAngular = hayGranAngular && zoomPedido < 1.0 - epsilon;
+        const destino = idDeNodo(quiereAngular ? nodoGranAngular : nodoPrincipal);
+        if (destino !== "" && root.camera.cameraDevice !== destino) {
+            if (root.camera.busy) {
+                // Se reintenta cuando deje de estarlo. Sin esto, un cambio
+                // pedido mientras la camara arranca se perdia PARA SIEMPRE, y
+                // la app se quedaba en gran angular marcando 1,0x.
+                reintento.running = true;
+            } else {
+                root.camera.cameraDevice = destino;
+            }
+        }
+        const base = quiereAngular ? factorGranAngular : 1.0;
+        viewfinder.scale = Math.max(1.0, zoomPedido / base);
+    }
+
+    Timer {
+        id: reintento
+        interval: 200
+        repeat: true
+        onTriggered: {
+            if (!root.camera.busy) {
+                running = false;
+                root.aplicarZoom();
+            }
+        }
+    }
+
+    onZoomPedidoChanged: aplicarZoom()
+
+    // Y tambien al arrancar: la camara puede venir puesta en el gran angular de
+    // una sesion anterior, y entonces no hay ningun cambio de zoom que dispare
+    // la correccion.
+    Component.onCompleted: aplicarZoom()
+
+    Connections {
+        target: root.camera
+
+        function onCameraDeviceChanged() {
+            // Al pasar a la frontal con el boton de rotar, el zoom vuelve al 1x:
+            // heredar un 4x sin saber por que es desconcertante.
+            if (!root.enTrasera) {
+                if (root.zoomPedido !== 1.0) {
+                    root.zoomPedido = 1.0;
+                }
+                return;
+            }
+            // Y si alguien nos deja en una trasera que no corresponde al zoom
+            // actual, se corrige. Hace falta: la aplicacion RESTAURA la camara
+            // de la sesion anterior DESPUES de que corra Component.onCompleted,
+            // asi que arrancaba en gran angular marcando 1,0x y la correccion
+            // del arranque llegaba demasiado pronto para servir de algo.
+            //
+            // No hay bucle: aplicarZoom solo asigna cuando la camara no es ya
+            // la que toca, asi que a la segunda vuelta no hace nada.
+            root.aplicarZoom();
+        }
+    }
