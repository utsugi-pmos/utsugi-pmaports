286159ef9e7fbf775e0e98ae8fa1e2aa9ec6f03a60e314bcf4a9b223d2d99dcd94e6b0ba5fb75a12d26dd3c663b695a121ec89e43828bb968dbcc9b01488222a  0001-plasma-camera-zoom-bar-with-ultra-wide-crossover.patch
369ee0b4e7989aba38c063c3b94a8810f56921390ab9120b927880e6b1585feb7a83d6dd9dac200b9347fe7efb2bcfdeed1f14a921f946d61d3384881b2caee9  0002-plasma-camera-tap-to-focus.patch
