392aa7583d0e728b5d5a5a8377e2db4e2b2a960b6a9ae6f1c5efb0c95a4a24dd969619cf12ee84defb01757a7e068d2f08363a9fc1b9deaf06f9a35595a477a0  0001-plasma-camera-barra-de-zoom-con-cruce-al-gran-angular.patch
4a67cd04922ebc62a7f5b7d69587f9e1c90b2a8877ece38564021dbe150bffe2181d99ffb3e5700da704fad225cc89d1b8d52e9e6e0ce45175bc7e704614b937  0002-plasma-camera-tocar-para-enfocar.patch
