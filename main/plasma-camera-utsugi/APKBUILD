f96c3aa764e9a15a5576758425ec2ade8877446326f0887e26fd2a36fa6211e221772b8b63f419a2e22b955509c8cbc038cfa0e3912f07b81753adcedc99e1a9  0001-plasma-camera-zoom-bar-with-ultra-wide-crossover.patch
489dae113dd6beface7fb45d751c847e11fea1a445f8b44bd3b619a54036b1af8cfc46235dde211e349cba9208d032ac27c9ccbbc72578baebcd7ab63dffbd88  0002-plasma-camera-tap-to-focus.patch
"
