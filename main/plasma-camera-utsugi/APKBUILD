077742c8d5d97e528388d38523145579d7c143842c534becb018bd97da39923c296c257098103e5aac82edd1951a035cc00e6b8ba9861d0c29c6417cf822eadb  0001-plasma-camera-zoom-bar-with-ultra-wide-crossover.patch
a5de420d73fa0eb259fb58c469777313fa249958a3ebcbb2f2cebf2242cc6d4d35e9d4b31f7f1375f776eadd5a54e5933a21b1486b209094447aa8c36d291df5  0002-plasma-camera-tap-to-focus.patch
"
