+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Contrast autofocus for the POCO X3 NFC (surya).
+//
+// WHY HERE AND NOT IN LIBCAMERA
+// ------------------------------
+// Because libcamera's simple pipeline handler exposes neither AfMode nor
+// LensPosition for this sensor, and because this phone's actuator has two
+// constraints that no generic autofocus accounts for:
+//
+//   - it only accepts commands WHILE THE SENSOR IS STREAMING, because the CCI bus lives
+//     with the sensor;
+//   - and on closing its node, the driver returns the lens to origin and powers off the
+//     chip.
+//
+// The second one is solved by the `enfoque-surya` service, which keeps the node
+// open and accepts positions over a pipe. The first one stops being a
+// problem right here: the preview is ALREADY streaming when the user
+// taps the screen. Which is, looking at it properly, how any
+// autoenfoque de verdad.
+//
+// THE METHOD
+// ---------
+// Climb the sharpness hill, coarsely and then refining, which is what was
+// validated by measuring from the PC: five positions spread over the whole
+// range and two refinements of five around the best. Fourteen measurements
+// gave 512, the same value as an exhaustive sweep of nine positions per
+// otro camino.
+//
+// Here it comes out much cheaper than there: in the preview the frames
+// llegan cada ~50 ms en vez de cada 1,2 s.
+
+#pragma once
+
+#include <QImage>
+#include <QList>
+#include <QObject>
+#include <QPointF>
+
+class Enfocador : public QObject
+{
+    Q_OBJECT
+
+    Q_PROPERTY(bool enfocando READ enfocando NOTIFY enfocandoChanged)
+    Q_PROPERTY(bool disponible READ disponible NOTIFY disponibleChanged)
+    Q_PROPERTY(int posicion READ posicion NOTIFY posicionChanged)
+    Q_PROPERTY(QPointF punto READ punto NOTIFY puntoChanged)
+    Q_PROPERTY(bool logrado READ logrado NOTIFY logradoChanged)
+
+public:
+    explicit Enfocador(QObject *parent = nullptr);
+
+    /*!
+     * Starts focusing at a point of the image, in coordinates from 0 to 1.
+     * Si ya se estaba enfocando, se descarta lo anterior y se empieza de nuevo
+     * at the new point: the user has just said where they want to look.
+     */
+    Q_INVOKABLE void enfocarEn(qreal x, qreal y);
+
+    /*!
+     * Moves the lens to a specific position, without searching. For manual control.
+     */
+    Q_INVOKABLE void moverA(int posicion);
+
+    //! Every preview frame. Cheap when not focusing.
+    void nuevoFotograma(const QImage &imagen);
+
+    /*!
+     * The degrees the image is going to be rotated by for display.
+     *
+     * Without this "tap to focus" would be a lie: the preview is rotated
+     * in software before painting it -the sensor is mounted crooked- so the
+     * point the user taps is NOT the point of the image that arrives here. With
+     * the 270 rotation of the rear camera, tapping the top left would measure the
+     * bottom left, and the user would see the camera focus somewhere else without
+     * understanding why.
+     */
+    void setGiro(int grados);
+
+    bool enfocando() const
+    {
+        return m_enfocando;
+    }
+    bool disponible() const
+    {
+        return m_disponible;
+    }
+    int posicion() const
+    {
+        return m_posicion;
+    }
+    QPointF punto() const
+    {
+        return m_punto;
+    }
+    bool logrado() const
+    {
+        return m_logrado;
+    }
+
+Q_SIGNALS:
+    void enfocandoChanged();
+    void disponibleChanged();
+    void posicionChanged();
+    void puntoChanged();
+    void logradoChanged();
+
+private:
+    //! Writes the position to the service pipe. False if there is no service.
+    bool pedirPosicion(int posicion);
+
+    /*!
+     * Sharpness of the crop around the chosen point.
+     *
+     * Variance of the HORIZONTAL second difference, normalized by the mean
+     * level squared. Normalizing is not cosmetic: raising the gain
+     * raises the signal and its noise at the same time, and without normalizing a change of
+     * exposure during the search would read as a change of focus.
+     *
+     * It is measured only horizontally because that is the version that was validated -against
+     * synthetic blur on a real capture: one pass divides by 15.9 and
+     * two by 54.3-. Here the image does not come decimated, so adding the
+     * vertical axis would give more signal; it is left for when it is measured, not before.
+     */
+    double nitidez(const QImage &imagen) const;
+
+    void terminar();
+    void siguientePosicion();
+
+    /*!
+     * Orders the stage positions in the direction that starts closer to
+     * where the lens is. Same measurements, same result, less travel.
+     */
+    void ordenarDesdeDondeEsta();
+
+    void setEnfocando(bool valor);
+    void setPosicion(int valor);
+    void setLogrado(bool valor);
+
+    bool m_enfocando = false;
+    bool m_disponible = false;
+    bool m_logrado = false;
+    int m_posicion = -1;
+    QPointF m_punto{0.5, 0.5};
+    int m_giro = 0;
+
+    //! The tapped point, mapped to the coordinates of the unrotated image.
+    QPointF puntoEnElSensor() const;
+
+    //! Positions remaining in the current stage, and what has been measured so far.
+    QList<int> m_pendientes;
+    QList<QPair<int, double>> m_medidas;
+    int m_etapa = 0;
+
+    /*!
+     * Frames dropped after moving the lens.
+     *
+     * They are needed for two reasons that add up: the actuator takes time to get there, and
+     * the camera pipeline lags -the frame coming in now was
+     * captured several frames ago-. Measuring without waiting mixes the sharpness of the old
+     * position with the new one, and that does not give a noisier curve: it gives a
+     * SHIFTED curve, which is worse because it looks good.
+     */
+    int m_porTirar = 0;
+    static constexpr int kFotogramasDeEspera = 4;
+};
