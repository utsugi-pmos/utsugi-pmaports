diff -ruN a/src/plasmacamera/enfocador.cpp b/src/plasmacamera/enfocador.cpp
--- a/src/plasmacamera/enfocador.cpp
+++ b/src/plasmacamera/enfocador.cpp
@@ -0,0 +1,331 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "enfocador.h"
+
+#include <QDebug>
+#include <QFile>
+#include <QRect>
+
+#include <algorithm>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace
+{
+// The pipe of the `enfoque-surya` service, which is what keeps the actuator
+// node open. Without it, the lens returns to origin as soon as nobody holds it.
+constexpr const char *kTuberia = "/run/enfoque-surya";
+
+constexpr int kMin = 0;
+constexpr int kMax = 1023;
+
+//! Search stages: five positions each, refining around the best.
+constexpr int kPointsPerStage = 5;
+constexpr int kEtapas = 3;
+
+/*!
+ * How much of the image is looked at around the tapped point, as a fraction of one.
+ * A fifth of the side: enough to have edges to measure, and little enough
+ * for focusing "there" to mean something.
+ */
+constexpr qreal kLadoRecorte = 0.2;
+
+//! Below this, the hill is noise and the lens is not touched.
+constexpr double kRelacionMinima = 1.25;
+}
+
+Enfocador::Enfocador(QObject *parent)
+    : QObject(parent)
+{
+    // The service may not be installed. It is checked once and reported, instead
+    // of failing silently every time somebody taps the screen.
+    m_disponible = QFile::exists(QString::fromLatin1(kTuberia));
+    if (!m_disponible) {
+        qWarning() << "focus: no service at" << kTuberia
+                   << "- tap to focus will do nothing";
+    }
+}
+
+bool Enfocador::pedirPosicion(int posicion)
+{
+    // O_NONBLOCK on purpose: opening a pipe for writing BLOCKS until
+    // there is somebody reading, and here we are on the UI thread. If
+    // the service is not there, this fails with ENXIO instantly instead of hanging
+    // the whole application, which is exactly what must not happen.
+    const int fd = ::open(kTuberia, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        return false;
+    }
+    const QByteArray linea = QByteArray::number(posicion) + '\n';
+    const ssize_t escrito = ::write(fd, linea.constData(), linea.size());
+    ::close(fd);
+    return escrito == linea.size();
+}
+
+void Enfocador::moverA(int posicion)
+{
+    posicion = qBound(kMin, posicion, kMax);
+    if (pedirPosicion(posicion)) {
+        setPosicion(posicion);
+    }
+}
+
+void Enfocador::enfocarEn(qreal x, qreal y)
+{
+    if (!m_disponible) {
+        return;
+    }
+    m_punto = QPointF(qBound(0.0, x, 1.0), qBound(0.0, y, 1.0));
+    Q_EMIT puntoChanged();
+
+    // It starts from scratch even if a search was in progress: the user
+    // has just said where they want to look, and the earlier measurements are from another
+    // place in the image.
+    m_medidas.clear();
+    m_pendientes.clear();
+    m_etapa = 0;
+    setLogrado(false);
+
+    for (int i = 0; i < kPointsPerStage; ++i) {
+        m_pendientes.append(kMin + (kMax - kMin) * i / (kPointsPerStage - 1));
+    }
+    ordenarDesdeDondeEsta();
+    setEnfocando(true);
+    siguientePosicion();
+}
+
+void Enfocador::ordenarDesdeDondeEsta()
+{
+    // WALK EACH STAGE IN THE DIRECTION THAT STARTS CLOSER
+    //
+    // A VCM is a coil pushing the lens against a spring: every long
+    // jump is AUDIBLE. And the first version asked for the sweep in increasing order
+    // always, without looking at where the lens had been left, so between one stage
+    // and the next it made a long trip for nothing:
+    //
+    //     coarse:  0 -> 256 -> 512 -> 767 -> 1023   (ends all the way up)
+    //     fina:    1023 -> 256 -> ...               (767 de vuelta, inutil)
+    //
+    // Walking each stage towards the side that starts closer, that trip
+    // disappears. The same positions are measured and the same result comes out:
+    // only the order changes, and with it, the noise and the time.
+    if (m_pendientes.size() < 2 || m_posicion < 0) {
+        return;
+    }
+    std::sort(m_pendientes.begin(), m_pendientes.end());
+    const int aLoBajo = qAbs(m_pendientes.first() - m_posicion);
+    const int aLoAlto = qAbs(m_pendientes.last() - m_posicion);
+    if (aLoAlto < aLoBajo) {
+        std::reverse(m_pendientes.begin(), m_pendientes.end());
+    }
+}
+
+void Enfocador::siguientePosicion()
+{
+    if (m_pendientes.isEmpty()) {
+        return;
+    }
+    const int siguiente = m_pendientes.takeFirst();
+    if (!pedirPosicion(siguiente)) {
+        // The service died halfway. Better to give up than to keep measuring
+        // a lens that no longer moves and give a result that looks good.
+        qWarning() << "focus: the pipe stopped accepting; giving up";
+        setEnfocando(false);
+        return;
+    }
+    setPosicion(siguiente);
+    m_porTirar = kFotogramasDeEspera;
+}
+
+void Enfocador::nuevoFotograma(const QImage &imagen)
+{
+    if (!m_enfocando || imagen.isNull()) {
+        return;
+    }
+    if (m_porTirar > 0) {
+        --m_porTirar;
+        return;
+    }
+
+    m_medidas.append({m_posicion, nitidez(imagen)});
+
+    if (!m_pendientes.isEmpty()) {
+        siguientePosicion();
+        return;
+    }
+
+    // Stage finished. If any is left, it refines around the best with a
+    // span the width of ONE STEP of this stage on each side: less risk of
+    // leaving the maximum out when the best fell on the edge of the hill,
+    // y mas no afina nada.
+    ++m_etapa;
+    if (m_etapa < kEtapas) {
+        int best = m_medidas.first().first;
+        double valor = m_medidas.first().second;
+        int menor = best, mayor = best;
+        for (const auto &m : std::as_const(m_medidas)) {
+            if (m.second > valor) {
+                valor = m.second;
+                best = m.first;
+            }
+            menor = qMin(menor, m.first);
+            mayor = qMax(mayor, m.first);
+        }
+        const int step = qMax(1, (mayor - menor) / (kPointsPerStage - 1));
+        const int from = qBound(kMin, best - step, kMax);
+        const int to = qBound(kMin, best + step, kMax);
+        for (int i = 0; i < kPointsPerStage; ++i) {
+            const int p = from + (to - from) * i / (kPointsPerStage - 1);
+            // Repeating an already measured position adds nothing and costs frames.
+            bool repetida = false;
+            for (const auto &m : std::as_const(m_medidas)) {
+                if (m.first == p) {
+                    repetida = true;
+                    break;
+                }
+            }
+            if (!repetida && !m_pendientes.contains(p)) {
+                m_pendientes.append(p);
+            }
+        }
+        if (!m_pendientes.isEmpty()) {
+            ordenarDesdeDondeEsta();
+            siguientePosicion();
+            return;
+        }
+    }
+    terminar();
+}
+
+void Enfocador::terminar()
+{
+    int best = m_posicion;
+    double height = 0.0;
+    double bajo = 0.0;
+    bool primero = true;
+    for (const auto &m : std::as_const(m_medidas)) {
+        if (primero) {
+            height = bajo = m.second;
+            best = m.first;
+            primero = false;
+            continue;
+        }
+        if (m.second > height) {
+            height = m.second;
+            best = m.first;
+        }
+        bajo = qMin(bajo, m.second);
+    }
+
+    // IF THE HILL IS FLAT, THE LENS IS NOT TOUCHED.
+    //
+    // A scene with no edges -or too dark, where what is measured is sensor
+    // noise, which does NOT go out of focus because it is added after the optics- gives
+    // some arbitrary maximum that looks perfectly good. It already happened: a
+    // whole search converged to 972 without a single error, with the camera looking
+    // at nothing. Better to leave focus where it was and report that it failed.
+    const double relacion = bajo > 0.0 ? height / bajo : 0.0;
+    const bool bien = m_medidas.size() >= 3 && relacion >= kRelacionMinima;
+
+    if (bien) {
+        pedirPosicion(best);
+        setPosicion(best);
+    }
+    setLogrado(bien);
+    setEnfocando(false);
+}
+
+void Enfocador::setGiro(int grados)
+{
+    m_giro = ((grados % 360) + 360) % 360;
+}
+
+QPointF Enfocador::puntoEnElSensor() const
+{
+    const qreal u = m_punto.x();
+    const qreal v = m_punto.y();
+    switch (m_giro) {
+    case 90:
+        // The image is displayed rotated a quarter turn clockwise, that is
+        // the bottom left corner of the sensor ends up at the top
+        // left of the screen. Undoing it is this:
+        return {v, 1.0 - u};
+    case 180:
+        return {1.0 - u, 1.0 - v};
+    case 270:
+        return {1.0 - v, u};
+    default:
+        return {u, v};
+    }
+}
+
+double Enfocador::nitidez(const QImage &imagen) const
+{
+    const QPointF p = puntoEnElSensor();
+    const int lado = qMax(16, int(qMin(imagen.width(), imagen.height()) * kLadoRecorte));
+    const int cx = int(p.x() * imagen.width());
+    const int cy = int(p.y() * imagen.height());
+    QRect r(cx - lado / 2, cy - lado / 2, lado, lado);
+    r = r.intersected(imagen.rect());
+    if (r.width() < 8 || r.height() < 3) {
+        return 0.0;
+    }
+
+    // It walks row by row with qGray, which is enough and does not force converting
+    // the whole image -this runs on every preview frame-.
+    double suma = 0.0;
+    double suma2 = 0.0;
+    double nivel = 0.0;
+    qint64 n = 0;
+    qint64 nNivel = 0;
+
+    for (int y = r.top(); y <= r.bottom(); ++y) {
+        const QRgb *fila = reinterpret_cast<const QRgb *>(imagen.constScanLine(y));
+        for (int x = r.left() + 1; x < r.right(); ++x) {
+            const int a = qGray(fila[x - 1]);
+            const int b = qGray(fila[x]);
+            const int c = qGray(fila[x + 1]);
+            const double d = a + c - 2 * b;
+            suma += d;
+            suma2 += d * d;
+            nivel += b;
+            ++n;
+            ++nNivel;
+        }
+    }
+    if (n < 8 || nNivel == 0) {
+        return 0.0;
+    }
+    const double media = suma / n;
+    const double varianza = suma2 / n - media * media;
+    const double nivelMedio = qMax(1.0, nivel / nNivel);
+    return varianza / (nivelMedio * nivelMedio);
+}
+
+void Enfocador::setEnfocando(bool valor)
+{
+    if (m_enfocando == valor) {
+        return;
+    }
+    m_enfocando = valor;
+    Q_EMIT enfocandoChanged();
+}
+
+void Enfocador::setPosicion(int valor)
+{
+    if (m_posicion == valor) {
+        return;
+    }
+    m_posicion = valor;
+    Q_EMIT posicionChanged();
+}
+
+void Enfocador::setLogrado(bool valor)
+{
+    if (m_logrado == valor) {
+        return;
+    }
+    m_logrado = valor;
+    Q_EMIT logradoChanged();
+}
