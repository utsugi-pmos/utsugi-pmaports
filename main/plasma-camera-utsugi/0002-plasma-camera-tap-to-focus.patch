diff -ruN a/src/plasmacamera/focuser.cpp b/src/plasmacamera/focuser.cpp
--- a/src/plasmacamera/focuser.cpp
+++ b/src/plasmacamera/focuser.cpp
@@ -0,0 +1,331 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "focuser.h"
+
+#include <QDebug>
+#include <QFile>
+#include <QRect>
+
+#include <algorithm>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace
+{
+// The pipe of the `focus-engine` service, which is what keeps the actuator
+// node open. Without it, the lens returns to origin as soon as nobody holds it.
+constexpr const char *kPipe = "/run/focus-engine";
+
+constexpr int kMin = 0;
+constexpr int kMax = 1023;
+
+//! Search stages: five positions each, refining around the best.
+constexpr int kPointsPerStage = 5;
+constexpr int kStages = 3;
+
+/*!
+ * How much of the image is looked at around the tapped point, as a fraction of one.
+ * A fifth of the side: enough to have edges to measure, and little enough
+ * for focusing "there" to mean something.
+ */
+constexpr qreal kCropSide = 0.2;
+
+//! Below this, the hill is noise and the lens is not touched.
+constexpr double kMinRatio = 1.25;
+}
+
+Focuser::Focuser(QObject *parent)
+    : QObject(parent)
+{
+    // The service may not be installed. It is checked once and reported, instead
+    // of failing silently every time somebody taps the screen.
+    m_available = QFile::exists(QString::fromLatin1(kPipe));
+    if (!m_available) {
+        qWarning() << "focus: no service at" << kPipe
+                   << "- tap to focus will do nothing";
+    }
+}
+
+bool Focuser::requestPosition(int position)
+{
+    // O_NONBLOCK on purpose: opening a pipe for writing BLOCKS until
+    // there is somebody reading, and here we are on the UI thread. If
+    // the service is not there, this fails with ENXIO instantly instead of hanging
+    // the whole application, which is exactly what must not happen.
+    const int fd = ::open(kPipe, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        return false;
+    }
+    const QByteArray line = QByteArray::number(position) + '\n';
+    const ssize_t written = ::write(fd, line.constData(), line.size());
+    ::close(fd);
+    return written == line.size();
+}
+
+void Focuser::moverA(int position)
+{
+    position = qBound(kMin, position, kMax);
+    if (requestPosition(position)) {
+        setPosition(position);
+    }
+}
+
+void Focuser::focusAt(qreal x, qreal y)
+{
+    if (!m_available) {
+        return;
+    }
+    m_point = QPointF(qBound(0.0, x, 1.0), qBound(0.0, y, 1.0));
+    Q_EMIT pointChanged();
+
+    // It starts from scratch even if a search was in progress: the user
+    // has just said where they want to look, and the earlier measurements are from another
+    // place in the image.
+    m_measurements.clear();
+    m_pending.clear();
+    m_stage = 0;
+    setAchieved(false);
+
+    for (int i = 0; i < kPointsPerStage; ++i) {
+        m_pending.append(kMin + (kMax - kMin) * i / (kPointsPerStage - 1));
+    }
+    orderFromWhereItIs();
+    setFocusing(true);
+    nextPosition();
+}
+
+void Focuser::orderFromWhereItIs()
+{
+    // WALK EACH STAGE IN THE DIRECTION THAT STARTS CLOSER
+    //
+    // A VCM is a coil pushing the lens against a spring: every long
+    // jump is AUDIBLE. And the first version asked for the sweep in increasing order
+    // always, without looking at where the lens had been left, so between one stage
+    // and the next it made a long trip for nothing:
+    //
+    //     coarse:  0 -> 256 -> 512 -> 767 -> 1023   (ends all the way up)
+    //     fina:    1023 -> 256 -> ...               (767 de vuelta, inutil)
+    //
+    // Walking each stage towards the side that starts closer, that trip
+    // disappears. The same positions are measured and the same result comes out:
+    // only the order changes, and with it, the noise and the time.
+    if (m_pending.size() < 2 || m_position < 0) {
+        return;
+    }
+    std::sort(m_pending.begin(), m_pending.end());
+    const int toTheLow = qAbs(m_pending.first() - m_position);
+    const int toTheHigh = qAbs(m_pending.last() - m_position);
+    if (toTheHigh < toTheLow) {
+        std::reverse(m_pending.begin(), m_pending.end());
+    }
+}
+
+void Focuser::nextPosition()
+{
+    if (m_pending.isEmpty()) {
+        return;
+    }
+    const int next = m_pending.takeFirst();
+    if (!requestPosition(next)) {
+        // The service died halfway. Better to give up than to keep measuring
+        // a lens that no longer moves and give a result that looks good.
+        qWarning() << "focus: the pipe stopped accepting; giving up";
+        setFocusing(false);
+        return;
+    }
+    setPosition(next);
+    m_toDrop = kFramesToWait;
+}
+
+void Focuser::newFrame(const QImage &image)
+{
+    if (!m_focusing || image.isNull()) {
+        return;
+    }
+    if (m_toDrop > 0) {
+        --m_toDrop;
+        return;
+    }
+
+    m_measurements.append({m_position, sharpness(image)});
+
+    if (!m_pending.isEmpty()) {
+        nextPosition();
+        return;
+    }
+
+    // Stage finished. If any is left, it refines around the best with a
+    // span the width of ONE STEP of this stage on each side: less risk of
+    // leaving the maximum out when the best fell on the edge of the hill,
+    // and more than that refines nothing.
+    ++m_stage;
+    if (m_stage < kStages) {
+        int best = m_measurements.first().first;
+        double value = m_measurements.first().second;
+        int lower = best, higher = best;
+        for (const auto &m : std::as_const(m_measurements)) {
+            if (m.second > value) {
+                value = m.second;
+                best = m.first;
+            }
+            lower = qMin(lower, m.first);
+            higher = qMax(higher, m.first);
+        }
+        const int step = qMax(1, (higher - lower) / (kPointsPerStage - 1));
+        const int from = qBound(kMin, best - step, kMax);
+        const int to = qBound(kMin, best + step, kMax);
+        for (int i = 0; i < kPointsPerStage; ++i) {
+            const int p = from + (to - from) * i / (kPointsPerStage - 1);
+            // Repeating an already measured position adds nothing and costs frames.
+            bool repeated = false;
+            for (const auto &m : std::as_const(m_measurements)) {
+                if (m.first == p) {
+                    repeated = true;
+                    break;
+                }
+            }
+            if (!repeated && !m_pending.contains(p)) {
+                m_pending.append(p);
+            }
+        }
+        if (!m_pending.isEmpty()) {
+            orderFromWhereItIs();
+            nextPosition();
+            return;
+        }
+    }
+    finish();
+}
+
+void Focuser::finish()
+{
+    int best = m_position;
+    double height = 0.0;
+    double low = 0.0;
+    bool first = true;
+    for (const auto &m : std::as_const(m_measurements)) {
+        if (first) {
+            height = low = m.second;
+            best = m.first;
+            first = false;
+            continue;
+        }
+        if (m.second > height) {
+            height = m.second;
+            best = m.first;
+        }
+        low = qMin(low, m.second);
+    }
+
+    // IF THE HILL IS FLAT, THE LENS IS NOT TOUCHED.
+    //
+    // A scene with no edges -or too dark, where what is measured is sensor
+    // noise, which does NOT go out of focus because it is added after the optics- gives
+    // some arbitrary maximum that looks perfectly good. It already happened: a
+    // whole search converged to 972 without a single error, with the camera looking
+    // at nothing. Better to leave focus where it was and report that it failed.
+    const double ratio = low > 0.0 ? height / low : 0.0;
+    const bool good = m_measurements.size() >= 3 && ratio >= kMinRatio;
+
+    if (good) {
+        requestPosition(best);
+        setPosition(best);
+    }
+    setAchieved(good);
+    setFocusing(false);
+}
+
+void Focuser::setGiro(int degrees)
+{
+    m_giro = ((degrees % 360) + 360) % 360;
+}
+
+QPointF Focuser::pointOnSensor() const
+{
+    const qreal u = m_point.x();
+    const qreal v = m_point.y();
+    switch (m_giro) {
+    case 90:
+        // The image is displayed rotated a quarter turn clockwise, that is
+        // the bottom left corner of the sensor ends up at the top
+        // left of the screen. Undoing it is this:
+        return {v, 1.0 - u};
+    case 180:
+        return {1.0 - u, 1.0 - v};
+    case 270:
+        return {1.0 - v, u};
+    default:
+        return {u, v};
+    }
+}
+
+double Focuser::sharpness(const QImage &image) const
+{
+    const QPointF p = pointOnSensor();
+    const int side = qMax(16, int(qMin(image.width(), image.height()) * kCropSide));
+    const int cx = int(p.x() * image.width());
+    const int cy = int(p.y() * image.height());
+    QRect r(cx - side / 2, cy - side / 2, side, side);
+    r = r.intersected(image.rect());
+    if (r.width() < 8 || r.height() < 3) {
+        return 0.0;
+    }
+
+    // It walks row by row with qGray, which is enough and does not force converting
+    // the whole image -this runs on every preview frame-.
+    double sum = 0.0;
+    double sum2 = 0.0;
+    double level = 0.0;
+    qint64 n = 0;
+    qint64 nLevel = 0;
+
+    for (int y = r.top(); y <= r.bottom(); ++y) {
+        const QRgb *row = reinterpret_cast<const QRgb *>(image.constScanLine(y));
+        for (int x = r.left() + 1; x < r.right(); ++x) {
+            const int a = qGray(row[x - 1]);
+            const int b = qGray(row[x]);
+            const int c = qGray(row[x + 1]);
+            const double d = a + c - 2 * b;
+            sum += d;
+            sum2 += d * d;
+            level += b;
+            ++n;
+            ++nLevel;
+        }
+    }
+    if (n < 8 || nLevel == 0) {
+        return 0.0;
+    }
+    const double mean = sum / n;
+    const double variance = sum2 / n - mean * mean;
+    const double meanLevel = qMax(1.0, level / nLevel);
+    return variance / (meanLevel * meanLevel);
+}
+
+void Focuser::setFocusing(bool value)
+{
+    if (m_focusing == value) {
+        return;
+    }
+    m_focusing = value;
+    Q_EMIT focusingChanged();
+}
+
+void Focuser::setPosition(int value)
+{
+    if (m_position == value) {
+        return;
+    }
+    m_position = value;
+    Q_EMIT positionChanged();
+}
+
+void Focuser::setAchieved(bool value)
+{
+    if (m_achieved == value) {
+        return;
+    }
+    m_achieved = value;
+    Q_EMIT achievedChanged();
+}
