 }
 
+/*
+ * Opens the directory a path names a file in, and points `base` at the file
+ * name inside `path`. Renaming needs the two halves apart: openat() resolves a
+ * whole path down to the file, and renameat() wants the parent and the name.
+ */
+static int open_parent_dir(struct hexagonfs_fd **fds, int rootfd,
+			   const char *path, const char **base)
+{
+	const char *slash;
+	char *dir;
+	int ret;
+
+	slash = strrchr(path, '/');
+
+	/* No directory part, or the parent is the root itself. */
+	if (slash == NULL || slash == path) {
+		*base = slash == NULL ? path : slash + 1;
+		return rootfd;
+	}
+
+	dir = strndup(path, slash - path);
+	if (dir == NULL)
+		return -ENOMEM;
+
+	ret = hexagonfs_openat(fds, rootfd, rootfd, dir, 0);
+
+	free(dir);
+
+	*base = slash + 1;
+
+	return ret;
+}
+
+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd,
+		     const char *oldpath, const char *newpath)
+{
+	const char *oldbase, *newbase;
+	int olddir, newdir, ret;
+
+	olddir = open_parent_dir(fds, rootfd, oldpath, &oldbase);
+	if (olddir < 0)
+		return olddir;
+
+	newdir = open_parent_dir(fds, rootfd, newpath, &newbase);
+	if (newdir < 0) {
+		ret = newdir;
+		goto out_close_old;
+	}
+
+	if (*oldbase == '\0' || *newbase == '\0') {
+		ret = -EINVAL;
+		goto out_close_new;
+	}
+
+	/*
+	 * Only two real directories can be renamed between. Anything else --
+	 * a virtual directory, or one side of each -- has no name to move.
+	 */
+	if (fds[olddir]->ops != fds[newdir]->ops
+	 || fds[olddir]->ops->renameat == NULL) {
+		ret = -EXDEV;
+		goto out_close_new;
+	}
+
+	ret = fds[olddir]->ops->renameat(fds[olddir], oldbase,
+					 fds[newdir], newbase);
+
+out_close_new:
+	if (fds[newdir] != fds[rootfd])
+		hexagonfs_close(fds, newdir);
+out_close_old:
+	if (fds[olddir] != fds[rootfd])
+		hexagonfs_close(fds, olddir);
+
+	return ret;
+}
+
 ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno,
 			size_t size, const void *ptr)
 {
