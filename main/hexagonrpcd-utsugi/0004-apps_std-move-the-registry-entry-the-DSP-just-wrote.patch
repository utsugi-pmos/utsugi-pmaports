+/*
+ * The sensor registry is not written in place: the DSP writes one entry into a
+ * scratch file and then asks for it to be moved over the real one. Without
+ * this the scratch file is written over and over -- once per registry entry,
+ * some 1900 calls on this device -- and nothing is ever kept.
+ *
+ * inbufs[0] holds the method id and the two path lengths; the paths themselves
+ * are the other two buffers.
+ */
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *oldname = inbufs[1].p;
+	const char *newname = inbufs[2].p;
+	int ret;
+
+	// Both names must be NULL-terminated
+	if (oldname[inbufs[1].s - 1] != 0
+	 || newname[inbufs[2].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_rename(ctx->fds, ctx->rootfd, oldname, newname);
+	if (ret) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n",
+				oldname, newname, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("rename(%s, %s)\n", oldname, newname);
+#endif
+
+	return 0;
+}
