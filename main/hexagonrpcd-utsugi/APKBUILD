# LOCAL SURYA APORT -- not Alpine's as-is. Two patches, both needed to bring the
# sensor registry up; see README.md for the whole story.
#
# 0001 maps /mnt/vendor/persist/sensors/registry to the REAL sensors/ directory
# instead of a virtual one with a single child. Without it the DSP's request for
# '.../registry/registry/../sns_reg_version' -- note the '..' -- resolves that
# '..' up the VIRTUAL tree, lands outside anything mapped and returns ENOENT no
# matter where the file is put.
#
# 0002 serves writable files. The DSP writes 'temp.json' next to the registry
# before it can initialise it, and 0.4.0 refuses every write-mode fopen().
#
# 0003 grows the listener's 256-byte input buffer, which cannot hold the payload
# of a write, and makes a rejected call say which one it was.
#
# 0004 implements the rename the DSP uses to move each registry entry into
# place. Without it nothing it writes is ever kept.
#
# Either one missing: registry init fails, the sensor PD dies, it drags the ADSP
# with it, and the sound card goes with the ADSP.
#
# Upstream issues: https://github.com/linux-msm/hexagonrpc/issues/19 and /21
#
# Contributor: Dylan Van Assche <dylan@postmarketos.org>
# Maintainer: Dylan Van Assche <dylan@postmarketos.org>
_orig=hexagonrpcd
pkgname=$_orig-utsugi
pkgver=0.4.0
pkgrel=8
# FORK of hexagonrpcd. Same files as upstream, so it claims upstream's name with a
# versioned provides and a replaces: apk then refuses to have both installed and
# every package that depends on "hexagonrpcd" is satisfied by this one.
provides="$_orig=$pkgver-r$pkgrel"
replaces="$_orig"
pkgdesc="Qualcomm HexagonFS daemon"
url="https://github.com/linux-msm/hexagonrpc"
# s390x: fails on 1 test. Hexagonrpcd is specific to Qualcomm ARM SoCs, so let's ignore it for now.
arch="all !s390x"
license="GPL-3.0-or-later"
makedepends="linux-headers meson"
install="$pkgname.pre-install"
subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd $pkgname-udev"

source="$_orig-$pkgver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/refs/tags/v$pkgver.tar.gz
	10-fastrpc.rules
	$_orig-adsp-rootpd.initd
	$_orig-adsp-sensorspd.initd
	$_orig-sdsp.initd
	systemd-services.patch
	0001-rpcd_builder-map-persist-registry-to-sensors-dir.patch
	0002-apps_std-serve-writable-files.patch
	0003-listener-fit-a-write-and-name-what-it-cannot-serve.patch
	0004-apps_std-move-the-registry-entry-the-DSP-just-wrote.patch
	"
builddir="$srcdir/hexagonrpc-$pkgver"

build() {
	abuild-meson -Db_lto=true . output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# Allow access for FastRPC node for FastRPC user/group
	install -Dm644 "$srcdir"/10-fastrpc.rules -t "$pkgdir"/usr/lib/udev/rules.d/

	install -Dm755 "$srcdir"/$_orig-adsp-rootpd.initd "$pkgdir"/etc/init.d/$_orig-adsp-rootpd
	install -Dm755 "$srcdir"/$_orig-adsp-sensorspd.initd "$pkgdir"/etc/init.d/$_orig-adsp-sensorspd
	install -Dm755 "$srcdir"/$_orig-sdsp.initd "$pkgdir"/etc/init.d/$_orig-sdsp
}


doc() {
	default_doc
	provides="hexagonrpcd-doc=$pkgver-r$pkgrel"
	replaces="hexagonrpcd-doc"
}

openrc() {
	default_openrc
	provides="hexagonrpcd-openrc=$pkgver-r$pkgrel"
	replaces="hexagonrpcd-openrc"
}

systemd() {
	default_systemd
	provides="hexagonrpcd-systemd=$pkgver-r$pkgrel"
	replaces="hexagonrpcd-systemd"
}

udev() {
	default_udev
	provides="hexagonrpcd-udev=$pkgver-r$pkgrel"
	replaces="hexagonrpcd-udev"
}

