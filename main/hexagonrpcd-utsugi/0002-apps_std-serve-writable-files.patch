@@ -102,7 +110,26 @@
 	if (expect_dir)
 		flags |= O_DIRECTORY;
 
-	ctx->fd = openat(dir_ctx->fd, segment, flags);
+	/*
+	 * The DSP creates and rewrites files under the directories it is
+	 * served -- the sensor registry among them -- so honour the create
+	 * flags the caller derived from the fopen() mode instead of failing
+	 * the open. Directories are always opened read-only.
+	 *
+	 * A read-only open is still tried read-write first: a file the DSP
+	 * only reads now may be one it writes later, and there is no second
+	 * chance to upgrade the descriptor.
+	 */
+	if (expect_dir)
+		ctx->fd = -1;
+	else
+		ctx->fd = openat(dir_ctx->fd, segment,
+				 (flags & ~O_ACCMODE) | O_RDWR | create_flags,
+				 0644);
+
+	/* Read-only filesystem, or a file we may not write: serve it as-is. */
+	if (ctx->fd == -1)
+		ctx->fd = openat(dir_ctx->fd, segment, flags);
 	if (ctx->fd == -1) {
