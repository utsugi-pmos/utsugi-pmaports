maintainer="Dr. Utsugi <cidwel@gmail.com>"
pkgname=smart-unlock
pkgver=1.1
pkgrel=0
pkgdesc="Skip the PIN on a trusted wifi, after unlocking, or in chosen time slots"
url="https://github.com/utsugi-pmos/smart-unlock"
arch="all"
license="GPL-2.0-or-later"
options="!check"
subpackages="$pkgname-systemd"
depends="
	plasma-settings
	kcmutils
	kirigami
	qt6-qtdeclarative
	qt6-qtsvg
	networkmanager
	"
makedepends="
	cmake
	samurai
	extra-cmake-modules
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	kcmutils-dev
	kconfig-dev
	kcoreaddons-dev
	ki18n-dev
	kirigami-dev
	"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
	80-smart-unlock.preset
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir"/80-smart-unlock.preset -t "$pkgdir"/usr/lib/systemd/user-preset/

}

systemd() {
	default_systemd
}
