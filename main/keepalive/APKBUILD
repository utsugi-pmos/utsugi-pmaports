maintainer="Dr. Utsugi <cidwel@gmail.com>"
# Apps that stay alive: swiping their card away in the task switcher minimises
# them instead of killing them, so the next open is instant.
#
# Two halves. The application and its Settings module manage the list; the
# behaviour itself is one guard inside Plasma Mobile's task switcher, which is a
# KWin effect written in loose QML.
#
# THE EFFECT IS NOT PATCHED IN PLACE. It is rebuilt from plasma-mobile's own
# tarball and installed into a data directory of ours, which environment.d puts
# AHEAD of /usr/share so KPackage finds it first. Owning plasma-mobile's file
# instead would mean that after a Plasma upgrade our old Task.qml sits next to
# new siblings -- mixed versions, and no error to say so.
#
# That is also why the dependency on plasma-mobile is pinned to the version the
# patch was made against: when Plasma moves, apk refuses to upgrade until this
# package is rebuilt. Loud, rather than silently broken.
pkgname=keepalive
pkgver=1.0
pkgrel=0
_pmver=6.7.4
pkgdesc="Keep chosen apps alive: swiping their card away minimises instead of closing"
url="https://github.com/utsugi-pmos/keepalive"
arch="all"
license="GPL-2.0-or-later"
options="!check"
subpackages="$pkgname-systemd"
depends="
	plasma-settings
	kcmutils
	kirigami
	qt6-qtdeclarative
	qt6-qtsvg
	plasma-mobile~$_pmver
	"
makedepends="
	cmake
	samurai
	extra-cmake-modules
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	kcmutils-dev
	kconfig-dev
	kcoreaddons-dev
	ki18n-dev
	kservice-dev
	kirigami-dev
	"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
	plasma-mobile-$_pmver.tar.xz::https://download.kde.org/stable/plasma/$_pmver/plasma-mobile-$_pmver.tar.xz
	0001-keep-marked-apps-alive-when-their-card-is-swiped-away.patch
	80-keepalive.preset
	40-keepalive.conf
	"

prepare() {
	# NOT default_prepare: it would try to apply the patch to OUR tree, and the
	# file it touches lives in plasma-mobile's.
	cd "$srcdir/plasma-mobile-$_pmver"
	patch -p1 -i "$srcdir"/0001-keep-marked-apps-alive-when-their-card-is-swiped-away.patch
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	# The patched effect, complete: KPackage needs the whole directory, not just
	# the file that changed.
	local eff="$srcdir/plasma-mobile-$_pmver/kwin/mobiletaskswitcher/package"
	mkdir -p "$pkgdir"/usr/share/keepalive/xdg-data/kwin/effects/mobiletaskswitcher
	cp -r "$eff"/. \
		"$pkgdir"/usr/share/keepalive/xdg-data/kwin/effects/mobiletaskswitcher/
	install -Dm644 "$srcdir"/40-keepalive.conf -t "$pkgdir"/usr/lib/environment.d/

	# Opens a marked application that is not running yet, minimised, and only
	# after the screen has actually been unlocked.
	# These come from the application's own tarball, not carried separately.
	install -Dm755 launch "$pkgdir"/usr/bin/keepalive-launch
	install -Dm755 wait-for-unlock \
		"$pkgdir"/usr/libexec/utsugi-surya/keepalive-wait-for-unlock
	install -Dm644 keepalive-unlock.service -t "$pkgdir"/usr/lib/systemd/user/
	install -Dm644 "$srcdir"/80-keepalive.preset \
		-t "$pkgdir"/usr/lib/systemd/user-preset/
}

systemd() {
	default_systemd
}
