# Valhalla WITH the Python bindings, which is the one thing Alpine's package is
# missing.
#
# WHY THIS RECIPE EXISTS
# ----------------------
# PocoNav has to be able to compute routes WITHOUT depending on osmscout-server.
# Today it does, and that is not independence: it is having swapped a remote
# server for a local one belonging to somebody else.
#
# 'libvalhalla.so' is already on the phone -- osmscout-server does nothing
# magic, it just links it. The problem is HOW to reach it from PocoNav:
#
#   valhalla_service   Valhalla's own HTTP server. NOT possible: it requires
#                      'prime_server', which Alpine does not package. That is
#                      why the original recipe carries -DENABLE_SERVICES=OFF.
#   C++ headers        Alpine's 'valhalla-dev' is EMPTY -- checked with
#                      'apk info -L': zero files. Without them nothing can be
#                      compiled against the library.
#   Python bindings    these DO work: 'py3-pybind11' is in the repositories.
#
# So that single option gets turned on. With it, PocoNav starts its own routing
# server in Python and needs nobody else.
#
# The services stay off: there is no 'prime_server' and they are not needed.
#
# ENABLE_DATA_TOOLS does have to be turned on, even though the tools go unused.
# Measured: with it off the Python bindings compile but do NOT link --
#
#   ImportError: Error relocating _valhalla.abi3.so:
#   valhalla::mjolnir::compute_tileset_build_id: symbol not found
#
# The module calls into 'mjolnir', the tile library, and that one is only built
# with DATA_TOOLS. It is not optional for what we want.
#
# The bindings use 'nanobind', which comes inside Valhalla's own tree, not
# pybind11. 'py3-pybind11' is left in makedepends in case some version asks for
# it again, but today it goes untouched.

maintainer="Bart Ribbers <bribbers@disroot.org>"
_orig=valhalla
pkgname=$_orig-utsugi
pkgver=3.8.3
pkgrel=3
# FORK of valhalla. Same files as upstream, so it claims upstream's name with a
# versioned provides and a replaces: apk then refuses to have both installed and
# every package that depends on "valhalla" is satisfied by this one.
provides="$_orig=$pkgver-r$pkgrel"
replaces="$_orig"
pkgdesc="Open Source Routing Engine for OpenStreetMap (with Python bindings)"
url="https://valhalla.readthedocs.io/"
# riscv64 blocked by luajit
arch="all !riscv64"
license="MIT"
depends_dev="
	boost-dev
	curl-dev
	gtest-dev
	libspatialite-dev
	luajit-dev
	lz4-dev
	protobuf-dev
	python3-dev
	rapidjson-dev
	sqlite-dev
	zeromq-dev
	zlib-dev
	"
# geos, openssl and expat are asked for only by the DATA_TOOLS block, which
# Alpine has turned off. That is why they are not in the original recipe.
makedepends="$depends_dev
	cmake
	samurai
	py3-pybind11
	geos-dev
	openssl-dev
	expat-dev
	"
checkdepends="bash"
subpackages="$pkgname-dev $pkgname-doc py3-$pkgname:_py3"
source="https://dev.alpinelinux.org/archive/valhalla/valhalla-$pkgver.tar.gz"
builddir="$srcdir/$_orig"
# check: localedef: command not found
options="!check"

prepare() {
	default_prepare

	# DATA_TOOLS requires the 'spatialite' and 'spatialite_tool' executables,
	# which Alpine does NOT package -- it only has the library. Without this
	# patch cmake does not even get as far as compiling.
	#
	# It can be dropped with no consequences HERE. Its comment in the CMakeLists
	# says what they are for: "make sure we can build tz.sqlite", the time-zone
	# database. That database is built from OSM data, and we do NOT build tiles
	# on the phone: they are downloaded ready-made, with their tz.sqlite inside.
	#
	# What is lost is the ability to generate tiles from scratch on this device,
	# which is not something a phone is ever going to do: it is hours of CPU and
	# tens of gigabytes of .pbf.
	sed -i '/spatialite-tools not found/s/FATAL_ERROR/WARNING/' CMakeLists.txt
}

build() {
	export CXXFLAGS="$CXXFLAGS -Wno-deprecated-declarations"
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=TRUE \
		-DENABLE_WERROR=OFF \
		-DENABLE_TOOLS=OFF \
		-DENABLE_DATA_TOOLS=ON \
		-DENABLE_SERVICES=OFF \
		-DENABLE_HTTP=ON \
		-DENABLE_PYTHON_BINDINGS=ON \
		-DENABLE_CCACHE=OFF \
		-DENABLE_COVERAGE=OFF \
		-DENABLE_COMPILER_WARNINGS=ON \
		-DENABLE_SANITIZERS=OFF \
		-DENABLE_ADDRESS_SANITIZER=OFF \
		-DENABLE_UNDEFINED_SANITIZER=OFF \
		-DENABLE_TESTS=OFF \
		-DENABLE_SINGLE_FILES_WERROR=OFF \
		-DENABLE_THREAD_SAFE_TILE_REF_COUNT=OFF \
		-DProtobuf_PROTOC_EXECUTABLE=/usr/bin/protoc
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

# The Python module in a package of its own, so it can be installed without
# dragging anything else in and so 'apk' knows it depends on python3.
_py3() {
	pkgdesc="$pkgdesc (Python module)"
	provides="py3-$_orig=$pkgver-r$pkgrel"
	replaces="py3-$_orig"
	depends="python3 $pkgname=$pkgver-r$pkgrel"
	amove usr/lib/python3*/site-packages/valhalla* || true
}

dev() {
	default_dev
	provides="valhalla-dev=$pkgver-r$pkgrel"
	replaces="valhalla-dev"
}

doc() {
	default_doc
	provides="valhalla-doc=$pkgver-r$pkgrel"
	replaces="valhalla-doc"
}

sha512sums="
