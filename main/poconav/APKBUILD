maintainer="Dr. Utsugi <cidwel@gmail.com>"
pkgname=poconav
pkgver=1.3
pkgrel=0
pkgdesc="Car navigation with neural-network voice, made for the dashboard"
url="https://github.com/utsugi-pmos/poconav"
arch="all"
license="LGPL-2.0-or-later"
options="!check"
# maplibre-native-qt6 is not optional, and it was missing: the map switches to
# the maplibre plugin the moment there are downloaded tiles (main.qml:
# name: root.localDrawing ? "maplibre" : "osm"). The plugin was published and
# depended on by nobody, so a phone drew fine on the online tiles and went blank
# the day you downloaded your own region -- the one case the offline design
# exists for.
depends="
	qt6-qtdeclarative
	qt6-qtlocation
	qt6-qtpositioning
	qt6-qtsensors
	kirigami
	espeak-ng
	alsa-utils
	python3
	py3-valhalla-utsugi
	maplibre-native-qt6
	"
makedepends="
	cmake
	samurai
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtpositioning-dev
	qt6-qttools-dev
	"
# A tag is immutable: re-tagging the same version leaves the OLD tarball in the
# distfile cache under the same name, and the build then silently uses it.
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm755 poconav-routes local-maps -t "$pkgdir"/usr/bin/
}
sha512sums="
d49cffd075ba683f5dea9d920ab1609304fd81484be44239b12372f6269e4591dedb96d036b8b29d57989fff7a65b0d0e9e6bf1ca1e2afd8f701a1387f132904  poconav-1.3.tar.gz
"
