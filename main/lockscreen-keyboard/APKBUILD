# Maintainer: Dr. Utsugi <cidwel@gmail.com>
#
# A lock screen that opens on the letters keyboard when the password is not a
# PIN. Plasma Mobile always starts on the number pad: a password with letters
# needs a tap on a small button first, and whoever does not know the button is
# left looking at digits. The first-boot Advanced setup writes the choice to
# ~/.config/utsugi-lockscreenrc.
#
# THE SHELL IS NOT PATCHED IN PLACE, the same way keepalive ships its task
# switcher: the mobile shell package is rebuilt from plasma-mobile's own tarball
# and installed into a data directory of ours, put AHEAD of /usr/share by a
# profile script, so KPackage finds it first. The whole package, because
# KPackage takes the first directory that has it and reads nothing from the
# others. The lock screen greeter and plasmashell both load it.
#
# The dependency on plasma-mobile is pinned to the version the patch was made
# against: when Plasma moves, apk refuses to upgrade until this is rebuilt,
# instead of an old shell running against a new Plasma.
pkgname=lockscreen-keyboard
pkgver=1
pkgrel=1
_pmver=6.7.5
pkgdesc="Plasma Mobile lock screen that opens on the keyboard for passwords that are not a PIN"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="GPL-2.0-or-later"
options="!check"
depends="plasma-mobile~$_pmver"
source="plasma-mobile-$_pmver.tar.xz::https://download.kde.org/stable/plasma/$_pmver/plasma-mobile-$_pmver.tar.xz
	start-on-the-keyboard.diff
	lockscreen-keyboard.profile
	"
builddir="$srcdir/plasma-mobile-$_pmver"

prepare() {
	default_prepare
	# .diff, not .patch: default_prepare would apply a .patch on its own, and
	# this one is applied here on purpose, next to the package it changes.
	patch -p1 -i "$srcdir"/start-on-the-keyboard.diff
}

package() {
	local shell="$pkgdir"/usr/share/lockscreen-keyboard/xdg-data/plasma/shells/org.kde.plasma.mobileshell
	mkdir -p "$shell"
	cp -r "$builddir"/shell/. "$shell"/
	rm -f "$shell"/Messages.sh
	install -Dm644 "$srcdir"/lockscreen-keyboard.profile \
		"$pkgdir"/etc/profile.d/lockscreen-keyboard.sh
}
sha512sums="
