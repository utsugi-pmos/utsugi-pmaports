+
     // whether we are in keyboard mode (hiding the numpad)
     property bool isKeyboardMode: false
 
+    // utsugi: start on the keyboard when the password is not a PIN.
+    //
+    // NOT a binding on unlockSettings.value(): that ran before Settings had its
+    // location, read the default, and never ran again -- the lock screen stayed
+    // on the number pad (measured 2026-09-17). And not only once: the greeter
+    // outlives unlocks, so this runs again every time the screen turns off,
+    // re-reading the file (sync) in case the setting changed.
+    function applyStartKeyboard(): void {
+        if (typeof unlockSettings.sync === "function") {
+            unlockSettings.sync();
+        }
+        isKeyboardMode = String(unlockSettings.value("startWithKeyboard", false)) === "true";
+    }
