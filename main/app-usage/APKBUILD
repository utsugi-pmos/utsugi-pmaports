maintainer="Dr. Utsugi <cidwel@gmail.com>"
pkgname=app-usage
pkgver=1.4
pkgrel=0
pkgdesc="Battery usage per application, in System Settings; the screen Plasma Mobile does not ship"
url="https://github.com/utsugi-pmos/app-usage"
arch="all"
license="LGPL-2.0-or-later"
options="!check"
subpackages="$pkgname-systemd"
# Since 1.4 the screen is a System Settings module (kcm_app_usage, under
# Hardware), not a drawer app -- so the KDE runtime that hosts KCMs is required.
depends="
	plasma-settings
	kcmutils
	kirigami
	qt6-qtdeclarative
	qt6-qtsvg
	python3
	"
makedepends="
	cmake
	samurai
	extra-cmake-modules
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qttools
	kcmutils-dev
	kconfig-dev
	kcoreaddons-dev
	ki18n-dev
	kirigami-dev
	"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
	80-app-usage.preset
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir"/80-app-usage.preset -t "$pkgdir"/usr/lib/systemd/user-preset/

}

systemd() {
	default_systemd
}
sha512sums="
