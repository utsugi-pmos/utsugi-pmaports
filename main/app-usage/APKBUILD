maintainer="Dr. Utsugi <cidwel@gmail.com>"
pkgname=app-usage
pkgver=1.3
pkgrel=0
pkgdesc="Battery usage per application, the screen Plasma Mobile does not ship"
url="https://github.com/utsugi-pmos/app-usage"
arch="all"
license="LGPL-2.0-or-later"
options="!check"
subpackages="$pkgname-systemd"
depends="
	qt6-qtdeclarative
	qt6-qtsvg
	python3
	"
makedepends="
	cmake
	samurai
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qttools
	"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
	80-app-usage.preset
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir"/80-app-usage.preset -t "$pkgdir"/usr/lib/systemd/user-preset/

}

systemd() {
	default_systemd
}
