+public:
+	CameraSensorHelperHi1337()
+	{
+		/*
+		 * Pedestal of 64 in ten bits, MEASURED on this sensor: with the
+		 * scene in the dark all the pixels land at 16 of the eight high
+		 * bits, with no spread, which is the 64 in ten bits.
+		 */
+		blackLevel_ = 4096;
+		/*
+		 * LINEAR gain with unity at 512: gain = code / 512.
+		 *
+		 * MEASURED, not from a datasheet. With the exposure fixed and a
+		 * still scene, looking at the signal above the pedestal AND the
+		 * contrast, which is what tells a gain apart from a black
+		 * level offset:
+		 *
+		 *     codigo  senal   contraste
+		 *        512   9,58        25,0
+		 *       1024  19,57        49,0    (x2,04 y x1,96)
+		 *       2048  39,49        96,0    (x4,12 y x3,84)
+		 *
+		 * Both quantities rise proportionally to the code, so the
+		 * curve is a straight line through the origin and 512 is 1x.
+		 *
+		 * Note: the gain of this sensor is FOUR registers, one per
+		 * Bayer channel -0x0214, 0x0216, 0x0218 and 0x021a-, which the driver
+		 * writes together. The 0x0204 next to them is NOT gain: it is the
+		 * black level, and it is told apart because it raises the mean while
+		 * it LOWERS the contrast.
+		 */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 512 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("hi1337", CameraSensorHelperHi1337)
