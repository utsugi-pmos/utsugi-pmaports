maintainer="SzczurekYT <szczurek@szczurek.yt>"
_orig=qcom-diag
pkgname=$_orig-utsugi
pkgver=0_git20250324
pkgrel=5
# FORK of qcom-diag. Same files as upstream, so it claims upstream's name with a
# versioned provides and a replaces: apk then refuses to have both installed and
# every package that depends on "qcom-diag" is satisfied by this one.
provides="$_orig=$pkgver-r$pkgrel"
replaces="$_orig"
_commit="29277ef0bcbe22468a3836b796dc525ba6df87f3"
pkgdesc="Routing of diagnostics related messages between host and various subsystems"
url="https://github.com/linux-msm/diag"
arch="all"
license="BSD-3-Clause"
makedepends="linux-headers musl-dev eudev-dev qrtr-dev"
subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd"
source="
	0001-qrtr-send-masks.patch
	0002-enable-masks-by-default.patch
	0003-full-ssid-coverage.patch
	diag-$_commit.tar.gz::https://github.com/linux-msm/diag/archive/$_commit.tar.gz
	diag-router.initd
	systemd-service.patch
"
builddir="$srcdir/diag-$_commit"
options="!check" # No test suite

build() {
	make prefix=/usr all
}

package() {
	make prefix=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/COPYING
	install -Dm755 "$srcdir"/diag-router.initd "$pkgdir"/etc/init.d/diag-router
	install -Dm644 diag-router.service -t "$pkgdir"/usr/lib/systemd/system/
}

doc() {
	default_doc
	provides="qcom-diag-doc=$pkgver-r$pkgrel"
	replaces="qcom-diag-doc"
}

openrc() {
	default_openrc
	provides="qcom-diag-openrc=$pkgver-r$pkgrel"
	replaces="qcom-diag-openrc"
}

systemd() {
	default_systemd
	provides="qcom-diag-systemd=$pkgver-r$pkgrel"
	replaces="qcom-diag-systemd"
}

