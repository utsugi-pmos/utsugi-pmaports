# Maintainer: Dr. Utsugi <cidwel@gmail.com>
#
# Compass, and the instrument used to find out whether the phone's sensors
# reach Linux at all.
#
# Its real job is to tell "there is no sensor" apart from "the sensor reads
# zero", which look identical to the eye and are not the same thing. In Qt,
# 'active: true' is a REQUEST: with no backend behind it, Qt sets 'active' back
# to false by itself, and that is what the page watches -- rather than watching
# whether the numbers move, which with the phone lying still would report a
# false negative. A sensor that is active but silent shows amber, not green.
#
# Nothing is compiled: it is QML, and QtSensors with its iio-sensor-proxy
# backend are already on the phone. It is in main/ and not device/ because
# nothing in it is specific to the surya -- it is useful on any phone where the
# question "does this sensor work?" comes up.
pkgname=utsugi-compass
pkgver=1
pkgrel=1
pkgdesc="Compass and sensor test bench"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="GPL-3.0-or-later"
# qmlscene lives in qt6-qtdeclarative and the QtSensors QML module in
# qt6-qtsensors; both checked against the image's package database rather than
# assumed. Without either, the launcher opens a black window and closes, which
# is the failure that says nothing.
depends="qt6-qtdeclarative qt6-qtsensors"
options="!check"  # no test suite: it is a QML page
source="compass.qml
	utsugi-compass.desktop
	utsugi-compass.svg"

package() {
	install -Dm644 "$srcdir"/compass.qml \
		-t "$pkgdir"/usr/share/utsugi-compass/
	install -Dm644 "$srcdir"/utsugi-compass.desktop \
		-t "$pkgdir"/usr/share/applications/
	# By theme NAME, not by absolute path. The shell script this replaced had
	# to use an absolute path because it installed into the user's own hicolor
	# tree, which has no index.theme, so KDE never indexed it and the name did
	# not resolve. Installed system-wide the name resolves normally.
	install -Dm644 "$srcdir"/utsugi-compass.svg \
		"$pkgdir"/usr/share/icons/hicolor/scalable/apps/utsugi-compass.svg
}
sha512sums="
