bb57ab414b52a9a57871bcb74ec7e25635b4482d03d6d4337ae9c30960e0211bf80eb49655139c294e54fc6692ba32ef3fad4c8c8727422f94cd54b5a5500c5c  utsugi-compass.desktop
418fe6be6b5e0a5e8971c90745e3b6c21bccde24f9dcce16ca1d6fdf6ac3eb153e9c515d8d6f1dea87f2da0444598bf4e8f8ade0399ff6b56b7d49530cbf4533  utsugi-compass.svg
"
