b19a112b2362fed0c3c5cb1592220c8478659dc17074fc9fc55e89bc30edea6f93dc335167bd4432b207b9c91f9a800f0a44cb71927fac677c6bce63b9256c73  0001-maplibre-native-qt-Fix-build-with-GCC-15.patch
"
