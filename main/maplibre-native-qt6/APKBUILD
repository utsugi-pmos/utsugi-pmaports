# MapLibre for Qt6, which is the one thing Alpine's package is missing.
#
# WHY THIS RECIPE EXISTS
# ----------------------
# So the map DRAWS with no coverage. QtLocation's 'osm' connector only paints
# images fetched from the network: without one, all that is left is whatever is
# in the cache of what was already visited -- measured on this phone, 9 MB,
# against 2.2 GB of routing data. The application knew how to get to places it
# could not show you.
#
# MapLibre draws from VECTOR tiles, which do fit on disk and are already
# distributed per region in the same catalogue the routing data comes from.
#
# Alpine's package cannot be used as it is: it is built against Qt5 and this
# application is Qt6. Qt finds it and rejects it, with this exact message --
#
#   The plugin '/usr/plugins/geoservices/libqtgeoservices_maplibre.so' uses
#   incompatible Qt library. (5.15.0) [release]
#
# -- which only appears with QT_DEBUG_PLUGINS=1. Without that variable the only
# symptom is that 'maplibre' does not show up in the list of connectors, with
# the .so installed and plainly there in 'ls'.
#
# And it is not upstream's doing: 3.0.0 supports both. It is Alpine's recipe
# that pins QT_VERSION_MAJOR=5 by hand, with this comment next to the
# dependencies: "It searches for Qt6 dependencies but it actually uses Qt5".
# Here that 5 becomes a 6 and the Qt6 dependencies go in.
#
# Everything else is left as the original recipe has it, on purpose: the less
# this diverges, the less there is to redo when Alpine updates it.
maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=maplibre-native-qt6
_name=maplibre-native-qt
pkgver=3.0.0
pkgrel=4
# The name differs so it does not fight Alpine's: same code built against a
# different Qt, and having both installed at once is legitimate -- Pure Maps is
# Qt5 and still wants its own.
pkgdesc="Open-source alternative to Mapbox GL Native"
url="https://maplibre.org/"
arch="all"
license="BSD-2-Clause"
makedepends="
	cmake
	icu-dev
	qt6-qtbase-dev
	qt6-qtlocation-dev
	qt6-qtpositioning-dev
	qt6-qtdeclarative-dev
	rapidjson-dev
	samurai
	"
# No -dev subpackage: nobody compiles against this, Qt only loads it at run
# time, and a -dev nobody uses is one more download to maintain.
#
# 'sonameprefix' is what keeps this out of a fight with Alpine's package.
# Without it both DECLARE they provide 'so:libQMapLibre.so.3' and apk refuses to
# have the two:
#
#   maplibre-native-qt-3.0.0-r3:
#     conflicts: maplibre-native-qt6-3.0.0-r3[so:libQMapLibre.so.3=3.0.0]
#     satisfies: mapbox-gl-qml-3.0.0-r0[so:libQMapLibre.so.3]
#
# And that 'satisfies' is the part that matters: what depends on that library
# is Pure Maps. Installing ours over it would take away its own, built against
# Qt5, and leave it with no map. With the prefix, ours declares itself as
# 'maplibre-native-qt6:so:libQMapLibre.so.3' and answers to nobody else.
sonameprefix="$pkgname:"
source="https://dev.alpinelinux.org/archive/$_name/$_name-$pkgver.tar.xz
	0001-maplibre-native-qt-Fix-build-with-GCC-15.patch
	"
options="!check" # No tests
builddir="$srcdir/$_name"


_disturl="dev.alpinelinux.org:/archive/$_name/"

snapshot() {
	clean
	deps
	mkdir -p "$srcdir" && cd "$srcdir"
	git clone https://github.com/maplibre/maplibre-native-qt -b v$pkgver --recursive
	tar cv $_name | xz -T0 -9 -vv - > $SRCDEST/$_name-$pkgver.tar.xz
	rsync --progress -La $SRCDEST/$_name-$pkgver.tar.xz $_disturl
}

prepare() {
	default_prepare

	# We prefer to build with our system version
	rm -r vendor/maplibre-native/vendor/mapbox-base/extras/rapidjson

	# QtLocation's PRIVATE module has to be asked for separately, and with Qt5 it
	# did not. That is why this patch is not in Alpine's recipe: there it builds
	# against Qt5, where 'Location' already dragged the private part in.
	#
	# In Qt6 they are separate components, so 'find_package(... Location)' leaves
	# 'Qt6::LocationPrivate' undefined and cmake stops before building anything:
	#
	#   Target "MLNQtLocation" links to: Qt6::LocationPrivate
	#   but the target was not found.
	#
	# The component IS in Alpine -- /usr/lib/cmake/Qt6LocationPrivate exists in
	# the build chroot -- it was just that nobody asked for it.
	sed -i 's/COMPONENTS Location REQUIRED)/COMPONENTS Location LocationPrivate REQUIRED)/' \
		CMakeLists.txt
	grep -q "LocationPrivate" CMakeLists.txt || {
		echo "the private-component patch did not apply" >&2
		return 1
	}
}

build() {
	# Qt6 marks QFile::open() [[nodiscard]] and Qt5 does not. MapLibre's code
	# ignores that return in one place -- src/core/style/source_style_change.cpp
	# -- and since the project builds with -Werror, that stops the whole build:
	#
	#   error: ignoring return value of 'virtual bool QFile::open(...)',
	#   declared with attribute 'nodiscard' [-Werror=unused-result]
	#
	# It is a legitimate warning, but it is not our code and this is not the place
	# to fix it: it goes back to being a warning. That file not checking whether
	# the style opened means, at worst, that an unreadable style draws empty
	# instead of erroring -- which is what happens today under Qt5, where nobody
	# warns about it at all.
	export CXXFLAGS="$CXXFLAGS -Wno-error=unused-result"
	# IN ITS OWN CORNER, not in /usr. The files are named exactly like the Qt5
	# package's -- /usr/lib/libQMapLibre.so.3 for both -- so installing in the
	# usual place would not be coexisting: it would be overwriting Pure Maps'
	# library and leaving it with no map.
	#
	# With a prefix of its own the two trees never touch and each application
	# loads its own. The price is having to tell Qt where to look, and that is
	# done in main.cpp with addLibraryPath() and addImportPath().
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr/lib/poconav \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=TRUE \
		-DQT_VERSION_MAJOR=6 \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
		-DCMAKE_INSTALL_RPATH=/usr/lib/poconav/lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

