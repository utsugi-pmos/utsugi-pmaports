#!/bin/sh
# Build the apk repository (index + signature) and, with --push, put it on the
# gh-pages branch that GitHub Pages serves.
#
#   scripts/publish              assemble and sign the site under $WORK/site
#   scripts/publish --push       ...and force-push it to gh-pages
#
# The site is assembled from scratch every time: what is not built locally is
# downloaded from the live site,
# the freshly built packages are added, and only the HIGHEST version of each
# package survives. Pages has a 1 GB soft limit and the kernel alone is 26 MB per
# build, so keeping history here is not an option; the history lives in git and
# in the image releases.
set -eu
REPO="$(cd "$(dirname "$0")/.." && pwd)"
. "$REPO/scripts/lib.sh"

PUSH=0
FROM=""
while [ $# -gt 0 ]; do
	case "$1" in
		--push) PUSH=1; shift ;;
		--from) FROM="$2"; shift 2 ;;   # a directory of .apk files, used by CI
		*) die "unknown option: $1" ;;
	esac
done
[ -z "$FROM" ] || PKGS="$FROM"
KEY="$(keyname)"
SITE="$WORK/site"
DIR="$SITE/$CHANNEL_DIR/$ARCH"
# pmbootstrap refreshes the index for the BUILD machine's architecture as well as
# the target's, and treats a missing index as a fatal error. This repository only
# ships aarch64, so the other architecture gets an empty (but signed) index
# instead of a 404.
EMPTY_ARCHES="x86_64"

title "Collecting packages"
rm -rf "$SITE"; mkdir -p "$DIR" "$SITE/keys"
for a in $EMPTY_ARCHES; do mkdir -p "$SITE/$CHANNEL_DIR/$a"; done

# Which files belong to us: each aport's own name plus its subpackages, at the
# version the APKBUILD currently declares. Globbing '<pkg>-*' would be wrong
# (it would catch other packages) and publishing everything in the packages
# directory would be worse: pmbootstrap also builds upstream dependencies there,
# and shipping those under their upstream names would shadow real packages.
# What is not in $PKGS is pulled from the LIVE site, and that is not an
# optimisation: CI runs with --from pointing at the artifact of the packages the
# commit touched, so everything else would be missing. Indexing only what is
# there would publish an index of three packages and silently drop the other
# sixty-six -- and phones would find their kernel gone on the next apk update.
# The gh-pages commit the live site is at RIGHT NOW, before anything is read
# from it. Checked again before pushing: see below.
LIVE_AT_START="$(git ls-remote "$GH_REMOTE" refs/heads/gh-pages 2>/dev/null | cut -f1)"

n=0; carried=0; missing=""
for pkg in $(all_aports); do
	ver="$(apkbuild_version "$pkg")"
	subs="$(apkbuild_get "$pkg" subpackages | tr ' \n' '  ')"
	for name in "$pkg" $(echo "$subs" | tr ' ' '\n' | sed 's/:.*//' | grep -v '^$'); do
		f="$PKGS/$name-$ver.apk"
		if [ -f "$f" ]; then
			cp "$f" "$DIR/"; n=$((n + 1))
		elif curl -fsSL --retry 2 -o "$DIR/$name-$ver.apk" \
				"$REPO_URL/$CHANNEL_DIR/$ARCH/$name-$ver.apk"; then
			carried=$((carried + 1))
		else
			rm -f "$DIR/$name-$ver.apk"
			grey "  not built and not published: $name-$ver.apk"
			missing="$missing $name-$ver"
		fi
	done
done
green "  $n built here, $carried carried from the live site"
[ $((n + carried)) -gt 0 ] || die "nothing to publish"
# A package that exists nowhere is only a problem if this run was supposed to
# produce it. Said out loud either way: an index quietly short of a package is
# the failure mode this whole step exists to avoid.
[ -z "$missing" ] || red "  MISSING FROM THE INDEX:$missing"

title "Index and signature"
# apk and abuild come from a throwaway Alpine container: exactly the tools
# pmbootstrap uses inside its own chroot, without needing one here.
# --platform pinned, and not for portability: docker caches an image by TAG.
# Pulling alpine:edge for another architecture -- a container test of the
# phone's own aarch64, say -- replaces what "alpine:edge" means on this
# machine, and the next publish runs "exec /bin/sh: no such file or
# directory" with no hint as to why. That happened on 2026-09-13 and left the
# install page pointing at an image the latest release did not have.
docker run --rm --platform "$DOCKER_PLATFORM" \
	-v "$SITE/$CHANNEL_DIR:/c" -v "$DIR:/r" -v "$WORK/config_abuild:/k:ro" \
	-e EMPTY_ARCHES="$EMPTY_ARCHES" \
	-e KEY="$KEY" -e UID="$(id -u)" -e GID="$(id -g)" \
	-v "$REPO/keys:/pub:ro" \
	alpine:edge sh -ec '
		apk add -q abuild
		# apk index refuses to read a package it does not trust, so the public
		# half has to be in the container too. It only reads; the signing uses
		# the private key mounted at /k.
		cp /pub/*.rsa.pub /etc/apk/keys/
		cd /r
		apk index --rewrite-arch aarch64 \
			-d "utsugi-pmaports $(date -u +%Y-%m-%dT%H:%M:%SZ)" \
			-o APKINDEX.tar.gz_ ./*.apk
		abuild-sign -k "/k/$KEY" APKINDEX.tar.gz_
		mv APKINDEX.tar.gz_ APKINDEX.tar.gz
		for a in $EMPTY_ARCHES; do
			cd "/c/$a"
			apk index --rewrite-arch "$a" -d "utsugi-pmaports (no packages for this architecture)" \
				-o APKINDEX.tar.gz_
			abuild-sign -k "/k/$KEY" APKINDEX.tar.gz_
			mv APKINDEX.tar.gz_ APKINDEX.tar.gz
		done
		chown -R "$UID:$GID" /r /c
	'
# The first member of a signed index is the signature, named after the key.
#
# Read the whole listing and take the first line, rather than piping into
# 'head -1'. head exits after one line, tar keeps writing into a pipe with no
# reader, and with pipefail that is a failed publish: "tar: stdout: write
# error". It passed locally for weeks and failed in CI on 2026-09-11, because
# whether tar notices the closed pipe is a race with how fast head exits.
# The listing is a handful of members; reading it all costs nothing.
first="$(tar -tzf "$DIR/APKINDEX.tar.gz")"
first="${first%%
*}"
[ "$first" = ".SIGN.RSA.$KEY.pub" ] || die "index is not signed by $KEY (first member: $first)"
green "  signed by $KEY"

cp "$REPO"/keys/*.rsa.pub "$SITE/keys/"
touch "$SITE/.nojekyll"                      # without it GitHub runs Jekyll over the tree
git -C "$REPO" rev-parse HEAD > "$SITE/VERSION" 2>/dev/null || echo unknown > "$SITE/VERSION"
# The landing page is a template in site/, not a heredoc: it is the first thing
# anyone sees, and a page worth reading does not belong inside a shell script.
# One page per template, plus whatever else site/ holds (the stylesheet).
# @CSSV@ is the stylesheet's own hash. Without it a browser can hold an old
# style.css against new markup: on 2026-09-11 that painted the hero's terminal
# block like a note -- near-white text on a light ground -- and the install
# command a visitor came for was invisible.
CSSV="$(sha256sum "$REPO/site/style.css" | cut -c1-8)"
# @IMG@ is the real name of the image the pages tell people to flash. A "*.img"
# in the instructions is one more thing for the reader to work out, and it does
# not even work in PowerShell, which does not expand it in an argument.
# --repo given explicitly. Without it gh infers the repository from the current
# directory's git remote, which works from a shell in this checkout and did not
# work from inside scripts/image running under systemd-run on 2026-09-14: the
# release was created fine and this lookup then failed, so the site kept naming
# the previous image and its download button was a 404 for the ten minutes
# until a hand-run publish. The stderr is kept, so the next such failure says
# what gh actually objected to.
GH_REPO="$(echo "$GH_REMOTE" | sed 's|.*:||; s|\.git$||')"
IMG="$(gh release list --repo "$GH_REPO" --limit 20 --json tagName -q '.[].tagName' \
	| grep -m1 -- -surya || true)"
# If this cannot be resolved the pages must not be published: a hardcoded name
# would point "releases/latest/download/..." at a file the latest release does
# not carry, and GitHub answers that with a 404 -- a dead download button that
# looks fine in the HTML. It happened once, with the name of the release before.
[ -n "$IMG" ] || die "could not read the latest -surya release: is 'gh' logged in?"
IMG="utsugi-surya-${IMG%-surya}.img"
green "  image in the instructions: $IMG"
for page in "$REPO"/site/*.html.in; do
	name="$(basename "$page" .in)"
	sed -e "s|@KEY@|$KEY.pub|g" -e "s|@URL@|$REPO_URL|g" -e "s|@ARCH@|$ARCH|g" \
		-e "s|@CSSV@|$CSSV|g" -e "s|@IMG@|$IMG|g" "$page" > "$SITE/$name"
done
for extra in "$REPO"/site/*.css "$REPO"/site/*.html; do
	[ -e "$extra" ] && cp "$extra" "$SITE/"
done
green "  site ready: $SITE ($(du -sh "$SITE" | cut -f1))"

if [ "$PUSH" = 1 ]; then
	title "Publishing to gh-pages"
	cd "$SITE"
	git init -q -b gh-pages
	git add -A
	git -c user.email=cidwel@gmail.com -c user.name="Dr. Utsugi" \
		commit -qm "publish $(cat VERSION)"
	# One orphan commit, force-pushed: the branch is a snapshot, not a history.
	#
	# Retried, because the failure that actually happens is GitHub answering
	# "Internal Server Error" -- which it did on 2026-09-13, when CI and a local
	# publish pushed this branch within seconds of each other. Nothing was wrong
	# with what was being pushed, and a build worth forty minutes should not be
	# thrown away by a 500. Force-pushing a snapshot branch is idempotent, so a
	# retry is safe in a way retrying a normal push would not be.
	# REFUSE TO PUBLISH ON TOP OF SOMETHING NEWER THAN WHAT WE READ.
	#
	# The site is assembled by merging what was built here with what the LIVE
	# site has. If the live site changes between that read and this push, the
	# merge is stale and force-pushing it puts packages BACK to older versions
	# -- silently, with a green "pushed" and a phone that finds its kernel gone
	# on the next apk update.
	#
	# It happened on 2026-09-13: a kernel published from the laptop was replaced
	# by the previous one minutes later, when a re-run of CI assembled its site
	# from the live version it had read before that push. Nothing failed. The
	# only sign was 'apk policy' on the phone still offering r261.
	#
	# Retrying the push does not help, because the problem is not the push.
	LIVE_NOW="$(git ls-remote "$GH_REMOTE" refs/heads/gh-pages 2>/dev/null | cut -f1)"
	if [ "$LIVE_NOW" != "$LIVE_AT_START" ]; then
		die "the live site moved while this one was being assembled
  read at:  ${LIVE_AT_START:-(empty)}
  now at:   ${LIVE_NOW:-(empty)}
  Something else published in between -- CI, or another machine. Pushing this
  would put its packages back to the versions read before it. Run publish again."
	fi

	pushed=0
	for attempt in 1 2 3; do
		if git push --force "$GH_REMOTE" gh-pages; then
			pushed=1
			break
		fi
		[ "$attempt" = 3 ] && break
		grey "  push failed, retrying in $((attempt * 10))s (attempt $attempt of 3)"
		sleep $((attempt * 10))
	done
	[ "$pushed" = 1 ] || die "could not push gh-pages after three attempts"
	green "  pushed to $GH_REMOTE"
else
	grey "  not pushed (pass --push)"
fi
