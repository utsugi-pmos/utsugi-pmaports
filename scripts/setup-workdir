#!/bin/sh
# One-off preparation of the release build environment. Safe to re-run.
#
# Creates a pmbootstrap work directory SEPARATE from the user's own, a throwaway
# pmaports checkout pinned to upstream.lock, and the repository signing key.
#
# Nothing here touches ~/.local/var/pmbootstrap: the daily work dir keeps its own
# chroots, its own packages and its throwaway pmos@local signing key.
set -eu
REPO="$(cd "$(dirname "$0")/.." && pwd)"
. "$REPO/scripts/lib.sh"

UPSTREAM_CLONE="${UPSTREAM_CLONE:-$HOME/.local/var/pmbootstrap/cache_git/pmaports}"
USER_WORK="${USER_WORK:-$HOME/.local/var/pmbootstrap}"
PACKAGER="${PACKAGER:-Dr. Utsugi <cidwel@gmail.com>}"

title "Work directory: $WORK"
mkdir -p "$WORK/config_abuild" "$WORK/config_apk_keys" "$WORK/cache_git"
# pmbootstrap refuses to touch a work dir without a matching version stamp.
[ -f "$WORK/version" ] || echo 8 > "$WORK/version"

# Share the two caches that are expensive and safe to share: downloaded tarballs
# and the compiler cache. Without the ccache the kernel goes from ~7 minutes to
# the better part of an hour.
for c in cache_distfiles cache_ccache_aarch64; do
	if [ -d "$USER_WORK/$c" ] && [ ! -e "$WORK/$c" ]; then
		ln -s "$USER_WORK/$c" "$WORK/$c"
		grey "  shared $c with $USER_WORK"
	fi
done

title "pmbootstrap"
# Cloned here rather than left as an instruction, because the encrypted-install
# page documents four commands and this was a silent fifth: setup-workdir
# finished happily and build-your-own-image then stopped on "pmbootstrap not
# found". Anyone who already has one keeps it -- PMB= points wherever you like.
PMBOOTSTRAP_URL=https://gitlab.postmarketos.org/postmarketOS/pmbootstrap.git
if [ ! -f "$PMB" ]; then
	PMB_DIR="$(dirname "$PMB")"
	grey "  cloning pmbootstrap into $PMB_DIR"
	mkdir -p "$(dirname "$PMB_DIR")"
	git clone --quiet --depth 1 "$PMBOOTSTRAP_URL" "$PMB_DIR" ||
		die "could not clone pmbootstrap from $PMBOOTSTRAP_URL"
fi
grey "  $PMB"

title "pmaports checkout"
[ -f "$REPO/upstream.lock" ] || die "no upstream.lock in $REPO"
LOCK="$(tr -d ' \n' < "$REPO/upstream.lock")"
PMAPORTS_URL=https://gitlab.postmarketos.org/postmarketOS/pmaports.git
if [ ! -d "$APORTS/.git" ]; then
	if [ -d "$UPSTREAM_CLONE/.git" ]; then
		# --local hardlinks the objects and writes NOTHING into the source clone,
		# so the user's own pmbootstrap keeps working exactly as before. Worth
		# preferring: pmaports is a large history and this costs no download.
		grey "  cloning from your existing pmbootstrap checkout"
		git clone --local --no-checkout "$UPSTREAM_CLONE" "$APORTS"
	else
		# A machine that has never run pmbootstrap has no such checkout, and
		# until 2026-09-13 this stopped there with "no pmaports clone at ..." --
		# which reads like something is broken rather than like the perfectly
		# ordinary case of a fresh machine. It was reported by someone following
		# the encrypted-install page, whose four commands start with git clone.
		grey "  no local pmbootstrap checkout; cloning pmaports from upstream"
		git clone --quiet --no-checkout "$PMAPORTS_URL" "$APORTS" ||
			die "could not clone pmaports from $PMAPORTS_URL"
	fi
fi
# pmbootstrap refuses to work with a pmaports checkout whose origin is not the
# official URL, and --local leaves origin pointing at the source clone. Nothing
# is ever fetched from it: the checkout stays pinned to upstream.lock.
git -C "$APORTS" remote set-url origin "$PMAPORTS_URL"
git -C "$APORTS" checkout -q --detach "$LOCK"
grey "  $APORTS at $(git -C "$APORTS" rev-parse --short HEAD)"

title "Signing key"
# THE KEY IN keys/ IS OURS, AND ITS PRIVATE HALF IS NOT IN THIS REPOSITORY.
#
# It is committed so phones can verify what we publish. Anyone else who clones
# this and builds -- which is the whole encrypted-install route, where the image
# has to be born on your own machine -- has the public half and no way to sign
# with it. Until 2026-09-13 that ended in "the private half ... is missing",
# which reads like something went wrong rather than like the obvious truth: it
# is not your key, so make your own.
# Pick the first key we can actually SIGN with, not simply the first file in
# keys/. Once a second key lands there -- and the branch below puts one there --
# "ls | head -1" is alphabetical order deciding which identity every package is
# signed with, which is no way to decide anything.
KEY=""
for pub in "$REPO"/keys/*.rsa.pub; do
	[ -f "$pub" ] || continue
	k="$(basename "$pub" .pub)"
	if [ -f "$HOME/.abuild/$k" ]; then KEY="$k"; break; fi
done
if [ -z "$KEY" ] && ls "$REPO"/keys/*.rsa.pub >/dev/null 2>&1; then
	grey "  the key in keys/ is not yours (its private half is not here)"
fi
if [ -z "$KEY" ] || [ ! -f "$REPO/keys/$KEY.pub" ]; then
	# abuild keys are plain RSA-4096; abuild-keygen does exactly this, so there is
	# no need for a container just to make one.
	KEY="$(id -un)-pmaports-$(printf '%08x' "$(date +%s)").rsa"
	mkdir -p "$REPO/keys" "$HOME/.abuild"
	openssl genrsa -out "$HOME/.abuild/$KEY" 4096 2>/dev/null
	chmod 600 "$HOME/.abuild/$KEY"
	openssl rsa -in "$HOME/.abuild/$KEY" -pubout -out "$REPO/keys/$KEY.pub" 2>/dev/null
	green "  generated $KEY"
	red   "  PRIVATE HALF: $HOME/.abuild/$KEY -- never commit it; back it up."
	red   "  The name is frozen from the first signed package on: apk stores it"
	red   "  inside every package and looks for exactly that file in /etc/apk/keys."
else
	grey "  reusing $KEY"
fi
[ -f "$HOME/.abuild/$KEY" ] || die "the private half $HOME/.abuild/$KEY is missing"

# sudo, because the copies are owned by the chroot user (see below) and a plain
# install(1) cannot replace them on a re-run.
sudo install -m600 "$HOME/.abuild/$KEY" "$WORK/config_abuild/$KEY"
sudo install -m644 "$REPO/keys/$KEY.pub" "$WORK/config_abuild/$KEY.pub"
install -m644 "$REPO/keys/$KEY.pub" "$WORK/config_apk_keys/$KEY.pub"
# abuild signs as the chroot's "pmos" user, which is uid 12345, not ours. A key
# readable only by the host user fails at the very last step of the build, after
# everything has already compiled: "failed to sign ... Permission denied".
sudo chown 12345:12345 "$WORK/config_abuild/$KEY" "$WORK/config_abuild/$KEY.pub"
# Written before the first build on purpose: pmbootstrap only generates its own
# throwaway pmos@local key when this file does not exist.
cat > "$WORK/config_abuild/abuild.conf" <<CONF
PACKAGER_PRIVKEY="/home/pmos/.abuild/$KEY"
PACKAGER="$PACKAGER"
CONF
grey "  key installed into config_abuild and config_apk_keys"

title "pmbootstrap config"
mkdir -p "$(dirname "$PMB_CFG")"
cat > "$PMB_CFG" <<CONF
[pmbootstrap]
aports = $APORTS
work = $WORK
device = qcom-sm7150
ui = plasma-mobile
service_manager = systemd
user = user
hostname = surya
timezone = Europe/Madrid
locale = es_ES.UTF-8
ssh_keys = False
sudo_timer = True
auto_zap_misconfigured_chroots = yes
build_pkgs_on_install = False

[providers]

[mirrors]
CONF
# The custom mirror is only added once something has been published: pmbootstrap
# aborts on a 404 index, so pointing at an empty repository breaks every command.
# Asked with python3, which is already a hard requirement, rather than curl,
# which is not. With curl missing this check simply took the "nothing
# published" branch -- in silence -- and left the machine building every
# package from source instead of downloading them, with nothing to say why.
# Caught on 2026-09-13 running the documented commands in a container that
# happened not to have curl.
index_is_live() {
	python3 -c 'import sys,urllib.request
req = urllib.request.Request(sys.argv[1], method="HEAD")
try:
    with urllib.request.urlopen(req, timeout=15) as r:
        sys.exit(0 if r.status == 200 else 1)
except Exception:
    sys.exit(1)' "$1" 2>/dev/null
}
if index_is_live "$REPO_URL/$CHANNEL_DIR/$ARCH/APKINDEX.tar.gz"; then
	echo "pmaports_custom = $REPO_URL" >> "$PMB_CFG"
	grey "  pmaports_custom = $REPO_URL (index is live)"
else
	grey "  pmaports_custom NOT set: nothing published at $REPO_URL yet."
	grey "  scripts/publish adds it once the first index is up."
fi
# Two audiences reach this line. Whoever maintains the repository builds and
# publishes; whoever followed the encrypted-install page wants one image and
# never touches publish. Saying only the first left that person guessing.
green "Ready."
grey  "  to build one image for yourself:   scripts/build-your-own-image [--encrypted]"
grey  "  to build and publish packages:     scripts/build --all"
