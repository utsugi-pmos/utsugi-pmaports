#!/bin/sh
# Build your own image, on your machine, from the published repository.
#
#   scripts/build-your-own-image                 an image like the one in releases
#   scripts/build-your-own-image --encrypted     the same, with the disk encrypted
#
# WHY ENCRYPTION IS NOT A DOWNLOAD
#
# In LUKS the master key is generated by cryptsetup at format time, which for a
# phone image means: on the machine that builds it. Changing the passphrase
# afterwards replaces the slot that protects that key, NOT the key itself.
#
# So an encrypted image handed out would give whoever built it the master key of
# every phone flashed from it, and no passphrase change would take it back. An
# encrypted disk has to be created by the person who owns it. That is this
# script: the recipe travels, the key does not.
#
# What you need: a Linux machine with python3, git and about 15 GB free. The rest
# is fetched here.
set -eu
ENCRYPTED=0
[ "${1:-}" = "--encrypted" ] && ENCRYPTED=1

REPO="$(cd "$(dirname "$0")/.." && pwd)"
. "$REPO/scripts/lib.sh"

title "Checking what is here"
for prog in python3 git rsync; do
	command -v "$prog" >/dev/null || die "$prog is missing"
done
[ -f "$PMB" ] || die "pmbootstrap not found at $PMB.
Get it with:
    git clone --depth 1 https://gitlab.postmarketos.org/postmarketOS/pmbootstrap.git ~/src/pmbootstrap
or point PMB= at your copy."
[ -d "$APORTS" ] || die "no build environment yet. Run scripts/setup-workdir first."

if [ "$ENCRYPTED" = 1 ]; then
	cat <<'WARN'

  The disk will be encrypted, and pmbootstrap will ask YOU for the passphrase
  during the install. It is not stored anywhere and nobody else can recover it:
  forget it and the phone is a brick with your data inside.

  You will type it on every boot, on the on-screen keyboard, BEFORE the PIN.

  On this phone it is also NOT a well-trodden path. The system lives inside a
  disk image written to the userdata partition, with U-Boot on boot, so the
  initramfs has to open a LUKS that sits inside a loop file and paint the
  keyboard on this panel. If it does not come up, the way back is to flash the
  normal image, which wipes.

WARN
	printf 'Continue? [y/N] '
	read -r answer
	case "$answer" in y|Y|yes|s|S|si) ;; *) die "cancelled" ;; esac
	exec "$REPO/scripts/image" --device surya --fde
fi
exec "$REPO/scripts/image" --device surya
