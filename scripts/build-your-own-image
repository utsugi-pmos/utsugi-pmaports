#!/bin/sh
# Build your own image, on your machine, from the published repository.
#
#   scripts/build-your-own-image                 an image like the one in releases
#   scripts/build-your-own-image --encrypted     the same, with the disk encrypted
#
# WHY ENCRYPTION IS NOT A DOWNLOAD
#
# In LUKS the master key is generated by cryptsetup at format time, which for a
# phone image means: on the machine that builds it. Changing the passphrase
# afterwards replaces the slot that protects that key, NOT the key itself.
#
# So an encrypted image handed out would give whoever built it the master key of
# every phone flashed from it, and no passphrase change would take it back. An
# encrypted disk has to be created by the person who owns it. That is this
# script: the recipe travels, the key does not.
#
# What you need: a Linux machine with python3, git and about 15 GB free. The rest
# is fetched here.
set -eu
ENCRYPTED=0
[ "${1:-}" = "--encrypted" ] && ENCRYPTED=1

REPO="$(cd "$(dirname "$0")/.." && pwd)"
. "$REPO/scripts/lib.sh"

title "Checking what is here"

# THIS ONLY RUNS ON LINUX.
#
# pmbootstrap builds inside chroots, on loop devices, with binfmt: none of that
# exists on macOS or Windows, and pmbootstrap's own README says WSL does not
# work either. A virtual machine with a Linux in it does.
[ "$(uname -s)" = Linux ] || die "this needs Linux.
pmbootstrap builds in chroots on loop devices, which macOS and Windows do not
have, and WSL is explicitly not supported. Run a Linux virtual machine.
Flashing a ready-made image works fine from any of the three."

# The whole list, checked here rather than twenty minutes into a build. These
# are pmbootstrap's requirements, not ours -- taken from its README -- plus
# rsync, which the overlay uses.
missing=""
for prog in python3 git rsync openssl tar ps losetup kpartx; do
	command -v "$prog" >/dev/null 2>&1 || missing="$missing $prog"
done
if [ -n "$missing" ]; then
	red "missing:$missing"
	grey "  Debian/Ubuntu:  sudo apt install python3 git rsync openssl multipath-tools util-linux procps tar"
	grey "  Fedora:         sudo dnf install python3 git rsync openssl device-mapper-multipath util-linux procps-ng tar"
	grey "  Arch:           sudo pacman -S python git rsync openssl multipath-tools util-linux procps-ng tar"
	die "install those and run this again"
fi

# git 2.46 or newer: pmbootstrap uses features older ones do not have, and the
# failure without it lands deep inside a clone rather than here.
gitver="$(git --version | awk '{print $3}')"
[ "$(printf '%s\n2.46\n' "$gitver" | sort -V | head -1)" = 2.46 ] ||
	die "git $gitver is too old; pmbootstrap needs 2.46 or newer"

# /tmp has to be executable. Hardened systems mount it noexec and pmbootstrap
# breaks in ways that do not name the cause.
printf '#!/bin/sh\nexit 0\n' > /tmp/.utsugi-exec-test.$$ 2>/dev/null || true
chmod +x /tmp/.utsugi-exec-test.$$ 2>/dev/null || true
if [ -f /tmp/.utsugi-exec-test.$$ ] && ! /tmp/.utsugi-exec-test.$$ 2>/dev/null; then
	rm -f /tmp/.utsugi-exec-test.$$
	die "/tmp is mounted noexec, which pmbootstrap cannot work with.
Either remount it exec, or run this with TMPDIR pointing somewhere executable:
    TMPDIR=\$HOME/.tmp $0 $*"
fi
rm -f /tmp/.utsugi-exec-test.$$
[ -f "$PMB" ] || die "pmbootstrap not found at $PMB.
Get it with:
    git clone --depth 1 https://gitlab.postmarketos.org/postmarketOS/pmbootstrap.git ~/src/pmbootstrap
or point PMB= at your copy."
[ -d "$APORTS" ] || die "no build environment yet. Run scripts/setup-workdir first."

if [ "$ENCRYPTED" = 1 ]; then
	cat <<'WARN'

  The disk will be encrypted, and pmbootstrap will ask YOU for the passphrase
  during the install. It is not stored anywhere and nobody else can recover it:
  forget it and the phone is a brick with your data inside.

  You will type it on every boot, on the on-screen keyboard, BEFORE the PIN.

  On this phone it is also NOT a well-trodden path. The system lives inside a
  disk image written to the userdata partition, with U-Boot on boot, so the
  initramfs has to open a LUKS that sits inside a loop file and paint the
  keyboard on this panel. If it does not come up, the way back is to flash the
  normal image, which wipes.

WARN
	printf 'Continue? [y/N] '
	read -r answer
	case "$answer" in y|Y|yes|s|S|si) ;; *) die "cancelled" ;; esac
	exec "$REPO/scripts/image" --device surya --fde
fi
exec "$REPO/scripts/image" --device surya
