#!/bin/sh
# sudo -A calls this so it can ask for the password without a terminal.
# pmbootstrap starts processes with no tty and plain sudo then dies with
# "a terminal is required to authenticate".
#
# The password lives in .local/credentials (gitignored), never in this file.
[ -n "${PMB_PW:-}" ] || {
	D="$(cd "$(dirname "$0")/.." && pwd)"
	# UTSUGI_CREDENTIALS points at your own file; the default lives beside this
	# repository and is gitignored. A path into one particular person's home
	# directory used to be hardcoded here, which is no business of a public
	# repository.
	for f in "${UTSUGI_CREDENTIALS:-}" "$D/.local/credentials"; do
		[ -n "$f" ] || continue
		[ -f "$f" ] && . "$f" && break
	done
}
[ -n "${PMB_PW:-}" ] || { echo "PMB_PW not found in .local/credentials" >&2; exit 1; }
printf '%s\n' "$PMB_PW"
