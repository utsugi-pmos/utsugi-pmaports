maintainer="Dr. Utsugi <cidwel@gmail.com>"
# Boot settings for the POCO X3 Pro, plus the tool that fetches the modem
# firmware off the phone's own stock partition.
pkgname=utsugi-vayu-boot
pkgver=1
pkgrel=0
pkgdesc="Kernel command line and IPA firmware extractor for the Xiaomi POCO X3 Pro"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
source="60-utsugi-vayu.conf
	vayu-ipa-firmware-extract
	"

package() {
	install -Dm644 "$srcdir"/60-utsugi-vayu.conf -t "$pkgdir"/usr/lib/kernel-cmdline.d/
	install -Dm755 "$srcdir"/vayu-ipa-firmware-extract -t "$pkgdir"/usr/bin/
}
