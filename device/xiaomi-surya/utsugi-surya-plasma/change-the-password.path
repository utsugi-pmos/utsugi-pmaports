[Unit]
Description=Re-decide the shipped-password question when /etc/shadow changes
# Without this the flag in /run is a once-per-boot snapshot: change the
# password and it stays behind until the next reboot, so a session restarted in
# the same boot asks again for something already done. Measured on the phone on
# 2026-09-12, right after the first real password change.
#
# systemd watches the parent directory as well as the file, which is what makes
# this work at all: passwd does not write /etc/shadow in place, it writes
# /etc/nshadow and renames it over the top.
ConditionPathExists=/etc/shadow

[Path]
PathChanged=/etc/shadow
Unit=change-the-password.service

[Install]
WantedBy=multi-user.target
