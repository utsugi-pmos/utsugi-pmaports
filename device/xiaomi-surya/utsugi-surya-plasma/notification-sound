#!/usr/bin/env python3
"""Makes notifications sound. Plasma Mobile does not sound them.

WHY IT IS NEEDED
----------------
Plasma Mobile does NOT play sound for notifications that arrive over D-Bus.
Measured: with the notification server healthy -- GetServerInformation
answering -- a test notification gives ZERO playbacks in
'pactl subscribe'.

And the clean path does not work either. Assigning the sound to Plasma's generic
event ([Event/notification] in plasma_workspace.notifyrc, with Action=Popup|Sound)
does not sound: that event is used by KNotification when plasma-workspace itself
raises a notification, not for those arriving from other applications. Not even with
explicit 'sound-name' or 'sound-file' hints.

WHY IN PYTHON AND NOT IN SHELL
------------------------------
The first version listened with 'busctl --user monitor' and a shell loop.
IT DOES NOT WORK: writing to a pipe, busctl buffers the output and the lines
do not arrive until the buffer fills. The watcher looked like it was running and
never sounded. We tried giving it a pseudoterminal with 'script' -- there is no
'stdbuf' here -- and that failed too: the message appears in the monitor's file but
the loop does not see it in time.

Speaking D-Bus directly there is no pipe in between and the problem
disappears. BecomeMonitor is what allows seeing other processes' calls; it is the same
thing 'busctl monitor' does inside.

ADVANTAGE OF LISTENING TO THE CALL AND NOT THE RESPONSE
-------------------------------------------------------
The message travels over the bus even if the notification server is hung
-- which on this phone happens every few minutes, see task 002. So this sounds
the same when Plasma stops answering, which is exactly when it is most needed.
"""
import os
import subprocess
import sys
import time

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

# NOTICE_SOUND since 2026-09-11; SONIDO_AVISO is the name the unit and whoever
# set it in their own drop-in still use, so both are read.
SOUND = os.environ.get("NOTICE_SOUND") or os.environ.get(
    "SONIDO_AVISO", "/usr/share/sounds/freedesktop/stereo/message-new-instant.oga"
)
# Seconds between sounds: a burst of messages must not be a machine gun.
WAIT = 2.0

# The size, not the existence: the system's 50 'Oxygen-*.ogg' weigh 36 bytes
# and are empty markers. Choosing them would be choosing silence, and with no error.
if not os.path.isfile(SOUND):
    sys.exit(f"{SOUND} does not exist")
if os.path.getsize(SOUND) < 1024:
    sys.exit(f"{SOUND} is empty (marker of {os.path.getsize(SOUND)} bytes)")

last = 0.0


def al_notificar(bus, message):
    global last
    if message.get_member() != "Notify":
        return
    if message.get_interface() != "org.freedesktop.Notifications":
        return

    now = time.monotonic()
    if now - last < WAIT:
        return
    last = now

    # Without waiting: a notification must not wait for the sound to finish.
    subprocess.Popen(
        ["paplay", SOUND],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SessionBus()

# Seeing calls bound for ANOTHER destination requires asking for it explicitly.
regla = (
    "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"
)
bus.call_blocking(
    "org.freedesktop.DBus",
    "/org/freedesktop/DBus",
    "org.freedesktop.DBus.Monitoring",
    "BecomeMonitor",
    "asu",
    ([regla], dbus.UInt32(0)),
)
bus.add_message_filter(al_notificar)

print(f"listening for notifications; they will sound with {os.path.basename(SOUND)}", flush=True)
GLib.MainLoop().run()
