#!/bin/sh
# Decides whether to run the full-screen first-boot step that asks the user to
# set their own password, and leaves a flag in /run saying so. That flag is
# what first-password.service is conditioned on.
#
# WHY THIS EXISTS
# ---------------
# A prebuilt image has to carry a password, and ours is printed on the install
# page: user 'user', password '1111'. That is fine for flashing it and wrong
# for keeping it -- and on a phone "just run passwd" means finding a terminal,
# which is not something a person does unprompted.
#
# postmarketOS itself mostly dodges this by not shipping prebuilt images:
# pmbootstrap asks for the password while installing. An image cannot ask, so
# the next best thing is to not let it be forgotten.
#
# HOW IT KNOWS: A BOOLEAN FLAG, NOT A COMPARISON
# ----------------------------------------------
# "Has the user set their own password?" is a yes/no fact, and it is recorded
# as exactly that. When the first-boot step finishes, it drops a persistent
# marker; from then on this never asks again -- WHATEVER password was chosen,
# including one that happens to equal the factory value.
#
# The previous design compared the live password to the shipped one (take the
# salt from the account's hash, re-hash the shipped value, match). It worked,
# but it could never let a person KEEP a password equal to the factory value:
# they were indistinguishable from a fresh image and got nagged for ever, and
# could not turn the nag off. A flag has no such blind spot -- it is set by the
# person going through the step, not inferred from what they typed. So you can
# set 1111, or anything, and keep it.
#
# The marker lives in the user's home so the unprivileged first-boot step can
# write it. This still runs as a system unit because it writes /run, which the
# session cannot, and it reads the marker as root.
set -u

# The phone's account by number, not by name: the first-boot setup lets the
# owner rename it, and the session finds it the same way (User=10000).
HOMEDIR=$(getent passwd "${1:-10000}" | cut -d: -f6)
RUN=/run/utsugi-surya/password-is-default
FLAG="${HOMEDIR:-/home/user}/.local/state/utsugi-surya/password-configured"

if [ -e "$FLAG" ]; then
	# The user has been through the step. Never ask again, whatever they chose.
	rm -f "$RUN"
	exit 0
fi

# No marker: a fresh image nobody has set up yet. Ask. /run is tmpfs, so this
# is re-decided every boot with no stale state; once the step writes the
# marker, the next boot (and change-the-password.path, the same boot) takes the
# branch above and the question is gone.
mkdir -p /run/utsugi-surya
: > "$RUN"
