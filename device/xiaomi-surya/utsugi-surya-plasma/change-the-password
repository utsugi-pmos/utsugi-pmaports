#!/bin/sh
# Says, once per boot and only while it is true, that the phone is still using
# the password the image shipped with.
#
# WHY THIS EXISTS
# ---------------
# A prebuilt image has to carry a password, and ours is printed on the install
# page: user 'user', password '147147'. That is fine for flashing it and wrong
# for keeping it -- and on a phone "just run passwd" means finding a terminal,
# which is not something a person does unprompted.
#
# postmarketOS itself mostly dodges this by not shipping prebuilt images:
# pmbootstrap asks for the password while installing. An image cannot ask, so
# the next best thing is to not let it be forgotten.
#
# HOW IT KNOWS
# ------------
# It does not store the shipped password. It takes the salt out of this
# account's own hash in /etc/shadow, hashes the shipped one with THAT salt, and
# compares. Change the password and the salt changes with it, so this stops
# matching and stops talking -- with no state file to go stale, and nothing on
# disk that says what the password is.
#
# Needs to read /etc/shadow, so it runs as a system unit and talks to the
# session over the user's bus.
set -u

SHIPPED='147147'
WHO="${1:-user}"

hash=$(awk -F: -v u="$WHO" '$1 == u { print $2 }' /etc/shadow 2>/dev/null)
case "$hash" in
	'$'*'$'*'$'*) ;;                      # a real crypt hash: carry on
	*) exit 0 ;;                          # locked, empty or absent: nothing to say
esac

# $id$salt$digest -- everything up to the last '$' is the setting.
setting=${hash%$'\n'}
setting=${setting%\$*}

command -v mkpasswd >/dev/null 2>&1 || exit 0
mine=$(mkpasswd --method=descrypt --salt="$setting" "$SHIPPED" 2>/dev/null) || \
mine=$(printf '%s' "$SHIPPED" | mkpasswd --stdin --salt "$setting" 2>/dev/null) || exit 0

[ "$mine" = "$hash" ] || exit 0           # already changed: say nothing, ever again

uid=$(id -u "$WHO" 2>/dev/null) || exit 0
su "$WHO" -c "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus \
	notify-send -u critical -i security-medium \
	'This phone still has the password it was shipped with' \
	'Anybody who read the install page knows it. Open Settings > Users, or a terminal and run: passwd'" \
	>/dev/null 2>&1
