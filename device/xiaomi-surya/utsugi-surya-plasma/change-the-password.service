[Unit]
Description=Decide whether the phone still has the password the image shipped with
# Before the session, because the flag it writes is what the session's
# first-password.service is conditioned on.
Before=graphical.target
DefaultDependencies=no
After=local-fs.target
ConditionPathExists=/etc/shadow

[Service]
Type=oneshot
ExecStart=/usr/libexec/utsugi-surya/change-the-password
# It writes one empty file in /run and reads a marker in the user's home
# (read-only under ProtectSystem=strict, which is all it needs). Nothing else.
ProtectSystem=strict
ReadWritePaths=/run
PrivateTmp=yes

[Install]
WantedBy=graphical.target
