[Unit]
Description=Say if the phone still has the password the image shipped with
# The session has to exist for a notification to land anywhere.
After=graphical.target
ConditionPathExists=/etc/shadow

[Service]
Type=oneshot
ExecStart=/usr/libexec/utsugi-surya/change-the-password
# It reads /etc/shadow and nothing else, and it writes nothing at all.
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=graphical.target
