maintainer="Dr. Utsugi <cidwel@gmail.com>"
# The Plasma Mobile side of the POCO X3 NFC: the quick settings the shell does
# not ship, the defaults it ships wrong, and the small services that make the
# session usable.
#
# Everything here used to be written into $HOME by an installer, which meant it
# was invisible to apk, survived nothing and had to be reapplied by hand. Now:
#
#   quick settings   /usr/share/plasma/quicksettings   (the shell enables a new
#                    one on its own, so no config edit is needed)
#   user services    /usr/lib/systemd/user + a preset  (postmarketOS runs
#                    "systemctl preset --global" from an apk trigger)
#   KConfig defaults /etc/xdg                          (the layer under $HOME,
#                    so anything the user changes still wins)
#   bar margins      a Plasma Mobile device preset, which is the mechanism made
#                    for it, instead of writing plasmamobilerc by hand
#
# NOT here: the mobiletaskswitcher patch that keeps applications alive. It
# belongs with the keepalive application that manages its list.
pkgname=utsugi-surya-plasma
pkgver=1
pkgrel=5
pkgdesc="Plasma Mobile quick settings, defaults and session services for the Xiaomi POCO X3 NFC"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
# plasma-camera-utsugi by name, and not because the fork happens to win on
# version: it provides "plasma-camera" like Alpine's does, so which one apk
# installs was decided by arithmetic. Named here, the zoom bar and tap-to-focus
# are guaranteed to be the camera that ends up on the phone.
depends="kconfig plasma-dialer-utsugi plasma-camera-utsugi"
# /etc/xdg/plasmanotifyrc belongs to plasma-workspace. Two packages shipping the
# same file is an error unless one is allowed to win, and ours has to: it is the
# whole point of shipping a default. The priority is well above Alpine's so a
# rebuild of theirs does not start winning by accident.
replaces="plasma-workspace"
replaces_priority=100
subpackages="$pkgname-systemd"
source="location-switch
	power-saving-switch
	usb-power-switch
	power-saving-agent
	notification-sound
	dialer-warmup
	location-metadata.json
	location-main.qml
	power-saving-metadata.json
	power-saving-main.qml
	usb-power-metadata.json
	usb-power-main.qml
	geoclue-agent.service
	power-saving-agent.service
	notification-sound.service
	dialer-warmup.service
	10-utsugi-scale.conf
	powerdevilrc
	plasmanotifyrc
	surya-device-preset.conf
	80-utsugi-surya-plasma.preset
	"

package() {
	local sw
	for sw in location-switch power-saving-switch usb-power-switch; do
		install -Dm755 "$srcdir/$sw" -t "$pkgdir"/usr/bin/
	done
	local helper
	for helper in power-saving-agent notification-sound dialer-warmup; do
		install -Dm755 "$srcdir/$helper" -t "$pkgdir"/usr/libexec/utsugi-surya/
	done

	# The quick settings. @SWITCH@ is substituted here because Plasma's executable
	# data engine expands no variables and plasmashell's PATH is not ours.
	local qs id
	for qs in location power-saving usb-power; do
		case "$qs" in
			location) id=org.kde.plasma.quicksetting.location; sw=location-switch ;;
			power-saving) id=org.kde.plasma.quicksetting.powersaving; sw=power-saving-switch ;;
			usb-power) id=org.kde.plasma.quicksetting.usbpower; sw=usb-power-switch ;;
		esac
		install -Dm644 "$srcdir/$qs-metadata.json" \
			"$pkgdir"/usr/share/plasma/quicksettings/$id/metadata.json
		sed "s|@SWITCH@|/usr/bin/$sw|g" "$srcdir/$qs-main.qml" > "$srcdir/$qs-main.qml.fixed"
		install -Dm644 "$srcdir/$qs-main.qml.fixed" \
			"$pkgdir"/usr/share/plasma/quicksettings/$id/contents/ui/main.qml
	done

	# KConfig cascades, so these are defaults: anything the user changes lands in
	# $HOME and still wins.
	install -Dm644 "$srcdir"/powerdevilrc "$srcdir"/plasmanotifyrc -t "$pkgdir"/etc/xdg/

	# The file name IS the match: the shell looks up the first string in
	# /sys/firmware/devicetree/base/compatible. abuild forbids a comma in a
	# source file name, so it is carried under a plain name and renamed here.
	install -Dm644 "$srcdir"/surya-device-preset.conf \
		"$pkgdir"/usr/share/plasma-mobile-device-presets/xiaomi,surya.conf

	local unit
	for unit in geoclue-agent power-saving-agent notification-sound dialer-warmup; do
		install -Dm644 "$srcdir/$unit.service" -t "$pkgdir"/usr/lib/systemd/user/
	done
	install -Dm644 "$srcdir"/10-utsugi-scale.conf \
		-t "$pkgdir"/usr/lib/systemd/user/plasma-xdg-desktop-portal-kde.service.d/
	install -Dm644 "$srcdir"/80-utsugi-surya-plasma.preset \
		-t "$pkgdir"/usr/lib/systemd/user-preset/
}

systemd() {
	default_systemd
}
