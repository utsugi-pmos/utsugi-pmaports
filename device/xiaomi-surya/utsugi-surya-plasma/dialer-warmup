#!/bin/sh
# Puts into the page cache what the dialer needs, so the first call of the day
# does not wait on flash memory. It only reads; it pins nothing.
set -u
leer() { [ -r "$1" ] || return 0; dd if="$1" of=/dev/null bs=1M 2>/dev/null; }

leer /usr/bin/plasma-dialer
ldd /usr/bin/plasma-dialer 2>/dev/null | awk '{print $3}' | grep '^/' | sort -u | while read -r l; do
	leer "$l"
done
# Kirigami's QML is read from disk as text on every boot (it shows in the dialer's
# log: file:///usr/lib/qt6/qml/org/kde/kirigami/...).
find /usr/lib/qt6/qml/org/kde/kirigami -name '*.qml' 2>/dev/null | while read -r q; do
	leer "$q"
done
