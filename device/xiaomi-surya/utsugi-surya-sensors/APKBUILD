maintainer="Dr. Utsugi <cidwel@gmail.com>"
# The four sensors of the POCO X3 NFC: accelerometer with rotation, light,
# compass and proximity. All four hang off the ADSP through hexagonrpcd.
#
# The dangerous coupling to remember: the ADSP is SHARED with audio. If the
# sensor domain dies it takes the ADSP down, and with the ADSP goes the sound
# card. That is why touching the accelerometer can leave the phone mute without
# anyone touching audio.
pkgname=utsugi-surya-sensors
pkgver=1
pkgrel=1
pkgdesc="Accelerometer, light, compass and proximity for the Xiaomi POCO X3 NFC"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
# The forks, by name: they carry the patches that make the registry work at all.
depends="hexagonrpcd-utsugi iio-sensor-proxy-utsugi firmware-xiaomi-surya"
subpackages="$pkgname-systemd"
source="sensors-seed
	hexagonrpcd-is-patched
	iio-sensor-proxy-is-patched
	utsugi-surya-sensors-seed.service
	sensors-on-resume.service
	10-utsugi-surya.conf
	10-utsugi-surya-iio.conf
	10-utsugi-iio-sensor-proxy.rules
	80-utsugi-surya-sensors.preset
	"

package() {
	local helper
	for helper in sensors-seed hexagonrpcd-is-patched iio-sensor-proxy-is-patched; do
		install -Dm755 "$srcdir/$helper" -t "$pkgdir"/usr/libexec/utsugi-surya/
	done

	# /usr/share, not /etc: /etc/polkit-1/rules.d is where the administrator puts
	# their own rules, packages use /usr/share.
	install -Dm644 "$srcdir"/10-utsugi-iio-sensor-proxy.rules \
		-t "$pkgdir"/usr/share/polkit-1/rules.d/

	install -Dm644 "$srcdir"/utsugi-surya-sensors-seed.service \
		"$srcdir"/sensors-on-resume.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/10-utsugi-surya.conf \
		-t "$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/
	install -Dm644 "$srcdir"/10-utsugi-surya-iio.conf \
		"$pkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-utsugi-surya.conf
	install -Dm644 "$srcdir"/80-utsugi-surya-sensors.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}

systemd() {
	default_systemd
}
