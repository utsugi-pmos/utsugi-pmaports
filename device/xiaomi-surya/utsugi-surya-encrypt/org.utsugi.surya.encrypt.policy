<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>utsugi-pmaports</vendor>
  <action id="org.utsugi.surya.encrypt">
    <description>Encrypt this phone's storage at the next boot</description>
    <message>Authentication is required to encrypt this phone</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/utsugi-surya/request-encryption</annotate>
  </action>
</policyconfig>
