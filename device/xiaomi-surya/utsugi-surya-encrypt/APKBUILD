# Maintainer: Dr. Utsugi <cidwel@gmail.com>
#
# Encrypt the phone on the phone: a first-boot step asks, and the initramfs
# does it in place at the next boot. The image people download stays an
# ordinary unencrypted one, and the LUKS master key is born on the device that
# will use it -- which is the only place it should ever exist.
#
# Three pieces, split by what needs privilege:
#
#   50-utsugi-encrypt.sh     the initramfs hook. Runs before the root is
#                            mounted, which is the only time it can be
#                            encrypted. cryptsetup reencrypt, in place,
#                            resumable if interrupted.
#   request-encryption       root, through pkexec: writes the passphrase where
#                            the hook reads it and reboots. One file, one
#                            reboot, deleted from inside the encrypted volume.
#   is-the-disk-encrypted    root, once per boot: leaves a flag in /run that
#                            the assistant (utsugi-surya-first-password) is
#                            conditioned on.
#
# unl0kr is a hard dependency and not a suggestion: it is what puts cryptsetup,
# unl0kr and fde-unlock INTO the initramfs (its 30-unl0kr.files list), and
# without them the hook has nothing to encrypt with and the next boot has
# nothing to draw the keyboard with. The unencrypted image used to install
# postmarketos-base-nofde instead, a dummy that keeps unl0kr out; scripts/image
# turns that off, and the two conflict, so a phone flashed before this needs
# 'apk del postmarketos-base-nofde' once (surya-setup --upgrade does it).
pkgname=utsugi-surya-encrypt
pkgver=1
pkgrel=3
pkgdesc="Encrypt the phone's storage from the first-boot assistant"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
depends="unl0kr cryptsetup e2fsprogs-extra polkit util-linux-misc"
options="!check"
subpackages="$pkgname-systemd"
source="50-utsugi-encrypt.sh
	request-encryption
	is-the-disk-encrypted
	org.utsugi.surya.encrypt.policy
	50-utsugi-surya-encrypt.rules
	is-the-disk-encrypted.service
	80-utsugi-surya-encrypt.preset
	"

package() {
	# The hook. /usr/share/mkinitfs/* is a trigger directory: installing this
	# regenerates the initramfs, so the hook is in place at the next boot.
	install -Dm755 "$srcdir"/50-utsugi-encrypt.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks-extra/
	install -Dm755 "$srcdir"/request-encryption "$srcdir"/is-the-disk-encrypted \
		-t "$pkgdir"/usr/libexec/utsugi-surya/
	install -Dm644 "$srcdir"/org.utsugi.surya.encrypt.policy \
		-t "$pkgdir"/usr/share/polkit-1/actions/
	# /usr/share, not /etc: /etc/polkit-1/rules.d is the administrator's.
	install -Dm644 "$srcdir"/50-utsugi-surya-encrypt.rules \
		-t "$pkgdir"/usr/share/polkit-1/rules.d/
}

systemd() {
	pkgdesc="$pkgdesc (system unit)"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/is-the-disk-encrypted.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/80-utsugi-surya-encrypt.preset \
		-t "$subpkgdir"/usr/lib/systemd/system-preset/
}
