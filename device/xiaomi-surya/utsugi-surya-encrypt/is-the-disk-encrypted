#!/bin/sh
# Decide, once per boot, whether the root is encrypted -- and leave flags in
# /run saying so. The decision needs root (blkid on the root device) and the
# drawing does not, so they are split the same way the shipped-password check is.
#
#   disk-is-not-encrypted   the truth; the Settings module reads it
#   offer-encryption        the truth, unless the first-boot step was already
#                           answered; the first-boot step reads it
#
# They were one flag until 2026-09-16, and "Not now" in the first-boot step
# then hid encryption from Settings too, which said "This phone is encrypted"
# on a phone that was not -- the one case that module exists for.
set -u
DIR=/var/lib/utsugi-surya
FLAG=/run/utsugi-surya/disk-is-not-encrypted
OFFER=/run/utsugi-surya/offer-encryption
rm -f "$FLAG" "$OFFER"

# Already requested: it happens on the next boot, nothing to show.
[ -e "$DIR/encrypt-request" ] && exit 0

src="$(findmnt -no SOURCE / 2>/dev/null)"
case "$src" in
	/dev/mapper/*) exit 0 ;;           # opened by the initramfs: encrypted
esac
[ -n "$src" ] || exit 0
type="$(blkid -o value -s TYPE "$src" 2>/dev/null)"
[ "$type" = "crypto_LUKS" ] && exit 0

# Only a filesystem the hook knows how to encrypt.
[ "$type" = "ext4" ] || exit 0

mkdir -p /run/utsugi-surya
: > "$FLAG"
[ -e "$DIR/encryption-declined" ] || : > "$OFFER"
