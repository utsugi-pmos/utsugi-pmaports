# Audio on the POCO X3 NFC, packaged so that it survives a reboot without anyone
# running an installer.
#
# What it solves, in order:
#   1. the ADSP does not publish its APR services at boot, so the sound card is
#      never created; restarting the ADSP once fixes it
#   2. the UCM has to be applied BEFORE PulseAudio probes the card, or PulseAudio
#      finds no profile and hammers the DSP retrying
#   3. both chips boot around -36 dB and the phone seems mute; the saved ALSA
#      state is what alsa-restore writes on the next boot, so it is written once
#      here and stored
#
# The volume is written ONLY by salida-audio, and only over ALSA. alsa-restore
# writes over ALSA on every boot, so a second writer (direct I2C, or the UCM)
# ends up fighting it and the result depends on who runs last.
maintainer="Dr. Utsugi <cidwel@gmail.com>"
pkgname=utsugi-surya-audio
pkgver=1
pkgrel=0
pkgdesc="Audio for the Xiaomi POCO X3 NFC: both speakers, saved volume, UCM ordering"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
depends="alsa-utils"
subpackages="$pkgname-systemd"
source="adsp-audio-init
	audio-volumen
	salida-audio
	ucm-antes-de-pulseaudio
	adsp-audio-init.service
	audio-volumen.service
	ucm-antes-de-pulseaudio.service
	q6voiced.conf
	80-utsugi-surya-audio.preset
	"

package() {
	# User-facing command: 'salida-audio estado' is meant to be typed.
	install -Dm755 "$srcdir"/salida-audio -t "$pkgdir"/usr/bin/

	# Unit-only helpers. They used to live in /usr/local/bin, which no package
	# may own.
	local helper
	for helper in adsp-audio-init audio-volumen ucm-antes-de-pulseaudio; do
		install -Dm755 "$srcdir/$helper" -t "$pkgdir"/usr/libexec/utsugi-surya/
	done

	# q6voiced.service (from soc-qcom) refuses to start without this file:
	# ConditionPathExists=/usr/share/q6voiced/q6voiced.conf. No package ships it
	# for this device.
	install -Dm644 "$srcdir"/q6voiced.conf -t "$pkgdir"/usr/share/q6voiced/

	local unit
	for unit in adsp-audio-init audio-volumen ucm-antes-de-pulseaudio; do
		install -Dm644 "$srcdir/$unit.service" -t "$pkgdir"/usr/lib/systemd/system/
	done
	install -Dm644 "$srcdir"/80-utsugi-surya-audio.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}

systemd() {
	# Takes the units AND the preset: default_systemd moves all of
	# usr/lib/systemd, which is where both live.
	default_systemd
}
