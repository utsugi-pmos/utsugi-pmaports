[Unit]
Description=Restart the ADSP once so the sound card gets created
Before=display-manager.service sddm.service greetd.service
DefaultDependencies=no
After=sysinit.target local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/utsugi-surya/adsp-audio-init
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
