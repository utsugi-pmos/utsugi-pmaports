[Unit]
Description=Charging screen: the phone plugged in, with no graphical session
Documentation=file:///usr/libexec/utsugi-surya/modo-carga
ConditionPathExists=/run/modo-carga
After=modo-carga-decidir.service

[Service]
Type=simple
ExecStart=/usr/libexec/utsugi-surya/modo-carga
# If the loop crashes, the phone stays plugged in with nothing attending the
# button or the unplug. Bring it back.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
