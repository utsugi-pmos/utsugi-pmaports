maintainer="Dr. Utsugi <cidwel@gmail.com>"
# Power on the POCO X3 NFC: powering off, the watchdog, charge mode and the
# power-saving profile.
#
# Powering off hangs on this phone at a different point every time, with no oops
# and no panic. apagar-de-verdad hands the power-off to the kernel BEFORE the
# teardown that freezes, and it is ordered so that it is the first unit stopped
# on the way down.
#
# The watchdog is what removes the need for a person: if the system stops
# responding the hardware resets on its own. 20 s because the hardware maximum
# is 30 and systemd arms NOTHING if the value is out of range.
pkgname=utsugi-surya-power
pkgver=1
pkgrel=0
pkgdesc="Power-off, watchdog, charge mode and power saving for the Xiaomi POCO X3 NFC"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
depends="python3"
subpackages="$pkgname-systemd"
source="apagar-de-verdad
	modo-carga
	modo-carga-decidir
	pantalla-de-carga
	apagar-de-verdad.service
	modo-carga.service
	modo-carga-decidir.service
	10-utsugi-charge-mode.conf
	50-utsugi-surya-watchdog.conf
	tuned.conf
	80-utsugi-surya-power.preset
	"

package() {
	local helper
	for helper in apagar-de-verdad modo-carga modo-carga-decidir pantalla-de-carga; do
		install -Dm755 "$srcdir/$helper" -t "$pkgdir"/usr/libexec/utsugi-surya/
	done

	# Installed as the stock "powersave" profile rather than a name of our own, so
	# tuned-ppd's out-of-the-box mapping (power-saver=powersave) reaches it with
	# no edit to /etc/tuned/ppd.conf, which is a file tuned-ppd owns.
	install -Dm644 "$srcdir"/tuned.conf -t "$pkgdir"/etc/tuned/profiles/powersave/

	local unit
	for unit in apagar-de-verdad modo-carga modo-carga-decidir; do
		install -Dm644 "$srcdir/$unit.service" -t "$pkgdir"/usr/lib/systemd/system/
	done
	install -Dm644 "$srcdir"/10-utsugi-charge-mode.conf \
		-t "$pkgdir"/usr/lib/systemd/system/plasma-mobile.service.d/
	install -Dm644 "$srcdir"/50-utsugi-surya-watchdog.conf \
		-t "$pkgdir"/usr/lib/systemd/system.conf.d/
	install -Dm644 "$srcdir"/80-utsugi-surya-power.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}

systemd() {
	# Takes everything under usr/lib/systemd: the units, the preset, the drop-in
	# over plasma-mobile.service and systemd's own system.conf.d snippet.
	default_systemd
}
