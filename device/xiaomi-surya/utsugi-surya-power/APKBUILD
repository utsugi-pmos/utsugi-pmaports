maintainer="Dr. Utsugi <cidwel@gmail.com>"
# Power on the POCO X3 NFC: powering off, the watchdog, the charging screen
# (in the initramfs), alarms while off, Bluetooth while asleep, and the
# power-saving profile.
#
# Powering off hangs on this phone at a different point every time, with no oops
# and no panic. poweroff-for-real hands the power-off to the kernel BEFORE the
# teardown that freezes, and it is ordered so that it is the first unit stopped
# on the way down.
#
# A powered-off phone turns itself on for the next clock alarm
# (arm-alarm-wakeup, run by poweroff-for-real; the PMIC wakes on its RTC).
#
# Bluetooth is blocked while the phone sleeps: its UART wake line aborts every
# suspend otherwise (bluetooth-off-while-asleep).
#
# The watchdog is what removes the need for a person: if the system stops
# responding the hardware resets on its own. 20 s because the hardware maximum
# is 30 and systemd arms NOTHING if the value is out of range.
pkgname=utsugi-surya-power
pkgver=1
pkgrel=17
pkgdesc="Power-off, watchdog, charge mode and power saving for the Xiaomi POCO X3 NFC"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
depends="python3 inotify-tools"
subpackages="$pkgname-systemd"
install="$pkgname.post-install $pkgname.post-upgrade"
source="power-reason
	poweroff-for-real
	bluetooth-off-while-asleep
	arm-alarm-wakeup
	alarm-watch
	alarm-watch.service
	alarm-sync.service
	alarm-sync.timer
	40-utsugi-charge-mode.sh
	40-utsugi-charge-mode.modules
	utsugi-spin.plymouth
	utsugi-spin.script
	pixel.png
	right.png
	top.png
	left.png
	error.png
	utsugi-spin.NOTICE
	reboot-to-bootloader
	poweroff-for-real.service
	50-utsugi-surya-watchdog.conf
	tuned.conf
	80-utsugi-surya-power.preset
	"

package() {
	# A user-facing command: which is why it goes in /usr/bin and not in
	# /usr/libexec, unlike the units' own helpers.
	install -Dm755 "$srcdir"/power-reason -t "$pkgdir"/usr/bin/

	local helper
	for helper in poweroff-for-real arm-alarm-wakeup alarm-watch; do
		install -Dm755 "$srcdir/$helper" -t "$pkgdir"/usr/libexec/utsugi-surya/
	done
	# /usr/bin, not /usr/libexec: this one is typed by a person, and reaching
	# fastboot is something you do with the phone in your hand.
	install -Dm755 "$srcdir"/reboot-to-bootloader -t "$pkgdir"/usr/bin/

	# Installed as the stock "powersave" profile rather than a name of our own, so
	# tuned-ppd's out-of-the-box mapping (power-saver=powersave) reaches it with
	# no edit to /etc/tuned/ppd.conf, which is a file tuned-ppd owns.
	install -Dm644 "$srcdir"/tuned.conf -t "$pkgdir"/etc/tuned/profiles/powersave/

	local unit
	for unit in poweroff-for-real.service alarm-watch.service alarm-sync.service alarm-sync.timer; do
		install -Dm644 "$srcdir/$unit" -t "$pkgdir"/usr/lib/systemd/system/
	done
	install -Dm644 "$srcdir"/50-utsugi-surya-watchdog.conf \
		-t "$pkgdir"/usr/lib/systemd/system.conf.d/
	install -Dm644 "$srcdir"/80-utsugi-surya-power.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
	# Run by systemd-sleep before and after every suspend. See the file.
	install -Dm755 "$srcdir"/bluetooth-off-while-asleep \
		-t "$pkgdir"/usr/lib/systemd/system-sleep/

	# The charging screen lives in the initramfs (so that it runs on an
	# encrypted phone too; the systemd version it replaced could not). /usr/share/mkinitfs/* is a trigger directory:
	# installing this regenerates the initramfs. The plymouth theme that
	# draws the battery is picked by the post-install, in plymouthd.conf.
	install -Dm755 "$srcdir"/40-utsugi-charge-mode.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks-extra/
	install -Dm644 "$srcdir"/40-utsugi-charge-mode.modules \
		-t "$pkgdir"/usr/share/mkinitfs/modules/
	local f
	for f in utsugi-spin.plymouth utsugi-spin.script pixel.png right.png top.png left.png error.png; do
		install -Dm644 "$srcdir/$f" -t "$pkgdir"/usr/share/plymouth/themes/utsugi-spin/
	done
	install -Dm644 "$srcdir"/utsugi-spin.NOTICE "$pkgdir"/usr/share/plymouth/themes/utsugi-spin/NOTICE
}

systemd() {
	# Takes everything under usr/lib/systemd: the unit, the preset, the sleep
	# hook and systemd's own system.conf.d snippet.
	default_systemd
}
