#!/bin/sh
# Ring the alarm by the speaker from inside the initramfs, while an encrypted
# phone waits for its passphrase -- where the real system, its sound server
# and the Clock app do not exist yet.
#
#   alarm-sound <rtc-second>
#
# Started in the background by 40-utsugi-charge-mode.sh when this boot is for
# an alarm and the root is LUKS, about two minutes before the alarm. Brings the
# audio DSP and the sound card up, waits for the alarm's second, then plays the
# tone and buzzes in a loop until a button is pressed (power, volume up or
# down), the passphrase has been typed (PID 1 becomes systemd) or ten minutes
# have passed.
#
# THE ORDER IS THE WHOLE TRICK, measured on 2026-09-16. With every module
# loaded at once, the AFE clock vote fails ("AFE failed to vote (3)"), the
# LPASS pin controller times out on its clocks and fails its probe for good,
# and there is no card -- and those drivers cannot be bound again by hand. So:
# first the DSP loader and what it needs, then wait for the DSP's audio domain
# to come up, then the audio drivers. Done that way the card appeared at once,
# and the real system still had working sound after the unlock.
#
# Nothing here runs on an ordinary boot: the modules are blacklisted inside the
# initramfs (utsugi-alarm-audio.conf) so udev never loads them on its own.
set -u
RING=${1:?rtc second}
RTC=/sys/class/rtc/rtc0/since_epoch
DIR=/usr/share/utsugi-surya/alarm-audio
log() { echo "utsugi-alarm: $*" > /dev/kmsg 2>/dev/null; }
up() { [ "$(cat /proc/1/comm 2>/dev/null)" = systemd ]; }

PHASE1="qcom_pd_mapper qrtr_smd qcom_q6v5_pas"
PHASE2="q6core q6afe q6afe_clocks q6afe_dai q6asm q6asm_dai q6adm q6routing \
	q6voice q6voice_dai snd_soc_lpass_va_macro snd_soc_lpass_rx_macro \
	snd_soc_lpass_tx_macro soundwire_qcom snd_soc_wcd937x_sdw snd_soc_wcd937x \
	snd_soc_tas2562 snd_soc_sm8250"

for m in $PHASE1; do modprobe "$m" 2>/dev/null || log "modprobe $m failed"; done
i=0
until dmesg | grep -q "Indication received from msm/adsp/audio_pd"; do
	i=$((i + 1)); [ "$i" -ge 60 ] && { log "the DSP's audio domain never came up"; break; }
	up && exit 0
	sleep 1
done
sleep 5
for m in $PHASE2; do modprobe "$m" 2>/dev/null || log "modprobe $m failed"; done
i=0
until grep -qs . /proc/asound/cards && [ -e /dev/snd/pcmC0D0p ]; do
	i=$((i + 1)); [ "$i" -ge 60 ] && { log "no sound card"; break; }
	up && exit 0
	sleep 1
done
card=0
[ -e /dev/snd/pcmC0D0p ] && card=1 && log "sound card up"

if [ "$card" = 1 ]; then
	alsactl -f "$DIR/speaker.state" restore 0 >/dev/null 2>&1 || log "mixer restore failed"
	# The speaker amplifiers' volume, as a percentage, from the boot partition
	# if the owner set one; the audio-output map from percent to ALSA index.
	vol=85
	bootp=$(blkid -L pmOS_boot 2>/dev/null)
	if [ -n "$bootp" ] && mkdir -p /tmp/utsugi-vol && mount -o ro "$bootp" /tmp/utsugi-vol 2>/dev/null; then
		v=$(cat /tmp/utsugi-vol/utsugi/alarm-volume 2>/dev/null)
		umount /tmp/utsugi-vol 2>/dev/null
		case "$v" in ''|*[!0-9]*) ;; *) [ "$v" -le 100 ] && vol=$v ;; esac
	fi
	MAP="0 30 42 50 54 58 62 64 66 68 70 72 74 74 76 76 78 80 80 82 82 82 84 84 86 \
86 86 88 88 88 88 88 88 90 90 90 90 90 92 92 92 92 92 94 94 94 94 94 96 96 96 96 \
96 96 98 98 98 98 98 98 100 100 100 100 100 100 100 100 102 102 102 102 102 102 \
102 102 104 104 104 104 104 104 104 104 104 106 106 106 106 106 106 106 106 106 \
106 109 109 109 109 109 109"
	idx=$(echo $MAP | cut -d' ' -f$((vol + 1)))
	for side in Left Right; do
		amixer -c0 cset name="$side Digital Volume Control" "$idx" >/dev/null 2>&1 \
			|| log "cannot set the $side amplifier volume"
	done
	log "speaker at ${vol}% (index $idx)"
fi

while [ "$(cat "$RTC")" -lt "$RING" ]; do
	up && exit 0
	sleep 1
done
# Any of the three buttons silences it: power (pm8941_pwrkey), volume down
# (pm8941_resin) and volume up (gpio-keys). One reader per button, each waiting
# for a single event, leaves a mark; the loop below checks it every 0.2 s.
STOP=/tmp/utsugi-alarm-stop
rm -f "$STOP"
readers=""
for d in /sys/class/input/event*; do
	case "$(cat "$d/device/name" 2>/dev/null)" in
	pm8941_pwrkey|pm8941_resin|gpio-keys)
		( dd if="/dev/input/${d##*/}" of=/dev/null bs=24 count=1 2>/dev/null && : > "$STOP" ) &
		readers="$readers $!" ;;
	esac
done

log "ringing"
end=$(( $(cat "$RTC") + 600 ))
why="ten minutes"
while [ "$(cat "$RTC")" -lt "$end" ]; do
	up && { why=unlocked; break; }
	[ -e "$STOP" ] && { why="a button"; break; }
	ap=""; [ "$card" = 1 ] && { aplay -q -D hw:0,0 "$DIR/alarm.wav" 2>/dev/null & ap=$!; }
	beebzzr -d 700 -b 2 >/dev/null 2>&1 & bz=$!
	i=0
	while [ "$i" -lt 10 ] && [ ! -e "$STOP" ] && ! up; do sleep 0.2; i=$((i + 1)); done
	kill $ap $bz 2>/dev/null
	wait $ap $bz 2>/dev/null
done
# The readers are subshells each waiting on a dd; take the dd's down too, so
# nothing is left holding the buttons open after the switch to the real system.
kill $readers 2>/dev/null
pkill -f "of=/dev/null bs=24 count=1" 2>/dev/null
log "stopped by $why"
