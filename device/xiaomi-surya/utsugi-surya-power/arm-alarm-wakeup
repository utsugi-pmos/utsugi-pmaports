#!/usr/bin/python3
"""Arm the PMIC's RTC alarm so the powered-off phone turns itself on for the
next clock alarm.

The Clock app (kclockd) keeps its alarms in ~/.config/kclockdrc, one JSON
object per alarm under [Alarms]. This reads them, finds the next one that is
enabled, and writes the RTC wake alarm LEAD seconds before it, so the phone
has booted to the desktop -- where kclockd rings it -- when the time comes.

Measured on 2026-09-16: an RTC alarm powers the phone on from a real power-off
(PON_REASON1 = 0x04), and the desktop is up about 70 s after the alarm fires.

Run from poweroff-for-real, right before the power-off itself. Prints what it
armed; arms nothing if there is no alarm in the next seven days.

    arm-alarm-wakeup            arm
    arm-alarm-wakeup --dry-run  only say what it would arm
"""
import datetime, glob, json, os, sys

LEAD = 120                       # seconds before the alarm to start booting
WAKEALARM = "/sys/class/rtc/rtc0/wakealarm"
RTC_NOW = "/sys/class/rtc/rtc0/since_epoch"
# The same alarm, for the charging screen in the initramfs, which runs before
# the root is unlocked and can only read the boot partition. In RTC seconds,
# because the RTC is the only clock the initramfs has.
NEXT_ALARM = "/boot/utsugi/next-alarm"
DRY = "--dry-run" in sys.argv


def alarms():
    for rc in glob.glob("/home/*/.config/kclockdrc"):
        group = None
        for line in open(rc, encoding="utf-8", errors="replace"):
            line = line.strip()
            if line.startswith("["):
                group = line
            elif group == "[Alarms]" and "=" in line:
                try:
                    yield json.loads(line.split("=", 1)[1])
                except ValueError:
                    pass


def next_ring(alarm, now):
    """The next time this alarm rings, as kclockd computes it: daysOfWeek is a
    bit mask, bit 0 = Monday; zero means once, today or tomorrow."""
    t = now.replace(hour=int(alarm["hours"]), minute=int(alarm["minutes"]),
                    second=0, microsecond=0)
    days = int(alarm.get("daysOfWeek", 0))
    # A snoozed alarm rings snoozedLength seconds after its nominal time.
    snooze = datetime.timedelta(seconds=int(alarm.get("snoozedLength", 0)))
    for i in range(-1, 8):
        cand = t + datetime.timedelta(days=i)
        if days and not days & (1 << cand.weekday()):
            continue
        if cand + snooze > now:
            return cand + snooze
    return None


now = datetime.datetime.now().astimezone()
best = None
for a in alarms():
    if not a.get("enabled", False):
        continue
    ring = next_ring(a, now)
    if ring and (best is None or ring < best[0]):
        best = (ring, a.get("name", ""))

def leave_for_the_initramfs(line):
    try:
        os.makedirs(os.path.dirname(NEXT_ALARM), exist_ok=True)
        if line is None:
            if os.path.exists(NEXT_ALARM):
                os.remove(NEXT_ALARM)
        else:
            with open(NEXT_ALARM, "w") as f:
                f.write(line + "\n")
    except OSError as e:
        print(f"arm-alarm-wakeup: cannot write {NEXT_ALARM}: {e}")


if best is None:
    print("arm-alarm-wakeup: no enabled alarm, nothing armed")
    if not DRY:
        leave_for_the_initramfs(None)
    sys.exit(0)

ring, name = best
delta = int((ring - now).total_seconds()) - LEAD
if delta < 5:
    delta = 5
print(f"arm-alarm-wakeup: next alarm '{name}' at {ring:%Y-%m-%d %H:%M}, "
      f"waking in {delta} s" + (" (dry run)" if DRY else ""))
if not DRY:
    with open(WAKEALARM, "w") as f:
        f.write("0\n")
    with open(WAKEALARM, "w") as f:
        f.write(f"+{delta}\n")
    try:
        rtc_now = int(open(RTC_NOW).read())
    except (OSError, ValueError):
        rtc_now = None
    if rtc_now is not None:
        leave_for_the_initramfs(f"{rtc_now + delta} {ring:%H:%M} {name}")
