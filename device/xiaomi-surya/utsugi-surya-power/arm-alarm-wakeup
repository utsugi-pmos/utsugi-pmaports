#!/usr/bin/python3
"""Keep the PMIC's RTC alarm, and the boot partition, set for the next clock
alarm, so a phone that is off turns itself on in time for it.

The Clock app (kclockd) keeps its alarms in ~/.config/kclockdrc, one JSON
object per alarm under [Alarms]. This reads them, finds the next one that is
enabled, and writes the RTC wake alarm LEAD seconds before it, so the phone
has booted to the desktop -- where kclockd rings it -- when the time comes.
The same moment goes to /boot/utsugi/next-alarm for the charging screen in the
initramfs, which runs before an encrypted root is unlocked.

Measured on 2026-09-16: an RTC alarm powers the phone on from a real power-off
(PON_REASON1 = 0x04), and the desktop is up about 70 s after the alarm fires.

It runs whenever the alarms change (alarm-watch), every quarter of an hour
(alarm-sync.timer, for repeating alarms whose next ring moves on without the
file changing) and at power-off. It used to run ONLY at power-off, and that
missed every other way a phone goes off: a reboot, a power-off before the
desktop was up, a flat battery. Found on 2026-09-16 on an encrypted phone.

    arm-alarm-wakeup            arm
    arm-alarm-wakeup --boot     first see whether an alarm was missed, then arm
    arm-alarm-wakeup --dry-run  only say what it would arm

A MISSED ALARM. On an encrypted phone the boot started for an alarm stops at
the passphrase, and the Clock app only starts after it. kclockd works out each
alarm's next ring from the moment it starts, so an alarm whose minute passed
while the passphrase screen waited is simply moved to tomorrow, and nothing
rings when the owner unlocks. Measured on 2026-09-16. With --boot, before the
boot partition's copy is replaced, this checks whether that copy's alarm fell
due within the last MISSED_WINDOW seconds, and if so leaves its details in
/run/utsugi-surya/missed-alarm for alarm-catch-up, in the session, to ring.
"""
import datetime, glob, json, os, sys

LEAD = 120                       # seconds before the alarm to start booting
WAKEALARM = "/sys/class/rtc/rtc0/wakealarm"
RTC_NOW = "/sys/class/rtc/rtc0/since_epoch"
# The same alarm, for the charging screen in the initramfs, which runs before
# the root is unlocked and can only read the boot partition. In RTC seconds,
# because the RTC is the only clock the initramfs has.
NEXT_ALARM = "/boot/utsugi/next-alarm"
DRY = "--dry-run" in sys.argv
BOOT = "--boot" in sys.argv
MISSED = "/run/utsugi-surya/missed-alarm"
# Longer than a passphrase typed by someone just woken; shorter than the
# quarter of an hour after which alarm-sync.timer has moved the boot copy on
# past an alarm that did ring, so a reboot soon after never rings it twice.
MISSED_WINDOW = 14 * 60


def alarms():
    for rc in glob.glob("/home/*/.config/kclockdrc"):
        group = None
        for line in open(rc, encoding="utf-8", errors="replace"):
            line = line.strip()
            if line.startswith("["):
                group = line
            elif group == "[Alarms]" and "=" in line:
                try:
                    yield json.loads(line.split("=", 1)[1])
                except ValueError:
                    pass


def next_ring(alarm, now):
    """The next time this alarm rings, as kclockd computes it: daysOfWeek is a
    bit mask, bit 0 = Monday; zero means once, today or tomorrow."""
    t = now.replace(hour=int(alarm["hours"]), minute=int(alarm["minutes"]),
                    second=0, microsecond=0)
    days = int(alarm.get("daysOfWeek", 0))
    # A snoozed alarm rings snoozedLength seconds after its nominal time.
    snooze = datetime.timedelta(seconds=int(alarm.get("snoozedLength", 0)))
    for i in range(-1, 8):
        cand = t + datetime.timedelta(days=i)
        if days and not days & (1 << cand.weekday()):
            continue
        if cand + snooze > now:
            return cand + snooze
    return None


def alarm_records():
    """(uuid, alarm) for every alarm in every user's kclockdrc."""
    for rc in glob.glob("/home/*/.config/kclockdrc"):
        group = None
        for line in open(rc, encoding="utf-8", errors="replace"):
            line = line.strip()
            if line.startswith("["):
                group = line
            elif group == "[Alarms]" and "=" in line:
                key, value = line.split("=", 1)
                try:
                    yield key, json.loads(value)
                except ValueError:
                    pass


def notice_missed_alarm():
    try:
        old_target, old_rest = open(NEXT_ALARM).read().split(None, 1)
        rtc_now = int(open(RTC_NOW).read())
    except (OSError, ValueError):
        return
    due_rtc = int(old_target) + LEAD
    late = rtc_now - due_rtc
    if not 0 < late <= MISSED_WINDOW:
        return
    hhmm, _, name = old_rest.strip().partition(" ")
    for uuid, a in alarm_records():
        if not a.get("enabled", False) or a.get("name", "") != name:
            continue
        if f"{int(a.get('hours', -1)):02d}:{int(a.get('minutes', -1)):02d}" != hhmm:
            continue
        record = dict(a, uuid=uuid, due=int(datetime.datetime.now().timestamp()) - late)
        os.makedirs(os.path.dirname(MISSED), exist_ok=True)
        with open(MISSED, "w") as f:
            json.dump(record, f)
        os.chmod(MISSED, 0o644)
        print(f"arm-alarm-wakeup: alarm '{name}' at {hhmm} was due {late} s ago and "
              f"has not rung: left for alarm-catch-up")
        return


if BOOT and not DRY:
    notice_missed_alarm()

now = datetime.datetime.now().astimezone()
best = None
for a in alarms():
    if not a.get("enabled", False):
        continue
    ring = next_ring(a, now)
    if ring and (best is None or ring < best[0]):
        best = (ring, a.get("name", ""))

def leave_for_the_initramfs(line):
    try:
        os.makedirs(os.path.dirname(NEXT_ALARM), exist_ok=True)
        if line is None:
            if os.path.exists(NEXT_ALARM):
                os.remove(NEXT_ALARM)
        else:
            with open(NEXT_ALARM, "w") as f:
                f.write(line + "\n")
    except OSError as e:
        print(f"arm-alarm-wakeup: cannot write {NEXT_ALARM}: {e}")


def current_wakealarm():
    try:
        v = open(WAKEALARM).read().strip()
        return int(v) if v else None
    except (OSError, ValueError):
        return None


if best is None:
    print("arm-alarm-wakeup: no enabled alarm, nothing armed")
    if not DRY:
        if current_wakealarm() is not None:
            with open(WAKEALARM, "w") as f:
                f.write("0\n")
        leave_for_the_initramfs(None)
    sys.exit(0)

ring, name = best
delta = int((ring - now).total_seconds()) - LEAD
if delta < 5:
    delta = 5
print(f"arm-alarm-wakeup: next alarm '{name}' at {ring:%Y-%m-%d %H:%M}, "
      f"waking in {delta} s" + (" (dry run)" if DRY else ""))
if not DRY:
    try:
        rtc_now = int(open(RTC_NOW).read())
    except (OSError, ValueError):
        rtc_now = None
    target = None if rtc_now is None else rtc_now + delta
    line = None if target is None else f"{target} {ring:%H:%M} {name}"
    # Called every quarter of an hour and on every save of the alarms: touch
    # nothing that is already right, so the FAT boot partition is not
    # rewritten for nothing.
    armed = current_wakealarm()
    try:
        old = open(NEXT_ALARM).read().split(None, 1)
    except OSError:
        old = None
    same_rtc = armed is not None and target is not None and abs(armed - target) <= 2
    same_file = (old is not None and len(old) == 2 and line is not None
                 and abs(int(old[0]) - target) <= 2
                 and old[1].strip() == line.split(None, 1)[1])
    if not same_rtc:
        with open(WAKEALARM, "w") as f:
            f.write("0\n")
        with open(WAKEALARM, "w") as f:
            f.write(f"+{delta}\n")
    if line is not None and not same_file:
        leave_for_the_initramfs(line)
