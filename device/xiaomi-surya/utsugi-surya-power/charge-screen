#!/usr/bin/env python3
"""The screen shown with the phone plugged in and powered off: a battery with its
fill, the charging bolt and the percentage.

It is drawn DIRECTLY to /dev/fb0 and not with Plymouth. Plymouth is fine for a
boot -- a fixed image and some text -- but here a changing value has to be
repainted, and its theme on this phone is the postmarketOS logo, which is
exactly what makes you think the phone has hung while booting.

Drawing by hand also avoids depending on themes being installed, of which on this
system there are none (`plymouth-set-default-theme --list` returns nothing).

The brightness is NOT touched here: it is set by the script that calls this, because
it also turns it off after a while of inactivity.
"""
import fcntl
import os
import sys

# KDSETMODE on the virtual console: it is how Plymouth and the compositors
# silence fbcon. KD_GRAPHICS does not turn off logging, it only stops PAINTING it.
KDSETMODE = 0x4B3A
KD_TEXT, KD_GRAPHICS = 0x00, 0x01

FB = "/dev/fb0"
SYS_FB = "/sys/class/graphics/fb0"
QG = "/sys/class/power_supply/qcom_qg"

BACKGROUND = (0, 0, 0)
EDGE = (150, 150, 150)
CHARGING = (76, 175, 80)     # green
FULL = (255, 255, 255)
LOW = (229, 115, 115)       # soft red below 15 %
BOLT = (20, 20, 20)          # the bolt is cut out over the fill


def console_mode(mode):
    """Silences (or restores) the framebuffer console.

    Without this fbcon writes the kernel messages ON TOP of the drawing, and this
    phone boots with the console at level 7 on purpose so that a hang leaves a
    trace (see the blackbox setting): meaning it writes a lot. The console
    drawing is turned off, not the logging; not a single line is lost.
    """
    try:
        fd = os.open("/dev/tty0", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return
    try:
        fcntl.ioctl(fd, KDSETMODE, mode)
    except OSError:
        pass
    finally:
        os.close(fd)


def read_value(path, fallback=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return fallback


def geometria():
    width, height = (int(v) for v in read_value(f"{SYS_FB}/virtual_size", "1080,2400").split(","))
    stride = int(read_value(f"{SYS_FB}/stride", str(width * 4)))
    bpp = int(read_value(f"{SYS_FB}/bits_per_pixel", "32"))
    if bpp != 32:
        raise SystemExit(f"only 32-bit drawing is supported, and this screen uses {bpp}")
    return width, height, stride


class Canvas:
    """A rectangle in memory that is then flushed row by row to the framebuffer.

    Only the box the drawing occupies is painted and not the whole screen: that is
    2 MB instead of 10, and this repaints every few seconds throughout a whole
    night of charging.
    """

    def __init__(self, x, y, width, height):
        self.x, self.y, self.width, self.height = x, y, width, height
        self.data = bytearray(width * height * 4)

    def rect(self, x, y, width, height, color):
        r, g, b = color
        # The framebuffer is 32-bit XRGB in little-endian: B, G, R, X.
        pixel = bytes((b, g, r, 255))
        x0, y0 = max(0, x), max(0, y)
        x1, y1 = min(self.width, x + width), min(self.height, y + height)
        if x1 <= x0 or y1 <= y0:
            return
        row = pixel * (x1 - x0)
        for fy in range(y0, y1):
            i = (fy * self.width + x0) * 4
            self.data[i:i + len(row)] = row

    def frame(self, x, y, width, height, thickness, color):
        self.rect(x, y, width, thickness, color)
        self.rect(x, y + height - thickness, width, thickness, color)
        self.rect(x, y, thickness, height, color)
        self.rect(x + width - thickness, y, thickness, height, color)

    def poligono(self, points, color):
        """Scanline fill. Used by the bolt, which is not a rectangle."""
        if not points:
            return
        ys = [p[1] for p in points]
        for fy in range(max(0, min(ys)), min(self.height, max(ys) + 1)):
            cuts = []
            for i in range(len(points)):
                x1, y1 = points[i]
                x2, y2 = points[(i + 1) % len(points)]
                if y1 == y2:
                    continue
                if min(y1, y2) <= fy < max(y1, y2):
                    cuts.append(x1 + (fy - y1) * (x2 - x1) / (y2 - y1))
            cuts.sort()
            for i in range(0, len(cuts) - 1, 2):
                self.rect(int(cuts[i]), fy, int(cuts[i + 1]) - int(cuts[i]) + 1, 1, color)

    def dump(self, fb, stride):
        width = self.width * 4
        for row in range(self.height):
            fb.seek((self.y + row) * stride + self.x * 4)
            fb.write(self.data[row * width:(row + 1) * width])


# Seven-segment digits: no fonts to install, and at this size they can be read
# from across the room, which is how a charging phone is looked at.
SEGMENTS = {
    "0": "abcdef", "1": "bc", "2": "abged", "3": "abgcd", "4": "fgbc",
    "5": "afgcd", "6": "afgedc", "7": "abc", "8": "abcdefg", "9": "abcdfg",
}


def figure(canvas, x, y, width, height, thickness, c, color):
    on = SEGMENTS.get(c, "")
    middle = y + (height - thickness) // 2
    if "a" in on: canvas.rect(x, y, width, thickness, color)
    if "g" in on: canvas.rect(x, middle, width, thickness, color)
    if "d" in on: canvas.rect(x, y + height - thickness, width, thickness, color)
    if "f" in on: canvas.rect(x, y, thickness, height // 2, color)
    if "b" in on: canvas.rect(x + width - thickness, y, thickness, height // 2, color)
    if "e" in on: canvas.rect(x, middle, thickness, height - height // 2, color)
    if "c" in on: canvas.rect(x + width - thickness, middle, thickness, height - height // 2, color)


def porciento(canvas, x, y, height, thickness, color):
    d = height // 3
    canvas.frame(x, y, d, d, thickness, color)
    canvas.frame(x + height - d, y + height - d, d, d, thickness, color)
    canvas.poligono([(x + height - thickness, y), (x + height, y),
                     (x + thickness, y + height), (x, y + height)], color)


def number(canvas, text, cx, y, height, color):
    thickness = max(6, height // 9)
    width = int(height * 0.55)
    gap = thickness * 2
    total = len(text) * width + (len(text) - 1) * gap
    x = cx - total // 2
    for c in text:
        if c == "%":
            porciento(canvas, x, y + height // 3, height * 2 // 3, thickness, color)
        else:
            figure(canvas, x, y, width, height, thickness, c, color)
        x += width + gap


def clean(fb, height, stride):
    negro = bytes(stride)
    fb.seek(0)
    for _ in range(height):
        fb.write(negro)


def main():
    width, height, stride = geometria()

    try:
        cap = int(read_value(f"{QG}/capacity", "0"))
    except ValueError:
        cap = 0
    cap = max(0, min(100, cap))
    status = read_value(f"{QG}/status")

    color = CHARGING if status == "Charging" else (LOW if cap < 15 else FULL)

    # The drawing box, centered. Outside it the screen stays black.
    box_w, box_h = 480, 1120
    x0, y0 = (width - box_w) // 2, (height - box_h) // 2
    L = Canvas(x0, y0, box_w, box_h)

    # Battery: the cap on top and the body below.
    spout_w, spout_h = 120, 30
    body_x, body_y, body_w, body_h = 50, spout_h, 380, 760
    thickness = 8
    L.rect((box_w - spout_w) // 2, 0, spout_w, spout_h, EDGE)
    L.frame(body_x, body_y, body_w, body_h, thickness, EDGE)

    # Fill, from bottom to top. A margin is left so it does not touch the
    # frame: flush against it, it reads as a single block and stops looking like a battery.
    margin = thickness + 12
    gap_x = body_x + margin
    gap_y = body_y + margin
    gap_w = body_w - 2 * margin
    gap_h = body_h - 2 * margin
    fill = int(gap_h * cap / 100)
    if fill > 0:
        L.rect(gap_x, gap_y + gap_h - fill, gap_w, fill, color)

    # The bolt, only while charging: it is what tells "plugged in" apart from
    # "powered on with battery". It is drawn in the background color, cut out.
    if status == "Charging":
        cx = box_w // 2
        cy = body_y + body_h // 2
        L.poligono([(cx + 55, cy - 150), (cx - 15, cy + 20), (cx + 20, cy + 20),
                    (cx - 55, cy + 150), (cx + 5, cy - 10), (cx - 30, cy - 10)],
                   BOLT if fill > body_h // 2 else color)

    number(L, f"{cap}%", box_w // 2, body_y + body_h + 60, 150, EDGE)

    if "--console_mode" in sys.argv:
        console_mode(KD_TEXT)
        return
    console_mode(KD_GRAPHICS)

    with open(FB, "r+b", buffering=0) as fb:
        if "--clean-only" in sys.argv or "--solo-limpiar" in sys.argv:
            clean(fb, height, stride)
            return
        if "--clean" in sys.argv or "--limpiar" in sys.argv:
            clean(fb, height, stride)
        L.dump(fb, stride)


if __name__ == "__main__":
    main()
