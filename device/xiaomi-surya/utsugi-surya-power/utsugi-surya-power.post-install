#!/bin/sh
# Pick the utsugi-spin plymouth theme: pmos-spin plus the charging screen that
# the initramfs hook drives. plymouthd.conf belongs to plymouth and is meant for
# exactly this ("Administrator customizations go in this file"), so it is
# edited rather than shipped. The initramfs is regenerated by the mkinitfs
# trigger, which fires after this because the hook lands in /usr/share/mkinitfs.
f=/etc/plymouth/plymouthd.conf
[ -f "$f" ] || printf '[Daemon]\n' > "$f"
grep -q '^\[Daemon\]' "$f" || printf '[Daemon]\n' >> "$f"
if grep -q '^Theme=' "$f"; then
	sed -i 's/^Theme=.*/Theme=utsugi-spin/' "$f"
else
	sed -i 's/^\[Daemon\]/[Daemon]\nTheme=utsugi-spin/' "$f"
fi
# postmarketOS makes the power button act as Escape in plymouth (its
# plymouthd.defaults: XkbExtraEscButton), which toggles the splash and the boot
# log. On the charging screen every press would flip the battery away and
# restart the theme -- seen on 2026-09-16. The button is ours there.
# Not 0: plymouth (main.c, load_settings) takes the first file that sets a
# non-zero value and 0 means "unset", so the defaults would win. A keysym no
# key produces, XKB_KEY_VoidSymbol, is what turns it off.
if grep -q '^XkbExtraEscButton=' "$f"; then
	sed -i 's/^XkbExtraEscButton=.*/XkbExtraEscButton=0xffffff/' "$f"
else
	sed -i 's/^\[Daemon\]/[Daemon]\nXkbExtraEscButton=0xffffff/' "$f"
fi
exit 0
