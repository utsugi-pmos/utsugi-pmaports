maintainer="Danila Tikhonov <danila@jiaxyga.com>"
_orig=alsa-ucm-conf-qcom-sm7150
pkgname=$_orig-utsugi
pkgver=1.2.15.3_git20260513
pkgrel=6
# FORK of alsa-ucm-conf-qcom-sm7150. Same files as upstream, so it claims upstream's name with a
# versioned provides and a replaces: apk then refuses to have both installed and
# every package that depends on "alsa-ucm-conf-qcom-sm7150" is satisfied by this one.
pkgdesc="ALSA UCM configuration for SM7150 devices"
url="https://github.com/sm7150-mainline/alsa-ucm-conf"
arch="aarch64"
license="BSD-3-Clause"
provides="$_orig=$pkgver-r$pkgrel alsa-ucm-conf"
replaces="$_orig alsa-ucm-conf"
provider_priority=1
_commit="4821070589906c1d80c83210639591678c245369"
source="$_orig-$_commit.tar.gz::https://github.com/sm7150-mainline/alsa-ucm-conf/archive/$_commit.tar.gz
	0001-surya-microfono-en-el-ucm.patch
	"
options="!check"
builddir="$srcdir/alsa-ucm-conf-$_commit"

package() {
	# install audio config files
	mkdir -p "$pkgdir"/usr/share/alsa
	cp -r ucm2 "$pkgdir"/usr/share/alsa/
}

