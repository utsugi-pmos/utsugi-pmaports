#!/bin/sh
# What was left of the last hang.
#
#   blackbox              the last hang, with a verdict
#   blackbox --lista      all saved traces
#   blackbox --beats      the raw heartbeats, to inspect by hand
#   blackbox --state      what is installed right now
#   blackbox --freeze     the dump freeze-watchdog left on the dump partition
#
# The ramoops side lives in RAM that was supposed to survive the reboot. On this
# phone it does not -- measured 2026-09-10, /sys/fs/pstore comes back empty both
# after SysRq b and after a normal reboot -- which is why freeze-watchdog writes
# its dump to a raw partition instead. That one is '--freeze'.
#
# The files are owned by root, so the script relaunches itself with sudo if
# needed.
set -eu

ARCHIVE=/var/log/blackbox
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

# The most recent trace: first the archive itself, and if nothing has been
# archived yet, whatever systemd-pstore has just left.
last() {
	d="$(ls -1d "$ARCHIVE"/*/ 2>/dev/null | sort | tail -1)"
	[ -n "$d" ] && { printf '%s\n' "${d%/}"; return 0; }
	[ -e /var/lib/systemd/pstore/pmsg-ramoops-0 ] && { echo /var/lib/systemd/pstore; return 0; }
	return 1
}

# The DISK heartbeat ('last-heartbeat') is the good source: on this phone it is the
# only one that survives. The pmsg one carries the whole history, but it only
# appears the day ramoops works here -- see the header of blackbox-heartbeat.
beats_of() {
	grep -a '^blackbox ' "$1/pmsg-ramoops-0" 2>/dev/null || true
	# Archives made before 2026-09-11 carry the file under its old name.
	grep -a '^blackbox ' "$1/last-heartbeat" 2>/dev/null \
		|| grep -a '^blackbox ' "$1/last-latido" 2>/dev/null || true
}

field() {  # field <line> <name>  ->  the value, or empty
	printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1
}

FREEZE_DEV=/dev/disk/by-partlabel/logdump
FREEZE_MAGIC=UTSUGI-FREEZE-DUMP

case "${1:-}" in
--freeze)
	# The partition always holds something; the magic is how we tell our dump
	# from whatever the stock bootloader left there.
	[ -e "$FREEZE_DEV" ] || { echo "there is no $FREEZE_DEV on this device"; exit 1; }
	if ! dd if="$FREEZE_DEV" bs=64 count=1 2>/dev/null | grep -q "$FREEZE_MAGIC"; then
		echo "the dump partition holds no freeze dump."
		echo "(freeze-watchdog writes one when the filesystem stops answering)"
		exit 0
	fi
	echo "== freeze dump, from $FREEZE_DEV =="
	dd if="$FREEZE_DEV" bs=1M count=1 2>/dev/null | tr -d '\000' | tail -n +2
	exit 0 ;;
--lista)
	echo "Traces saved in $ARCHIVE:"
	for d in "$ARCHIVE"/*/; do
		[ -d "$d" ] || { echo "  (none yet)"; break; }
		n="$(beats_of "${d%/}" | wc -l)"
		printf '  %-20s %s heartbeats%s\n' "$(basename "$d")" "$n" \
			"$([ -e "${d%/}/dmesg-ramoops-0" ] && echo ', WITH panic dump')"
	done
	exit 0 ;;
--beats|--latidos)
	d="$(last)" || { echo "No trace saved."; exit 1; }
	beats_of "$d"
	exit 0 ;;
--state|--estado)
	printf 'console awake on suspend        %s\n' \
		"$(cat /sys/module/printk/parameters/console_suspend 2>/dev/null)  (N = yes, which is what we want)"
	printf 'console level                   %s\n' "$(cut -f1 /proc/sys/kernel/printk)  (7 = everything)"
	printf 'heartbeat timer                 %s\n' "$(systemctl is-active blackbox-heartbeat.timer 2>/dev/null)"
	printf 'ramoops                         %s KB of console, %s KB of messages\n' \
		"$(($(cat /sys/module/ramoops/parameters/console_size) / 1024))" \
		"$(($(cat /sys/module/ramoops/parameters/pmsg_size) / 1024))"
	# 'Finished', not 'Started': for a oneshot service systemd logs
	# "Starting"/"Finished", so counting "Started" always gave zero.
	printf 'sign of life right now          %s\n' \
		"$(cut -d' ' -f2 /var/log/blackbox/heartbeat 2>/dev/null \
			|| cut -d' ' -f2 /var/log/blackbox/latido 2>/dev/null || echo 'none yet')"
	printf 'heartbeats in this boot         %s\n' \
		"$(journalctl -u blackbox-heartbeat.service -b --no-pager 2>/dev/null | grep -c Finished || true)"
	exit 0 ;;
esac

d="$(last)" || {
	cat <<'FIN'
No trace saved yet.

That is good news: it means the phone has not hung since the black box was put
in place. Come back here after the next hang.
FIN
	exit 0
}

echo "=== Trace of $(basename "$d") ==="
echo

# --- 1. how long it stayed alive -------------------------------------------
ult="$(beats_of "$d" | tail -1)"
if [ -z "$ult" ]; then
	echo "No heartbeats. Either the black box was not in place on that boot, or the"
	echo "message area filled up and wrapped around."
else
	t="$(field "$ult" t)"
	boot="$(($(date +%s) - $(cut -d. -f1 /proc/uptime)))"
	# The line is: blackbox <date> t=... up=...  -- the date is the 2nd field.
	echo "Last heartbeat:  $(printf '%s\n' "$ult" | cut -d' ' -f2)"
	echo "  the phone had been on for $(field "$ult" up) s"
	echo "  screen $(field "$ult" luz), suspends $(field "$ult" susp) (good/bad), charge $(field "$ult" load)"
	if [ -n "$t" ] && [ "$t" -gt 0 ] 2>/dev/null; then
		gap=$((boot - t))
		if [ "$gap" -gt 0 ]; then
			echo "  and the phone did not boot again until $((gap / 60)) min later"
		fi
	fi
fi
echo

# --- 2. what the kernel said at the end -------------------------------------
if [ -s "$d/console-ramoops-0" ]; then
	echo "--- the last thing the kernel said on the console (ramoops) ---"
	tail -40 "$d/console-ramoops-0"
else
	echo "--- no console saved ---"
	echo "The kernel did not get to say anything, or the console was suspended."
fi
echo

# --- 3. was there a panic? --------------------------------------------------
if [ -s "$d/dmesg-ramoops-0" ]; then
	echo "--- THERE WAS A KERNEL PANIC, and this is its tail ---"
	tail -30 "$d/dmesg-ramoops-0"
else
	cat <<'FIN'
--- there was no kernel panic ---
There is no dmesg dump. The kernel did not enter a panic: either it got stuck
unable to write, or it died all at once. A panic would have left the trace here
with the exact function.
FIN
fi
echo
echo "The log of the previous boot: $d/previous-boot-log.txt"
