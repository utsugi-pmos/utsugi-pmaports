[Unit]
Description=Leave the kernel ready to leave a trace if it hangs
DefaultDependencies=no
After=sysinit.target
Before=sleep.target

[Service]
Type=oneshot
RemainAfterExit=yes

# 1. Keep the console from turning OFF on suspend.
#
# The kernel silences the consoles before sleeping ("printk: Suspending
# console(s) (use no_console_suspend to debug)"), and here the console is
# ramoops: 1 MB of RAM that survives the reboot. So exactly in the stretch where
# this phone dies -- suspend and resume -- nothing was being saved.
#
# With this, the suspend and resume printk DO get recorded, and after a hang they
# are read with 'blackbox'.
ExecStart=/bin/sh -c 'echo N > /sys/module/printk/parameters/console_suspend'

# Raising the console to level 7 used to live here too, at multi-user. It was
# moved to blackbox-console-verbose.service, which waits for the compositor to
# own the screen first: at level 7 every driver's chatter was painted on the
# framebuffer for the few seconds between unlocking and the desktop, because
# the boot console (loglevel=3) is still on screen until kwin takes over.
# Keeping console_suspend here (it matters at the first suspend, well after the
# desktop) and the raise there keeps the boot quiet without losing anything.

[Install]
WantedBy=multi-user.target
