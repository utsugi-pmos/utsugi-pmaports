[Unit]
Description=Archive the trace from the previous boot before the next one overwrites it
# systemd-pstore is what pulls the files out of /sys/fs/pstore. If we run
# before it, there is nothing to copy.
After=systemd-pstore.service
Requires=systemd-pstore.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/utsugi-surya/blackbox-archive

[Install]
WantedBy=multi-user.target
