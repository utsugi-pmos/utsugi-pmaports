#!/bin/sh
# Saves, BEFORE it is lost, what was left from the previous boot.
#
# TWO THINGS THAT ARE LOST FOR DIFFERENT REASONS
# ----------------------------------------------
# 1. The LAST SIGN OF LIFE (/var/log/blackbox/heartbeat). It is a one-line
#    file that the heartbeat OVERWRITES every 30 s. If it is not moved aside now, the first
#    heartbeat of this boot overwrites the one from the freeze -- exactly the data of interest.
#    That is why the heartbeat timer starts AFTER this service.
#
# 2. The ramoops trace. systemd-pstore empties /sys/fs/pstore on every boot
#    and leaves the files in /var/lib/systemd/pstore/ with FIXED names:
#    console-ramoops-0, pmsg-ramoops-0... The next freeze overwrites them, and with
#    two in a row you are left only with the second, which is when comparing them
#    is most needed.
#
#    NOTE: on this phone ramoops does NOT survive the reboot (measured on 2026-09-04,
#    neither with an orderly reboot nor with a panic and a warm reboot). Here almost
#    always there will be nothing to archive by this route, and it is not a bug of this
#    script. The sign of life from point 1 is the one that does work.
set -eu

SOURCE=/var/lib/systemd/pstore
BASE=/var/log/blackbox
HEARTBEAT="$BASE/heartbeat"
# The file was called "latido" until 2026-09-11. A phone that froze before the
# rename still has that one sitting there, and it is the only record of when it
# last drew breath -- so it is archived too, under the new name.
[ -f "$HEARTBEAT" ] || [ ! -f "$BASE/latido" ] || HEARTBEAT="$BASE/latido"

mkdir -p "$BASE"

# Is there anything to archive? The sign of life, the ramoops trace, or neither.
# The heartbeat is only archived if it is from a PREVIOUS boot. Without this, running
# this script by hand with the phone working takes away the CURRENT sign of life
# and fabricates a trace of a freeze that has not happened. It happens when testing.
#
# The check needs nothing saved: the line carries 't=' (the instant at
# which it was written) and this system booted at 'now - uptime'. If the heartbeat is
# later than that boot, it is from the current session and is not touched.
has_heartbeat=0
if [ -s "$HEARTBEAT" ]; then
	t="$(tr ' ' '\n' < "$HEARTBEAT" | sed -n 's/^t=//p' | head -1 | tr -dc 0-9)"
	boot=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) ))
	if [ -z "$t" ]; then
		# Without 't=' it cannot be dated: it is archived, which is the prudent side --
		# losing a freeze's mark is worse than archiving one too many.
		has_heartbeat=1
	elif [ "$t" -lt "$boot" ]; then
		has_heartbeat=1
	fi
fi
# Ramoops ONLY counts if it is NEW. systemd-pstore leaves its files there and does not
# delete them, so without this check each boot would copy the
# same old dump again to a new directory -- and the reader would present it as
# this freeze's dump. It happened: the 2026-09-04 trace came out "WITH a panic
# dump" showing the oops from September 1st.
#
# The boundary is the date of the most recent one already archived, kept aside.
STATE="$BASE/.ramoops-archived"
# The marker was ".ramoops-archivado" until 2026-09-11. Reading only the new name
# on a phone that has the old one loses the boundary, and the next run archives a
# dump that was already archived -- which is the exact failure the boundary is
# here to prevent.
[ -f "$STATE" ] || [ ! -f "$BASE/.ramoops-archivado" ] || STATE="$BASE/.ramoops-archivado"
seen=0
[ -f "$STATE" ] && seen="$(cat "$STATE" 2>/dev/null | tr -dc 0-9)"
[ -n "$seen" ] || seen=0

has_ramoops=0
new_seen="$seen"
for f in "$SOURCE"/*-ramoops-*; do
	[ -e "$f" ] || continue
	m="$(date -r "$f" +%s 2>/dev/null || echo 0)"
	[ "$m" -gt "$seen" ] || continue
	has_ramoops=1
	[ "$m" -gt "$new_seen" ] && new_seen="$m"
done
[ "$has_heartbeat" = 1 ] || [ "$has_ramoops" = 1 ] || exit 0

# The directory's mark comes from the time of the LAST HEARTBEAT, which is the real time
# at which the phone stopped giving signals. If there is no heartbeat -- because the black box
# was not set on that boot -- it falls back to the date of the ramoops trace.
mark=""
if [ "$has_heartbeat" = 1 ]; then
	mark="$(date -r "$HEARTBEAT" +%Y%m%d-%H%M%S 2>/dev/null || true)"
fi
if [ -z "$mark" ] && [ "$has_ramoops" = 1 ]; then
	mark="$(date -r "$(ls -t "$SOURCE"/*-ramoops-* | head -1)" +%Y%m%d-%H%M%S 2>/dev/null || true)"
fi
[ -n "$mark" ] || mark="$(date +%Y%m%d-%H%M%S)"

dir="$BASE/$mark"
[ -d "$dir" ] && exit 0   # already archived in a previous boot
mkdir -p "$dir"

# 1. The sign of life. It is MOVED, not copied: this way this boot's heartbeat
#    starts from zero and no old copy is left confusing things.
if [ "$has_heartbeat" = 1 ]; then
	mv "$HEARTBEAT" "$dir/last-heartbeat"
fi

# 2. The ramoops trace, and ONLY the one not already archived (see above).
if [ "$has_ramoops" = 1 ]; then
	for f in "$SOURCE"/*-ramoops-*; do
		[ -e "$f" ] || continue
		m="$(date -r "$f" +%s 2>/dev/null || echo 0)"
		[ "$m" -gt "$seen" ] || continue
		cp -a "$f" "$dir"/ 2>/dev/null || true
	done
	printf '%s\n' "$new_seen" > "$STATE"
fi

# 3. The previous boot's journal, alongside the rest. Without this you have to remember
#    the '-b -1', and after two reboots it is no longer -1.
#
#    IT CARRIES A HEADER ON PURPOSE: the journal is the one from the boot BEFORE THIS, and
#    the ramoops trace may be from another, much older event if nobody
#    rebooted since then. It happened first time: a directory dated September 1st
#    had inside it the journal of the freeze from the 3rd.
{
	echo "# Journal of the boot BEFORE the one archiving this (journalctl -b -1)."
	echo "# If this directory has *-ramoops-* files, they may be from another"
	echo "# different and older event: check their dates."
	printf '# That boot: '
	journalctl --list-boots --no-pager 2>/dev/null | awk '$1 == "-1"' || echo "(not recorded)"
	echo "#"
	journalctl -b -1 --no-pager 2>/dev/null
} > "$dir/previous-boot-log.txt" 2>/dev/null || true

# Keep it from growing without end: the last ten are enough.
ls -1d "$BASE"/*/ 2>/dev/null | sort -r | tail -n +11 | while read -r old; do
	rm -rf "$old"
done
