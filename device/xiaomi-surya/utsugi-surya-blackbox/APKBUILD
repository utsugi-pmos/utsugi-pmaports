maintainer="Dr. Utsugi <cidwel@gmail.com>"
# The black box: what the phone was doing right before it died.
#
# This device hangs on shutdown at a different point every time, with no oops and
# no panic, so the evidence has to survive the reboot. A heartbeat timer leaves a
# trail, the archiver keeps the previous boot's journal, and journald is given
# enough room not to rotate it away.
pkgname=utsugi-surya-blackbox
pkgver=1
pkgrel=0
pkgdesc="Keep evidence across the reboots this phone does not survive"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
subpackages="$pkgname-systemd"
source="caja-negra
	caja-negra-latido
	caja-negra-archivar
	sincronizar-journal
	caja-negra-ajustes.service
	caja-negra-archivar.service
	caja-negra-latido.service
	caja-negra-latido.timer
	sincronizar-journal.service
	50-utsugi-blackbox.conf
	80-utsugi-surya-blackbox.preset
	"

package() {
	# caja-negra is the command you type to read the box; the rest only run from
	# their units.
	install -Dm755 "$srcdir"/caja-negra -t "$pkgdir"/usr/bin/
	local helper
	for helper in caja-negra-latido caja-negra-archivar sincronizar-journal; do
		install -Dm755 "$srcdir/$helper" -t "$pkgdir"/usr/libexec/utsugi-surya/
	done

	local unit
	for unit in caja-negra-ajustes.service caja-negra-archivar.service \
	            caja-negra-latido.service caja-negra-latido.timer \
	            sincronizar-journal.service; do
		install -Dm644 "$srcdir/$unit" -t "$pkgdir"/usr/lib/systemd/system/
	done
	install -Dm644 "$srcdir"/50-utsugi-blackbox.conf \
		-t "$pkgdir"/usr/lib/systemd/journald.conf.d/
	install -Dm644 "$srcdir"/80-utsugi-surya-blackbox.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}

systemd() {
	default_systemd
}
