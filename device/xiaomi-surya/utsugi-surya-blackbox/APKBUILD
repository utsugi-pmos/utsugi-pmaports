maintainer="Dr. Utsugi <cidwel@gmail.com>"
# The black box: what the phone was doing right before it died.
#
# This device hangs on shutdown at a different point every time, with no oops and
# no panic, so the evidence has to survive the reboot. A heartbeat timer leaves a
# trail, the archiver keeps the previous boot's journal, and journald is given
# enough room not to rotate it away.
pkgname=utsugi-surya-blackbox
pkgver=1
pkgrel=16
pkgdesc="Keep evidence across the reboots this phone does not survive"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
# Not noarch any more: freeze-watchdog is a C program on purpose. A shell
# script cannot be the thing that survives a frozen filesystem -- it would
# need to exec sleep, and an exec is a read.
arch="all"
license="MIT"
options="!check"
# Every source is a local file, so there is no unpacked tree to build in.
builddir="$srcdir"
subpackages="$pkgname-systemd"
source="blackbox
	freeze-watchdog.c
	freeze-watchdog.service
	utsugi-surya-freeze-watchdog.default
	blackbox-heartbeat
	blackbox-archive
	journal-sync
	blackbox-settings.service
	blackbox-console-verbose.service
	blackbox-archive.service
	blackbox-heartbeat.service
	blackbox-heartbeat.timer
	journal-sync.service
	50-utsugi-blackbox.conf
	80-utsugi-surya-blackbox.preset
	"

build() {
	# One file, no build system: it is 180 lines whose whole job is to keep
	# working when nothing else does.
	${CC:-cc} $CFLAGS $LDFLAGS -o "$srcdir"/freeze-watchdog "$srcdir"/freeze-watchdog.c
}

package() {
	# blackbox is the command you type to read the box; the rest only run from
	# their units.
	install -Dm755 "$srcdir"/blackbox -t "$pkgdir"/usr/bin/
	local helper
	for helper in blackbox-heartbeat blackbox-archive journal-sync; do
		install -Dm755 "$srcdir/$helper" -t "$pkgdir"/usr/libexec/utsugi-surya/
	done
	install -Dm755 "$srcdir"/freeze-watchdog -t "$pkgdir"/usr/libexec/utsugi-surya/
	# /etc/default, and shipped as a real config file: it is the only knob, and
	# an upgrade must not overwrite a threshold someone tuned.
	install -Dm644 "$srcdir"/utsugi-surya-freeze-watchdog.default \
		"$pkgdir"/etc/default/utsugi-surya-freeze-watchdog

	local unit
	for unit in blackbox-settings.service blackbox-console-verbose.service \
	            blackbox-archive.service \
	            blackbox-heartbeat.service blackbox-heartbeat.timer \
	            journal-sync.service freeze-watchdog.service; do
		install -Dm644 "$srcdir/$unit" -t "$pkgdir"/usr/lib/systemd/system/
	done
	install -Dm644 "$srcdir"/50-utsugi-blackbox.conf \
		-t "$pkgdir"/usr/lib/systemd/journald.conf.d/
	install -Dm644 "$srcdir"/80-utsugi-surya-blackbox.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}

systemd() {
	default_systemd
}
