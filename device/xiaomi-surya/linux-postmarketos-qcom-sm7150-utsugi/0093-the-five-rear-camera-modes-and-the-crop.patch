+/*
+ * EL RECTANGULO DE RECORTE.
+ *
+ * Sin esto libcamera avisa "Unable to get rectangle 0 on pad 0/0" y se inventa
+ * que el area leida es igual al tamano de salida. Con los modos agrupados eso
+ * es falso -2312x1304 sale de una ventana de 9248x5216- y el campo de vision
+ * que calcula queda mal, que es de donde sale el zoom digital.
+ */
+static int imx682_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx682 *s = to_imx682(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r.left = 0;
+		sel->r.top = s->mode->crop_top;
+		sel->r.width = IMX682_NATIVE_WIDTH;
+		sel->r.height = s->mode->crop_height;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX682_NATIVE_WIDTH;
+		sel->r.height = IMX682_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
