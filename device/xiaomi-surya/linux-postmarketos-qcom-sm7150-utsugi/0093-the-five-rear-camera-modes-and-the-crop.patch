+/* link x 2 x trios / bits per pixel, the same arithmetic already in use */
+static s64 imx682_mode_pixel_rate(s64 link)
+{
+	return link * 2 * IMX682_DATA_LANES / IMX682_BITS_PER_PIXEL;
+}
