+static int imx682_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx682 *s = to_imx682(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r.left = 0;
+		sel->r.top = s->mode->crop_top;
+		sel->r.width = IMX682_NATIVE_WIDTH;
+		sel->r.height = s->mode->crop_height;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX682_NATIVE_WIDTH;
+		sel->r.height = IMX682_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
