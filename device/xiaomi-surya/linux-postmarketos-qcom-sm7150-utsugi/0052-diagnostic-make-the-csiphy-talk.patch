+/*
+ * DIAGNOSTICO: la cuenta de asentamiento decide cuanto espera el PHY antes de
+ * empezar a muestrear un carril. Si no cuadra con la velocidad real del
+ * enlace, el PHY ve la señal -sus registros de estado no estan a cero- pero no
+ * consigue sincronizar, y como las interrupciones van enmascaradas en
+ * mainline, no se entera nadie.
+ *
+ * La formula de mainline usa el MINIMO de la ventana T_HS_SETTLE de la norma
+ * (85 ns + 6 UI) y luego resta 6 cuentas, con lo que a 845 MHz se queda en
+ * unos 67 ns: por debajo de los 88 ns que pide la norma. Puede que ese margen
+ * le valga a otros aparatos y a este no.
+ *
+ * Se deja ajustable EN CALIENTE (0644) para poder barrerlo sin recompilar ni
+ * reiniciar, que en este movil cuesta caro: se cuelga uno de cada cuatro
+ * arranques.
+ */
+static int desenmascarar;
+module_param(desenmascarar, int, 0644);
+MODULE_PARM_DESC(desenmascarar,
+	"1 = desenmascarar las interrupciones del CSIPHY. Falsea la medida: solo para saber si el PHY oye al sensor.");
+
+static int settle_cnt_override = -1;
+module_param(settle_cnt_override, int, 0644);
+MODULE_PARM_DESC(settle_cnt_override,
+	"Cuenta de asentamiento del CSIPHY. -1 = la calculada.");
+
 static u8 csiphy_settle_cnt_calc(s64 link_freq, u32 timer_clk_rate)
 {
 	u32 ui; /* ps */
