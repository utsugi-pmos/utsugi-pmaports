@@ -1005,6 +1016,32 @@
  * Return settle count value or 0 if the CSI2 link frequency
  * is not available
  */
+/*
+ * DIAGNOSTIC: the settle count decides how long the PHY waits before
+ * it starts sampling a lane. If it does not match the real link
+ * rate, the PHY sees the signal -its status registers are not zero- but it does not
+ * manage to synchronize, and since the interrupts are masked in
+ * mainline, nobody finds out.
+ *
+ * The mainline formula uses the MINIMUM of the spec T_HS_SETTLE window
+ * (85 ns + 6 UI) and then subtracts 6 counts, so that at 845 MHz it ends up at
+ * about 67 ns: below the 88 ns the spec requires. That margin may
+ * be good enough for other devices and not for this one.
+ *
+ * It is left tunable AT RUNTIME (0644) so it can be swept without recompiling or
+ * reboot, which is expensive on this phone: one boot in four hangs
+ * starts.
+ */
+static int unmask;
+module_param(unmask, int, 0644);
+MODULE_PARM_DESC(unmask,
+	"1 = unmask the CSIPHY interrupts. It skews the measurement: only to find out whether the PHY hears the sensor.");
+
+static int settle_cnt_override = -1;
+module_param(settle_cnt_override, int, 0644);
+MODULE_PARM_DESC(settle_cnt_override,
+	"CSIPHY settle count. -1 = the computed one.");
+
 static u8 csiphy_settle_cnt_calc(s64 link_freq, u32 timer_clk_rate)
 {
 	u32 ui; /* ps */
@@ -1024,6 +1056,9 @@
 	timer_period = div_u64(1000000000000LL, timer_clk_rate);
 	settle_cnt = t_hs_settle / timer_period - 6;
 
+	if (settle_cnt_override >= 0)
+		settle_cnt = settle_cnt_override;
+
 	return settle_cnt;
 }
 
@@ -1160,7 +1195,7 @@
 	struct csiphy_lanes_cfg *c = &cfg->csi2->lane_cfg;
 	struct csiphy_device_regs *regs = csiphy->regs;
 	u8 settle_cnt;
-	u8 val;
+	u8 val, ctrl5;
 	int i;
 
 	settle_cnt = csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);
@@ -1171,6 +1206,7 @@
 
 	writel_relaxed(val, csiphy->base +
 		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 5));
+	ctrl5 = val;
 
 	val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL6_COMMON_PWRDN_B;
 	writel_relaxed(val, csiphy->base +
@@ -1189,11 +1225,25 @@
 	else
 		csiphy_gen1_config_lanes(csiphy, cfg, settle_cnt);
 
-	/* IRQ_MASK registers - disable all interrupts */
+	/*
+	 * Unmasking the PHY is EXPENSIVE and skews the measurement: with the link
+	 * unlocked it fires about 8700 times per second, and each ISR pass
+	 * does 35 register accesses. That is 300,000 reads and writes per
+	 * second on the very block that is trying to synchronize.
+	 *
+	 * So by default it behaves like mainline, masked, and it is only
+	 * is enabled when the specific question of whether the
+	 * PHY hears the sensor has to be answered -which is answered by looking at /proc/interrupts-.
+	 */
 	for (i = 11; i < 22; i++) {
-		writel_relaxed(0, csiphy->base +
+		writel_relaxed(unmask ? 0xff : 0, csiphy->base +
 			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, i));
 	}
+
+	dev_info(csiphy->camss->dev,
+		 "csiphy%d: link_freq=%lld timer_clk=%u settle_cnt=%u lane_mask=0x%02x num_data=%u ctrl5=0x%02x\n",
+		 csiphy->id, link_freq, csiphy->timer_clk_rate, settle_cnt,
+		 lane_mask, c->num_data, ctrl5);
 }
 
