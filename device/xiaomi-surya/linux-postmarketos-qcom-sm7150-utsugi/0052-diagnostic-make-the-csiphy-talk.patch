+			 "csiphy%d state: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			 csiphy->id, seen[0], seen[1], seen[2], seen[3],
+			 seen[4], seen[5], seen[6], seen[7], seen[8],
