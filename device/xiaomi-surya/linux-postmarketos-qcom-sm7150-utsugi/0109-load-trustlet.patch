+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Diagnostic: ask the TrustZone whether a given trustlet is loaded.
+ *
+ * The fingerprint sensor is only reachable through its trusted app; every
+ * direct route to its bus is measured shut (task 020). But mainline can talk
+ * to a QSEECom app that is ALREADY loaded:
+ *
+ *      qcom_scm_qseecom_app_get_id(name, &id)   -- resolve name to id
+ *      qcom_scm_qseecom_app_send(id, ...)       -- send it a command
+ *
+ * What mainline lacks is the load operation. So the question worth answering
+ * before writing any of that is simply: is it loaded already? On Android,
+ * qseecomd loads these at boot; postmarketOS has no qseecomd, but the boot
+ * chain may well have loaded some itself.
+ *
+ * Reading is harmless: an unknown name just returns an error.
+ *
+ *      cat /sys/kernel/debug/probe_ta/state
+ */
+
+#include <linux/debugfs.h>
+#include <linux/firmware.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/hex.h>
+#include <linux/unaligned.h>
+#include <linux/clk.h>
+#include <linux/of_clk.h>
+#include <linux/of.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/driver.h>
+#include <linux/interrupt.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/seq_file.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+
+/* The two the phone ships, plus known-loaded ones as controls. */
+/*
+ * QTEE names its apps with a "qcom.tz." prefix -- the uefisecapp driver header
+ * says so: "Client driver for Qualcomm UEFI Secure Application
+ * (qcom.tz.uefisecapp)". Asking for the bare name returns -ENOENT for
+ * everything, control included, which is a broken probe rather than a result.
+ * Both spellings are tried so the answer cannot be blamed on the prefix.
+ */
+static const char * const names[] = {
+	/* CONTROL: this one is known to work -- the EFI variables come from it. */
+	"qcom.tz.uefisecapp",
+	"uefisecapp",
+	/* The fingerprint sensor, the two factory variants. */
+	"qcom.tz.goodixfp",
+	"goodixfp",
+	"qcom.tz.fpctzapp",
+	"fpctzapp",
+	/* More controls, of the kind boot usually loads. */
+	"qcom.tz.keymaster",
+	"qcom.tz.qwes",
+};
+
+static int probe_ta_show(struct seq_file *s, void *unused)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		u32 id = 0;
+		int ret = qcom_scm_qseecom_app_get_id(names[i], &id);
+
+		if (ret)
+			seq_printf(s, "%-12s no: %d\n", names[i], ret);
+		else
+			seq_printf(s, "%-12s LOADED, app_id=%u\n",
+				   names[i], id);
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(probe_ta);
+
+/*
+ * Asking by name: write a name here and the TrustZone is asked whether it has
+ * an app so called.
+ *
+ *   echo qcom.tz.keymaster > /sys/kernel/debug/probe_ta/search
+ *
+ * `state` above carries a fixed list, which was fine while the question was
+ * "is the fingerprint TA loaded". It stops being fine as soon as the name is
+ * the unknown -- keymaster is loaded by the bootloader under a name nobody
+ * here knows, and finding it by rebuilding the kernel once per guess is not a
+ * way to search.
+ */
+static ssize_t probe_search_write(struct file *f, const char __user *ubuf,
+				  size_t len, loff_t *off)
+{
+	char *buf, *name;
+	u32 id = 0;
+	int ret;
+
+	if (len >= 128)
+		return -EINVAL;
+
+	buf = memdup_user_nul(ubuf, len);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	name = strim(buf);
+	ret = qcom_scm_qseecom_app_get_id(name, &id);
+	if (ret)
+		pr_info("probe_ta: look up '%s' -> no: %d\n", name, ret);
+	else
+		pr_info("probe_ta: look up '%s' -> LOADED, app_id=%u\n",
+			name, id);
+
+	kfree(buf);
+	return len;
+}
+
+/*
+ * The fingerprint sensor hangs off spi6 (0xa80000, function qup10 on pins
+ * 59-62), whose SE clock is GCC_QUPV3_WRAP1_S0_CLK. On this kernel that clock
+ * is registered, off, and has no consumer at all -- `deviceless` in
+ * clk_summary -- because no SPI node claims the controller: it belongs to the
+ * secure world.
+ *
+ * Which raises the question this knob exists to answer. The TrustZone may well
+ * turn its own clock on; or it may assume the HLOS left it running, in which
+ * case its register accesses land on an unclocked block, and an unclocked
+ * register access is exactly the kind of fault that gets a trustlet killed --
+ * which is what every command that reaches the sensor does here.
+ *
+ *   echo on  > /sys/kernel/debug/probe_ta/clocks
+ *   echo off > /sys/kernel/debug/probe_ta/clocks
+ *
+ * Only GCC registers are touched, never the controller's own: reading those
+ * from here is what hung the CPU the first time round.
+ */
+#define GCC_QUPV3_WRAP1_CORE_2X_CLK	75
+#define GCC_QUPV3_WRAP1_CORE_CLK	76
+#define GCC_QUPV3_WRAP1_S0_CLK		77
+#define GCC_QUPV3_WRAP_1_M_AHB_CLK	95
+#define GCC_QUPV3_WRAP_1_S_AHB_CLK	96
+
+static const unsigned int probe_clocks_spi6[] = {
+	/* AHB (interface) clocks first: without them the QUP wrapper's SE
+	 * registers can't be reached -- not by HLOS and not by QSEE when the TA
+	 * opens the secure SPI. These were missing before. S0 (the SE) stays LAST
+	 * so ARRAY_SIZE-1 still points to it for the rate logic. */
+	GCC_QUPV3_WRAP_1_M_AHB_CLK,
+	GCC_QUPV3_WRAP_1_S_AHB_CLK,
+	GCC_QUPV3_WRAP1_CORE_2X_CLK,
+	GCC_QUPV3_WRAP1_CORE_CLK,
+	GCC_QUPV3_WRAP1_S0_CLK,
+};
+
+static struct clk *probe_clocks[ARRAY_SIZE(probe_clocks_spi6)];
+static bool probe_clocks_set_done;
+static unsigned long probe_clocks_rate = 19200000;
+
+static struct clk *probe_grab_clock(unsigned int indice)
+{
+	struct of_phandle_args spec = {};
+	struct device_node *gcc;
+	struct clk *clk;
+
+	gcc = of_find_compatible_node(NULL, NULL, "qcom,sm7150-gcc");
+	if (!gcc)
+		return ERR_PTR(-ENODEV);
+
+	spec.np = gcc;
+	spec.args_count = 1;
+	spec.args[0] = indice;
+
+	clk = of_clk_get_from_provider(&spec);
+	of_node_put(gcc);
+
+	return clk;
+}
+
+static void probe_clocks_release(void)
+{
+	int i;
+
+	if (!probe_clocks_set_done)
+		return;
+
+	for (i = ARRAY_SIZE(probe_clocks_spi6) - 1; i >= 0; i--) {
+		if (IS_ERR_OR_NULL(probe_clocks[i]))
+			continue;
+		clk_disable_unprepare(probe_clocks[i]);
+		clk_put(probe_clocks[i]);
+		probe_clocks[i] = NULL;
+	}
+
+	probe_clocks_set_done = false;
+	pr_info("probe_ta: spi6 clocks off\n");
+}
+
+static int probe_clocks_set(void)
+{
+	int i, ret;
+
+	if (probe_clocks_set_done)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(probe_clocks_spi6); i++) {
+		probe_clocks[i] = probe_grab_clock(probe_clocks_spi6[i]);
+		if (IS_ERR(probe_clocks[i])) {
+			ret = PTR_ERR(probe_clocks[i]);
+			pr_err("probe_ta: no clock %u: %d\n",
+			       probe_clocks_spi6[i], ret);
+			probe_clocks[i] = NULL;
+			goto atras;
+		}
+
+		ret = clk_prepare_enable(probe_clocks[i]);
+		if (ret) {
+			pr_err("probe_ta: clock %u does not enable: %d\n",
+			       probe_clocks_spi6[i], ret);
+			clk_put(probe_clocks[i]);
+			probe_clocks[i] = NULL;
+			goto atras;
+		}
+	}
+
+	/* The SE clock (WRAP1_S0) sets the SPI bit rate. QSEE drives the SE from
+	 * the secure world but cannot set clock rates -- that is HLOS's job. With
+	 * no rate the bus does not clock and the sensor never answers. Goodix runs
+	 * the SE around 19.2 MHz. Settable live via `echo "rate <hz>" > clocks`. */
+	if (probe_clocks[ARRAY_SIZE(probe_clocks_spi6) - 1]) {
+		struct clk *se = probe_clocks[ARRAY_SIZE(probe_clocks_spi6) - 1];
+		ret = clk_set_rate(se, probe_clocks_rate);
+		pr_info("probe_ta: SE clock rate asked %lu -> real %lu (ret %d)\n",
+			probe_clocks_rate, clk_get_rate(se), ret);
+	}
+
+	probe_clocks_set_done = true;
+	pr_info("probe_ta: clocks de spi6 powered_on\n");
+	return 0;
+
+atras:
+	probe_clocks_set_done = true;	/* so that release() cleans up what was done */
+	probe_clocks_release();
+	return ret;
+}
+
+/*
+ * Prepare the sensor's hardware the way Goodix's kernel driver does before the
+ * trusted app is expected to reach it. The driver (gf3208/gf_spi.c) is a
+ * platform driver in the TEE model: it does no SPI itself, it only powers,
+ * clocks, resets and arms the IRQ, and the secure world does the transfers.
+ * Its power hook is empty on this board, so the sequence is:
+ *
+ *   1. turn on spi6's clocks
+ *   2. pulse FP_RESET_N (out 0, 3 ms, out 1), the driver's gf_hw_reset
+ *   3. arm the IRQ on FP_INT_N
+ *
+ * This is a probe, not the port: if the trustlet stops answering -1 once the
+ * hardware is in this state, the driver is worth porting for real. The reset
+ * and IRQ lines are the ones already measured -- 90 and 89.
+ */
+/*
+ * The reset and interrupt lines by chip offset, not global number. The tlmm's
+ * global base is assigned dynamically, so gpio_request(90) reaches the wrong
+ * pin -- the descriptor API takes the chip and the offset (90, 89) straight.
+ */
+#define GOODIX_TLMM_LABEL	"3500000.pinctrl"
+#define GOODIX_RESET_OFFSET	90
+#define GOODIX_IRQ_OFFSET	89
+
+static struct gpio_desc *probe_goodix_rst;
+static struct gpio_desc *probe_goodix_int;
+static int probe_goodix_irq;
+
+static irqreturn_t probe_goodix_isr(int irq, void *dev)
+{
+	pr_info("probe_ta: goodix IRQ (FP_INT_N)\n");
+	return IRQ_HANDLED;
+}
+
+static struct gpio_desc *probe_grab_line(unsigned int offset, const char *consumer)
+{
+	struct gpio_device *gdev;
+	struct gpio_desc *desc;
+
+	gdev = gpio_device_find_by_label(GOODIX_TLMM_LABEL);
+	if (!gdev)
+		return ERR_PTR(-ENODEV);
+
+	desc = gpio_device_get_desc(gdev, offset);
+	gpio_device_put(gdev);
+	return desc;
+}
+
+static int probe_prepare_goodix(void)
+{
+	int ret;
+
+	ret = probe_clocks_set();
+	if (ret)
+		return ret;
+
+	if (!probe_goodix_rst) {
+		probe_goodix_rst = probe_grab_line(GOODIX_RESET_OFFSET, "reset");
+		if (IS_ERR(probe_goodix_rst)) {
+			ret = PTR_ERR(probe_goodix_rst);
+			probe_goodix_rst = NULL;
+			pr_err("probe_ta: no reset line: %d\n", ret);
+			return ret;
+		}
+	}
+	if (!probe_goodix_int) {
+		probe_goodix_int = probe_grab_line(GOODIX_IRQ_OFFSET, "irq");
+		if (IS_ERR(probe_goodix_int)) {
+			ret = PTR_ERR(probe_goodix_int);
+			probe_goodix_int = NULL;
+			pr_err("probe_ta: no irq line: %d\n", ret);
+			return ret;
+		}
+	}
+
+	/* gf_hw_reset: out 0, 3 ms, out 1, then settle. */
+	gpiod_direction_output(probe_goodix_rst, 0);
+	mdelay(3);
+	gpiod_set_value(probe_goodix_rst, 1);
+	mdelay(10);
+
+	gpiod_direction_input(probe_goodix_int);
+	if (!probe_goodix_irq) {
+		probe_goodix_irq = gpiod_to_irq(probe_goodix_int);
+		if (probe_goodix_irq < 0) {
+			ret = probe_goodix_irq;
+			probe_goodix_irq = 0;
+			pr_err("probe_ta: gpiod_to_irq: %d\n", ret);
+			return ret;
+		}
+		ret = request_irq(probe_goodix_irq, probe_goodix_isr,
+				  IRQF_TRIGGER_RISING, "goodix_fp", NULL);
+		if (ret) {
+			pr_err("probe_ta: request_irq: %d\n", ret);
+			probe_goodix_irq = 0;
+			return ret;
+		}
+	}
+
+	pr_info("probe_ta: goodix hardware ready (clk+reset+irq)\n");
+	return 0;
+}
+
+static ssize_t probe_prepare_write(struct file *f, const char __user *ubuf,
+				    size_t len, loff_t *off)
+{
+	int ret = probe_prepare_goodix();
+
+	return ret ? ret : len;
+}
+
+static const struct file_operations probe_prepare_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_prepare_write,
+	.llseek = noop_llseek,
+};
+
+static ssize_t probe_clocks_write(struct file *f, const char __user *ubuf,
+				   size_t len, loff_t *off)
+{
+	char buf[32];
+	unsigned long hz;
+	int ret;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (sysfs_streq(buf, "on")) {
+		ret = probe_clocks_set();
+		if (ret)
+			return ret;
+	} else if (sysfs_streq(buf, "off")) {
+		probe_clocks_release();
+	} else if (sscanf(buf, "rate %lu", &hz) == 1) {
+		probe_clocks_rate = hz;
+		if (probe_clocks_set_done &&
+		    probe_clocks[ARRAY_SIZE(probe_clocks_spi6) - 1]) {
+			struct clk *se =
+			    probe_clocks[ARRAY_SIZE(probe_clocks_spi6) - 1];
+			ret = clk_set_rate(se, hz);
+			pr_info("probe_ta: SE rate asked %lu -> real %lu (ret %d)\n",
+				hz, clk_get_rate(se), ret);
+		}
+	} else {
+		return -EINVAL;
+	}
+
+	return len;
+}
+
+/*
+ * Goodix's dialect: write "<app_id> <arg0> <cmd>" and the request is built the
+ * way libgf_ca.so builds it, with the shared buffer's physical address in word
+ * zero -- which is the part userspace cannot supply.
+ *
+ *   echo "3 2 110" > /sys/kernel/debug/probe_ta/goodix    # ask for the challenge
+ *
+ * Commands 0x6e and 0x6f are the authentication handshake, and the vendor
+ * client treats them apart from every other command precisely because they run
+ * before there is a session to encrypt under.
+ */
+static ssize_t probe_goodix_write(struct file *f, const char __user *ubuf,
+				  size_t len, loff_t *off)
+{
+	unsigned int app_id, arg0, cmd, length = 0;
+	u8 answer[128] = {};
+	char buf[64];
+	int ret, i, n;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	/* "<app> <arg0> <cmd> [len]" -- len is the size of the requested data. */
+	n = sscanf(buf, "%u %u %u %u", &app_id, &arg0, &cmd, &length);
+	if (n < 3)
+		return -EINVAL;
+
+	ret = qcom_scm_qseecom_app_goodix(app_id, arg0, cmd, NULL, length,
+					  answer, sizeof(answer));
+	if (ret < 0) {
+		pr_err("probe_ta: goodix arg0=%u cmd=%#x -> error %d\n",
+		       arg0, cmd, ret);
+		return ret;
+	}
+
+	pr_info("probe_ta: goodix arg0=%u cmd=%#x -> status %d (command buffer)\n",
+		arg0, cmd, ret);
+	for (i = 0; i < sizeof(answer); i += 16) {
+		if (memchr_inv(answer + i, 0, 16))
+			pr_info("probe_ta:   +%02d: %*ph\n", i, 16,
+				answer + i);
+	}
+
+	return len;
+}
+
+/*
+ * Goodix, every field yours: write "<app_id> <hex>" -- up to 128 bytes of the
+ * request -- and the kernel sends it verbatim save for word zero, which it
+ * fills with the physical address. Spaces in the hex are ignored, so a request
+ * can be laid out field by field.
+ *
+ *   # token=1 at +8, arg0=2 at +0xc, cmd=0x6e at +0x20, len=0x10 at +0x24
+ *   echo "3 00000000 0000 0000 01000000 02000000 ..." > .../goodixraw
+ */
+static ssize_t probe_goodixraw_write(struct file *f, const char __user *ubuf,
+				     size_t len, loff_t *off)
+{
+	u8 req[0x80] = {}, out[0x80] = {};
+	char *buf, *hex;
+	unsigned int app_id;
+	s32 status = 0;
+	int ret, n = 0, i;
+
+	if (len >= 1024)
+		return -EINVAL;
+
+	buf = memdup_user_nul(ubuf, len);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	if (sscanf(buf, "%u", &app_id) != 1) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	hex = strchr(buf, ' ');
+	if (!hex) { ret = -EINVAL; goto out; }
+
+	while (*hex && n < (int)sizeof(req)) {
+		int hi, lo;
+		while (*hex == ' ' || *hex == '\n')
+			hex++;
+		if (!hex[0] || !hex[1])
+			break;
+		hi = hex_to_bin(hex[0]);
+		lo = hex_to_bin(hex[1]);
+		if (hi < 0 || lo < 0) { ret = -EINVAL; goto out; }
+		req[n++] = (hi << 4) | lo;
+		hex += 2;
+	}
+
+	ret = qcom_scm_qseecom_app_goodix_raw(app_id, req, out, &status);
+	if (ret) {
+		pr_err("probe_ta: goodixraw -> error %d\n", ret);
+		goto out;
+	}
+
+	pr_info("probe_ta: goodixraw(%d bytes) -> status %d (%#x)\n",
+		n, status, status);
+	for (i = 0; i < (int)sizeof(out); i += 16) {
+		if (memchr_inv(out + i, 0, 16))
+			pr_info("probe_ta:   +%02d: %*ph\n", i, 16, out + i);
+	}
+
+	ret = len;
+out:
+	kfree(buf);
+	return ret;
+}
+
+/*
+ * Access to physical registers THROUGH TrustZone, with qcom_scm_io_readl/writel.
+ * The sensor Serial Engine (0xa80000) is walled off by the XPU: reading it
+ * directly from Linux hangs the CPU. But the TZ DOES have permission over it (the
+ * QUPAC policy assigns it to the TEE), so maybe it can read/write it for
+ * us without hanging. This mode tests that.
+ *
+ *   echo "r a80068" > /sys/kernel/debug/probe_ta/scmio   # read the proto register
+ *   echo "w a80068 1" > /sys/kernel/debug/probe_ta/scmio # write_it
+ */
+static ssize_t probe_scmio_write(struct file *f, const char __user *ubuf,
+				 size_t len, loff_t *off)
+{
+	char buf[64], op;
+	unsigned long long addr;
+	unsigned int val = 0;
+	int ret, n;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	n = sscanf(buf, " %c %llx %x", &op, &addr, &val);
+	if (n < 2)
+		return -EINVAL;
+
+	if (op == 'r') {
+		ret = qcom_scm_io_readl((phys_addr_t)addr, &val);
+		if (ret)
+			pr_err("probe_ta: scm_io_readl(%#llx) -> error %d\n", addr, ret);
+		else
+			pr_info("probe_ta: scm_io_readl(%#llx) = %#010x\n", addr, val);
+	} else if (op == 'w') {
+		ret = qcom_scm_io_writel((phys_addr_t)addr, val);
+		pr_info("probe_ta: scm_io_writel(%#llx, %#x) -> %d\n", addr, val, ret);
+	} else {
+		return -EINVAL;
+	}
+
+	return len;
+}
+
+static const struct file_operations probe_scmio_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_scmio_write,
+	.llseek = noop_llseek,
+};
+
+static const struct file_operations probe_goodixraw_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_goodixraw_write,
+	.llseek = noop_llseek,
+};
+
+/*
+ * Modified command with data buffer (for DETECT/image). Format:
+ *   echo "<app_id> <cmd_buf_offset> <cmd_hex 128B> | <data_hex>" > goodixmod
+ * Stamps the physical address of the data buffer into cmd[cmd_buf_offset] (=word0), as
+ * the QSEECom ifd does. Dumps cmd (c+NN) and data (d+NNNN) back.
+ */
+static ssize_t probe_goodixmod_write(struct file *f, const char __user *ubuf,
+				     size_t len, loff_t *off)
+{
+	u8 cmd[0x80] = {}, cmd_out[0x80] = {};
+	u8 *data = NULL;
+	char *buf, *hex, *sep;
+	unsigned int app_id, cbo;
+	s32 status = 0;
+	size_t datalen = 0, dcap = 0x2000;
+	int ret, n = 0, i;
+
+	if (len >= 0x6000)
+		return -EINVAL;
+
+	buf = memdup_user_nul(ubuf, len);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	if (sscanf(buf, "%u %u", &app_id, &cbo) != 2) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	sep = strchr(buf, '|');
+	if (!sep) { ret = -EINVAL; goto out; }
+
+	hex = strchr(buf, ' ');
+	hex = hex ? strchr(hex + 1, ' ') : NULL;	/* skip app_id and offset */
+	if (!hex) { ret = -EINVAL; goto out; }
+	while (hex < sep && n < (int)sizeof(cmd)) {
+		int hi, lo;
+		while (*hex == ' ' || *hex == '\n')
+			hex++;
+		if (hex >= sep || !hex[0] || !hex[1])
+			break;
+		hi = hex_to_bin(hex[0]);
+		lo = hex_to_bin(hex[1]);
+		if (hi < 0 || lo < 0)
+			break;
+		cmd[n++] = (hi << 4) | lo;
+		hex += 2;
+	}
+
+	data = kzalloc(dcap, GFP_KERNEL);
+	if (!data) { ret = -ENOMEM; goto out; }
+	hex = sep + 1;
+	while (*hex && datalen < dcap) {
+		int hi, lo;
+		while (*hex == ' ' || *hex == '\n')
+			hex++;
+		if (!hex[0] || !hex[1])
+			break;
+		hi = hex_to_bin(hex[0]);
+		lo = hex_to_bin(hex[1]);
+		if (hi < 0 || lo < 0)
+			break;
+		data[datalen++] = (hi << 4) | lo;
+		hex += 2;
+	}
+
+	ret = qcom_scm_qseecom_app_goodix_mod(app_id, cmd, cmd_out,
+					      data, datalen, cbo, &status);
+	if (ret) {
+		pr_err("probe_ta: goodixmod -> error %d\n", ret);
+		goto out;
+	}
+
+	pr_info("probe_ta: goodixmod(cmd %d, data %zu) -> status %d (%#x)\n",
+		n, datalen, status, status);
+	for (i = 0; i < (int)sizeof(cmd_out); i += 16)
+		if (memchr_inv(cmd_out + i, 0, 16))
+			pr_info("probe_ta:   c+%02d: %*ph\n", i, 16, cmd_out + i);
+	for (i = 0; i < (int)datalen; i += 16)
+		if (memchr_inv(data + i, 0, 16))
+			pr_info("probe_ta:   d+%04d: %*ph\n", i, 16, data + i);
+
+	ret = len;
+out:
+	kfree(data);
+	kfree(buf);
+	return ret;
+}
+
+static const struct file_operations probe_goodixmod_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_goodixmod_write,
+	.llseek = noop_llseek,
+};
+
+/*
+ * Dump of a physical memory region readable by the HLOS (ioremap). To
+ * read the TZ_DIAG log from QSEE (~0x146aa000 in IMEM), which is where the secure
+ * world writes its messages -- including those from the sensor SPI.
+ *   echo "146aa000 2000" > /sys/kernel/debug/probe_ta/readmem
+ * NOTE: only for non-secure readable regions; a walled-off region would hang.
+ */
+static ssize_t probe_readmem_write(struct file *f, const char __user *ubuf,
+				   size_t len, loff_t *off)
+{
+	char buf[64];
+	unsigned long long addr;
+	unsigned int n = 0x800;
+	void __iomem *m;
+	int i;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (sscanf(buf, "%llx %u", &addr, &n) < 1)
+		return -EINVAL;
+	if (n > 0x4000)
+		n = 0x4000;
+
+	m = ioremap((phys_addr_t)addr, n);
+	if (!m) {
+		pr_err("probe_ta: readmem ioremap %#llx failure\n", addr);
+		return -ENOMEM;
+	}
+	pr_info("probe_ta: readmem %#llx (%u bytes):\n", addr, n);
+	for (i = 0; i < (int)n; i += 32) {
+		u8 tmp[32];
+		memcpy_fromio(tmp, m + i, 32);
+		if (memchr_inv(tmp, 0, 32))
+			pr_info("probe_ta:   +%04x: %*ph\n", i, 32, tmp);
+	}
+	iounmap(m);
+	return len;
+}
+
+static const struct file_operations probe_readmem_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_readmem_write,
+	.llseek = noop_llseek,
+};
+
+static const struct file_operations probe_goodix_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_goodix_write,
+	.llseek = noop_llseek,
+};
+
+static const struct file_operations probe_clocks_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_clocks_write,
+	.llseek = noop_llseek,
+};
+
+/*
+ * Keymaster answers with a certificate, which is about a kilobyte -- far more
+ * than the 64 bytes the fingerprint TA replies with. Dumps skip rows that are
+ * all zero, so asking for the big buffer costs nothing when the reply is small.
+ */
+#define PROBE_RSP_MAX	1024
+
+/*
+ * Pairing: write "<keymaster_app_id> <fingerprint_app_id>" and the two steps
+ * Android's HAL does at init happen here, in one go.
+ *
+ *   echo "1 3" > /sys/kernel/debug/probe_ta/pair
+ *
+ * Step one asks keymaster for the certificate with its command 0x205; step two
+ * hands the blob straight to the fingerprint app as FPC_SET_KEY_DATA.
+ *
+ * It is done inside the kernel on purpose. The blob is a device key, and the
+ * obvious shape -- read it in one debugfs call, write it back in another --
+ * would mean printing it to the kernel log and carrying it through userspace
+ * to get it back. There is no reason for it to leave this function.
+ */
+#define KM_CMD_GET_CERT		0x205
+#define FPC_GROUP_FPCDATA	0x3
+#define FPC_SET_KEY_DATA	0x5
+
+static ssize_t probe_pair_write(struct file *f, const char __user *ubuf,
+				     size_t len, loff_t *off)
+{
+	unsigned int km_id, fp_id;
+	u32 request[16] = {};
+	u32 state, offset, length;
+	char buf[64];
+	u8 *rsp;
+	int ret;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (sscanf(buf, "%u %u", &km_id, &fp_id) != 2)
+		return -EINVAL;
+
+	rsp = kzalloc(PROBE_RSP_MAX, GFP_KERNEL);
+	if (!rsp)
+		return -ENOMEM;
+
+	/* keymaster_cmd_t { cmd_id, ret_val, length } */
+	request[0] = KM_CMD_GET_CERT;
+	request[1] = 0x02;
+
+	ret = qcom_scm_qseecom_app_raw(km_id, request, sizeof(request),
+				       rsp, PROBE_RSP_MAX);
+	if (ret) {
+		pr_err("probe_ta: keymaster (app %u) -> error %d\n", km_id, ret);
+		goto out;
+	}
+
+	/* keymaster_return_t { status, offset, length } */
+	state = get_unaligned_le32(rsp);
+	offset = get_unaligned_le32(rsp + 4);
+	length = get_unaligned_le32(rsp + 8);
+
+	if (state) {
+		pr_err("probe_ta: keymaster says no: %#x\n", state);
+		ret = -EIO;
+		goto out;
+	}
+
+	if (!length || offset > PROBE_RSP_MAX || length > PROBE_RSP_MAX - offset) {
+		pr_err("probe_ta: keymaster answers out of range: offset=%u len=%u\n",
+		       offset, length);
+		ret = -EIO;
+		goto out;
+	}
+
+	pr_info("probe_ta: keymaster hands over %u bytes of key\n", length);
+
+	ret = qcom_scm_qseecom_app_fpc_buf(fp_id, FPC_GROUP_FPCDATA,
+					   FPC_SET_KEY_DATA, rsp + offset,
+					   length, NULL, 0);
+	if (ret < 0) {
+		pr_err("probe_ta: SET_KEY_DATA -> error %d\n", ret);
+		goto out;
+	}
+
+	pr_info("probe_ta: SET_KEY_DATA -> status %d (%#x)\n", ret, ret);
+	ret = len;
+out:
+	kfree_sensitive(rsp);
+	return ret;
+}
+
+static const struct file_operations probe_pair_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_pair_write,
+	.llseek = noop_llseek,
+};
+
+static const struct file_operations probe_search_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_search_write,
+	.llseek = noop_llseek,
+};
+
+/*
+ * Loading: write "<firmware-name> <mdt_len>" here and the image is fetched
+ * from /lib/firmware and handed to the TrustZone.
+ *
+ *   echo "fpctzapp.img 7260" > /sys/kernel/debug/probe_ta/load
+ *
+ * The image must be the QSEECom layout -- .mdt followed by every .bNN,
+ * concatenated, no padding -- which is NOT the same as an ELF rebuilt by
+ * segment offsets.
+ */
+static ssize_t probe_load_write(struct file *f, const char __user *ubuf,
+				  size_t len, loff_t *off)
+{
+	const struct firmware *fw;
+	char buf[128], name[96];
+	unsigned int mdt_len;
+	u32 app_id = 0;
+	int ret;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (sscanf(buf, "%95s %u", name, &mdt_len) != 2)
+		return -EINVAL;
+
+	ret = request_firmware(&fw, name, NULL);
+	if (ret) {
+		pr_err("probe_ta: cannot find %s in /lib/firmware: %d\n",
+		       name, ret);
+		return ret;
+	}
+
+	pr_info("probe_ta: loading %s, mdt_len=%u img_len=%zu\n",
+		name, mdt_len, fw->size);
+
+	ret = qcom_scm_qseecom_app_load(fw->data, mdt_len, fw->size, &app_id);
+	release_firmware(fw);
+
+	if (ret) {
+		pr_err("probe_ta: TrustZone says no: %d\n", ret);
+		return ret;
+	}
+
+	pr_info("probe_ta: LOADED, app_id=%u\n", app_id);
+
+	return len;
+}
+
+/*
+ * Talking to it: write "<app_id> <cmd>" and the TA gets a 64-byte request whose
+ * first word is <cmd>, with a 64-byte response right after it. That layout
+ * comes from disassembling fpc_tac_transfer in the vendor HAL:
+ *
+ *     mov w2, #0x40      request length
+ *     mov w4, #0x40      response length
+ *     str w9, [x8]       command id goes in the first word
+ *     add x19, x9, #0x40 response starts at request + 0x40
+ *     bl  QSEECom_send_modified_cmd
+ *
+ * The reply is dumped whole because we do not know the TA's structures yet;
+ * printing it raw is the point.
+ */
+#define PROBE_REQ_LEN	64
+#define PROBE_RSP_LEN	64
+
+static ssize_t probe_talk_write(struct file *f, const char __user *ubuf,
+				  size_t len, loff_t *off)
+{
+	unsigned int app_id, cmd;
+	u32 rsp[PROBE_RSP_LEN / 4];
+	char buf[64];
+	int ret, i;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (sscanf(buf, "%u %u", &app_id, &cmd) != 2)
+		return -EINVAL;
+
+	ret = qcom_scm_qseecom_app_talk(app_id, cmd, rsp, sizeof(rsp));
+	if (ret) {
+		pr_err("probe_ta: app %u cmd %u -> error %d\n", app_id, cmd, ret);
+		return ret;
+	}
+
+	pr_info("probe_ta: app %u cmd %u -> ANSWERS\n", app_id, cmd);
+	for (i = 0; i < PROBE_RSP_LEN / 4; i += 4)
+		pr_info("probe_ta:   +%02d: %08x %08x %08x %08x\n",
+			i * 4, rsp[i], rsp[i + 1], rsp[i + 2], rsp[i + 3]);
+
+	return len;
+}
+
+/*
+ * Free-form requests: write "<app_id> <hex>" and those exact bytes are sent.
+ *
+ *   echo "3 0c00000000000000 04000000 01000000" > .../raw
+ *
+ * Spaces are ignored, so a request can be written grouped by field. The reply
+ * is dumped whole; without knowing the TA's structures, seeing it raw is the
+ * whole point.
+ */
+#define PROBE_MAX_REQ	512
+
+static ssize_t probe_raw_write(struct file *f, const char __user *ubuf,
+				 size_t len, loff_t *off)
+{
+	u8 req[PROBE_MAX_REQ], *rsp;
+	char *buf, *p, *hex;
+	unsigned int app_id;
+	int ret, n = 0, i;
+
+	if (len >= 2048)
+		return -EINVAL;
+
+	buf = memdup_user_nul(ubuf, len);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	rsp = kzalloc(PROBE_RSP_MAX, GFP_KERNEL);
+	if (!rsp) {
+		kfree(buf);
+		return -ENOMEM;
+	}
+
+	p = strim(buf);
+	if (sscanf(p, "%u", &app_id) != 1) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	hex = strchr(p, ' ');
+	if (!hex) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/* Read hex nibble pairs, skipping any spacing. */
+	while (*hex && n < PROBE_MAX_REQ) {
+		int hi, lo;
+
+		while (*hex == ' ' || *hex == '\n')
+			hex++;
+		if (!hex[0] || !hex[1])
+			break;
+		hi = hex_to_bin(hex[0]);
+		lo = hex_to_bin(hex[1]);
+		if (hi < 0 || lo < 0) {
+			ret = -EINVAL;
+			goto out;
+		}
+		req[n++] = (hi << 4) | lo;
+		hex += 2;
+	}
+
+	if (!n) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = qcom_scm_qseecom_app_raw(app_id, req, n, rsp, PROBE_RSP_MAX);
+	if (ret) {
+		pr_err("probe_ta: app %u raw(%d) -> error %d\n", app_id, n, ret);
+		goto out;
+	}
+
+	pr_info("probe_ta: app %u raw(%d bytes) -> ANSWERS\n", app_id, n);
+	for (i = 0; i < PROBE_RSP_MAX; i += 16) {
+		/* Silence the empty tail: a kilobyte of zeros hides the reply. */
+		if (memchr_inv(rsp + i, 0, 16))
+			pr_info("probe_ta:   +%04d: %*ph\n", i, 16, rsp + i);
+	}
+
+	ret = len;
+out:
+	kfree(rsp);
+	kfree(buf);
+	return ret;
+}
+
+/*
+ * FPC-style: write "<app_id> <group> <cmd>" and the two-buffer protocol is
+ * used, which is the one its trusted app actually speaks.
+ *
+ *   echo "3 1 3" > /sys/kernel/debug/probe_ta/fpc     # grupo 1, command 3
+ *
+ * Groups, from Sony's open HAL: 1 normal, 2 db, 3 fpcdata, 6 debug, 7 qc,
+ * 8 navigation, 9 info, 0xa sensor, 0xb template. The command ids differ
+ * between TA variants, so they have to be found by trying.
+ */
+static ssize_t probe_fpc_write(struct file *f, const char __user *ubuf,
+			       size_t len, loff_t *off)
+{
+	unsigned int app_id, group, cmd;
+	u32 out[8];
+	char buf[64];
+	int ret;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (sscanf(buf, "%u %i %i", &app_id, &group, &cmd) != 3)
+		return -EINVAL;
+
+	ret = qcom_scm_qseecom_app_fpc(app_id, group, cmd, NULL, 0,
+				       out, sizeof(out));
+	if (ret < 0) {
+		pr_err("probe_ta: fpc g=%#x c=%#x -> error %d\n",
+		       group, cmd, ret);
+		return ret;
+	}
+
+	pr_info("probe_ta: fpc g=%#x c=%#x -> status %d | ret_val=%#x  %08x %08x %08x\n",
+		group, cmd, ret, out[2], out[3], out[4], out[5]);
+
+	return len;
+}
+
+static const struct file_operations probe_fpc_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_fpc_write,
+	.llseek = noop_llseek,
+};
+
+static const struct file_operations probe_raw_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_raw_write,
+	.llseek = noop_llseek,
+};
+
+static const struct file_operations probe_talk_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_talk_write,
+	.llseek = noop_llseek,
+};
+
+static const struct file_operations probe_load_fops = {
+	.owner = THIS_MODULE,
+	.write = probe_load_write,
+	.llseek = noop_llseek,
+};
+
+static int __init probe_ta_init(void)
+{
+	struct dentry *dir = debugfs_create_dir("probe_ta", NULL);
+
+	debugfs_create_file("state", 0400, dir, NULL, &probe_ta_fops);
+	debugfs_create_file("search", 0200, dir, NULL, &probe_search_fops);
+	debugfs_create_file("pair", 0200, dir, NULL,
+			    &probe_pair_fops);
+	debugfs_create_file("clocks", 0200, dir, NULL, &probe_clocks_fops);
+	debugfs_create_file("prepare", 0200, dir, NULL,
+			    &probe_prepare_fops);
+	debugfs_create_file("goodix", 0200, dir, NULL, &probe_goodix_fops);
+	debugfs_create_file("goodixraw", 0200, dir, NULL,
+			    &probe_goodixraw_fops);
+	debugfs_create_file("goodixmod", 0200, dir, NULL,
+			    &probe_goodixmod_fops);
+	debugfs_create_file("readmem", 0200, dir, NULL,
