C-PHY: the lane mask carries no clock bit, and the trios do not go two by two

Patch 0088 left the CSID asking for C-PHY -measured: rx_cfg0 = 0x01002102, with
bit 24 set- and the three-phase table applied. And still zero packets.

What was missing was in the mask computation, which is still the D-PHY one.
Measured on the rear camera with 0088 in:

    ctrl5 = 0x95    lane_mask = 0x87

Both numbers are D-PHY ones:

    0x95 = BIT(7) of the CLOCK lane | BIT(pos * 2) of each lane
    0x87 = BIT(7) of the CLOCK lane | BIT(pos) of each lane

But in C-PHY THERE IS NO CLOCK LANE: the trios are self-synchronised, the clock
travels embedded in the three-phase coding itself. And the *2 step is the one
for the D-PHY pairs, not the one for trios.

Qualcomm's driver does it like this, without removing a clock and without
shifting:

    adj_lane_mask = cam_cmd_csiphy_info->lane_mask & LANE_MASK_3PH;

For three trios the right value is 0x07, not 0x95 nor 0x87.

The flag travels down to csiphy_lanes_cfg so that csiphy_get_lane_mask -which
only receives that structure- can decide without changing its signature nor the
one of the operation that exposes it.
--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -1437,7 +1437,14 @@
 	u8 lane_mask;
 	int i;
 
-	lane_mask = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
+	/*
+	 * El bit del carril de reloj solo existe en D-PHY. En C-PHY la mascara
+	 * son los trios y nada mas, que es lo que hace el driver de Qualcomm:
+	 *     adj_lane_mask = lane_mask & LANE_MASK_3PH;
+	 * sin quitar reloj ni desplazar.
+	 */
+	lane_mask = lane_cfg->cphy ? 0 :
+		    CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
 
 	for (i = 0; i < lane_cfg->num_data; i++)
 		lane_mask |= 1 << lane_cfg->data[i].pos;
@@ -1497,9 +1504,24 @@
 
 	settle_cnt = csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);
 
-	val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
-	for (i = 0; i < c->num_data; i++)
-		val |= BIT(c->data[i].pos * 2);
+	/*
+	 * C-PHY no tiene carril de reloj: los trios van autosincronizados. Asi
+	 * que ni se pone CLK_ENABLE ni se cuenta de dos en dos -el paso *2 es
+	 * el de las parejas de D-PHY-, sino un bit por trio.
+	 *
+	 * Medido antes de esto en la trasera: ctrl5 = 0x95, o sea el bit 7 del
+	 * reloj mas las posiciones dobladas, con el sensor emitiendo en tres
+	 * fases. Lo correcto para tres trios es 0x07.
+	 */
+	if (cfg->cphy) {
+		val = 0;
+		for (i = 0; i < c->num_data; i++)
+			val |= BIT(c->data[i].pos);
+	} else {
+		val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
+		for (i = 0; i < c->num_data; i++)
+			val |= BIT(c->data[i].pos * 2);
+	}
 
 	writel_relaxed(val, csiphy->base +
 		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 5));
--- a/drivers/media/platform/qcom/camss/camss-csiphy.h
+++ b/drivers/media/platform/qcom/camss/camss-csiphy.h
@@ -33,6 +33,8 @@
  * @clk:      clock lane configuration (only for D-PHY)
  */
 struct csiphy_lanes_cfg {
+	/* enlace de tres fases: los trios no llevan carril de reloj */
+	u8 cphy;
 	int num_data;
 	struct csiphy_lane *data;
 	struct csiphy_lane clk;
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -4781,6 +4781,7 @@
 
 	csd->interface.csiphy_id = vep.base.port;
 	csd->interface.cphy = (vep.bus_type == V4L2_MBUS_CSI2_CPHY);
+	csd->interface.csi2.lane_cfg.cphy = csd->interface.cphy;
 
 	mipi_csi2 = &vep.bus.mipi_csi2;
 	lncfg->clk.pos = mipi_csi2->clock_lane;
