+ *   2 = D-PHY   (negative control: still nothing must arrive)
+ *   3 = C-PHY
+ */
+static int phy_signal;
+module_param(phy_signal, int, 0644);
+MODULE_PARM_DESC(phy_signal,
+	"Link declared to the sensor in 0x0111. 2 = D-PHY, 3 = C-PHY, 0 = table.");
