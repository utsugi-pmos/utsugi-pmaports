 	{ 0x3C7E, 0x02 },
 	{ 0x3C7F, 0x0A },
-	{ 0x0111, 0x02 },
+	/*
+	 * 0x0111 is CSI_SIGNALING_MODE from the CCS spec, and it carries a VALUE, not a
+	 * flag: 2 = D-PHY, 3 = C-PHY. It is defined in this very kernel, in
+	 * drivers/media/i2c/ccs/ccs-regs.h.
+	 *
+	 * The 0x02 came from the MediaTek port, which was two-lane D-PHY. Here
+	 * the board has three C-PHY trios, so with 0x02 the sensor was being asked for
+	 * THREE-lane D-PHY, which is exactly the one thing its capability
