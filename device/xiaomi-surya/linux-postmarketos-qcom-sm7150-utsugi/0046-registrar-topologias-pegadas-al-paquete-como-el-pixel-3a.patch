-static int q6core_register_topologies(struct device *dev, u32 size, const void *data)
+/*
+ * Metodo de entrega del bloque de topologias:
+ *
+ *   0 = PEGADO AL PAQUETE APR (in-band).  [por defecto]
+ *   1 = por memoria compartida.           PELIGRO: tumba el movil.
+ *
+ *   /sys/module/q6core/parameters/registro_por_memoria
+ *
+ * POR QUE EL DEFECTO CAMBIA A IN-BAND
+ * -----------------------------------
+ * El parche del Pixel 3a (sdm670-mainline/linux-patches,
+ * ASoC-qdsp6-q6core-add-support-for-registering-topologies.patch), que es el
+ * unico sitio donde esto funciona de verdad en mainline, **manda el bloque
+ * pegado al paquete y no mapea memoria en ningun momento**. Su estructura
+ * lleva payload_addr_lsw/msw y mem_map_handle, pero los deja a CERO a
+ * proposito: reserva el paquete con kzalloc y solo rellena payload_size.
+ *
+ * Aqui se hizo al reves. El primer intento fue in-band, el DSP contesto
+ * ADSP_EBADPARAM, y se dedujo que hacia falta memoria compartida. Esa
+ * deduccion llevo a un callejon sin salida: mapear la region **reinicia el
+ * movil entero**.
+ *
+ * El EBADPARAM tenia otra explicacion mucho mas simple. Al DSP se le estaba
+ * dando el fichero de calibracion del **Pixel 4a**: el que el kernel leia
+ * (md5 485b0439...) es el Global_cal.acdb de sunfish, y el que el proyecto
+ * empaquetaba "de surya" tambien es una copia byte a byte del mismo. El de
+ * verdad de este movil (md5 72b7f3fd...) solo existia dentro de la particion
+ * de fabrica, y se saco el 2026-08-11 (ver docs/REFERENCIA-STOCK.md).
+ *
+ * O sea: se le pedia al DSP que registrase las topologias de otro telefono.
+ * "Parametro incorrecto" es exactamente lo que toca contestar a eso.
+ */
+static unsigned int registro_por_memoria;
+module_param(registro_por_memoria, uint, 0644);
+MODULE_PARM_DESC(registro_por_memoria,
+		 "0 = pegado al paquete (como el Pixel 3a), 1 = memoria compartida (PELIGRO: reinicia el movil)");
+
+/* Como lo hace el parche del Pixel 3a: el bloque va dentro del paquete. */
+static int q6core_register_topologies_inband(struct device *dev, u32 size,
+					     const void *data)
+{
+	struct q6core *core = dev_get_drvdata(dev);
+	struct avcs_cmd_register_topologies *cmd;
+	struct apr_pkt *pkt;
+	void *p, *dest;
+	int pkt_size, rc;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd) + size;
+
+	p = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+	dest = p + APR_HDR_SIZE + sizeof(*cmd);
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.opcode = AVCS_CMD_REGISTER_TOPOLOGIES;
+
+	/*
+	 * kzalloc deja payload_addr_lsw, payload_addr_msw y mem_map_handle a
+	 * cero, y ESO es lo que le dice al DSP que los datos vienen dentro del
+	 * paquete. No es un olvido, es el mecanismo.
+	 */
+	cmd->payload_size = size;
+	memcpy(dest, data, size);
+
+	dev_info(dev, "registro in-band: %u bytes de topologias, paquete de %d\n",
+		 size, pkt_size);
+
+	core->resp_received = false;
+	rc = apr_send_pkt(core->adev, pkt);
+	kfree(pkt);
+	if (rc >= 0)
+		q6core_wait_resp(core);
+
+	return rc < 0 ? rc : 0;
+}
+
+static int q6core_register_topologies_shmem(struct device *dev, u32 size,
+					    const void *data)
 {
 	struct q6core *core = dev_get_drvdata(dev);
 	struct avcs_cmd_register_topologies *cmd;
@@ -487,6 +570,15 @@
 	return rc < 0 ? rc : 0;
 }
 
+static int q6core_register_topologies(struct device *dev, u32 size,
+				      const void *data)
+{
+	if (registro_por_memoria)
+		return q6core_register_topologies_shmem(dev, size, data);
+
+	return q6core_register_topologies_inband(dev, size, data);
+}
