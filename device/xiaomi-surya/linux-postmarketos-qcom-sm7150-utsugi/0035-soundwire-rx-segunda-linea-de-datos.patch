--- a/sound/soc/codecs/lpass-rx-macro.c	2026-05-13 02:27:25.000000000 +0200
+++ b/sound/soc/codecs/lpass-rx-macro.c	2026-08-10 19:49:25.130884480 +0200
@@ -666,6 +666,7 @@
 	struct clk *dcodec;
 	struct clk *fsgen;
 	struct clk_hw hw;
+	bool swr_reset_done;
 };
 #define to_rx_macro(_hw) container_of(_hw, struct rx_macro, hw)
 
@@ -3679,9 +3680,32 @@
 
 	rx_macro_mclk_enable(rx, true);
 
+	/*
+	 * El bloque SoundWire necesita el pulso de reset alrededor de la
+	 * habilitacion de su reloj, no solo en el probe. En el probe llega
+	 * demasiado pronto: el maestro todavia no ha arrancado, y despues el
+	 * bus da errores de comando, "read underflow" y colisiones, con lo que
+	 * el codec no acepta la configuracion de sus puertos y la reproduccion
+	 * falla en snd_soc_link_prepare().
+	 *
+	 * Es exactamente el mismo fallo que tenia el macro TX y que se arreglo
+	 * en el parche 0021; alli tambien hubo que hacerlo UNA SOLA VEZ,
+	 * porque esta funcion corre en cada arranque de flujo y resetear
+	 * entonces tira al esclavo del bus a mitad de la preparacion.
+	 */
+	if (!rx->swr_reset_done)
+		regmap_update_bits(rx->regmap, CDC_RX_CLK_RST_CTRL_SWR_CONTROL,
+				   CDC_RX_SWR_RESET_MASK, CDC_RX_SWR_RESET);
+
 	regmap_update_bits(rx->regmap, CDC_RX_CLK_RST_CTRL_SWR_CONTROL,
 			   CDC_RX_SWR_CLK_EN_MASK, 1);
 
+	if (!rx->swr_reset_done) {
+		regmap_update_bits(rx->regmap, CDC_RX_CLK_RST_CTRL_SWR_CONTROL,
+				   CDC_RX_SWR_RESET_MASK, 0);
+		rx->swr_reset_done = true;
+	}
+
 	return 0;
 }
 
diff -ruN a/sound/soc/codecs/lpass-tx-macro.c b/sound/soc/codecs/lpass-tx-macro.c
--- a/sound/soc/codecs/lpass-tx-macro.c	2026-05-13 02:27:25.000000000 +0200
+++ b/sound/soc/codecs/lpass-tx-macro.c	2026-08-10 10:41:21.733143509 +0200
@@ -285,6 +285,7 @@
 	int dec_mode[NUM_DECIMATORS];
 	struct lpass_macro *pds;
 	bool bcs_clk_en;
+	bool swr_reset_done;
 };
 #define to_tx_macro(_hw) container_of(_hw, struct tx_macro, hw)
 
@@ -2157,9 +2158,34 @@
 
 	tx_macro_mclk_enable(tx, true);
 
+	/*
+	 * El bloque SoundWire necesita un pulso de reset alrededor de la
+	 * habilitacion de su reloj. Mainline solo lo da en el probe, que aqui
+	 * llega demasiado pronto: el maestro no arranca el generador de trama
+	 * y ningun esclavo se presenta en el bus.
+	 *
+	 * Pero el pulso tiene que darse UNA SOLA VEZ. Esta funcion se llama
+	 * cada vez que el controlador SoundWire pide su reloj, o sea en cada
+	 * arranque de flujo; si se resetea entonces, el esclavo se cae del bus
+	 * en mitad de la preparacion del puerto ("Slave 1 state check1:
+	 * UNATTACHED") y la captura sale a ceros. Downstream lleva la misma
+	 * cuenta con tx_priv->reset_swr, que pone a false tras el primer pulso
+	 * (techpack/audio/asoc/codecs/bolero/tx-macro.c, tx_macro_swrm_clock).
+	 */
+	if ((tx->data->flags & LPASS_MACRO_FLAG_RESET_SWR) && !tx->swr_reset_done)
+		regmap_update_bits(regmap, CDC_TX_CLK_RST_CTRL_SWR_CONTROL,
+				   CDC_TX_SWR_RESET_MASK, CDC_TX_SWR_RESET_ENABLE);
+
 	regmap_update_bits(regmap, CDC_TX_CLK_RST_CTRL_SWR_CONTROL,
 			   CDC_TX_SWR_CLK_EN_MASK,
 			   CDC_TX_SWR_CLK_ENABLE);
+
+	if ((tx->data->flags & LPASS_MACRO_FLAG_RESET_SWR) && !tx->swr_reset_done) {
+		regmap_update_bits(regmap, CDC_TX_CLK_RST_CTRL_SWR_CONTROL,
+				   CDC_TX_SWR_RESET_MASK, 0x0);
+		tx->swr_reset_done = true;
+	}
+
 	return 0;
 }
 
