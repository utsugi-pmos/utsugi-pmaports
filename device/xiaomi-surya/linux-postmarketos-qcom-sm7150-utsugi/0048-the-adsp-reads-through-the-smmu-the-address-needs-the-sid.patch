+ * THE SMMU SID, AND WHY THE PHONE WAS HANGING
+ * =============================================
+ *
+ * Measured with r73: mapping memory and unmapping it goes clean, but as soon as the
+ * ADSP READS that memory the SoC resets. And at the same time playback (q6asm)
+ * does the same -allocates with the DMA API, has it mapped for the DSP- and the DSP reads it
+ * without breaking a sweat. That contradiction had to be explained, and it is.
+ *
+ * The ADSP does not address physical memory: it goes through the apps_smmu. In the device tree
+ * of this phone the node of the q6asm DAIs declares it:
+ *
+ *     q6asmdai: dais {
+ *             compatible = "qcom,q6asm-dais";
+ *             iommus = <&apps_smmu 0x1b21 0x0>;
+ *     };
+ *
+ * And q6asm-dai.c does TWO things with that (q6asm-dai.c:1309 and :651):
+ *
+ *   1. It allocates the buffer ON THAT DEVICE. Since the device has "iommus", the
+ *      DMA API gives it an address ALREADY TRANSLATED by the apps_smmu, valid in
+ *      the ADSP context.
+ *   2. It puts the SID in the high bits of the address before handing it to the DSP:
+ *
+ *          prtd->phys = dma_buffer.addr | (pdata->sid << 32);
+ *          pdata->sid = args.args[0] & 0xF;      // 0x1b21 & 0xF = 1
+ *
+ * We did NEITHER of the two:
+ *
+ *   1. We allocated on the APR device. And apr.c registers its devices with
+ *      a bare device_register() (apr.c:474), WITHOUT ever calling
+ *      of_dma_configure(). So our device has no IOMMU domain
+ *      at all: the address we got is raw physical, with no translation in
+ *      the ADSP context.
+ *   2. We sent upper_32_bits(phys), which is 0. No SID.
+ *
+ * That fits exactly what was measured: the mapping works because the DSP only
+ * notes the address down and returns a handle -it touches nothing-, and the read takes the
+ * system down because it goes to the SMMU with an address that does not exist there. SMMU
+ * translation fault, and the subsystem takes the SoC with it.
+ *
+ * So this patch does the same as q6asm: it allocates on the device that IS
+ * behind the SMMU, and folds the SID into the high bits.
+ *
+ *   use_asm_dev  0 = APR device (the old way, which hangs) / 1 = the q6asm one
+ *   mem_sid       -1 = read it from the device tree (the correct one), or force 0..15
+ */
+static int use_asm_dev = 1;
+module_param(use_asm_dev, int, 0644);
+MODULE_PARM_DESC(use_asm_dev,
+		 "0 = allocate on the APR device (hangs the phone), 1 = on the q6asm-dais one");
+
+static int mem_sid = -1;
+module_param(mem_sid, int, 0644);
+MODULE_PARM_DESC(mem_sid, "SMMU SID in the high bits; -1 = read it from the device tree");
+
+/*
+ * Returns the device to allocate on, and through *sid the SMMU stream that
+ * has to be folded into the address. If something is missing, it falls back to the APR device with SID 0,
+ * which is the old behaviour -and it warns, because then it hangs.
+ *
+ * Takes a reference to the device; release it with q6core_dma_dev_put().
+ */
+static struct device *q6core_dma_dev(struct device *apr_dev, int *sid)
+{
+	struct of_phandle_args args;
+	struct platform_device *pdev;
+	struct device_node *np;
+
+	*sid = 0;
+
+	if (!use_asm_dev)
+		goto sin_smmu;
+
+	np = of_find_compatible_node(NULL, NULL, "qcom,q6asm-dais");
+	if (!np) {
+		dev_warn(apr_dev, "no qcom,q6asm-dais node in the device tree\n");
+		goto sin_smmu;
+	}
+
+	if (!of_parse_phandle_with_fixed_args(np, "iommus", 1, 0, &args))
+		*sid = args.args[0] & 0xF;
+	else
+		dev_warn(apr_dev, "qcom,q6asm-dais no declara iommus\n");
+
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev) {
+		dev_warn(apr_dev, "qcom,q6asm-dais no tiene device asociado\n");
+		goto sin_smmu;
+	}
+
+	if (mem_sid >= 0)
+		*sid = mem_sid;
+
+	return &pdev->dev;
+
+sin_smmu:
+	if (mem_sid >= 0)
+		*sid = mem_sid;
+	return apr_dev;
+}
