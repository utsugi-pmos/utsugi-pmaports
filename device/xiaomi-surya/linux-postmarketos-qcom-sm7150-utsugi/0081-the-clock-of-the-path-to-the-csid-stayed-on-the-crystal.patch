--- a/drivers/media/platform/qcom/camss/camss-csid.c
+++ b/drivers/media/platform/qcom/camss/camss-csid.c
@@ -27,6 +27,15 @@
 #include "camss-csid-gen1.h"
 #include "camss.h"
 
+/*
+ * To sweep the frequency of the CSIPHY->CSID path without recompiling.
+ * -1 uses the one from the table. The SM7150 supports 19200000, 300000000,
+ * 384000000 and 400000000; any other value is rounded by the RCG.
+ */
+static int cphy_rx_rate = -1;
+module_param(cphy_rx_rate, int, 0644);
+MODULE_PARM_DESC(cphy_rx_rate, "Hz of the CSID cphy_rx clock (-1 = table)");
+
 /* offset of CSID registers in VFE region for VFE 480 */
 #define VFE_480_CSID_OFFSET 0x4000
 #define VFE_480_LITE_CSID_OFFSET 0x200
@@ -589,6 +598,22 @@
 				dev_err(dev, "clk set rate failed: %d\n", ret);
 				return ret;
 			}
+		} else if (strstr(clock->name, "cphy_rx")) {
+			/*
+			 * It is handled separately so it can be swept at runtime and
+			 * to PUT ON RECORD the rate that really ends up
+			 * set: asking for a rate does not guarantee getting it,
+			 * and this clock had been on the crystal all along without
+			 * anything saying so.
+			 */
+			unsigned long pedida = cphy_rx_rate > 0 ? cphy_rx_rate :
+					       (clock->nfreqs ? clock->freq[0] : 0);
+
+			if (pedida)
+				clk_set_rate(clock->clk, pedida);
+
+			dev_info(dev, "%s: pedido %lu Hz, queda %lu Hz\n",
+				 clock->name, pedida, clk_get_rate(clock->clk));
 		} else if (clock->nfreqs) {
 			clk_set_rate(clock->clk, clock->freq[0]);
 		}
