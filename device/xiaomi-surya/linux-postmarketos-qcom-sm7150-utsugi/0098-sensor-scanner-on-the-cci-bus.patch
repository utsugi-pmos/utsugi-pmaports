+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Camera sensor scanner on the CCI bus of the Xiaomi POCO X3 NFC.
+ *
+ * WHY IT EXISTS
+ * --------------
+ * The phone has four rear cameras. Two work; the others -wide-angle
+ * Hi-1337, macro Hi-259 and depth- hang off cci1_i2c0, which in the
+ * device tree is EMPTY. And to write a driver for them you need to know two
+ * things nobody tells: at which address they answer and with which GPIO their
+ * reset is released.
+ *
+ * Scanning from userspace does NOT work, and it is measured: with the rear camera
+ * powered, on that bus 0x51, 0x54, 0x59 and 0x5c answer, but none of them
+ * responds to the SK Hynix id register (0x0f16, which on the
+ * mainline hi846 returns 46 08). That is, they are not sensors: the sensors
+ * siguen apagados.
+ *
+ * And turning rails on by hand is not enough, because a sensor also needs its
+ * MCLK -which only a driver brings up- and its reset released.
+ *
+ * WHAT THIS MODULE DOES
+ * --------------------
+ * It runs the whole sequence just like a real driver would
+ * -supplies, clock, wait- and then, for each candidate reset GPIO:
+ *
+ *     it releases it, sweeps the whole bus, and puts it back
+ *
+ * From every address that answers it reads the Hynix id and register
+ * 0x0000, which is where Sony and Samsung keep theirs. This way a single test
+ * answers both questions at once.
+ *
+ * It is a MODULE and not a normal driver on purpose: it is loaded by hand when
+ * you want to measure, dmesg is read, and it is unloaded. A bug here cannot leave the
+ * phone unable to boot.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+/* The same three names the hi846 driver uses, so as to be able to reuse its
+ * device tree as is when this becomes the real driver. */
+static const char * const surya_supplies[] = { "vddio", "vdda", "vddd" };
+
+/* Candidate cap. The list now has 36 -the reset, 19 free pins of the
+ * tlmm and 16 from the two PMICs- and the headroom is to be able to add more in the device
+ * tree without touching the code. WATCH OUT: if the device tree list grows beyond
+ * this, the module TRUNCATES it silently, so the two numbers it
+ * prints at startup -usable and total- are the check that everything
+ * has been tried. */
+#define SURYA_MAX_RESETS 48
+
+/* What has to be turned off when the module is unloaded, and it is only filled in on the
+ * `mantener` path, which is the only one that leaves probe bound. */
+struct surya_encendido {
+	struct regulator_bulk_data *supplies;
+	struct clk_bulk_data *relojes;
+	int nrelojes;
+	struct gpio_desc *reset;
+	struct gpio_desc *standby;	/* NULL if left without standby */
+};
+
+/* With this set to a candidate index, the module does NOT power off when it finishes:
+ * it leaves that reset released, the clocks spinning and the rails on, and stays
+ * bound. It is useful to keep poking from userspace with
+ * i2ctransfer, which is much faster than recompiling the kernel for each
+ * register one wants to read.
+ *
+ * Whatever is left on is turned off by surya_cam_scan_remove() when the module is
+ * unloaded. Doing it matters more than it seems: neither clk_bulk_prepare_enable nor
+ * regulator_bulk_enable are devm, so without that remove devres freed the
+ * regulators with the enable count still standing -three WARNs in
+ * regulator_bulk_free, one per rail- and left them on forever, with
+ * the kernel already tainted. And a tainted kernel is exactly the state in which
+ * the UFS deadlock showed up.
+ *
+ * To see it you have to look at the DELTA in regulator_summary, not the bare number:
+ * cam_avdd1 -the vdda of this node- already shows use 1 and open 0 right after boot,
+ * so that value on its own says nothing. What gave the leak away is that it
+ * went up to 2 on load and STAYED at 2 after the rmmod. Now it goes back to 1. */
+static int mantener = -1;
+module_param(mantener, int, 0644);
+MODULE_PARM_DESC(mantener,
+		 "index of the candidate gpio left released with everything on; -1 powers off and exits");
+
+/*
+ * Registros de identificacion.
+ *
+ * THE BUG THAT COST THE WHOLE INVESTIGATION: 0x0f16 was copied from the driver
+ * mainline hi846 -where HI846_REG_CHIP_ID_L is 0x0f16 and returns 46 08- and
+ * and it was assumed that the Hi-1337, being SK Hynix too, would have it at the
+ * same place. It does NOT.
+ *
+ * The Hi-1337 puts its id at 0x0716, and there it answers a clean 1337. At
+ * 0x0f16 it returns 0000, which is what was being read round after round as
+ * "the sensor does not wake". The sensor had been awake ever since
+ * the reset was found; what was not waking up was the question.
+ *
+ * Both are kept: if a real Hi-846 ever shows up on this bus, we have
+ * to be able to tell it apart.
+ */
+#define REG_ID_HI1337	0x0716
+#define REG_ID_HI846	0x0f16
+#define REG_ID_SMIA	0x0000
+
+/* Output size at full resolution. It serves as a second confirmation: the
+ * Hi-1337 gives 0x1070 x 0x0c30, that is 4208 x 3120, exactly what the
+ * modes extracted from the factory blob say. */
+#define REG_ANCHO	0x0b12
+#define REG_ALTO	0x0b14
+
+static int leer16(struct i2c_client *cl, u16 addr, u16 reg, u16 *val)
+{
+	u8 buf[2] = { reg >> 8, reg & 0xff };
+	u8 out[2];
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0, .len = 2, .buf = buf },
+		{ .addr = addr, .flags = I2C_M_RD, .len = 2, .buf = out },
+	};
+
+	if (i2c_transfer(cl->adapter, msgs, 2) != 2)
+		return -EIO;
+	*val = (out[0] << 8) | out[1];
+	return 0;
+}
+
+static bool contesta(struct i2c_client *cl, u16 addr)
+{
+	u8 b;
+	struct i2c_msg m = { .addr = addr, .flags = I2C_M_RD, .len = 1, .buf = &b };
+
+	return i2c_transfer(cl->adapter, &m, 1) == 1;
+}
+
+/* The reset is PULSED, not just released: the factory sequence drives it low, lets
+ * it settle, and drives it high. If standby changes while reset is released, the
+ * sensor does not notice. */
+static int escribir16(struct i2c_client *cl, u16 addr, u16 reg, u8 val)
+{
+	u8 buf[3] = { reg >> 8, reg & 0xff, val };
+	struct i2c_msg m = { .addr = addr, .flags = 0, .len = 3, .buf = buf };
+
+	return i2c_transfer(cl->adapter, &m, 1) == 1 ? 0 : -EIO;
+}
+
+/*
+ * THE PROBE
+ *
+ * It exists because of a measured limitation: on the CCI bus, i2ctransfer answers
+ * "Not supported" -the adapter does not do the combined transactions it uses- and
+ * from userspace you can only get there with i2cget/i2cdump, which are 8
+ * bit. But the sensors on this bus speak with 16-bit registers. That is,
+ * EVERY 16-bit hypothesis cost a kernel rebuild: ten minutes per
+ * pregunta.
+ *
+ * With this, while `mantener` holds rails and clocks, you ask from
+ * outside without recompiling anything:
+ *
+ *     echo "21 0f16"      > /sys/module/surya_cam_scan/parameters/sonda
+ *     echo "21 0a00 01"   > /sys/module/surya_cam_scan/parameters/sonda
+ *     dmesg | tail -1
+ *
+ * Two fields read two bytes (the register and the next one); three write one byte
+ * and read back to see what stuck. The answer comes out on dmesg and not on the
+ * file itself because the parameter is write-only.
+ */
+static struct i2c_client *probe_client;
+
+static int probe_set(const char *val, const struct kernel_param *kp)
+{
+	struct i2c_client *cl = READ_ONCE(probe_client);
+	unsigned int addr, reg, dato = 0;
+	u16 leido;
+	int n, ret;
+
+	/* There is a bus only if probe stayed bound, that is with `mantener`. */
+	if (!cl)
+		return -ENODEV;
+
+	n = sscanf(val, "%x %x %x", &addr, &reg, &dato);
+	if (n < 2 || addr > 0x7f || reg > 0xffff || (n >= 3 && dato > 0xff))
+		return -EINVAL;
+
+	if (n >= 3) {
+		ret = escribir16(cl, addr, reg, dato);
+		if (ret) {
+			dev_info(&cl->dev, "sonda: escribir %02x/%04x=%02x fallo\n",
+				 addr, reg, dato);
+			return 0;
+		}
+	}
+
+	ret = leer16(cl, addr, reg, &leido);
+	if (ret)
+		dev_info(&cl->dev, "sonda: %02x/%04x no contesta\n", addr, reg);
+	else
+		dev_info(&cl->dev, "sonda: %02x/%04x = %04x\n", addr, reg, leido);
+	return 0;
+}
+
+static const struct kernel_param_ops probe_ops = { .set = probe_set };
+module_param_cb(sonda, &probe_ops, NULL, 0200);
+MODULE_PARM_DESC(sonda,
+		 "\"addr reg\" reads 16 bits, \"addr reg data\" writes 8 and reads back; the answer comes out on dmesg");
+
+static void pulso_reset(struct gpio_desc *rst)
+{
+	gpiod_set_value_cansleep(rst, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(rst, 1);
+	usleep_range(10000, 12000);
+}
+
+static void sweep(struct i2c_client *cl, const char *when)
+{
+	unsigned int a;
+	int hallados = 0;
+
+	for (a = 0x08; a <= 0x77; a++) {
+		u16 hi1337 = 0, hi846 = 0, smia = 0, width = 0, height = 0;
+
+		if (a == cl->addr || !contesta(cl, a))
+			continue;
+
+		hallados++;
+		leer16(cl, a, REG_ID_HI1337, &hi1337);
+		leer16(cl, a, REG_ID_HI846, &hi846);
+		leer16(cl, a, REG_ID_SMIA, &smia);
+		leer16(cl, a, REG_ANCHO, &width);
+		leer16(cl, a, REG_ALTO, &height);
+		dev_info(&cl->dev,
+			 "%s: 0x%02x contesta  hi1337(0x0716)=%04x hi846(0x0f16)=%04x smia(0x0000)=%04x  %ux%u\n",
+			 when, a, hi1337, hi846, smia, width, height);
+		if (hi1337 == 0x1337)
+			dev_info(&cl->dev, "%s: 0x%02x IS THE Hi-1337, the wide-angle\n",
+				 when, a);
+	}
+	if (!hallados)
+		dev_info(&cl->dev, "%s: nobody answers\n", when);
+}
+
+static int surya_cam_scan_probe(struct i2c_client *cl)
+{
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *resets[SURYA_MAX_RESETS];
+	unsigned int pin[SURYA_MAX_RESETS];
+	unsigned int nresets = 0;
+	int ncand;
+	struct clk_bulk_data *relojes;
+	int nrelojes;
+	unsigned int i;
+	int ret;
+
+	/* ON THE HEAP, not on the stack: devm_regulator_bulk_get() KEEPS the
+	 * pointer to this array and reads it again on release, which here happens
+	 * always because probe ends in -ENODEV on purpose. With the array
+	 * on the probe() stack that is reading dead memory: the kernel blew up
+	 * with a NULL deref in devm_regulator_bulk_release, got tainted, and
+	 * a while later the UFS deadlocked turning its clock off and the phone
+	 * was left with 35 processes stuck in disk wait. */
+	supplies = devm_kcalloc(&cl->dev, ARRAY_SIZE(surya_supplies),
+				sizeof(*supplies), GFP_KERNEL);
+	if (!supplies)
+		return -ENOMEM;
+
+	for (i = 0; i < ARRAY_SIZE(surya_supplies); i++)
+		supplies[i].supply = surya_supplies[i];
+
+	ret = devm_regulator_bulk_get(&cl->dev, ARRAY_SIZE(surya_supplies), supplies);
+	if (ret)
+		return dev_err_probe(&cl->dev, ret, "no supplies\n");
+
+	nrelojes = devm_clk_bulk_get_all(&cl->dev, &relojes);
+	if (nrelojes < 0)
+		return dev_err_probe(&cl->dev, nrelojes, "no clocks\n");
+
+	/* The frequency is set HERE and not with assigned-clocks in the device
+	 * tree: that is applied by the kernel when the node is registered, with no driver
+	 * involved, and it hung the boot. */
+	/* 19.2 MHz. The generic QRD device tree says 24 MHz, but the
+	 * factory file of THIS module -powerSetting of
+	 * com.qti.sensormodule.j20c_sunny_hi1337_ultra.bin- pide
+	 * 0x0124f800 = 19200000. The module one wins. */
+	for (i = 0; i < (unsigned int)nrelojes; i++) {
+		ret = clk_set_rate(relojes[i].clk, 19200000);
+		if (ret)
+			return dev_err_probe(&cl->dev, ret,
+					     "%s no acepta 19,2 MHz\n",
+					     relojes[i].id);
+	}
+
+	/* The reset candidates, as outputs at rest -active low, that is the
+	 * sensor IN reset- so as not to wake anything too early.
+	 *
+	 * They are requested ONE BY ONE and the failing one is skipped. Requesting them as a block with
+	 * devm_gpiod_get_array_optional() made a single owned pin
+	 * abort the WHOLE sweep with -EINVAL, and that is exactly what happened:
+	 * gpio27 is requested by ac4b000.cci because it is its i2c line. A
+	 * probing instrument cannot fall over because one probe is bad. */
+	ncand = gpiod_count(&cl->dev, "probe");
+	if (ncand < 0)
+		ncand = 0;
+	if (ncand > SURYA_MAX_RESETS)
+		ncand = SURYA_MAX_RESETS;
+
+	for (i = 0; i < (unsigned int)ncand; i++) {
+		struct gpio_desc *g = devm_gpiod_get_index(&cl->dev, "probe", i,
+							   GPIOD_OUT_LOW);
+		if (IS_ERR(g)) {
+			dev_info(&cl->dev, "candidato %u descartado: %pe\n", i, g);
+			continue;
+		}
+		pin[nresets] = i;
+		resets[nresets++] = g;
+	}
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(surya_supplies), supplies);
+	if (ret)
+		return dev_err_probe(&cl->dev, ret, "no enciende\n");
+
+	ret = clk_bulk_prepare_enable(nrelojes, relojes);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(surya_supplies), supplies);
+		return dev_err_probe(&cl->dev, ret, "clock does not start\n");
+	}
+
+	dev_info(&cl->dev, "alimentado, %d relojes a %lu Hz, %u gpios utiles de %d\n",
+		 nrelojes, nrelojes ? clk_get_rate(relojes[0].clk) : 0,
+		 nresets, ncand);
+	usleep_range(10000, 12000);
+
+	/*
+	 * The factory sequence of the wide-angle -powerSetting of the
+	 * com.qti.sensormodule of the phone itself- is:
+	 *
+	 *     STANDBY=1 -> RESET=0 -> VIO -> MCLK -> RESET=1
+	 *
+	 * That is, standby goes BEFORE reset. That is why it is no good to release
+	 * reset and then try pins one by one: you have to set the candidate and
+	 * THEN pulse the reset, which is what this loop does.
+	 *
+	 * The first gpio in the list is the reset, already found (tlmm 24). The
+	 * rest are standby candidates.
+	 */
+	sweep(cl, "en reset, referencia");
+
+	pulso_reset(resets[0]);
+	sweep(cl, "reset pulsed, no standby");
+
+	for (i = 1; i < nresets; i++) {
+		char etq[64];
+
+		gpiod_set_value_cansleep(resets[i], 1);
+		usleep_range(5000, 6000);
+		pulso_reset(resets[0]);
+		snprintf(etq, sizeof(etq), "standby en candidato #%u", pin[i]);
+		sweep(cl, etq);
+		gpiod_set_value_cansleep(resets[i], 0);
+		gpiod_set_value_cansleep(resets[0], 0);
+		usleep_range(5000, 6000);
+	}
+
+	if (mantener >= 0 && (unsigned int)mantener < nresets) {
+		struct surya_encendido *e;
+
+		if (mantener > 0)
+			gpiod_set_value_cansleep(resets[mantener], 1);
+		pulso_reset(resets[0]);
+
+		/* It stays bound, so we have to note down that there are
+		 * things powered on and who turns them off. */
+		e = devm_kzalloc(&cl->dev, sizeof(*e), GFP_KERNEL);
+		if (!e) {
+			clk_bulk_disable_unprepare(nrelojes, relojes);
+			regulator_bulk_disable(ARRAY_SIZE(surya_supplies), supplies);
+			return -ENOMEM;
+		}
+		e->supplies = supplies;
+		e->relojes = relojes;
+		e->nrelojes = nrelojes;
+		e->reset = resets[0];
+		e->standby = mantener ? resets[mantener] : NULL;
+		i2c_set_clientdata(cl, e);
+		WRITE_ONCE(probe_client, cl);
+
+		dev_info(&cl->dev,
+			 "STAYING AWAKE: reset (candidate #%u) pulsed, standby on candidate #%u, everything on\n",
+			 pin[0], mantener ? pin[mantener] : pin[0]);
+		return 0;
+	}
+
+	clk_bulk_disable_unprepare(nrelojes, relojes);
+	regulator_bulk_disable(ARRAY_SIZE(surya_supplies), supplies);
+
+	/* Never stays bound: it is a measuring instrument, not a driver. */
+	dev_info(&cl->dev, "barrido terminado\n");
+	return -ENODEV;
+}
+
+/* Only called when probe stayed bound, that is on the
+ * `mantener` path. When the sweep ends normally probe returns -ENODEV, there is no
+ * bind, and this does not run: that is why no flag is needed. */
+static void surya_cam_scan_remove(struct i2c_client *cl)
+{
+	struct surya_encendido *e = i2c_get_clientdata(cl);
+
+	/* First of all, make the probe stop holding a client that is going away. */
+	WRITE_ONCE(probe_client, NULL);
+
+	if (!e)
+		return;
+
+	/* The same order as the factory power-off sequence of the wide-angle
+	 * (RESET=0 -> MCLK=0 -> VIO=0 -> STANDBY=0): the sensor goes back into reset
+	 * before clock and power are removed, and standby is driven low at the end.
+	 *
+	 * Driving standby low matters even if it looks like a detail: when the
+	 * descriptor is released the pin stays as it was, that is asserted, and that
+	 * poisons the next measurement without showing anywhere. */
+	gpiod_set_value_cansleep(e->reset, 0);
+	clk_bulk_disable_unprepare(e->nrelojes, e->relojes);
+	regulator_bulk_disable(ARRAY_SIZE(surya_supplies), e->supplies);
+	if (e->standby)
+		gpiod_set_value_cansleep(e->standby, 0);
+	dev_info(&cl->dev, "apagado: reset y standby abajo, relojes y rieles fuera\n");
+}
+
+static const struct of_device_id surya_cam_scan_of[] = {
+	{ .compatible = "xiaomi,surya-cam-scan" },
+	{ }
+};
+/* ON PURPOSE without MODULE_DEVICE_TABLE: with it udev generates the modalias and
+ * loads the module by itself as soon as the node appears, and this module wiggles GPIOs
+ * of unknown ownership. This way it only comes in with modprobe. */
+
+static struct i2c_driver surya_cam_scan_driver = {
+	.driver = { .name = "surya-cam-scan", .of_match_table = surya_cam_scan_of },
+	.probe = surya_cam_scan_probe,
+	.remove = surya_cam_scan_remove,
+};
+module_i2c_driver(surya_cam_scan_driver);
+
+MODULE_DESCRIPTION("Sensor scanner on the surya CCI bus");
+MODULE_LICENSE("GPL");
