+static int q6core_wait_resp(struct q6core *core)
+{
+	int rc;
+
+	/*
+	 * Q6_READY_TIMEOUT_MS son 100 ms, pensados para preguntas triviales.
+	 * Mapear memoria en el DSP puede tardar mas, y quedarse corto se
+	 * confunde con un rechazo.
+	 */
+	rc = wait_event_timeout(core->wait, core->resp_received,
+				msecs_to_jiffies(1000));
+	if (!rc)
+		return -ETIMEDOUT;
+
+	core->resp_received = false;
+	return 0;
+}
+
+/*
+ * El DSP no acepta el bloque de topologias pegado al paquete: hay que dejarlo
+ * en memoria y pasarle un asa. Enviandolo en banda contesta ADSP_EBADPARAM (2),
+ * que es lo que pasaba con el parche tal cual venia de aguas arriba.
+ */
+static int q6core_map_memory(struct q6core *core, dma_addr_t phys, u32 size)
+{
+	struct avcs_cmd_shared_mem_map_regions *cmd;
+	struct avcs_shared_map_region_payload *region;
+	struct apr_pkt *pkt;
+	int pkt_size, rc;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd) + sizeof(*region);
+	pkt = kzalloc(pkt_size, GFP_KERNEL);
+	if (!pkt)
+		return -ENOMEM;
+
+	cmd = (void *)pkt + APR_HDR_SIZE;
+	region = (void *)cmd + sizeof(*cmd);
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.opcode = AVCS_CMD_SHARED_MEM_MAP_REGIONS;
+
+	cmd->mem_pool_id = ADSP_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = 0;
+
+	region->shm_addr_lsw = lower_32_bits(phys);
+	region->shm_addr_msw = upper_32_bits(phys);
+	region->mem_size_bytes = size;
+
+	core->mem_map_handle = 0;
+	core->resp_received = false;
+
+	rc = apr_send_pkt(core->adev, pkt);
+	kfree(pkt);
+	if (rc < 0)
+		return rc;
+
+	rc = q6core_wait_resp(core);
+	if (rc)
+		return rc;
+
+	return core->mem_map_handle ? 0 : -EIO;
+}
+
+static void q6core_unmap_memory(struct q6core *core)
+{
+	struct avcs_cmd_shared_mem_unmap_regions *cmd;
+	struct apr_pkt *pkt;
+	int pkt_size;
+
+	if (!core->mem_map_handle)
+		return;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd);
+	pkt = kzalloc(pkt_size, GFP_KERNEL);
+	if (!pkt)
+		return;
+
+	cmd = (void *)pkt + APR_HDR_SIZE;
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.opcode = AVCS_CMD_SHARED_MEM_UNMAP_REGIONS;
+	cmd->mem_map_handle = core->mem_map_handle;
+
+	core->resp_received = false;
+	if (apr_send_pkt(core->adev, pkt) >= 0)
+		q6core_wait_resp(core);
+
+	kfree(pkt);
+	core->mem_map_handle = 0;
+}
