+ *
+ * The topology block lives in the ACDB preceded by a u32 with its size.
+ * The Pixel 3a skips that u32 and sends the rest (offset 4, size as-is), and that is
+ * what we did. The DSP of this phone rejects it with ADSP_EBADPARAM (2), and
+ * it rejects it THE SAME with the surya calibration and with the Pixel 4a one, that is
+ * the content is not the variable: the frame is.
+ *
+ *   topo_offset  bytes skipped from the start        [4]
+ *   topo_delta   added to the declared size          [0]
+ *
+ * Combinations worth testing:
+ *   4  0   like the Pixel 3a  (rejected)
+ *   0  4   also send the size u32, counting it
+ *   0  0   start at the u32 but without counting it
+ *   4 -4   by elimination
+ */
+static int topo_offset = 4;
+module_param(topo_offset, int, 0644);
+MODULE_PARM_DESC(topo_offset, "bytes skipped from the start of the block");
+
+static int topo_delta;
+module_param(topo_delta, int, 0644);
+MODULE_PARM_DESC(topo_delta, "added to the size declared to the DSP");
+
