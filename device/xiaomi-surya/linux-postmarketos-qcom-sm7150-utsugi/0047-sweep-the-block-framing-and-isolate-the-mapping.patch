+/*
+ * Tests ONLY the memory mapping, 4 KiB, without registering anything behind it.
+ *
+ *     echo 1 > /sys/bus/aprbus/devices/aprsvc:service:4:3/test_mapping
+ *
+ * It exists to separate two things that until now went together: whether what takes
+ * the phone down is the mapping itself, or the registration command that came after. Without
+ * separating them there is no way to know which one to fix.
+ *
+ * DANGER: if the mapping is what takes it down, this reboots the phone. But rebooting
+ * costs 90 seconds and costs no call, so it is worth it.
+ */
+static ssize_t test_mapping_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct q6core *core = dev_get_drvdata(dev);
+	dma_addr_t phys;
+	void *p;
+	int rc;
+
+	rc = dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (rc) {
+		dev_err(dev, "could not set the DMA mask: %d\n", rc);
+		return rc;
+	}
+
+	p = dma_alloc_coherent(dev, SZ_4K, &phys, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	dev_info(dev, "testing ONLY the mapping: 4 KiB at %pad, token %#x\n",
+		 &phys, mapping_token);
+
+	rc = q6core_map_memory(core, phys, SZ_4K);
+	dev_info(dev, "map: rc=%d handle=%#x\n", rc, core->mem_map_handle);
+
+	if (!rc) {
+		q6core_unmap_memory(core);
+		dev_info(dev, "unmap done\n");
+	}
+
+	dma_free_coherent(dev, SZ_4K, p, phys);
+	return count;
+}
+static DEVICE_ATTR_WO(test_mapping);
