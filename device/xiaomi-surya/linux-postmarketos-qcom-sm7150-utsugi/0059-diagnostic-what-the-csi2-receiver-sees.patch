+		writel_relaxed(diag_rx_mask,
+			       csid->base + CSID_CSI2_RDIN_IRQ_MASK(vc));
+		writel_relaxed(1 << IRQ_CMD_CLEAR, csid->base + CSID_IRQ_CMD);
+	}
 }
 
