+/*
+ * TEMPORARY DIAGNOSTIC: what the CSI-2 receiver sees.
+ *
+ * The counters are module parameters at 0644, that is, they are READ and
+ * ZEROED from user space. That matters more than it looks:
+ * the previous diagnostic printed through dev_info with a cap of 25 lines and a
+ * static counter that is never reset, so if anything touched the camera
+ * at boot -pipewire does- the quota was spent and the log came out
+ * EMPTY even though the hardware was firing two million times. That already
+ * led to accepting a "the PHY sees nothing" that was false.
+ *
+ * A counter that can be zeroed before each test does not have that
+ * problem and on top of that does not flood the log.
+ */
+static unsigned int diag_rx_seen;
+module_param(diag_rx_seen, uint, 0644);
+MODULE_PARM_DESC(diag_rx_seen,
+	"OR of CSI2_RX_IRQ_STATUS seen. Write 0 to reset.");
+
+static unsigned int diag_rdi0_seen;
+module_param(diag_rdi0_seen, uint, 0644);
+MODULE_PARM_DESC(diag_rdi0_seen,
+	"OR of RDIN0_IRQ_STATUS seen. Write 0 to reset.");
+
+/*
+ * Mainline leaves masked ALL the interrupts of the CSI-2 receiver and of
+ * the RDIs: it only unmasks the "reset done" bit. With this they can be
+ * enabled, but by default it is NOT done: at 30 frames per second and several
+ * interrupts per frame this can turn into a storm, and this
+ * phone is sensitive to timing. Enable it by hand when needed.
+ */
+static unsigned int diag_rx_mask;
+module_param(diag_rx_mask, uint, 0644);
+MODULE_PARM_DESC(diag_rx_mask,
+	"Mask for CSI2_RX_IRQ_MASK and RDIN_IRQ_MASK. 0 = like mainline.");
+
