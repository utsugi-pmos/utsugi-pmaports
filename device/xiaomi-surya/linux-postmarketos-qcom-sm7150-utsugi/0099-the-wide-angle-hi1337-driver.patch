@@ -0,0 +1,3158 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SK Hynix Hi-1337: the wide-angle camera of the Xiaomi POCO X3 NFC (surya).
+ *
+ * WHERE THIS DRIVER COMES FROM
+ * -------------------------
+ * It is a port of the hi1337.c in this same tree -the front camera, which already
+ * works end to end- because both sensors are wired the same way:
+ * four D-PHY lanes. What was already proven has not been rewritten.
+ *
+ * THE MISTAKE THAT COST THE WHOLE INVESTIGATION, AND THAT MUST NOT BE REPEATED
+ * -------------------------------------------------------------------
+ * The scanner that found this sensor read its ID at 0x0f16,
+ * copied from the mainline hi846 driver assuming that another SK
+ * Hynix sensor would have it in the same place. It does NOT: the Hi-1337 puts it at
+ * 0x0716. For entire rounds 0000 was read and interpreted as "the sensor
+ * is dead", when it meant "that register does not exist here".
+ *
+ * So from this sibling driver the STRUCTURE is copied, not the constants.
+ * Every register address below comes from the factory file of this
+ * module or is measured on the chip, and which is which is stated.
+ *
+ * WHERE THE TABLES COME FROM
+ * -------------------------
+ * From com.qti.sensormodule.j20c_sunny_hi1337_ultra.bin, the file of the phone
+ * itself, read with surya/camara/leer-sensormodule.py --tablas. They are 1457
+ * initialization writes and 87 per mode.
+ *
+ * The first few hundred of the initialization go to 0x2000 and above, with values
+ * like 40b2 b05c 8446: those are not settings, that is microcode for the sensor's
+ * internal sequencer.
+ *
+ * WHAT IS MEASURED ON THE CHIP, not inferred
+ * ------------------------------------------
+ *   0x0716 = 0x1337    the ID
+ *   0x0b12 = 4208      width de salida
+ *   0x0b14 = 3120      height de salida
+ *
+ * The last two match what the factory table says, which is the
+ * cross-check that the tables belong to this sensor.
+ *
+ * WHAT IS NOT SETTLED, and that is why it is not touched
+ * ---------------------------------------------
+ * It is not known for certain where the Hi-1337 keeps the exposure or the analog
+ * gain. They are somewhere in the 0x0200 block -the per-channel digital gains
+ * are located, at 0x0214..0x021a, and they come from the factory
+ * file itself-, but guessing which is which only leads to writing to
+ * the wrong register. So this version does NOT expose exposure or
+ * gain controls: it sticks with whatever the tables set.
+ *
+ * That is the whole difference from the front camera driver, and it is deliberate.
+ *
+ * THE LINK FREQUENCY IS PROVISIONAL
+ * --------------------------------------
+ * From the PLL registers of the full mode, the multiplier of the first
+ * chain (0x0736) is 90, which with INCK = 19.2 MHz gives 1728 MHz of VCO and
+ * therefore 864 MHz of link clock. It fits comfortably with what the mode needs
+ * completo (4208 x 3120 x 30 fps x 10 bits / 4 lanes / 2 = 493 MHz minimo),
+ * but the exact PLL structure of this sensor is not documented and it has not
+ * been possible to verify it through a second path, which is how the one of the
+ * frontal.
+ *
+ * That is why it goes as a module parameter: it can be swept without recompiling, just
+ * like it was done with the scanner's probe.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define HI1337_MCLK_FREQ	(19200 * HZ_PER_KHZ)
+#define HI1337_DATA_LANES	4
+#define HI1337_BPP		10
+
+/* 845.71 MHz. The arithmetic, and how it was checked, in the comment above. */
+/* 864 MHz. Provisional and therefore also a parameter: see the header. */
+#define HI1337_LINK_FREQ	864000000ULL
+
+/* MEASURED on the chip, not copied from hi846: there it is 0x0f16 and here it reads 0. */
+#define HI1337_REG_CHIP_ID	CCI_REG16(0x0716)
+#define HI1337_CHIP_ID		0x1337
+/* The two individual bytes, for the raw sweep of hi1337_probe_id_at(). */
+#define HI1337_ID_REG_HI	0x07
+#define HI1337_ID_REG_LO	0x16
+
+/*
+ * The register that starts and stops the stream. It comes from the factory tables: there are
+ * four single-write regSetting entries and all of them go to 0x0b00, with 0x0100
+ * to start and 0x0000 to stop. It is the analogue of the Hi-846's 0x0a00.
+ */
+#define HI1337_REG_CTRL_MODE	CCI_REG16(0x0b00)
+#define HI1337_MODE_STREAMING	0x0100
+
+/*
+ * The group hold, taken from the factory blob: there 0x0208 shows up as two
+ * single-write "tables", 0x0100 and 0x0000, right next to the stream start
+ * and stop pair. See hi1337_set_ctrl().
+ */
+/* How much has to be left free at the end of the frame for the exposure. */
+#define HI1337_EXPOSURE_MARGEN	4
+
+/* Below this the sensor stops streaming. Measured, not from the datasheet. */
+#define HI1337_EXPOSURE_MINIMA	720
+
+#define HI1337_REG_GROUP_HOLD	CCI_REG16(0x0208)
+#define HI1337_GROUP_HOLD_ON	0x0100
+#define HI1337_GROUP_HOLD_OFF	0x0000
+
+
+
+
+
+
+#define to_hi1337(_sd)		container_of(_sd, struct hi1337, sd)
+
+static int i2c_addr = -1;
+module_param(i2c_addr, int, 0444);
+MODULE_PARM_DESC(i2c_addr,
+	"7-bit I2C address of the sensor. -1 (default) = search for it.");
+
+static ulong link_freq_hz;
+module_param(link_freq_hz, ulong, 0444);
+MODULE_PARM_DESC(link_freq_hz,
+	"Link frequency in Hz. 0 (default) = the one computed from the PLL.");
+
+/*
+ * THE EXPOSURE AND GAIN ADDRESSES GO AS PARAMETERS
+ *
+ * libcamera EXIGE cuatro controles -exposicion, ganancia analogica, HBLANK y
+ * VBLANK- and without them it rejects the whole sensor: "The sensor kernel driver needs
+ * to be fixed". So they are not decoration.
+ *
+ * But the Hi-1337 register map is not documented and it can NOT be
+ * copied from hi846: there the ID is at 0x0f16 and here at 0x0716, the
+ * stream start at 0x0a00 and here at 0x0b00. There is no constant
+ * offset that works.
+ *
+ * What there is, is our own evidence:
+ *   - the factory blob places the digital gains at 0x0214..0x021a, that is,
+ *     the 0x02xx block is the exposure and gain one;
+ *   - within that block, 0x0206 (=720) and 0x020a (=3307) have the SAME value in
+ *     both modes, which is what one expects from a default exposure and frame
+ *     length;
+ *   - 0x0234..0x023a do change between modes (1111 -> 3311/2222): those are the
+ *     registros de combinacion de pixeles, no de ganancia.
+ *
+ * Of the analog gain there is no clue, and the 0x0204 that was tried as such is
+ * DISPROVED: the binned mode table sets it to 0x0200 and writing a 0 to it leaves
+ * the sensor streaming ONE single frame. A gain register does not do that.
+ * Where it is remains unknown, and it will be found by measuring brightness.
+ */
+static int reg_exposure = 0x0206;
+module_param(reg_exposure, int, 0444);
+MODULE_PARM_DESC(reg_exposure, "Exposure register (default 0x0206).");
+
+/*
+ * THE GAIN IS FOUR REGISTERS, ONE PER CHANNEL
+ * -----------------------------------------------
+ * 0x0214, 0x0216, 0x0218 and 0x021a. All four have to be written with the same
+ * value to get a global gain; 512 is unity.
+ *
+ * This cost three rounds and two wrong conclusions, so it is worth
+ * writing down HOW a gain is told apart from what is not one:
+ *
+ *   - Mean brightness is NO good: it is raised by a longer exposure, by a gain
+ *     and by a black level offset. All three.
+ *   - The frame period rules out the exposure, but not the offset.
+ *   - What tells them apart is the STANDARD DEVIATION. A gain multiplies the
+ *     signal and its spread; an offset raises the floor and leaves the
+ *     spread unchanged, or squashes it.
+ *   - And none of this works if the sensor is not looking at a scene: on a
+ *     black image a zero gets amplified and every measurement lies.
+ *
+ * 0x0204 -which was here as a gain twice- is the BLACK LEVEL.
+ * Measured: moving it from 512 to 768 raises the mean from 20.5 to 82.0 but the
+ * deviation DROPS from 16.5 to 10.3 and the contrast is halved. It raises the
+ * floor, not the signal.
+ *
+ * And these four, measured per Bayer channel by writing only 0x0214:
+ *
+ *     canal   senal a 512   senal a 2048   factor
+ *       Gr           4,76           4,74     1,00
+ *        R           3,45           8,97     2,60
+ *        B           4,41           4,40     1,00
+ *       Gb           4,01          10,75     2,68
+ *
+ * Two channels amplified and two untouched, with the pedestal steady. That is a
+ * per-channel gain.
+ */
+static int reg_again = 0x0214;
+module_param(reg_again, int, 0444);
+MODULE_PARM_DESC(reg_again,
+	"First gain register (default 0x0214); four are written; 0 = none.");
+
+/* Cuantos registros consecutivos de ganancia se escriben, de dos en dos. */
+#define HI1337_CANALES_GANANCIA	4
+
+static int reg_vts = 0x020a;
+module_param(reg_vts, int, 0444);
+MODULE_PARM_DESC(reg_vts, "Frame length register (default 0x020a).");
+
+/*
+ * The mate of 0x020a. In the three factory tables it is always 4 above.
+ * At 0 it is left unwritten, so it can be checked whether it is really needed.
+ */
+static int reg_vts_par = 0x020e;
+module_param(reg_vts_par, int, 0444);
+MODULE_PARM_DESC(reg_vts_par,
+	"Second frame length register, +4 (default 0x020e); 0 = do not write it.");
+
+/*
+ * The MIPI switch ALWAYS goes to this sensor's position while it is
+ * powered on, because without that no image arrives. The parameter is kept to be able
+ * to leave it alone (=0) if some day the front camera needs debugging without
+ * unloading this driver.
+ */
+static int mipi_switch = 1;
+module_param(mipi_switch, int, 0444);
+MODULE_PARM_DESC(mipi_switch,
+	"1 (default) points the MIPI switch at this sensor; 0 leaves it alone.");
+
+static s64 hi1337_link_freq_menu[] = {
+	HI1337_LINK_FREQ,
+};
+
+/*
+ * The exact assignment of the four WL2866D LDOs among the five sensors
+ * is not known yet, and that is why the device tree leaves them always on.
+ * Here the three lanes that are identified are requested.
+ */
+static const char * const hi1337_supply_names[] = {
+	"vdda",		/* analogica */
+	"vddd",		/* digital */
+	"vddio",	/* entrada/salida, 1,8 V */
+};
+
