+/*
+ * Solo los dos controles obligatorios. La exposicion y la ganancia analogica
+ * de este sensor no estan localizadas con certeza -ver la cabecera-, y un
+ * control que escribe en el registro equivocado es peor que no tenerlo: falla
+ * de una forma que parece un problema del enlace.
+ */
+static int hi1337_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct hi1337 *hi1337 = container_of(ctrl->handler, struct hi1337,
+					     ctrl_handler);
+	int ret = 0;
+
+	/* Sin alimentacion no hay a quien escribir. */
+	if (!pm_runtime_get_if_in_use(hi1337->dev))
+		return 0;
+
+	/*
+	 * CERROJO DE GRUPO
+	 * ----------------
+	 * El blob de fabrica trae 0x0208=0x0100 y 0x0208=0x0000 como dos
+	 * "tablas" de UNA sola escritura, justo al lado del par de arranque y
+	 * parada del flujo (0x0b00). Ese es el patron clasico del cerrojo de
+	 * grupo: se cierra, se escriben los registros que deben cambiar a la
+	 * vez, y se abre; el sensor los aplica todos al empezar la trama
+	 * siguiente, no a mitad de la que esta leyendo.
+	 *
+	 * Sin esto la exposicion se escribia a pelo en mitad de una trama.
+	 * Medido: subirla funciona -1440 y 2880 van bien- pero bajarla rompe el
+	 * flujo, y el suelo cae justo por debajo del valor de fabrica: 720 va,
+	 * 690 no. Que el limite coincida con el valor de fabrica es demasiada
+	 * casualidad para ser un limite fisico del sensor.
+	 */
+	cci_write(hi1337->regmap, HI1337_REG_GROUP_HOLD,
+		  HI1337_GROUP_HOLD_ON, NULL);
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(hi1337->regmap, CCI_REG16(reg_exposure),
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		/* Los cuatro canales con el mismo valor: ganancia global. */
+		if (reg_again) {
+			unsigned int i;
+
+			for (i = 0; i < HI1337_CANALES_GANANCIA; i++) {
+				ret = cci_write(hi1337->regmap,
+						CCI_REG16(reg_again + i * 2),
+						ctrl->val, NULL);
+				if (ret)
+					break;
+			}
+		}
+		break;
+	case V4L2_CID_VBLANK:
+		/*
+		 * LA LONGITUD DE TRAMA SON DOS REGISTROS, NO UNO.
+		 *
+		 * En las TRES tablas de modo del blob de fabrica, 0x020a y
+		 * 0x020e van emparejados y la diferencia es siempre 4:
+		 *
+		 *     4208x3120: 0x020a=3307  0x020e=3311
+		 *     2104x1560: 0x020a=3307  0x020e=3311
+		 *     2104x1560: 0x020a=1662  0x020e=1666   (variante rapida)
+		 *
+		 * Se escribia solo el primero, asi que en cuanto alguien tocaba
+		 * el blanqueo vertical la pareja quedaba descuadrada. Encaja con
+		 * lo medido: doblar 0x020a de 3307 a 6614 no cambiaba NADA -ni el
+		 * periodo de trama ni el suelo de exposicion-, que es justo lo
+		 * que hace un sensor que ignora un par incoherente.
+		 */
+		ret = cci_write(hi1337->regmap, CCI_REG16(reg_vts),
+				hi1337->mode->height + ctrl->val, NULL);
+		if (ret)
+			break;
+		if (reg_vts_par)
+			ret = cci_write(hi1337->regmap, CCI_REG16(reg_vts_par),
+					hi1337->mode->height + ctrl->val + 4,
+					NULL);
+
+		/*
+		 * Y el techo de la exposicion tiene que seguir a la trama, que si
+		 * no se puede pedir una exposicion que no cabe dentro.
+		 *
+		 * Medido: con vblank=102 -trama de 1662- el control seguia
+		 * admitiendo 3303, que era el maximo calculado en el probe con la
+		 * trama por defecto de 3307. Y libcamera, a oscuras, pide
+		 * exactamente el maximo: acababa pidiendo el DOBLE de lo que cabe
+		 * y el sensor alargaba la trama para que cupiera, con lo que
+		 * acortarla no servia de nada.
+		 *
+		 * Es lo que hace hi846.c de mainline, que es el pariente cercano.
+		 */
+		if (hi1337->exposure) {
+			s64 max = hi1337->mode->height + ctrl->val -
+				  HI1337_EXPOSURE_MARGEN;
+
+			__v4l2_ctrl_modify_range(hi1337->exposure,
+						 hi1337->exposure->minimum,
+						 max, hi1337->exposure->step,
+						 min(hi1337->exposure->val, max));
+		}
+		break;
+	default:
+		break;
+	}
+
+	/* Abrir el cerrojo: el sensor aplica los cambios en la trama siguiente. */
+	cci_write(hi1337->regmap, HI1337_REG_GROUP_HOLD,
+		  HI1337_GROUP_HOLD_OFF, NULL);
+
+	pm_runtime_mark_last_busy(hi1337->dev);
+	pm_runtime_put_autosuspend(hi1337->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops hi1337_ctrl_ops = {
+	.s_ctrl = hi1337_set_ctrl,
+};
+
+/*
+ * libcamera EXIGE exposicion, ganancia analogica, HBLANK y VBLANK: sin los
+ * cuatro rechaza el sensor entero con "The sensor kernel driver needs to be
+ * fixed". Por eso estan aqui aunque las direcciones de dos de ellos sean
+ * provisionales -ver el comentario de los parametros-. Un control que escribe
+ * en el registro equivocado se nota: la imagen sale pero no responde. Sin el
+ * control no hay imagen siquiera.
+ */
+static int hi1337_init_controls(struct hi1337 *hi1337)
+{
+	struct v4l2_ctrl_handler *h = &hi1337->ctrl_handler;
+	const struct hi1337_mode *mode = hi1337->mode;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	s64 hblank, vblank;
+	int ret;
+
+	if (link_freq_hz) {
+		hi1337_link_freq_menu[0] = link_freq_hz;
+		dev_info(hi1337->dev, "frecuencia de enlace forzada: %lu Hz\n",
+			 link_freq_hz);
+	}
+
+	ret = v4l2_ctrl_handler_init(h, 8);
+	if (ret)
+		return ret;
+
+	ctrl = v4l2_ctrl_new_int_menu(h, NULL, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(hi1337_link_freq_menu) - 1, 0,
+				      hi1337_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ctrl = v4l2_ctrl_new_std(h, NULL, V4L2_CID_PIXEL_RATE, 0,
+				 hi1337_freq_to_pixel_rate(hi1337_link_freq_menu[0]), 1,
+				 hi1337_freq_to_pixel_rate(hi1337_link_freq_menu[0]));
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	hblank = mode->hts - mode->width;
+	ctrl = v4l2_ctrl_new_std(h, &hi1337_ctrl_ops, V4L2_CID_HBLANK,
+				 hblank, hblank, 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	/*
+	 * El MINIMO del blanqueo vertical era el propio valor por defecto, o
+	 * sea que la trama solo podia alargarse y nunca acortarse: libcamera no
+	 * tenia forma de acelerar la camara ni queriendo. Ahora baja hasta la
+	 * longitud de trama mas corta que usa el blob de fabrica.
+	 */
+	v4l2_ctrl_new_std(h, &hi1337_ctrl_ops, V4L2_CID_VBLANK,
+			  mode->vts_min - mode->height,
+			  0xffff - mode->height, 1, vblank);
+
+	/*
+	 * EL MINIMO ES 720, NO 4, Y ESTA MEDIDO.
+	 *
+	 * Por debajo de ~720 este sensor DEJA DE EMITIR: se le escribe el valor,
+	 * lo acepta y lo devuelve tal cual, y a partir de ahi no sale un solo
+	 * paquete por el CSI. Acotado por bisección: 720 va, 690 no.
+	 *
+	 * Declarar 4 no era inofensivo. Los controles PERSISTEN, asi que en
+	 * cuanto alguien pedia menos -el control automatico de libcamera o una
+	 * barra en la herramienta de calibracion- la camara se quedaba muerta y
+	 * TODAS las capturas siguientes esperaban su tiempo de espera entero y
+	 * devolvian cero bytes. Visto desde fuera parece una camara lentisima,
+	 * no una camara parada, que es lo que despista.
+	 *
+	 * Un driver no debe ofrecer un rango en el que su sensor no funciona.
+	 */
+	hi1337->exposure = v4l2_ctrl_new_std(h, &hi1337_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     HI1337_EXPOSURE_MINIMA,
+					     mode->vts - HI1337_EXPOSURE_MARGEN,
+					     1, mode->exposure);
+
+	/*
+	 * Suelo: el valor de fabrica de ESTE modo, porque por debajo el binado
+	 * deja de transmitir. Techo: abierto, porque el escalon medido esta en
+	 * 0x0300 y el limite de arriba todavia no se ha buscado.
+	 */
+	/* 512 es la unidad en los cuatro registros de canal, en los dos modos. */
+	v4l2_ctrl_new_std(h, &hi1337_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  512, 0x0fff, 1, 512);
+
+	/*
+	 * Donde mira la camara y como esta montada, sacado del device tree.
+	 * Sin esto libcamera avisa "Failed to retrieve the camera location",
+	 * lista la camara como 'hi1337' en vez de "Internal back camera", y la
+	 * imagen sale girada porque nadie le ha dicho como enderezarla. Las
+	 * otras dos ya lo hacen; ver 0096-orientacion-y-rotacion.
+	 */
+	ret = v4l2_fwnode_device_parse(hi1337->dev, &props);
+	if (ret) {
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+
+	ret = v4l2_ctrl_new_fwnode_properties(h, &hi1337_ctrl_ops, &props);
+	if (ret) {
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+
+	if (h->error) {
+		ret = h->error;
+		dev_err(hi1337->dev, "fallo montando los controles: %d\n", ret);
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+
+	hi1337->sd.ctrl_handler = h;
+
+	return 0;
+}
+
+/*
+ * s_stream CLASICO, y no el par enable_streams/disable_streams que traia el
+ * driver de la frontal.
+ *
+ * Medido: con enable_streams el nucleo toma el camino de la API de "streams",
+ * que exige la bandera V4L2_SUBDEV_FL_STREAMS y rutas declaradas, y camss
+ * fallaba con
+ *
+ *     collect_streams: sub-device "hi1337 14-0021" does not support streams
+ *
+ * despues de haber validado la tuberia ENTERA. El driver del IMX682, que si
+ * captura con esta misma camss, usa .s_stream a secas: sin enable_streams el
+ * nucleo cae a esa via. Alinearse con el caso que funciona sale mas barato que
+ * implementar rutas.
+ */
+static int hi1337_parar(struct v4l2_subdev *sd);
+
+/*
+ * EL CONMUTADOR MIPI ES DE QUIEN ESTA TRANSMITIENDO
+ * -------------------------------------------------
+ * La frontal y el gran angular comparten la entrada CSIPHY1 del SoC a traves
+ * de un conmutador MIPI, asi que el conmutador es un recurso compartido y hay
+ * que cogerlo mientras se USA, no mientras se esta encendido.
+ *
+ * La primera version lo cogia en hi1337_power_on(). Parecia razonable y estaba
+ * mal: el sensor se queda encendido bastante despues de dejar de usarse
+ * -runtime PM con autosuspend, y ademas libcamera lo deja en "active" al
+ * cerrar la camara-, asi que el conmutador seguia apuntando aqui y la frontal
+ * capturaba CERO paquetes con todo lo demas correcto: enlaces bien, formato
+ * bien, frecuencia bien y s_stream sin quejarse. Un fallo mudo y lejos de su
+ * causa, que es la peor clase.
+ *
+ * Cogido en s_stream(1) y soltado en la parada, la ventana en la que este
+ * sensor se queda el bus es exactamente la que lo necesita.
+ */
+static int hi1337_coger_conmutador(struct hi1337 *hi1337)
+{
+	int ret;
+
+	if (hi1337->conmutador_cogido || mipi_switch == 0)
+		return 0;
+
+	if (hi1337->mipi_switch_reg) {
+		ret = regulator_enable(hi1337->mipi_switch_reg);
+		if (ret)
+			return ret;
+	}
+	gpiod_set_value_cansleep(hi1337->mipi_switch_oe, 1);
+	hi1337->conmutador_cogido = true;
+
+	return 0;
+}
+
+static void hi1337_soltar_conmutador(struct hi1337 *hi1337)
+{
+	if (!hi1337->conmutador_cogido)
+		return;
+
+	gpiod_set_value_cansleep(hi1337->mipi_switch_oe, 0);
+	if (hi1337->mipi_switch_reg)
+		regulator_disable(hi1337->mipi_switch_reg);
+	hi1337->conmutador_cogido = false;
+}
+
+static int hi1337_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	const struct hi1337_reg_list *reg_list;
+	int ret;
+
+	if (!enable)
+		return hi1337_parar(sd);
+
+	ret = pm_runtime_resume_and_get(hi1337->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = hi1337_coger_conmutador(hi1337);
+	if (ret) {
+		dev_err(hi1337->dev, "no pude coger el conmutador MIPI\n");
+		goto err_rpm_put;
+	}
+
+	/*
+	 * El reinicio por pagina del Samsung no existe aqui: el Hi-1337 sale
+	 * del reset fisico listo para recibir la tabla.
+	 */
+	ret = cci_multi_reg_write(hi1337->regmap, hi1337_init,
+				  ARRAY_SIZE(hi1337_init), NULL);
+	if (ret) {
+		dev_err(hi1337->dev, "fallo la tabla de inicializacion\n");
+		goto err_rpm_put;
+	}
+
+	reg_list = &hi1337->mode->reg_list;
+	ret = cci_multi_reg_write(hi1337->regmap, reg_list->regs,
+				  reg_list->num_regs, NULL);
+	if (ret) {
+		dev_err(hi1337->dev, "fallo la tabla del modo\n");
+		goto err_rpm_put;
+	}
+
+	/*
+	 * Los controles ANTES de arrancar, que es lo que hacen los demas
+	 * drivers.
+	 *
+	 * Estuvieron un rato despues, por una medida que resulto ser una
+	 * carrera: creí haber demostrado que el sensor solo se atraganta al
+	 * ARRANCAR con una exposicion corta y que bajarla en marcha iba bien
+	 * -"30 fotogramas de 30"-. Pero esa captura de 30 fotogramas a 47 ms
+	 * termina en 1,4 s y yo bajaba la exposicion a los 3 s: cuando ya no
+	 * quedaba nada que medir. Repetida con 100 fotogramas y bajandola al
+	 * segundo, entran 14 y el flujo MUERE. El suelo es real y tambien
+	 * aplica en marcha, asi que reordenar no arreglaba nada y solo alejaba
+	 * este driver de lo que hace todo el mundo.
+	 *
+	 * Lo que sigue sin explicacion es el suelo en si: entre 700 y 720, el
+	 * mismo en los dos modos, sin relacion con vts ni con la altura, y con
+	 * el chip aceptando y devolviendo cualquier valor que se le escriba
+	 * -incluido 0x0004-. Ver docs/CAMARA-06.
+	 */
+	ret = __v4l2_ctrl_handler_setup(&hi1337->ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	/*
+	 * Sin volteos: el gran angular mira hacia atras, no hace falta darle
+	 * la vuelta. Y donde estan sus bits de volteo tampoco esta confirmado.
+	 */
+	ret = cci_write(hi1337->regmap, HI1337_REG_CTRL_MODE,
+			HI1337_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	hi1337_soltar_conmutador(hi1337);
+	pm_runtime_mark_last_busy(hi1337->dev);
+	pm_runtime_put_autosuspend(hi1337->dev);
+
+	return ret;
+}
+
+static int hi1337_parar(struct v4l2_subdev *sd)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	int ret;
+
+	ret = cci_write(hi1337->regmap, HI1337_REG_CTRL_MODE, 0, NULL);
+
+	hi1337_soltar_conmutador(hi1337);
+	pm_runtime_mark_last_busy(hi1337->dev);
+	pm_runtime_put_autosuspend(hi1337->dev);
+
+	return ret;
+}
+
+/*
+ * EL DISPARADOR DE TRANSMISION
+ *
+ * Existe porque camss todavia NO esta cableado a este sensor, y con razon: el
+ * parche 0051 dejo escrito que declarar un puerto en camss cuyo sensor no
+ * arranque hace perder /dev/media0, y con el la camara frontal, que si
+ * funciona. Cablearlo es un paso con riesgo y hay que darlo a sabiendas.
+ *
+ * Pero sin camss nadie llama a enable_streams(), asi que no habia forma de
+ * saber si el sensor llega a emitir. Con esto se comprueba lo importante -que
+ * las 1544 escrituras entran sin error y que el sensor arranca el flujo- sin
+ * tocar nada de lo que ya va:
+ *
+ *     echo 1 > /sys/module/hi1337/parameters/transmitir
+ *     echo 0 > /sys/module/hi1337/parameters/transmitir
+ *
+ * Es el mismo truco que la sonda del buscador, y por el mismo motivo: separar
+ * la pregunta cara -recompilar, arriesgar el arranque- de la pregunta barata.
+ */
+static struct hi1337 *hi1337_vivo;
+
+static int transmitir_set(const char *val, const struct kernel_param *kp)
+{
+	struct hi1337 *h = READ_ONCE(hi1337_vivo);
+	unsigned int on;
+	int ret;
+
+	if (!h)
+		return -ENODEV;
+	if (kstrtouint(val, 0, &on))
+		return -EINVAL;
+
+	if (!on) {
+		ret = cci_write(h->regmap, HI1337_REG_CTRL_MODE, 0, NULL);
+		dev_info(h->dev, "transmision parada (%d)\n", ret);
+		pm_runtime_mark_last_busy(h->dev);
+		pm_runtime_put_autosuspend(h->dev);
+		return 0;
+	}
+
+	ret = pm_runtime_resume_and_get(h->dev);
+	if (ret < 0) {
+		dev_info(h->dev, "no se pudo despertar: %d\n", ret);
+		return 0;
+	}
+
+	ret = cci_multi_reg_write(h->regmap, hi1337_init,
+				  ARRAY_SIZE(hi1337_init), NULL);
+	if (ret) {
+		dev_info(h->dev, "la inicializacion fallo en i2c: %d\n", ret);
+		goto suelta;
+	}
+	dev_info(h->dev, "inicializacion escrita: %u registros\n",
+		 (unsigned int)ARRAY_SIZE(hi1337_init));
+
+	ret = cci_multi_reg_write(h->regmap, h->mode->reg_list.regs,
+				  h->mode->reg_list.num_regs, NULL);
+	if (ret) {
+		dev_info(h->dev, "la tabla del modo fallo en i2c: %d\n", ret);
+		goto suelta;
+	}
+	dev_info(h->dev, "modo %ux%u escrito: %u registros\n",
+		 h->mode->width, h->mode->height, h->mode->reg_list.num_regs);
+
+	ret = cci_write(h->regmap, HI1337_REG_CTRL_MODE,
+			HI1337_MODE_STREAMING, NULL);
+	dev_info(h->dev, "TRANSMITIENDO (%d), MCLK a %lu Hz\n",
+		 ret, clk_get_rate(h->mclk));
+	return 0;
+
+suelta:
+	pm_runtime_mark_last_busy(h->dev);
+	pm_runtime_put_autosuspend(h->dev);
+	return 0;
+}
+
+/*
+ * LA SONDA DE 16 BITS
+ *
+ * Existe porque medir este sensor desde el espacio de usuario NO SE PUEDE
+ * hacer con i2cdump: el bus del CCI no admite las transacciones combinadas de
+ * i2ctransfer, e i2cdump lee de 8 en 8 bits sobre un chip de 16. Eso no es
+ * leer, es ESCRIBIR -el segundo byte entra como dato- y este repositorio ya lo
+ * tiene documentado como trampa.
+ *
+ * Yo mismo cai en ella: di por bueno que el sensor "estaba emitiendo" mirando
+ * una huella sacada con i2cdump, cuando esa huella puede ser un artefacto de
+ * mis propias escrituras.
+ *
+ *     echo "0b00"      > /sys/module/hi1337/parameters/sonda   # leer
+ *     echo "0b00 0100" > /sys/module/hi1337/parameters/sonda   # escribir y releer
+ */
+static int sonda_set(const char *val, const struct kernel_param *kp)
+{
+	struct hi1337 *h = READ_ONCE(hi1337_vivo);
+	unsigned int reg, dato = 0;
+	u64 leido = 0;
+	int n, ret;
+
+	if (!h)
+		return -ENODEV;
+
+	n = sscanf(val, "%x %x", &reg, &dato);
+	if (n < 1 || reg > 0xffff || (n >= 2 && dato > 0xffff))
+		return -EINVAL;
+
+	ret = pm_runtime_resume_and_get(h->dev);
+	if (ret < 0) {
+		dev_info(h->dev, "sonda: no se pudo despertar: %d\n", ret);
+		return 0;
+	}
+
+	if (n >= 2) {
+		ret = cci_write(h->regmap, CCI_REG16(reg), dato, NULL);
+		if (ret)
+			dev_info(h->dev, "sonda: escribir %04x=%04x fallo\n",
+				 reg, dato);
+	}
+
+	ret = cci_read(h->regmap, CCI_REG16(reg), &leido, NULL);
+	if (ret)
+		dev_info(h->dev, "sonda: %04x no contesta\n", reg);
+	else
+		dev_info(h->dev, "sonda: %04x = %04llx\n", reg, leido);
+
+	pm_runtime_mark_last_busy(h->dev);
+	pm_runtime_put_autosuspend(h->dev);
+
+	return 0;
+}
+
+static const struct kernel_param_ops sonda_ops = { .set = sonda_set };
+module_param_cb(sonda, &sonda_ops, NULL, 0200);
+MODULE_PARM_DESC(sonda,
+		 "\"reg\" lee 16 bits, \"reg dato\" escribe y relee; sale por dmesg");
+
+static const struct kernel_param_ops transmitir_ops = { .set = transmitir_set };
+module_param_cb(transmitir, &transmitir_ops, NULL, 0200);
+MODULE_PARM_DESC(transmitir,
+		 "1 escribe las tablas y arranca el flujo, 0 lo para; la respuesta sale por dmesg");
+
+static void hi1337_update_pad_format(const struct hi1337_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = hi1337_get_format_code();
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int hi1337_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	const struct hi1337_mode *mode;
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(hi1337_supported_modes,
+				      ARRAY_SIZE(hi1337_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	hi1337_update_pad_format(mode, &fmt->format);
+
+	format = v4l2_subdev_state_get_format(state, 0);
+	*format = fmt->format;
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	/*
+	 * Aqui el driver de la frontal reajusta los rangos de hblank, vblank y
+	 * exposicion. Este no: no expone esos controles porque no se sabe en
+	 * que registros viven en el Hi-1337, y tocarlos a ciegas rompe el
+	 * enlace de una forma que parece un problema de CSI.
+	 */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		hi1337->mode = mode;
+
+	return 0;
+}
+
+static int hi1337_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = hi1337_get_format_code();
+
+	return 0;
+}
+
+static int hi1337_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(hi1337_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != hi1337_get_format_code())
+		return -EINVAL;
+
+	fse->min_width = hi1337_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = hi1337_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int hi1337_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		/*
+		 * Aqui habia 5184x3880 a pelo, que es la matriz del S5K3T2: se
+		 * quedo del driver del que se porto esto. El Hi-1337 es de 13 MP,
+		 * no de 20. Se veia desde fuera, en cam --list-properties:
+		 *
+		 *     camara 2 (hi1337):  PixelArraySize = 5184x3880
+		 *     camara 3 (s5k3t2):  PixelArraySize = 5184x3880
+		 *
+		 * Dos sensores distintos declarando la misma matriz. libcamera
+		 * usa ese tamano para el recorte y el campo de vision, asi que un
+		 * numero prestado sale por ahi como geometria equivocada.
+		 *
+		 * Se saca del modo mas grande en vez de escribirlo, para que no
+		 * pueda volver a separarse de la realidad.
+		 */
+		sel->r.width = hi1337_supported_modes[ARRAY_SIZE(hi1337_supported_modes) - 1].width;
+		sel->r.height = hi1337_supported_modes[ARRAY_SIZE(hi1337_supported_modes) - 1].height;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int hi1337_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = hi1337_supported_modes[0].width,
+			.height = hi1337_supported_modes[0].height,
+		},
+	};
+
+	return hi1337_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops hi1337_video_ops = {
+	.s_stream = hi1337_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops hi1337_pad_ops = {
+	.enum_mbus_code = hi1337_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = hi1337_set_pad_format,
+	.enum_frame_size = hi1337_enum_frame_size,
+	.get_selection = hi1337_get_selection,
+};
+
+static const struct v4l2_subdev_ops hi1337_subdev_ops = {
+	.video = &hi1337_video_ops,
+	.pad = &hi1337_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops hi1337_internal_ops = {
+	.init_state = hi1337_init_state,
+};
+
+static const struct media_entity_operations hi1337_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+/* Lee la identificacion en una direccion concreta, sin usar el regmap. */
+/*
+ * OJO CON LA DIRECCION DEL REGISTRO, que ya ha mordido dos veces.
+ *
+ * Esta funcion venia del s5k3t2 con el registro CABLEADO a 0x0000, porque en
+ * el Samsung la identificacion vive ahi. Al portarla se renombraron las
+ * constantes pero esta se quedo, y el driver leia 0x0000 -que en el Hi-1337
+ * vale 0- y concluia "no encuentro el sensor" con el sensor delante,
+ * contestando.
+ *
+ * Es el mismo fallo que ya bloqueo la investigacion entera cuando el buscador
+ * leia 0x0f16 por copiarlo del hi846. Una constante heredada de un driver
+ * hermano es una suposicion, aunque venga dentro de codigo que funciona.
+ */
+static int hi1337_probe_id_at(struct i2c_client *client, u8 addr, u16 *id)
+{
+	u8 reg[2] = { HI1337_ID_REG_HI, HI1337_ID_REG_LO };
+	u8 val[2];
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0, .len = 2, .buf = reg },
+		{ .addr = addr, .flags = I2C_M_RD, .len = 2, .buf = val },
+	};
+	int ret;
+
+	ret = i2c_transfer(client->adapter, msgs, 2);
+	if (ret != 2)
+		return -ENODEV;
+
+	*id = (val[0] << 8) | val[1];
+
+	return 0;
+}
+
+/*
+ * El fichero de fabrica NO trae la direccion del sensor -su unico slaveAddr es
+ * la EEPROM-, asi que se busca leyendo la identificacion. Es la misma trampa
+ * que con el trasero, donde el 0x50 "documentado" resulto ser la EEPROM y el
+ * sensor estaba en 0x1a.
+ */
+static int hi1337_find_sensor(struct hi1337 *hi1337, struct i2c_client *client)
+{
+	static const u8 probables[] = { 0x10, 0x2d, 0x1a, 0x16, 0x20, 0x36, 0x3c, 0x5a };
+	u16 id;
+	int i;
+
+	if (i2c_addr >= 0) {
+		client->addr = i2c_addr;
+		dev_info(hi1337->dev, "direccion forzada por parametro: 0x%02x\n",
+			 i2c_addr);
+		return 0;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(probables); i++) {
+		if (!hi1337_probe_id_at(client, probables[i], &id) &&
+		    id == HI1337_CHIP_ID) {
+			dev_info(hi1337->dev, "HI1337 encontrado en 0x%02x\n",
+				 probables[i]);
+			client->addr = probables[i];
+			return 0;
+		}
+	}
+
+	/* Nada en las probables: barrido completo, y se dice quien contesta. */
+	for (i = 0x08; i <= 0x77; i++) {
+		if (hi1337_probe_id_at(client, i, &id))
+			continue;
+
+		dev_info(hi1337->dev, "contesta 0x%02x, identificacion 0x%04x\n",
+			 i, id);
+
+		if (id == HI1337_CHIP_ID) {
+			client->addr = i;
+			return 0;
+		}
+	}
+
+	return -ENODEV;
+}
+
+static int hi1337_check_hwcfg(struct hi1337 *hi1337)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(hi1337->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = HI1337_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != HI1337_DATA_LANES) {
+		dev_err(hi1337->dev, "hacen falta %u carriles, el device tree dice %u\n",
+			HI1337_DATA_LANES, bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(hi1337->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       hi1337_link_freq_menu,
+				       ARRAY_SIZE(hi1337_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int hi1337_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(HI1337_NUM_SUPPLIES, hi1337->supplies);
+	if (ret)
+		return ret;
+
+	/*
+	 * El MCLK NO se toca aqui: se enciende una sola vez en el probe y se
+	 * queda girando mientras el driver este enlazado. Ver el comentario
+	 * largo del probe.
+	 */
+
+	/*
+	 * El conmutador MIPI NO se toca aqui. Se coge al empezar a transmitir
+	 * y se suelta al parar: ver hi1337_coger_conmutador(). Antes se hacia
+	 * en el encendido y estaba MAL, porque el sensor puede quedarse
+	 * encendido mucho despues de dejar de usarse -runtime PM con
+	 * autosuspend, y libcamera lo deja "active" al cerrar-, y mientras
+	 * tanto la frontal se quedaba sin bus y capturaba cero paquetes.
+	 */
+
+	gpiod_set_value_cansleep(hi1337->reset_gpio, 0);
+	usleep_range(10 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+
+	/*
+	 * Decir en voz alta si el reloj esta girando de verdad. La primera
+	 * version no lo decia, y como leer la identificacion por i2c NO
+	 * necesita MCLK, un reloj parado pasaba desapercibido hasta mucho
+	 * despues, cuando no llegara imagen. Eso es lo peor que puede hacer un
+	 * fallo: aparecer lejos de donde se causa.
+	 */
+	dev_dbg(dev, "encendido: MCLK a %lu Hz\n", clk_get_rate(hi1337->mclk));
+
+	return 0;
+}
+
+static int hi1337_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	gpiod_set_value_cansleep(hi1337->reset_gpio, 1);
+	hi1337_soltar_conmutador(hi1337);
+	regulator_bulk_disable(HI1337_NUM_SUPPLIES, hi1337->supplies);
+
+	return 0;
+}
+
+static int hi1337_probe(struct i2c_client *client)
+{
+	struct hi1337 *hi1337;
+	unsigned long freq;
+	unsigned int i;
+	u16 id;
+	int ret;
+
+	hi1337 = devm_kzalloc(&client->dev, sizeof(*hi1337), GFP_KERNEL);
+	if (!hi1337)
+		return -ENOMEM;
+
+	hi1337->dev = &client->dev;
+
+	/*
+	 * Esto va lo primero, y no es cosmetico: es lo que deja el subdev
+	 * colgado del device, y hi1337_power_on() lo busca ahi con
+	 * dev_get_drvdata(). Encender antes de esta linea es una
+	 * desreferencia a NULL nada mas arrancar.
+	 */
+	v4l2_i2c_subdev_init(&hi1337->sd, client, &hi1337_subdev_ops);
+
+	/*
+	 * devm_clk_get() a secas, y NO el devm_v4l2_sensor_clk_get() que traia
+	 * el driver de la frontal. Medido: con aquel, al encender el reloj la
+	 * habilitacion NO se propagaba al padre -camcc_mclk3_clk_src se quedaba
+	 * en enable_cnt 0- y la rama reportaba "status stuck at off". El
+	 * buscador enciende ese mismo MCLK3 sin problema pidiendolo por la via
+	 * normal, y ahi el padre sube a 1: esa es la unica diferencia entre los
+	 * dos casos, y es la que se cambia aqui.
+	 */
+	hi1337->mclk = devm_clk_get(hi1337->dev, "xvclk");
+	if (IS_ERR(hi1337->mclk))
+		return dev_err_probe(hi1337->dev, PTR_ERR(hi1337->mclk),
+				     "no pude coger el MCLK\n");
+
+	/*
+	 * La frecuencia se pone AQUI y no con assigned-clocks en el device
+	 * tree: aquello lo aplica el nucleo al registrar el nodo y cuelga el
+	 * arranque en este SoC. Ver el comentario del nodo en el dtsi.
+	 */
+	ret = clk_set_rate(hi1337->mclk, HI1337_MCLK_FREQ);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "el MCLK no acepta %lu Hz\n",
+				     (unsigned long)HI1337_MCLK_FREQ);
+
+	/*
+	 * EL MCLK SE ENCIENDE UNA SOLA VEZ Y SE QUEDA GIRANDO
+	 *
+	 * Medido en la placa, y costo tres hipotesis descartadas: sobre el mismo
+	 * manejador de reloj, la secuencia encender -> apagar -> encender FALLA.
+	 * El segundo encendido reporta "camcc_mclk3_clk status stuck at 'off'",
+	 * el resume de runtime PM falla y el dispositivo se queda suspendido
+	 * para siempre.
+	 *
+	 * No es de la plataforma: el buscador enciende ESE MISMO MCLK3 dos veces
+	 * seguidas sin quejarse... porque cada vez lo hace con un manejador
+	 * recien pedido y nunca lo apaga en medio. Esa es la unica diferencia
+	 * que queda entre los dos casos.
+	 *
+	 * Descartado antes, y por medida, no por corazonada:
+	 *   - el GDSC de camara (camcc_titan_top_gdsc sigue apagado con el
+	 *     buscador manteniendo el reloj encendido),
+	 *   - devm_v4l2_sensor_clk_get() frente a devm_clk_get(),
+	 *   - volver a fijar la frecuencia antes de cada encendido.
+	 *
+	 * Asi que el reloj se enciende aqui y se apaga en el remove. Runtime PM
+	 * sigue gobernando rieles y reset, que es lo que de verdad consume. Un
+	 * MCLK de 19,2 MHz girando cuesta poco, y hasta que se entienda por que
+	 * la rama no vuelve a arrancar, esto es honesto y funciona.
+	 */
+	ret = clk_prepare_enable(hi1337->mclk);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "el MCLK no arranca\n");
+
+	freq = clk_get_rate(hi1337->mclk);
+	if (freq != HI1337_MCLK_FREQ)
+		return dev_err_probe(hi1337->dev, -EINVAL,
+				     "el MCLK se quedo en %lu Hz y las tablas son para %lu\n",
+				     freq, (unsigned long)HI1337_MCLK_FREQ);
+
+	ret = hi1337_check_hwcfg(hi1337);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "el device tree no cuadra\n");
+
+	hi1337->reset_gpio = devm_gpiod_get_optional(hi1337->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(hi1337->reset_gpio))
+		return dev_err_probe(hi1337->dev, PTR_ERR(hi1337->reset_gpio),
+				     "no pude coger el pin de reset\n");
+
+	for (i = 0; i < HI1337_NUM_SUPPLIES; i++)
+		hi1337->supplies[i].supply = hi1337_supply_names[i];
+
+	ret = devm_regulator_bulk_get(hi1337->dev, HI1337_NUM_SUPPLIES,
+				      hi1337->supplies);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "no pude coger los reguladores\n");
+
+	/*
+	 * El conmutador MIPI que comparten la frontal y el gran angular. Se
+	 * pide como opcional y solo se toca si lo mandan por parametro: no se
+	 * conduce un pin cuya posicion correcta todavia no esta medida.
+	 */
+	/*
+	 * La segunda señal del conmutador MIPI. Sin ella el CSID no ve un solo
+	 * paquete por mucho que el sensor transmita: es opcional en el codigo
+	 * pero imprescindible en esta placa.
+	 */
+	hi1337->mipi_switch_oe = devm_gpiod_get_optional(hi1337->dev,
+							"mipi-switch-oe",
+							GPIOD_OUT_LOW);
+	if (IS_ERR(hi1337->mipi_switch_oe))
+		return dev_err_probe(hi1337->dev, PTR_ERR(hi1337->mipi_switch_oe),
+				     "no pude coger la señal OE del conmutador\n");
+
+	hi1337->mipi_switch_reg = devm_regulator_get_optional(hi1337->dev,
+							      "mipi-switch");
+	if (IS_ERR(hi1337->mipi_switch_reg))
+		hi1337->mipi_switch_reg = NULL;
+
+	/* Hay que alimentarlo y darle reloj antes de que conteste por I2C. */
+	ret = hi1337_power_on(hi1337->dev);
+	if (ret)
+		return ret;
+
+	ret = hi1337_find_sensor(hi1337, client);
+	if (ret) {
+		dev_err(hi1337->dev, "no encuentro el HI1337 en el bus\n");
+		goto power_off;
+	}
+
+	hi1337->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(hi1337->regmap)) {
+		ret = dev_err_probe(hi1337->dev, PTR_ERR(hi1337->regmap),
+				    "no pude arrancar el CCI\n");
+		goto power_off;
+	}
+
+	ret = hi1337_probe_id_at(client, client->addr, &id);
+	if (ret || id != HI1337_CHIP_ID) {
+		dev_err(hi1337->dev, "identificacion 0x%04x, esperaba 0x%04x\n",
+			id, HI1337_CHIP_ID);
+		ret = -ENODEV;
+		goto power_off;
+	}
+
+	dev_info(hi1337->dev, "ES UN HI1337: identificacion 0x%04x en 0x%02x\n",
+		 id, client->addr);
+
+	hi1337->mode = &hi1337_supported_modes[0];
+	WRITE_ONCE(hi1337_vivo, hi1337);
+
+	ret = hi1337_init_controls(hi1337);
+	if (ret) {
+		dev_err_probe(hi1337->dev, ret, "fallaron los controles\n");
+		goto power_off;
+	}
+
+	hi1337->sd.state_lock = hi1337->ctrl_handler.lock;
+	hi1337->sd.internal_ops = &hi1337_internal_ops;
+	hi1337->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	hi1337->sd.entity.ops = &hi1337_subdev_entity_ops;
+	hi1337->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	hi1337->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&hi1337->sd.entity, 1, &hi1337->pad);
+	if (ret)
+		goto ctrl_free;
+
+	ret = v4l2_subdev_init_finalize(&hi1337->sd);
+	if (ret < 0)
+		goto media_cleanup;
+
+	pm_runtime_set_active(hi1337->dev);
+	pm_runtime_enable(hi1337->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&hi1337->sd);
+	if (ret < 0) {
+		dev_err_probe(hi1337->dev, ret, "no pude registrar el subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(hi1337->dev, 1000);
+	pm_runtime_use_autosuspend(hi1337->dev);
+	pm_runtime_idle(hi1337->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&hi1337->sd);
+	pm_runtime_disable(hi1337->dev);
+	clk_disable_unprepare(hi1337->mclk);
+	pm_runtime_set_suspended(hi1337->dev);
+
+media_cleanup:
+	media_entity_cleanup(&hi1337->sd.entity);
+
+ctrl_free:
+	v4l2_ctrl_handler_free(&hi1337->ctrl_handler);
+
+power_off:
+	hi1337_power_off(hi1337->dev);
+
+	return ret;
+}
+
+static void hi1337_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	WRITE_ONCE(hi1337_vivo, NULL);
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(hi1337->dev);
+
+	if (!pm_runtime_status_suspended(hi1337->dev)) {
+		hi1337_power_off(hi1337->dev);
+		pm_runtime_set_suspended(hi1337->dev);
+	}
+
+	/*
+	 * Y el MCLK, que ya no lo apaga power_off: se enciende en el probe y
+	 * vive lo que viva el enlace, asi que hay que pararlo AQUI.
+	 *
+	 * Se olvido en la primera version y el reloj se quedaba girando tras el
+	 * rmmod -visible en clk_summary como camcc_mclk3_clk con enable=1 y sin
+	 * consumidor-. Es la misma fuga que ya tuvo el buscador con los rieles,
+	 * y se encontro igual: mirando el estado despues de descargar en vez de
+	 * dar por hecho que se habia limpiado.
+	 */
+	clk_disable_unprepare(hi1337->mclk);
+}
+
+static const struct dev_pm_ops hi1337_pm_ops = {
+	SET_RUNTIME_PM_OPS(hi1337_power_off, hi1337_power_on, NULL)
+};
+
+static const struct of_device_id hi1337_of_match[] = {
+	{ .compatible = "hynix,hi1337" },
+	{ /* sentinel */ }
+};
+/*
+ * AHORA SI, con MODULE_DEVICE_TABLE. Se quito mientras el driver era una
+ * primera version sin probar, para que un fallo suyo no pudiera dejar el movil
+ * sin arrancar. Ya no es el caso: identifica el sensor, aguanta ciclos de
+ * suspender y despertar sin un aviso, y escribe las 1544 entradas de las tablas
+ * sin un error de i2c.
+ *
+ * Y ahora hace falta: camss espera a que aparezca el subdev del sensor de su
+ * puerto, y si nadie carga el modulo esa espera no termina nunca y se pierde
+ * /dev/media0.
+ */
+MODULE_DEVICE_TABLE(of, hi1337_of_match);
+
+static struct i2c_driver hi1337_i2c_driver = {
+	.driver = {
+		.name = "hi1337",
+		.pm = &hi1337_pm_ops,
+		.of_match_table = hi1337_of_match,
+	},
+	.probe = hi1337_probe,
+	.remove = hi1337_remove,
+};
+
+module_i2c_driver(hi1337_i2c_driver);
+
+MODULE_DESCRIPTION("SK Hynix Hi-1337: el gran angular del POCO X3 NFC");
+MODULE_LICENSE("GPL");

