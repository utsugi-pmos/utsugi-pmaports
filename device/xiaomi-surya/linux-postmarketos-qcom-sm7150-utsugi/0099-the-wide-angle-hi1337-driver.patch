+++ b/drivers/media/i2c/hi1337.c
@@ -0,0 +1,3158 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SK Hynix Hi-1337: el gran angular del Xiaomi POCO X3 NFC (surya).
+ *
+ * DE DONDE SALE ESTE DRIVER
+ * -------------------------
+ * Es un port del hi1337.c de este mismo arbol -la camara frontal, que ya
+ * funciona de punta a punta- porque los dos sensores estan cableados igual:
+ * cuatro carriles D-PHY. No se ha reescrito lo que ya estaba probado.
+ *
+ * EL FALLO QUE COSTO LA INVESTIGACION ENTERA, Y QUE NO HAY QUE REPETIR
+ * -------------------------------------------------------------------
+ * El buscador que encontro este sensor leia su identificacion en 0x0f16,
+ * copiado del driver hi846 de mainline dando por hecho que otro sensor de SK
+ * Hynix la tendria en el mismo sitio. NO la tiene: el Hi-1337 la pone en
+ * 0x0716. Durante rondas enteras se leyo 0000 y se interpreto como "el sensor
+ * esta muerto", cuando significaba "ese registro no existe aqui".
+ *
+ * Asi que de este driver hermano se copia la ESTRUCTURA, no las constantes.
+ * Cada direccion de registro de aqui abajo sale del fichero de fabrica de este
+ * modulo o esta medida en el chip, y se dice cual es cual.
+ *
+ * DE DONDE SALEN LAS TABLAS
+ * -------------------------
+ * De com.qti.sensormodule.j20c_sunny_hi1337_ultra.bin, el fichero del propio
+ * movil, leido con surya/camara/leer-sensormodule.py --tablas. Son 1457
+ * escrituras de inicializacion y 87 por modo.
+ *
+ * Las primeras cientos de la inicializacion van a 0x2000 y arriba, con valores
+ * tipo 40b2 b05c 8446: eso no son ajustes, es microcodigo para el secuenciador
+ * interno del sensor.
+ *
+ * LO QUE ESTA MEDIDO EN EL CHIP, no deducido
+ * ------------------------------------------
+ *   0x0716 = 0x1337    la identificacion
+ *   0x0b12 = 4208      ancho de salida
+ *   0x0b14 = 3120      alto de salida
+ *
+ * Los dos ultimos coinciden con lo que dice la tabla de fabrica, que es la
+ * comprobacion cruzada de que las tablas son de este sensor.
+ *
+ * LO QUE NO ESTA RESUELTO, y por eso no se toca
+ * ---------------------------------------------
+ * No se sabe con certeza donde tiene el Hi-1337 la exposicion ni la ganancia
+ * analogica. Estan en algun sitio del bloque 0x0200 -las ganancias digitales
+ * por canal si estan localizadas, en 0x0214..0x021a, y salen del propio
+ * fichero de fabrica-, pero adivinar cual es cual solo sirve para escribir en
+ * un registro equivocado. Asi que esta version NO expone controles de
+ * exposicion ni ganancia: se queda con lo que ponen las tablas.
+ *
+ * Esa es toda la diferencia con el driver de la frontal, y es deliberada.
+ *
+ * LA FRECUENCIA DE ENLACE ES PROVISIONAL
+ * --------------------------------------
+ * De los registros del PLL del modo completo, el multiplicador de la primera
+ * cadena (0x0736) vale 90, que con INCK = 19,2 MHz da 1728 MHz de VCO y por
+ * tanto 864 MHz de reloj de enlace. Cuadra de sobra con lo que pide el modo
+ * completo (4208 x 3120 x 30 fps x 10 bits / 4 carriles / 2 = 493 MHz minimo),
+ * pero la estructura exacta del PLL de este sensor no esta documentada y no se
+ * ha podido verificar por un segundo camino, que es como se valido la de la
+ * frontal.
+ *
+ * Por eso va como parametro de modulo: se puede barrer sin recompilar, igual
+ * que se hizo con la sonda del buscador.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define HI1337_MCLK_FREQ	(19200 * HZ_PER_KHZ)
+#define HI1337_DATA_LANES	4
+#define HI1337_BPP		10
+
+/* 845,71 MHz. La cuenta, y como se comprobo, en el comentario de arriba. */
+/* 864 MHz. Provisional y por eso tambien parametro: ver la cabecera. */
+#define HI1337_LINK_FREQ	864000000ULL
+
+/* MEDIDO en el chip, no copiado del hi846: alli es 0x0f16 y aqui vale 0. */
+#define HI1337_REG_CHIP_ID	CCI_REG16(0x0716)
+#define HI1337_CHIP_ID		0x1337
+/* Los dos bytes sueltos, para el barrido a pelo de hi1337_probe_id_at(). */
+#define HI1337_ID_REG_HI	0x07
+#define HI1337_ID_REG_LO	0x16
+
+/*
+ * El registro que arranca y para el flujo. Sale de las tablas de fabrica: hay
+ * cuatro regSetting de una sola escritura y todas van a 0x0b00, con 0x0100
+ * para arrancar y 0x0000 para parar. Es el analogo del 0x0a00 del Hi-846.
+ */
+#define HI1337_REG_CTRL_MODE	CCI_REG16(0x0b00)
+#define HI1337_MODE_STREAMING	0x0100
+
+/*
+ * El cerrojo de grupo, sacado del blob de fabrica: alli 0x0208 aparece como dos
+ * "tablas" de una sola escritura, 0x0100 y 0x0000, justo al lado del par de
+ * arranque y parada del flujo. Ver hi1337_set_ctrl().
+ */
+/* Cuanto hay que dejar libre al final de la trama para la exposicion. */
+#define HI1337_EXPOSURE_MARGEN	4
+
+/* Por debajo de esto el sensor deja de emitir. Medido, no del manual. */
+#define HI1337_EXPOSURE_MINIMA	720
+
+#define HI1337_REG_GROUP_HOLD	CCI_REG16(0x0208)
+#define HI1337_GROUP_HOLD_ON	0x0100
+#define HI1337_GROUP_HOLD_OFF	0x0000
+
+
+
+
+
+
+#define to_hi1337(_sd)		container_of(_sd, struct hi1337, sd)
+
+static int i2c_addr = -1;
+module_param(i2c_addr, int, 0444);
+MODULE_PARM_DESC(i2c_addr,
+	"Direccion I2C de 7 bits del sensor. -1 (por defecto) = buscarla.");
+
+static ulong link_freq_hz;
+module_param(link_freq_hz, ulong, 0444);
+MODULE_PARM_DESC(link_freq_hz,
+	"Frecuencia de enlace en Hz. 0 (por defecto) = la calculada del PLL.");
+
+/*
+ * LAS DIRECCIONES DE EXPOSICION Y GANANCIA VAN COMO PARAMETRO
+ *
+ * libcamera EXIGE cuatro controles -exposicion, ganancia analogica, HBLANK y
+ * VBLANK- y sin ellos rechaza el sensor entero: "The sensor kernel driver needs
+ * to be fixed". O sea que no son un adorno.
+ *
+ * Pero el mapa de registros del Hi-1337 no esta documentado y NO se puede
+ * copiar del hi846: alli la identificacion esta en 0x0f16 y aqui en 0x0716, el
+ * arranque del flujo en 0x0a00 y aqui en 0x0b00. No hay desplazamiento
+ * constante que valga.
+ *
+ * Lo que si hay es evidencia propia:
+ *   - el blob de fabrica situa las ganancias digitales en 0x0214..0x021a, o sea
+ *     que el bloque 0x02xx es el de exposicion y ganancia;
+ *   - dentro de ese bloque, 0x0206 (=720) y 0x020a (=3307) valen IGUAL en los
+ *     dos modos, que es lo que se espera de una exposicion y una longitud de
+ *     trama por defecto;
+ *   - 0x0234..0x023a si cambian entre modos (1111 -> 3311/2222): esos son los
+ *     registros de combinacion de pixeles, no de ganancia.
+ *
+ * De la ganancia analogica no hay pista, y el 0x0204 que se probo como tal esta
+ * DESMENTIDO: la tabla del modo binado lo pone a 0x0200 y escribirle un 0 deja
+ * al sensor emitiendo UN solo fotograma. Un registro de ganancia no hace eso.
+ * Sigue sin saberse donde esta, y se encontrara midiendo brillo.
+ */
+static int reg_exposure = 0x0206;
+module_param(reg_exposure, int, 0444);
+MODULE_PARM_DESC(reg_exposure, "Registro de exposicion (por defecto 0x0206).");
+
+/*
+ * LA GANANCIA SON CUATRO REGISTROS, UNO POR CANAL
+ * -----------------------------------------------
+ * 0x0214, 0x0216, 0x0218 y 0x021a. Hay que escribir los cuatro con el mismo
+ * valor para tener una ganancia global; 512 es la unidad.
+ *
+ * Esto costo tres vueltas y dos conclusiones equivocadas, asi que conviene
+ * dejar escrito COMO se distingue una ganancia de lo que no lo es:
+ *
+ *   - El brillo medio NO vale: lo suben una exposicion mas larga, una ganancia
+ *     y un desplazamiento del nivel de negro. Las tres.
+ *   - El periodo de trama descarta la exposicion, pero no el desplazamiento.
+ *   - Lo que las separa es la DESVIACION TIPICA. Una ganancia multiplica la
+ *     senal y su dispersion; un desplazamiento sube el suelo y deja la
+ *     dispersion igual, o la aplasta.
+ *   - Y nada de esto sirve si el sensor no esta mirando a una escena: sobre una
+ *     imagen negra se amplifica un cero y todas las medidas mienten.
+ *
+ * 0x0204 -que estuvo aqui como ganancia dos veces- es el NIVEL DE NEGRO.
+ * Medido: al pasarlo de 512 a 768 la media sube de 20,5 a 82,0 pero la
+ * desviacion BAJA de 16,5 a 10,3 y el contraste se parte por la mitad. Sube el
+ * suelo, no la senal.
+ *
+ * Y estos cuatro, medidos por canal de Bayer escribiendo solo 0x0214:
+ *
+ *     canal   senal a 512   senal a 2048   factor
+ *       Gr           4,76           4,74     1,00
+ *        R           3,45           8,97     2,60
+ *        B           4,41           4,40     1,00
+ *       Gb           4,01          10,75     2,68
+ *
+ * Dos canales amplificados y dos intactos, con el pedestal quieto. Eso es una
+ * ganancia por canal.
+ */
+static int reg_again = 0x0214;
+module_param(reg_again, int, 0444);
+MODULE_PARM_DESC(reg_again,
