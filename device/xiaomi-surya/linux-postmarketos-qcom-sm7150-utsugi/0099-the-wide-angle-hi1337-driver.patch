+config VIDEO_HI1337
+	tristate "SK Hynix Hi-1337 sensor support"
+	depends on OF && I2C && VIDEO_DEV
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_CCI_I2C
+	select V4L2_FWNODE
+	help
+	  The wide-angle camera of the Xiaomi POCO X3 NFC. Tables taken from the factory
+	  calibration file of the phone itself.
+
 config VIDEO_HI846
 	tristate "Hynix Hi-846 sensor support"
 	help
