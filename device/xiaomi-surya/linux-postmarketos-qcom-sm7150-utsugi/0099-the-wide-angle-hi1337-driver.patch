+static const struct hi1337_mode hi1337_supported_modes[] = {
+	{
+		/*
+		 * The binned one goes first: 3.3 MP is a size that software
+		 * debayering can keep up with, and it is the mode worth using to
+		 * check that an image arrives before asking for the 13 MP.
+		 */
+		.width = 2104,
+		.height = 1560,
+		/*
+		 * vts comes from 0x020a in the factory table. hts is NOT known:
+		 * 0x022c is 3629 here and 3615 in the full mode, but in the
+		 * full one that is LESS than the 4208 of width, so it cannot
+		 * be a line length in pixels. The horizontal blanking is left
+		 * the same in both modes and marked as provisional:
+		 * libcamera uses it to estimate timings, not to capture.
+		 */
+		.hts = 2104 + 1525,
+		.vts = 3307,
+		/*
+		 * The blob carries TWO tables for this mode, identical except in the
+		 * frame length: one with 3307 and another with 1662. The second one is
+		 * the fast variant, so 1662 is a value blessed by the
+		 * manufacturer and can be used as the minimum.
+		 *
+		 * It matters since r180: until then the frame length was
+		 * written only halfway -just 0x020a, without its mate 0x020e- and the
+		 * sensor ignored it, so this minimum would have been of no
+		 * use at all. With the mate in place, doubling vts from 3307 to 6614 drops from
+		 * 19,5 a 12,3 fps: ya manda.
+		 */
+		.vts_min = 1662,
+		/*
+		 * The binned mode table puts 0x0200 here, and a 0 leaves it
+		 * streaming a single frame. It is the floor of the control.
+		 */
+		.again = 0x0200,
+		.exposure = 720,
+		.reg_list = {
+			.regs = hi1337_mode_2104x1560,
+			.num_regs = ARRAY_SIZE(hi1337_mode_2104x1560),
+		},
+	},
+	{
+		.width = 4208,
+		.height = 3120,
+		.hts = 4208 + 1525,
+		.vts = 3307,
+		/* Here the blob only carries one table, so there is no measured margin. */
+		.vts_min = 3307,
+		/* At full resolution the factory table leaves it at zero. */
+		.again = 0x0000,
+		.exposure = 720,
+		.reg_list = {
+			.regs = hi1337_mode_4208x3120,
+			.num_regs = ARRAY_SIZE(hi1337_mode_4208x3120),
+		},
+	},
+};
