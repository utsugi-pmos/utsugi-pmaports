+	/*
+	 * The wide-angle camera. Address 0x21 is MEASURED: it shows up on the bus when
+	 * the tlmm 24 reset is released and it answers 0x1337 in register 0x0716.
+	 *
+	 * WATCH OUT with the endpoint: it does NOT point to camss yet, and that is deliberate. If
+	 * the port is declared in camss and this sensor failed to probe, the
+	 * async notifier keeps waiting and /dev/media0 is lost, which
+	 * is where the front camera works. First make it probe; the wiring
+	 * CSI, despues.
+	 */
+	camera@21 {
+		compatible = "hynix,hi1337";
+		reg = <0x21>;
+
+		/*
+		 * It sits on the back, next to the main one and mounted the same way, so
+		 * it gets the same values as that one: see
+		 * 0096-orientation-and-rotation-of-both-cameras.patch, where
+		 * it was measured that the back one is 270 and the front one 90.
+		 *
+		 * The first version set rotation=0 and orientation=0, and
+		 * orientation=0 is FRONT: the comment said "faces
+		 * backwards" and the number said the opposite.
+		 */
+		rotation = <270>;
+		orientation = <1>;	/* trasera */
+
+		/* CAM_RESET3 from the factory, confirmed by measurement. */
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk3_active>;
+
+		/*
+		 * MCLK3 on gpio16 at 19.2 MHz. The 24 MHz stated by the generic
+		 * QRD device tree belong to another node -the one of the ToF sensor on
+		 * the reference board- and they misled for rounds.
+		 */
+		clocks = <&camcc CAMCC_MCLK3_CLK>;
+		clock-names = "xvclk";
+		/*
+		 * NO assigned-clocks, and that is not an oversight. Setting the frequency
+		 * here makes the kernel apply it in of_clk_set_defaults() when REGISTERING
+		 * the node, with no driver involved, and on this SoC that hangs the
+		 * boot with the high MCLKs: it happened to the scanner with MCLK2
+		 * -it is its bug number 1- and it happened again here with MCLK3. The
+		 * front camera node does carry it, but it uses MCLK0, which does not hang.
+		 * The frequency is set by the driver with clk_set_rate() in probe.
+		 */
+
+		/*
+		 * From the factory this sensor only gets VIO from the SoC: its
+		 * powerSetting asks for neither VDIG nor VANA. The two digital
+		 * channels of the wl2866d are taken by the two cameras that
+		 * ya funcionan.
+		 */
+		vddio-supply = <&vreg_l13a_1p8>;
+		vdda-supply = <&wl_avdd1>;
+		vddd-supply = <&vreg_camera_vdig>;
+
