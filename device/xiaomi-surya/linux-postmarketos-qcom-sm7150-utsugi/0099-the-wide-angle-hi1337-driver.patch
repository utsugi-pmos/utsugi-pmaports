+/*
+ * Only the two mandatory controls. The exposure and the analog gain
+ * of this sensor are not located with certainty -see the header-, and a
+ * control that writes to the wrong register is worse than not having it: it fails
+ * in a way that looks like a link problem.
+ */
+static int hi1337_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct hi1337 *hi1337 = container_of(ctrl->handler, struct hi1337,
+					     ctrl_handler);
+	int ret = 0;
+
+	/* With no power there is nobody to write to. */
+	if (!pm_runtime_get_if_in_use(hi1337->dev))
+		return 0;
+
+	/*
+	 * CERROJO DE GRUPO
+	 * ----------------
+	 * The factory blob carries 0x0208=0x0100 and 0x0208=0x0000 as two
+	 * single-write "tables", right next to the stream start and
+	 * stop pair (0x0b00). That is the classic pattern of the group
+	 * hold: it is closed, the registers that must change together are
+	 * written, and it is opened; the sensor applies them all at the start of the
+	 * next frame, not in the middle of the one it is reading out.
+	 *
+	 * Without this the exposure was written raw in the middle of a frame.
+	 * Measured: raising it works -1440 and 2880 are fine- but lowering it breaks the
+	 * stream, and the floor falls right below the factory value: 720 works,
+	 * 690 does not. That the limit coincides with the factory value is too much of
+	 * a coincidence to be a physical limit of the sensor.
+	 */
+	cci_write(hi1337->regmap, HI1337_REG_GROUP_HOLD,
+		  HI1337_GROUP_HOLD_ON, NULL);
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(hi1337->regmap, CCI_REG16(reg_exposure),
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		/* All four channels with the same value: global gain. */
+		if (reg_again) {
+			unsigned int i;
+
+			for (i = 0; i < HI1337_CANALES_GANANCIA; i++) {
+				ret = cci_write(hi1337->regmap,
+						CCI_REG16(reg_again + i * 2),
+						ctrl->val, NULL);
+				if (ret)
+					break;
+			}
+		}
+		break;
+	case V4L2_CID_VBLANK:
+		/*
+		 * THE FRAME LENGTH IS TWO REGISTERS, NOT ONE.
+		 *
+		 * In the THREE mode tables of the factory blob, 0x020a and
+		 * 0x020e are paired and the difference is always 4:
+		 *
+		 *     4208x3120: 0x020a=3307  0x020e=3311
+		 *     2104x1560: 0x020a=3307  0x020e=3311
+		 *     2104x1560: 0x020a=1662  0x020e=1666   (variante rapida)
+		 *
+		 * Only the first one was written, so as soon as anyone touched
+		 * the vertical blanking the pair went out of sync. It fits
+		 * what was measured: doubling 0x020a from 3307 to 6614 changed NOTHING -neither the
+		 * frame period nor the exposure floor-, which is exactly what
+		 * a sensor that ignores an inconsistent pair does.
+		 */
+		ret = cci_write(hi1337->regmap, CCI_REG16(reg_vts),
+				hi1337->mode->height + ctrl->val, NULL);
+		if (ret)
+			break;
+		if (reg_vts_par)
+			ret = cci_write(hi1337->regmap, CCI_REG16(reg_vts_par),
+					hi1337->mode->height + ctrl->val + 4,
+					NULL);
+
+		/*
+		 * And the exposure ceiling has to follow the frame, because
+		 * otherwise an exposure that does not fit inside can be requested.
+		 *
+		 * Measured: with vblank=102 -a frame of 1662- the control still
+		 * accepted 3303, which was the maximum computed in probe with the
+		 * default frame of 3307. And libcamera, in the dark, asks for
+		 * exactly the maximum: it ended up asking for TWICE what fits
+		 * and the sensor stretched the frame so that it would fit, which
+		 * acortarla no servia de nada.
+		 *
+		 * It is what mainline's hi846.c does, which is the close relative.
+		 */
+		if (hi1337->exposure) {
+			s64 max = hi1337->mode->height + ctrl->val -
+				  HI1337_EXPOSURE_MARGEN;
+
+			__v4l2_ctrl_modify_range(hi1337->exposure,
+						 hi1337->exposure->minimum,
+						 max, hi1337->exposure->step,
+						 min(hi1337->exposure->val, max));
+		}
+		break;
+	default:
+		break;
+	}
+
+	/* Open the group hold: the sensor applies the changes on the next frame. */
+	cci_write(hi1337->regmap, HI1337_REG_GROUP_HOLD,
+		  HI1337_GROUP_HOLD_OFF, NULL);
+
+	pm_runtime_mark_last_busy(hi1337->dev);
+	pm_runtime_put_autosuspend(hi1337->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops hi1337_ctrl_ops = {
+	.s_ctrl = hi1337_set_ctrl,
+};
+
+/*
+ * libcamera REQUIRES exposure, analog gain, HBLANK and VBLANK: without the
+ * four of them it rejects the whole sensor with "The sensor kernel driver needs to be
+ * fixed". That is why they are here even though the addresses of two of them are
+ * provisional -see the comment on the parameters-. A control that writes
+ * to the wrong register shows: the image comes out but does not respond. Without the
+ * control there is not even an image.
+ */
+static int hi1337_init_controls(struct hi1337 *hi1337)
+{
+	struct v4l2_ctrl_handler *h = &hi1337->ctrl_handler;
+	const struct hi1337_mode *mode = hi1337->mode;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	s64 hblank, vblank;
+	int ret;
+
+	if (link_freq_hz) {
+		hi1337_link_freq_menu[0] = link_freq_hz;
+		dev_info(hi1337->dev, "frecuencia de enlace forzada: %lu Hz\n",
+			 link_freq_hz);
+	}
+
+	ret = v4l2_ctrl_handler_init(h, 8);
+	if (ret)
+		return ret;
+
+	ctrl = v4l2_ctrl_new_int_menu(h, NULL, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(hi1337_link_freq_menu) - 1, 0,
+				      hi1337_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ctrl = v4l2_ctrl_new_std(h, NULL, V4L2_CID_PIXEL_RATE, 0,
+				 hi1337_freq_to_pixel_rate(hi1337_link_freq_menu[0]), 1,
+				 hi1337_freq_to_pixel_rate(hi1337_link_freq_menu[0]));
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	hblank = mode->hts - mode->width;
+	ctrl = v4l2_ctrl_new_std(h, &hi1337_ctrl_ops, V4L2_CID_HBLANK,
+				 hblank, hblank, 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	/*
+	 * The MINIMUM of the vertical blanking was the default value itself,
+	 * that is, the frame could only be lengthened and never shortened: libcamera had
+	 * no way to speed up the camera even if it wanted to. Now it goes down to the
+	 * shortest frame length that the factory blob uses.
+	 */
+	v4l2_ctrl_new_std(h, &hi1337_ctrl_ops, V4L2_CID_VBLANK,
+			  mode->vts_min - mode->height,
+			  0xffff - mode->height, 1, vblank);
+
+	/*
+	 * THE MINIMUM IS 720, NOT 4, AND IT IS MEASURED.
+	 *
+	 * Below ~720 this sensor STOPS STREAMING: the value is written to it,
+	 * lo acepta y lo devuelve tal cual, y a partir de ahi no sale un solo
+	 * packet over CSI. Bounded by bisection: 720 works, 690 does not.
+	 *
+	 * Declaring 4 was not harmless. Controls PERSIST, so as
+	 * soon as anyone asked for less -libcamera's automatic control or a
+	 * slider in the calibration tool- the camera was left dead and
+	 * ALL the following captures waited their whole timeout and
+	 * returned zero bytes. Seen from outside it looks like a very slow camera,
+	 * not a stopped camera, which is what misleads.
+	 *
+	 * A driver must not offer a range in which its sensor does not work.
+	 */
+	hi1337->exposure = v4l2_ctrl_new_std(h, &hi1337_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     HI1337_EXPOSURE_MINIMA,
+					     mode->vts - HI1337_EXPOSURE_MARGEN,
+					     1, mode->exposure);
+
+	/*
+	 * Floor: the factory value of THIS mode, because below it the binned one
+	 * stops streaming. Ceiling: open, because the measured step is at
+	 * 0x0300 and the upper limit has not been looked for yet.
+	 */
+	/* 512 is unity in the four channel registers, in both modes. */
+	v4l2_ctrl_new_std(h, &hi1337_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  512, 0x0fff, 1, 512);
+
+	/*
+	 * Where the camera looks and how it is mounted, taken from the device tree.
+	 * Without this libcamera warns "Failed to retrieve the camera location",
+	 * lists the camera as 'hi1337' instead of "Internal back camera", and the
+	 * image comes out rotated because nobody has told it how to straighten it. The
+	 * otras dos ya lo hacen; ver 0096-orientacion-y-rotacion.
+	 */
+	ret = v4l2_fwnode_device_parse(hi1337->dev, &props);
+	if (ret) {
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+
+	ret = v4l2_ctrl_new_fwnode_properties(h, &hi1337_ctrl_ops, &props);
+	if (ret) {
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+
+	if (h->error) {
+		ret = h->error;
+		dev_err(hi1337->dev, "failed setting up the controls: %d\n", ret);
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+
+	hi1337->sd.ctrl_handler = h;
+
+	return 0;
+}
+
+/*
+ * CLASSIC s_stream, and not the enable_streams/disable_streams pair that the
+ * front camera driver carried.
+ *
+ * Measured: with enable_streams the kernel takes the path of the "streams" API,
+ * which requires the V4L2_SUBDEV_FL_STREAMS flag and declared routes, and camss
+ * failed with
+ *
+ *     collect_streams: sub-device "hi1337 14-0021" does not support streams
+ *
+ * after having validated the WHOLE pipeline. The IMX682 driver, which does
+ * capture with this same camss, uses plain .s_stream: without enable_streams the
+ * kernel falls back to that path. Aligning with the case that works is cheaper than
+ * implementar rutas.
+ */
+static int hi1337_parar(struct v4l2_subdev *sd);
+
+/*
+ * THE MIPI SWITCH BELONGS TO WHOEVER IS STREAMING
+ * -------------------------------------------------
+ * The front and the wide-angle cameras share the SoC's CSIPHY1 input through
+ * a MIPI switch, so the switch is a shared resource and it has
+ * to be taken while it is USED, not while it is powered on.
+ *
+ * The first version took it in hi1337_power_on(). It looked reasonable and it was
+ * wrong: the sensor stays powered on for a good while after it stops being used
+ * -runtime PM with autosuspend, and besides libcamera leaves it "active" when
+ * closing the camera-, so the switch kept pointing here and the front camera
+ * captured ZERO packets with everything else correct: links fine, format
+ * fine, frequency fine and s_stream not complaining. A silent failure far from its
+ * cause, which is the worst kind.
+ *
+ * Taken in s_stream(1) and released on stop, the window in which this
+ * sensor keeps the bus is exactly the one that needs it.
+ */
+static int hi1337_acquire_mux(struct hi1337 *hi1337)
+{
+	int ret;
+
+	if (hi1337->mux_held || mipi_switch == 0)
+		return 0;
+
+	if (hi1337->mipi_switch_reg) {
+		ret = regulator_enable(hi1337->mipi_switch_reg);
+		if (ret)
+			return ret;
+	}
+	gpiod_set_value_cansleep(hi1337->mipi_switch_oe, 1);
+	hi1337->mux_held = true;
+
+	return 0;
+}
+
+static void hi1337_release_mux(struct hi1337 *hi1337)
+{
+	if (!hi1337->mux_held)
+		return;
+
+	gpiod_set_value_cansleep(hi1337->mipi_switch_oe, 0);
+	if (hi1337->mipi_switch_reg)
+		regulator_disable(hi1337->mipi_switch_reg);
+	hi1337->mux_held = false;
+}
+
+static int hi1337_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	const struct hi1337_reg_list *reg_list;
+	int ret;
+
+	if (!enable)
+		return hi1337_parar(sd);
+
+	ret = pm_runtime_resume_and_get(hi1337->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = hi1337_acquire_mux(hi1337);
+	if (ret) {
+		dev_err(hi1337->dev, "could not take the MIPI switch\n");
+		goto err_rpm_put;
+	}
+
+	/*
+	 * The Samsung's per-page reset does not exist here: the Hi-1337 comes
+	 * out of the physical reset ready to receive the table.
+	 */
+	ret = cci_multi_reg_write(hi1337->regmap, hi1337_init,
+				  ARRAY_SIZE(hi1337_init), NULL);
+	if (ret) {
+		dev_err(hi1337->dev, "the initialization table failed\n");
+		goto err_rpm_put;
+	}
+
+	reg_list = &hi1337->mode->reg_list;
+	ret = cci_multi_reg_write(hi1337->regmap, reg_list->regs,
+				  reg_list->num_regs, NULL);
+	if (ret) {
+		dev_err(hi1337->dev, "the mode table failed\n");
+		goto err_rpm_put;
+	}
+
+	/*
+	 * The controls BEFORE starting, which is what all the other
+	 * drivers.
+	 *
+	 * They were after it for a while, because of a measurement that turned out to be a
+	 * race: I thought I had shown that the sensor only chokes when
+	 * STARTING with a short exposure and that lowering it while running was fine
+	 * -"30 frames out of 30"-. But that capture of 30 frames at 47 ms
+	 * ends in 1.4 s and I was lowering the exposure at 3 s: when there was
+	 * nothing left to measure. Repeated with 100 frames and lowering it at the
+	 * one second mark, 14 come in and the stream DIES. The floor is real and it also
+	 * applies while running, so reordering fixed nothing and only moved
+	 * this driver away from what everyone else does.
+	 *
+	 * What remains unexplained is the floor itself: between 700 and 720, the
+	 * same in both modes, unrelated to vts or to the height, and with
+	 * the chip accepting and reading back any value written to it
+	 * -incluido 0x0004-. Ver docs/CAMARA-06.
+	 */
+	ret = __v4l2_ctrl_handler_setup(&hi1337->ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	/*
+	 * No flips: the wide-angle camera faces backwards, there is no need to turn it
+	 * around. And where its flip bits are is not confirmed either.
+	 */
+	ret = cci_write(hi1337->regmap, HI1337_REG_CTRL_MODE,
+			HI1337_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	hi1337_release_mux(hi1337);
+	pm_runtime_mark_last_busy(hi1337->dev);
+	pm_runtime_put_autosuspend(hi1337->dev);
+
+	return ret;
+}
+
+static int hi1337_parar(struct v4l2_subdev *sd)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	int ret;
+
+	ret = cci_write(hi1337->regmap, HI1337_REG_CTRL_MODE, 0, NULL);
+
+	hi1337_release_mux(hi1337);
+	pm_runtime_mark_last_busy(hi1337->dev);
+	pm_runtime_put_autosuspend(hi1337->dev);
+
+	return ret;
+}
+
+/*
+ * THE STREAMING TRIGGER
+ *
+ * It exists because camss is NOT wired to this sensor yet, and rightly so:
+ * patch 0051 wrote down that declaring a port in camss whose sensor does not
+ * probe loses /dev/media0, and with it the front camera, which does
+ * work. Wiring it up is a risky step and it has to be taken knowingly.
+ *
+ * But without camss nobody calls enable_streams(), so there was no way to
+ * know whether the sensor manages to stream. This checks what matters -that
+ * the 1544 writes go in without error and that the sensor starts the stream- without
+ * touching anything that already works:
+ *
+ *     echo 1 > /sys/module/hi1337/parameters/transmitir
+ *     echo 0 > /sys/module/hi1337/parameters/transmitir
+ *
+ * It is the same trick as the scanner's probe, and for the same reason: to separate
+ * the expensive question -recompiling, risking the boot- from the cheap one.
+ */
+static struct hi1337 *hi1337_vivo;
+
+static int transmitir_set(const char *val, const struct kernel_param *kp)
+{
+	struct hi1337 *h = READ_ONCE(hi1337_vivo);
+	unsigned int on;
+	int ret;
+
+	if (!h)
+		return -ENODEV;
+	if (kstrtouint(val, 0, &on))
+		return -EINVAL;
+
+	if (!on) {
+		ret = cci_write(h->regmap, HI1337_REG_CTRL_MODE, 0, NULL);
+		dev_info(h->dev, "transmision parada (%d)\n", ret);
+		pm_runtime_mark_last_busy(h->dev);
+		pm_runtime_put_autosuspend(h->dev);
+		return 0;
+	}
+
+	ret = pm_runtime_resume_and_get(h->dev);
+	if (ret < 0) {
+		dev_info(h->dev, "could not wake up: %d\n", ret);
+		return 0;
+	}
+
+	ret = cci_multi_reg_write(h->regmap, hi1337_init,
+				  ARRAY_SIZE(hi1337_init), NULL);
+	if (ret) {
+		dev_info(h->dev, "the initialization failed on i2c: %d\n", ret);
+		goto suelta;
+	}
+	dev_info(h->dev, "inicializacion escrita: %u registros\n",
+		 (unsigned int)ARRAY_SIZE(hi1337_init));
+
+	ret = cci_multi_reg_write(h->regmap, h->mode->reg_list.regs,
+				  h->mode->reg_list.num_regs, NULL);
+	if (ret) {
+		dev_info(h->dev, "the mode table failed on i2c: %d\n", ret);
+		goto suelta;
+	}
+	dev_info(h->dev, "modo %ux%u escrito: %u registros\n",
+		 h->mode->width, h->mode->height, h->mode->reg_list.num_regs);
+
+	ret = cci_write(h->regmap, HI1337_REG_CTRL_MODE,
+			HI1337_MODE_STREAMING, NULL);
+	dev_info(h->dev, "TRANSMITIENDO (%d), MCLK a %lu Hz\n",
+		 ret, clk_get_rate(h->mclk));
+	return 0;
+
+suelta:
+	pm_runtime_mark_last_busy(h->dev);
+	pm_runtime_put_autosuspend(h->dev);
+	return 0;
+}
+
+/*
+ * THE 16-BIT PROBE
+ *
+ * It exists because measuring this sensor from user space CANNOT be
+ * done with i2cdump: the CCI bus does not support the combined transactions of
+ * i2ctransfer, and i2cdump reads 8 bits at a time on a 16-bit chip. That is not
+ * reading, it is WRITING -the second byte goes in as data- and this repository already
+ * has it documented as a trap.
+ *
+ * I fell into it myself: I took for granted that the sensor "was streaming" by looking at
+ * a fingerprint taken with i2cdump, when that fingerprint can be an artifact of
+ * mis propias escrituras.
+ *
+ *     echo "0b00"      > /sys/module/hi1337/parameters/sonda   # leer
+ *     echo "0b00 0100" > /sys/module/hi1337/parameters/sonda   # escribir y releer
+ */
+static int probe_set(const char *val, const struct kernel_param *kp)
+{
+	struct hi1337 *h = READ_ONCE(hi1337_vivo);
+	unsigned int reg, dato = 0;
+	u64 leido = 0;
+	int n, ret;
+
+	if (!h)
+		return -ENODEV;
+
+	n = sscanf(val, "%x %x", &reg, &dato);
+	if (n < 1 || reg > 0xffff || (n >= 2 && dato > 0xffff))
+		return -EINVAL;
+
+	ret = pm_runtime_resume_and_get(h->dev);
+	if (ret < 0) {
+		dev_info(h->dev, "probe: could not wake up: %d\n", ret);
+		return 0;
+	}
+
+	if (n >= 2) {
+		ret = cci_write(h->regmap, CCI_REG16(reg), dato, NULL);
+		if (ret)
+			dev_info(h->dev, "sonda: escribir %04x=%04x fallo\n",
+				 reg, dato);
+	}
+
+	ret = cci_read(h->regmap, CCI_REG16(reg), &leido, NULL);
+	if (ret)
+		dev_info(h->dev, "sonda: %04x no contesta\n", reg);
+	else
+		dev_info(h->dev, "sonda: %04x = %04llx\n", reg, leido);
+
+	pm_runtime_mark_last_busy(h->dev);
+	pm_runtime_put_autosuspend(h->dev);
+
+	return 0;
+}
+
+static const struct kernel_param_ops probe_ops = { .set = probe_set };
+module_param_cb(sonda, &probe_ops, NULL, 0200);
+MODULE_PARM_DESC(sonda,
+		 "\"reg\" reads 16 bits, \"reg data\" writes and reads back; output goes to dmesg");
+
+static const struct kernel_param_ops transmitir_ops = { .set = transmitir_set };
+module_param_cb(transmitir, &transmitir_ops, NULL, 0200);
+MODULE_PARM_DESC(transmitir,
+		 "1 writes the tables and starts the stream, 0 stops it; the answer goes to dmesg");
+
+static void hi1337_update_pad_format(const struct hi1337_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = hi1337_get_format_code();
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int hi1337_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	const struct hi1337_mode *mode;
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(hi1337_supported_modes,
+				      ARRAY_SIZE(hi1337_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	hi1337_update_pad_format(mode, &fmt->format);
+
+	format = v4l2_subdev_state_get_format(state, 0);
+	*format = fmt->format;
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	/*
+	 * Here the front camera driver readjusts the hblank, vblank and
+	 * exposure ranges. This one does not: it does not expose those controls because it is not known
+	 * in which registers they live in the Hi-1337, and touching them blindly breaks the
+	 * link in a way that looks like a CSI problem.
+	 */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		hi1337->mode = mode;
+
+	return 0;
+}
+
+static int hi1337_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = hi1337_get_format_code();
+
+	return 0;
+}
+
+static int hi1337_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(hi1337_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != hi1337_get_format_code())
+		return -EINVAL;
+
+	fse->min_width = hi1337_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = hi1337_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int hi1337_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		/*
+		 * Here there was a raw 5184x3880, which is the S5K3T2's array: it
+		 * was left over from the driver this was ported from. The Hi-1337 is 13 MP,
+		 * not 20. It was visible from outside, in cam --list-properties:
+		 *
+		 *     camara 2 (hi1337):  PixelArraySize = 5184x3880
+		 *     camara 3 (s5k3t2):  PixelArraySize = 5184x3880
+		 *
+		 * Two different sensors declaring the same array. libcamera
+		 * uses that size for the crop and the field of view, so a
+		 * borrowed number comes out there as wrong geometry.
+		 *
+		 * It is derived from the largest mode instead of being written, so that it
+		 * cannot drift away from reality again.
+		 */
+		sel->r.width = hi1337_supported_modes[ARRAY_SIZE(hi1337_supported_modes) - 1].width;
+		sel->r.height = hi1337_supported_modes[ARRAY_SIZE(hi1337_supported_modes) - 1].height;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int hi1337_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = hi1337_supported_modes[0].width,
+			.height = hi1337_supported_modes[0].height,
+		},
+	};
+
+	return hi1337_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops hi1337_video_ops = {
+	.s_stream = hi1337_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops hi1337_pad_ops = {
+	.enum_mbus_code = hi1337_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = hi1337_set_pad_format,
+	.enum_frame_size = hi1337_enum_frame_size,
+	.get_selection = hi1337_get_selection,
+};
+
+static const struct v4l2_subdev_ops hi1337_subdev_ops = {
+	.video = &hi1337_video_ops,
+	.pad = &hi1337_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops hi1337_internal_ops = {
+	.init_state = hi1337_init_state,
+};
+
+static const struct media_entity_operations hi1337_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+/* Reads the ID at a given address, without going through the regmap. */
+/*
+ * WATCH OUT WITH THE REGISTER ADDRESS, which has already bitten twice.
+ *
+ * This function came from the s5k3t2 with the register HARDCODED to 0x0000, because on
+ * the Samsung the ID lives there. When porting it the constants were
+ * renamed but this one stayed, and the driver read 0x0000 -which on the Hi-1337
+ * reads 0- and concluded "cannot find the sensor" with the sensor right there,
+ * contestando.
+ *
+ * It is the same mistake that already blocked the whole investigation when the scanner
+ * read 0x0f16 because it was copied from hi846. A constant inherited from a sibling
+ * driver is an assumption, even when it comes inside code that works.
+ */
+static int hi1337_probe_id_at(struct i2c_client *client, u8 addr, u16 *id)
+{
+	u8 reg[2] = { HI1337_ID_REG_HI, HI1337_ID_REG_LO };
+	u8 val[2];
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0, .len = 2, .buf = reg },
+		{ .addr = addr, .flags = I2C_M_RD, .len = 2, .buf = val },
+	};
+	int ret;
+
+	ret = i2c_transfer(client->adapter, msgs, 2);
+	if (ret != 2)
+		return -ENODEV;
+
+	*id = (val[0] << 8) | val[1];
+
+	return 0;
+}
+
+/*
+ * The factory file does NOT carry the sensor address -its only slaveAddr is
+ * the EEPROM-, so it is found by reading the ID. It is the same trap
+ * as with the rear one, where the "documented" 0x50 turned out to be the EEPROM and the
+ * sensor estaba en 0x1a.
+ */
+static int hi1337_find_sensor(struct hi1337 *hi1337, struct i2c_client *client)
+{
+	static const u8 probables[] = { 0x10, 0x2d, 0x1a, 0x16, 0x20, 0x36, 0x3c, 0x5a };
+	u16 id;
+	int i;
+
+	if (i2c_addr >= 0) {
+		client->addr = i2c_addr;
+		dev_info(hi1337->dev, "address forced by parameter: 0x%02x\n",
+			 i2c_addr);
+		return 0;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(probables); i++) {
+		if (!hi1337_probe_id_at(client, probables[i], &id) &&
+		    id == HI1337_CHIP_ID) {
+			dev_info(hi1337->dev, "HI1337 encontrado en 0x%02x\n",
+				 probables[i]);
+			client->addr = probables[i];
+			return 0;
+		}
+	}
+
+	/* Nothing at the likely ones: full sweep, and report who answers. */
+	for (i = 0x08; i <= 0x77; i++) {
+		if (hi1337_probe_id_at(client, i, &id))
+			continue;
+
+		dev_info(hi1337->dev, "contesta 0x%02x, identificacion 0x%04x\n",
+			 i, id);
+
+		if (id == HI1337_CHIP_ID) {
+			client->addr = i;
+			return 0;
+		}
+	}
+
+	return -ENODEV;
+}
+
+static int hi1337_check_hwcfg(struct hi1337 *hi1337)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(hi1337->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = HI1337_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != HI1337_DATA_LANES) {
+		dev_err(hi1337->dev, "%u lanes are needed, the device tree says %u\n",
+			HI1337_DATA_LANES, bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(hi1337->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       hi1337_link_freq_menu,
+				       ARRAY_SIZE(hi1337_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int hi1337_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(HI1337_NUM_SUPPLIES, hi1337->supplies);
+	if (ret)
+		return ret;
+
+	/*
+	 * The MCLK is NOT touched here: it is enabled once in probe and it
+	 * keeps spinning while the driver is bound. See the long comment
+	 * in probe.
+	 */
+
+	/*
+	 * The MIPI switch is NOT touched here. It is taken when streaming starts
+	 * and released on stop: see hi1337_acquire_mux(). It used to be done
+	 * at power on and that was WRONG, because the sensor can stay
+	 * powered on long after it stops being used -runtime PM with
+	 * autosuspend, and libcamera leaves it "active" on close-, and in the
+	 * meantime the front camera was left without a bus and captured zero packets.
+	 */
+
+	gpiod_set_value_cansleep(hi1337->reset_gpio, 0);
+	usleep_range(10 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+
+	/*
+	 * Say out loud whether the clock is really spinning. The first
+	 * version did not say it, and since reading the ID over i2c does NOT
+	 * need MCLK, a stopped clock went unnoticed until much
+	 * later, when no image would arrive. That is the worst thing a
+	 * fallo: aparecer lejos de donde se causa.
+	 */
+	dev_dbg(dev, "encendido: MCLK a %lu Hz\n", clk_get_rate(hi1337->mclk));
+
+	return 0;
+}
+
+static int hi1337_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	gpiod_set_value_cansleep(hi1337->reset_gpio, 1);
+	hi1337_release_mux(hi1337);
+	regulator_bulk_disable(HI1337_NUM_SUPPLIES, hi1337->supplies);
+
+	return 0;
+}
+
+static int hi1337_probe(struct i2c_client *client)
+{
+	struct hi1337 *hi1337;
+	unsigned long freq;
+	unsigned int i;
+	u16 id;
+	int ret;
+
+	hi1337 = devm_kzalloc(&client->dev, sizeof(*hi1337), GFP_KERNEL);
+	if (!hi1337)
+		return -ENOMEM;
+
+	hi1337->dev = &client->dev;
+
+	/*
+	 * This goes first, and it is not cosmetic: it is what leaves the subdev
+	 * hanging off the device, and hi1337_power_on() looks for it there with
+	 * in dev_get_drvdata(). Powering on before this line is a
+	 * desreferencia a NULL nada mas arrancar.
+	 */
+	v4l2_i2c_subdev_init(&hi1337->sd, client, &hi1337_subdev_ops);
+
+	/*
+	 * plain devm_clk_get(), and NOT the devm_v4l2_sensor_clk_get() that the
+	 * front camera driver carried. Measured: with that one, when enabling the clock the
+	 * enable did NOT propagate to the parent -camcc_mclk3_clk_src stayed
+	 * at enable_cnt 0- and the branch reported "status stuck at off". The
+	 * scanner enables that same MCLK3 without trouble by requesting it the
+	 * normal way, and there the parent goes up to 1: that is the only difference between the
+	 * two cases, and it is the one changed here.
+	 */
+	hi1337->mclk = devm_clk_get(hi1337->dev, "xvclk");
+	if (IS_ERR(hi1337->mclk))
+		return dev_err_probe(hi1337->dev, PTR_ERR(hi1337->mclk),
+				     "could not get the MCLK\n");
+
+	/*
+	 * The frequency is set HERE and not with assigned-clocks in the device
+	 * tree: the kernel applies that when registering the node and it hangs the
+	 * boot on this SoC. See the node's comment in the dtsi.
+	 */
+	ret = clk_set_rate(hi1337->mclk, HI1337_MCLK_FREQ);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "the MCLK does not accept %lu Hz\n",
+				     (unsigned long)HI1337_MCLK_FREQ);
+
+	/*
+	 * THE MCLK IS ENABLED ONCE AND KEPT SPINNING
+	 *
+	 * Measured on the board, and it cost three discarded hypotheses: on the same
+	 * clock handle, the sequence enable -> disable -> enable FAILS.
+	 * The second enable reports "camcc_mclk3_clk status stuck at 'off'",
+	 * the runtime PM resume fails and the device stays suspended
+	 * forever.
+	 *
+	 * It is not the platform: the scanner enables THAT SAME MCLK3 twice
+	 * in a row without complaining... because each time it does so with a freshly
+	 * requested handle and never disables it in between. That is the only difference
+	 * left between the two cases.
+	 *
+	 * Ruled out before, and by measurement, not by hunch:
+	 *   - the camera GDSC (camcc_titan_top_gdsc stays off with the
+	 *     scanner keeping the clock enabled),
+	 *   - devm_v4l2_sensor_clk_get() frente a devm_clk_get(),
+	 *   - setting the frequency again before every enable.
+	 *
+	 * So the clock is enabled here and disabled in remove. Runtime PM
+	 * still governs rails and reset, which is what really draws power. A
+	 * A 19.2 MHz MCLK spinning costs little, and until we understand why
+	 * the branch does not start up again, this is honest and it works.
+	 */
+	ret = clk_prepare_enable(hi1337->mclk);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "MCLK does not start\n");
+
+	freq = clk_get_rate(hi1337->mclk);
+	if (freq != HI1337_MCLK_FREQ)
+		return dev_err_probe(hi1337->dev, -EINVAL,
+				     "MCLK stayed at %lu Hz and the tables are for %lu\n",
+				     freq, (unsigned long)HI1337_MCLK_FREQ);
+
+	ret = hi1337_check_hwcfg(hi1337);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "the device tree does not match\n");
+
+	hi1337->reset_gpio = devm_gpiod_get_optional(hi1337->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(hi1337->reset_gpio))
+		return dev_err_probe(hi1337->dev, PTR_ERR(hi1337->reset_gpio),
+				     "could not get the reset pin\n");
+
+	for (i = 0; i < HI1337_NUM_SUPPLIES; i++)
+		hi1337->supplies[i].supply = hi1337_supply_names[i];
+
+	ret = devm_regulator_bulk_get(hi1337->dev, HI1337_NUM_SUPPLIES,
+				      hi1337->supplies);
+	if (ret)
+		return dev_err_probe(hi1337->dev, ret,
+				     "could not get the regulators\n");
+
+	/*
+	 * The MIPI switch shared by the front camera and the wide angle. It is
+	 * requested as optional and only touched if told to by parameter: a pin
+	 * whose correct position has not been measured yet is not driven.
+	 */
+	/*
+	 * The second signal of the MIPI switch. Without it the CSID does not see a single
+	 * packet no matter how much the sensor transmits: it is optional in the code
+	 * but essential on this board.
+	 */
+	hi1337->mipi_switch_oe = devm_gpiod_get_optional(hi1337->dev,
+							"mipi-switch-oe",
+							GPIOD_OUT_LOW);
+	if (IS_ERR(hi1337->mipi_switch_oe))
+		return dev_err_probe(hi1337->dev, PTR_ERR(hi1337->mipi_switch_oe),
+				     "could not get the switch OE signal\n");
+
+	hi1337->mipi_switch_reg = devm_regulator_get_optional(hi1337->dev,
+							      "mipi-switch");
+	if (IS_ERR(hi1337->mipi_switch_reg))
+		hi1337->mipi_switch_reg = NULL;
+
+	/* It has to be powered and clocked before it answers over I2C. */
+	ret = hi1337_power_on(hi1337->dev);
+	if (ret)
+		return ret;
+
+	ret = hi1337_find_sensor(hi1337, client);
+	if (ret) {
+		dev_err(hi1337->dev, "HI1337 not found on the bus\n");
+		goto power_off;
+	}
+
+	hi1337->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(hi1337->regmap)) {
+		ret = dev_err_probe(hi1337->dev, PTR_ERR(hi1337->regmap),
+				    "could not start the CCI\n");
+		goto power_off;
+	}
+
+	ret = hi1337_probe_id_at(client, client->addr, &id);
+	if (ret || id != HI1337_CHIP_ID) {
+		dev_err(hi1337->dev, "identificacion 0x%04x, esperaba 0x%04x\n",
+			id, HI1337_CHIP_ID);
+		ret = -ENODEV;
+		goto power_off;
+	}
+
+	dev_info(hi1337->dev, "ES UN HI1337: identificacion 0x%04x en 0x%02x\n",
+		 id, client->addr);
+
+	hi1337->mode = &hi1337_supported_modes[0];
+	WRITE_ONCE(hi1337_vivo, hi1337);
+
+	ret = hi1337_init_controls(hi1337);
+	if (ret) {
+		dev_err_probe(hi1337->dev, ret, "controls failed\n");
+		goto power_off;
+	}
+
+	hi1337->sd.state_lock = hi1337->ctrl_handler.lock;
+	hi1337->sd.internal_ops = &hi1337_internal_ops;
+	hi1337->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	hi1337->sd.entity.ops = &hi1337_subdev_entity_ops;
+	hi1337->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	hi1337->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&hi1337->sd.entity, 1, &hi1337->pad);
+	if (ret)
+		goto ctrl_free;
+
+	ret = v4l2_subdev_init_finalize(&hi1337->sd);
+	if (ret < 0)
+		goto media_cleanup;
+
+	pm_runtime_set_active(hi1337->dev);
+	pm_runtime_enable(hi1337->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&hi1337->sd);
+	if (ret < 0) {
+		dev_err_probe(hi1337->dev, ret, "could not register the subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(hi1337->dev, 1000);
+	pm_runtime_use_autosuspend(hi1337->dev);
+	pm_runtime_idle(hi1337->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&hi1337->sd);
+	pm_runtime_disable(hi1337->dev);
+	clk_disable_unprepare(hi1337->mclk);
+	pm_runtime_set_suspended(hi1337->dev);
+
+media_cleanup:
+	media_entity_cleanup(&hi1337->sd.entity);
+
+ctrl_free:
+	v4l2_ctrl_handler_free(&hi1337->ctrl_handler);
+
+power_off:
+	hi1337_power_off(hi1337->dev);
+
+	return ret;
+}
+
+static void hi1337_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct hi1337 *hi1337 = to_hi1337(sd);
+
+	WRITE_ONCE(hi1337_vivo, NULL);
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(hi1337->dev);
+
+	if (!pm_runtime_status_suspended(hi1337->dev)) {
+		hi1337_power_off(hi1337->dev);
+		pm_runtime_set_suspended(hi1337->dev);
+	}
+
+	/*
+	 * And the MCLK, which power_off no longer turns off: it is enabled in probe and
+	 * lives as long as the binding does, so it has to be stopped HERE.
+	 *
+	 * It was forgotten in the first version and the clock kept spinning after
+	 * rmmod -visible in clk_summary as camcc_mclk3_clk with enable=1 and no
+	 * consumer-. It is the same leak the scanner already had with the rails,
+	 * and it was found the same way: looking at the state after unloading instead of
+	 * assuming it had been cleaned up.
+	 */
+	clk_disable_unprepare(hi1337->mclk);
+}
+
+static const struct dev_pm_ops hi1337_pm_ops = {
+	SET_RUNTIME_PM_OPS(hi1337_power_off, hi1337_power_on, NULL)
+};
+
+static const struct of_device_id hi1337_of_match[] = {
+	{ .compatible = "hynix,hi1337" },
+	{ /* sentinel */ }
+};
+/*
+ * NOW YES, with MODULE_DEVICE_TABLE. It was removed while the driver was a
+ * first untested version, so that a bug in it could not leave the phone
+ * unable to boot. That is no longer the case: it identifies the sensor, survives
+ * suspend and resume cycles without a single warning, and writes the 1544 table entries
+ * without a single i2c error.
+ *
+ * And now it is needed: camss waits for the sensor subdev of its
+ * port to appear, and if nobody loads the module that wait never ends and it loses
+ * /dev/media0.
+ */
+MODULE_DEVICE_TABLE(of, hi1337_of_match);
+
+static struct i2c_driver hi1337_i2c_driver = {
+	.driver = {
+		.name = "hi1337",
+		.pm = &hi1337_pm_ops,
+		.of_match_table = hi1337_of_match,
+	},
+	.probe = hi1337_probe,
+	.remove = hi1337_remove,
+};
+
+module_i2c_driver(hi1337_i2c_driver);
+
+MODULE_DESCRIPTION("SK Hynix Hi-1337: the POCO X3 NFC wide-angle camera");
+MODULE_LICENSE("GPL");

