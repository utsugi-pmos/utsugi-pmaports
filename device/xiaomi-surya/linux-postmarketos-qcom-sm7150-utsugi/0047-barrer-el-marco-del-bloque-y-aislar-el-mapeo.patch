 static DEVICE_ATTR_WO(registrar_topologias);
 
+/*
+ * Prueba SOLO el mapeo de memoria, 4 KiB, sin registrar nada detras.
+ *
+ *     echo 1 > /sys/bus/aprbus/devices/aprsvc:service:4:3/probar_mapeo
+ *
+ * Existe para separar dos cosas que hasta ahora iban juntas: si lo que tumba
+ * el movil es el mapeo en si, o el comando de registro que venia despues. Sin
+ * separarlas no se puede saber cual arreglar.
+ *
+ * PELIGRO: si el mapeo es lo que tumba, esto reinicia el movil. Pero reiniciar
+ * cuesta 90 segundos y no cuesta ninguna llamada, asi que sale a cuenta.
+ */
+static ssize_t probar_mapeo_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct q6core *core = dev_get_drvdata(dev);
+	dma_addr_t phys;
+	void *p;
+	int rc;
+
+	rc = dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (rc) {
+		dev_err(dev, "no se pudo fijar la mascara de DMA: %d\n", rc);
+		return rc;
+	}
+
+	p = dma_alloc_coherent(dev, SZ_4K, &phys, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	dev_info(dev, "probando SOLO el mapeo: 4 KiB en %pad, token %#x\n",
+		 &phys, mapeo_token);
+
+	rc = q6core_map_memory(core, phys, SZ_4K);
+	dev_info(dev, "mapeo: rc=%d handle=%#x\n", rc, core->mem_map_handle);
+
+	if (!rc) {
+		q6core_unmap_memory(core);
+		dev_info(dev, "desmapeo hecho\n");
+	}
+
+	dma_free_coherent(dev, SZ_4K, p, phys);
+	return count;
+}
+static DEVICE_ATTR_WO(probar_mapeo);
+
 static int q6core_probe(struct apr_device *adev)
 {
 	g_core = kzalloc_obj(*g_core);
