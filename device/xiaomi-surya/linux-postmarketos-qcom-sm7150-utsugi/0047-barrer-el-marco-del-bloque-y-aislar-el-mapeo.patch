+static int topo_offset = 4;
+module_param(topo_offset, int, 0644);
+MODULE_PARM_DESC(topo_offset, "bytes que se saltan del principio del bloque");
+
+static int topo_delta;
+module_param(topo_delta, int, 0644);
+MODULE_PARM_DESC(topo_delta, "se suma al tamano declarado al DSP");
