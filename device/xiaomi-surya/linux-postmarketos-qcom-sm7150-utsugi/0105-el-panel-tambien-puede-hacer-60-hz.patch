+/*
+ * The vendor device tree ships 120/90/60/50/30 Hz for this panel; the generator
+ * only carried over the 120 Hz timing.
+ *
+ * The refresh rate is varied through the VERTICAL FRONT PORCH, with the pixel
+ * clock held constant. That is what the vendor tree asks for:
+ *
+ *     qcom,mdss-dsi-pan-enable-dynamic-fps;
+ *     qcom,mdss-dsi-pan-fps-update = "dfps_immediate_porch_mode_vfp";
+ *     qcom,dsi-supported-dfps-list = <120 90 60 50 30>;
+ *
+ * so every mode below keeps clock, horizontal timing and the DSI bit clock
+ * exactly as the panel already runs them, and only the front porch grows:
+ *
+ *     120 Hz   vfp   32   vtotal 2464   1205 * 2464 * 120 / 1000 = 356294 kHz
+ *      60 Hz   vfp 2496   vtotal 4928   1205 * 4928 *  60 / 1000 = 356294 kHz
+ *
+ * Halving the clock instead, which is the obvious-looking way to do it, does
+ * NOT work on this panel: it fills the screen with glitches while every
+ * machine-readable signal claims success. Measured, and the reason this file
+ * looks the way it does.
+ *
+ * DSC is unaffected either way: its parameters depend on hdisplay and the
+ * slice geometry (540x20, 8bpc), not on timing.
+ */
+#define NT36672C_TIANMA_MODE(vfp, hz) {					\
+	.clock = (1080 + 73 + 12 + 40) *				\
+		 (2400 + (vfp) + 2 + 30) * (hz) / 1000,			\
+	.hdisplay = 1080,						\
+	.hsync_start = 1080 + 73,					\
+	.hsync_end = 1080 + 73 + 12,					\
+	.htotal = 1080 + 73 + 12 + 40,					\
+	.vdisplay = 2400,						\
+	.vsync_start = 2400 + (vfp),					\
+	.vsync_end = 2400 + (vfp) + 2,					\
+	.vtotal = 2400 + (vfp) + 2 + 30,				\
+	.width_mm = 70,							\
+	.height_mm = 154,						\
+	.type = DRM_MODE_TYPE_DRIVER,					\
+}
+
+/*
+ * 120 Hz stays first and is the one flagged preferred below, so nothing about
+ * the default behaviour of this panel changes by adding the second mode.
+ */
+static const struct drm_display_mode nt36672c_tianma_modes[] = {
+	NT36672C_TIANMA_MODE(32, 120),
+	NT36672C_TIANMA_MODE(2496, 60),
 };
 
