diff -ruN a/drivers/regulator/wl2866d.c b/drivers/regulator/wl2866d.c
--- a/drivers/regulator/wl2866d.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/regulator/wl2866d.c	2026-08-14 20:00:55.672824532 +0200
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Will Semiconductor WL2866D: cuatro LDOs para las camaras.
+ *
+ * POR QUE HACE FALTA
+ * ------------------
+ * Los cinco sensores del Xiaomi POCO X3 NFC (surya) cuelgan de este chip.
+ * Linux no lo soporta, asi que sus cuatro carriles se quedan APAGADOS al
+ * arrancar y ningun sensor contesta en los buses CCI. Esa es la razon, medida,
+ * de que la camara "no exista" en este movil.
+ *
+ * EL MAPA DE REGISTROS, Y COMO SE COMPROBO
+ * ----------------------------------------
+ * No hay hoja de datos publica. El mapa se reconstruyo del driver de fabrica
+ * del propio surya (drivers/misc/wl2866d.c de su kernel Android) y se
+ * comprobo LEYENDO EL CHIP: al arrancar tiene 0x64 0x64 0x80 0x80 en los
+ * cuatro registros de tension, que es exactamente lo que predicen las
+ * formulas de abajo (1,2 V los digitales y 2,8 V los analogicos). Que los
+ * valores de fabrica cuadren con la formula al bit es lo que convierte esto
+ * en una lectura y no en una suposicion.
+ *
+ *   0x03  DVDD1     microvoltios = 600000 + valor * 6000
+ *   0x04  DVDD2     idem
+ *   0x05  AVDD1     microvoltios = 1200000 + valor * 12500
+ *   0x06  AVDD2     idem
+ *   0x0E  encendido, un bit por LDO
+ *
+ * El Android de fabrica escribe 0x55 0x55 0x80 0x88, o sea 1,11 V digital y
+ * 2,80 / 2,90 V analogico.
+ */
+
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define WL2866D_REG_DVDD1	0x03
+#define WL2866D_REG_ENABLE	0x0e
+
+#define WL2866D_DVDD_MIN_UV	600000
+#define WL2866D_DVDD_STEP_UV	6000
+#define WL2866D_AVDD_MIN_UV	1200000
+#define WL2866D_AVDD_STEP_UV	12500
+#define WL2866D_N_VOLTAGES	256
+
+enum { WL2866D_DVDD1, WL2866D_DVDD2, WL2866D_AVDD1, WL2866D_AVDD2 };
+
+/*
+ * Los cuatro registros de tension son consecutivos desde 0x03, y el bit de
+ * encendido de cada LDO es su propio indice dentro de 0x0E. Se generan con una
+ * macro para que esa correspondencia quede escrita una sola vez: separarla en
+ * cuatro estructuras a mano es justo donde se cuela una errata que enciende el
+ * carril equivocado.
+ */
+#define WL2866D_LDO(_id, _nombre, _min, _paso)				\
+	[_id] = {							\
+		.name		= _nombre,				\
+		.of_match	= of_match_ptr(_nombre),		\
+		.regulators_node = of_match_ptr("regulators"),		\
+		.id		= _id,					\
+		.type		= REGULATOR_VOLTAGE,			\
+		.owner		= THIS_MODULE,				\
+		.ops		= &wl2866d_ops,				\
+		.n_voltages	= WL2866D_N_VOLTAGES,			\
+		.min_uV		= _min,					\
+		.uV_step	= _paso,				\
+		.vsel_reg	= WL2866D_REG_DVDD1 + (_id),		\
+		.vsel_mask	= 0xff,					\
+		.enable_reg	= WL2866D_REG_ENABLE,			\
+		.enable_mask	= BIT(_id),				\
+	}
+
+static const struct regulator_ops wl2866d_ops = {
+	.enable			= regulator_enable_regmap,
+	.disable		= regulator_disable_regmap,
+	.is_enabled		= regulator_is_enabled_regmap,
+	.list_voltage		= regulator_list_voltage_linear,
+	.map_voltage		= regulator_map_voltage_linear,
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+};
+
+static const struct regulator_desc wl2866d_regs[] = {
+	WL2866D_LDO(WL2866D_DVDD1, "dvdd1", WL2866D_DVDD_MIN_UV, WL2866D_DVDD_STEP_UV),
+	WL2866D_LDO(WL2866D_DVDD2, "dvdd2", WL2866D_DVDD_MIN_UV, WL2866D_DVDD_STEP_UV),
+	WL2866D_LDO(WL2866D_AVDD1, "avdd1", WL2866D_AVDD_MIN_UV, WL2866D_AVDD_STEP_UV),
+	WL2866D_LDO(WL2866D_AVDD2, "avdd2", WL2866D_AVDD_MIN_UV, WL2866D_AVDD_STEP_UV),
+};
+
+static const struct regmap_config wl2866d_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0x0f,
+};
+
+static int wl2866d_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regulator_config config = { };
+	struct gpio_desc *enable;
+	struct regmap *regmap;
+	unsigned int val;
+	int i, ret;
+
+	regmap = devm_regmap_init_i2c(client, &wl2866d_regmap);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap), "sin regmap\n");
+
+	/*
+	 * El chip no responde por I2C hasta que su pin de habilitacion esta
+	 * alto. En surya ese pin lo lleva el PMIC (pm6150l gpio1).
+	 */
+	enable = devm_gpiod_get_optional(dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(enable))
+		return dev_err_probe(dev, PTR_ERR(enable), "sin gpio de habilitacion\n");
+
+	/*
+	 * Comprobacion de que hay alguien ahi, y de que es lo que creemos.
+	 * No existe registro de identificacion, asi que se usa lo unico
+	 * fiable: el registro de tension de DVDD1 vale 0x64 de fabrica.
+	 * Es debil como identificacion, pero distingue "el chip no esta" de
+	 * "el chip esta y ya lo toco alguien", que es lo que importa al
+	 * depurar.
+	 */
+	ret = regmap_read(regmap, WL2866D_REG_DVDD1, &val);
+	if (ret)
+		return dev_err_probe(dev, ret, "no contesta en 0x%02x\n", client->addr);
+
+	dev_info(dev, "presente, DVDD1 arranca en 0x%02x (%u uV)\n", val,
+		 WL2866D_DVDD_MIN_UV + val * WL2866D_DVDD_STEP_UV);
+
+	config.dev = dev;
+	config.regmap = regmap;
+
+	for (i = 0; i < ARRAY_SIZE(wl2866d_regs); i++) {
+		struct regulator_dev *rdev;
+
+		rdev = devm_regulator_register(dev, &wl2866d_regs[i], &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "no se registra %s\n",
+					     wl2866d_regs[i].name);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id wl2866d_of_match[] = {
+	{ .compatible = "willsemi,wl2866d" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, wl2866d_of_match);
+
+static struct i2c_driver wl2866d_driver = {
+	.driver = {
+		.name = "wl2866d",
+		.of_match_table = wl2866d_of_match,
+	},
+	.probe = wl2866d_probe,
+};
+module_i2c_driver(wl2866d_driver);
+
+MODULE_DESCRIPTION("Will Semiconductor WL2866D camera regulator");
+MODULE_LICENSE("GPL");
