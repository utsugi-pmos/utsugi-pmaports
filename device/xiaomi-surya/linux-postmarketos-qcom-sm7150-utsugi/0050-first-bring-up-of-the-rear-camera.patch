+struct imx682 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct i2c_client *client;
+
+	struct clk *xvclk;
+	struct gpio_desc *reset;
+	struct regulator *dovdd;
+	struct regulator *avdd;
+	struct regulator *dvdd;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *exposure;
+
+	const struct imx682_mode *mode;
+};
+
+static inline struct imx682 *to_imx682(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx682, sd);
+}
+
+/* Registro de 16 bits de direccion y 8 de dato. */
+static int imx682_read(struct imx682 *s, u16 reg, u8 *val)
+{
+	u8 dir[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msgs[2] = {
+		{ .addr = s->client->addr, .flags = 0, .len = 2, .buf = dir },
+		{ .addr = s->client->addr, .flags = I2C_M_RD, .len = 1, .buf = val },
+	};
+	int ret = i2c_transfer(s->client->adapter, msgs, 2);
+
+	return ret == 2 ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+static int imx682_write(struct imx682 *s, u16 reg, u8 val)
+{
+	u8 buf[3] = { reg >> 8, reg & 0xff, val };
+	int ret = i2c_master_send(s->client, buf, 3);
+
+	return ret == 3 ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+static int imx682_write16(struct imx682 *s, u16 reg, u16 val)
+{
+	int ret = imx682_write(s, reg, val >> 8);
+
+	return ret ? ret : imx682_write(s, reg + 1, val & 0xff);
+}
+
+static int imx682_write_regs(struct imx682 *s, const struct imx682_reg *r,
+			     unsigned int n)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < n; i++) {
+		ret = imx682_write(s, r[i].addr, r[i].val);
+		if (ret) {
+			dev_err(&s->client->dev,
+				"fallo al escribir 0x%04x (registro %u de %u): %d\n",
+				r[i].addr, i, n, ret);
+			return ret;
+		}
+	}
+	return 0;
+}
+
+static int imx682_power_on(struct device *dev)
+{
+	struct imx682 *s = to_imx682(dev_get_drvdata(dev));
+	int ret;
+
+	/*
+	 * Orden que pide Sony: tensiones, luego reloj, y el reset el ultimo.
+	 * Al reves el sensor arranca sin reloj estable y se queda mudo sin dar
+	 * ningun error.
+	 */
+	ret = regulator_enable(s->dovdd);
+	if (ret)
+		return ret;
+	ret = regulator_enable(s->avdd);
+	if (ret)
+		goto err_dovdd;
+	ret = regulator_enable(s->dvdd);
+	if (ret)
+		goto err_avdd;
+
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(s->xvclk);
+	if (ret)
+		goto err_dvdd;
+
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(s->reset, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+
+err_dvdd:
+	regulator_disable(s->dvdd);
+err_avdd:
+	regulator_disable(s->avdd);
+err_dovdd:
+	regulator_disable(s->dovdd);
+	return ret;
+}
+
+static int imx682_power_off(struct device *dev)
+{
+	struct imx682 *s = to_imx682(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(s->reset, 1);
+	clk_disable_unprepare(s->xvclk);
+	regulator_disable(s->dvdd);
+	regulator_disable(s->avdd);
+	regulator_disable(s->dovdd);
+	return 0;
+}
+
+static int imx682_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx682 *s = container_of(ctrl->handler, struct imx682, ctrls);
+	int ret;
+
+	/* Sin alimentacion no hay a quien escribirle; no es un error. */
+	if (!pm_runtime_get_if_in_use(&s->client->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = imx682_write16(s, IMX682_REG_EXPOSURE, ctrl->val);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = imx682_write16(s, IMX682_REG_ANALOG_GAIN, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = imx682_write16(s, IMX682_REG_FRAME_LENGTH,
+				     s->mode->height + ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(&s->client->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx682_ctrl_ops = {
+	.s_ctrl = imx682_set_ctrl,
+};
+
+static int imx682_init_ctrls(struct imx682 *s)
+{
+	const struct imx682_mode *m = s->mode;
+	struct v4l2_ctrl_handler *h = &s->ctrls;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(h, 8);
+	if (ret)
+		return ret;
+
+	/*
+	 * LINK_FREQ y PIXEL_RATE no son opcionales: sin ellos el CSIPHY de
+	 * CAMSS aborta con "Cannot get CSI2 transmitter's link frequency" y
+	 * no llega a configurarse nada.
+	 */
+	s->link_freq = v4l2_ctrl_new_int_menu(h, NULL, V4L2_CID_LINK_FREQ,
+					      ARRAY_SIZE(imx682_link_freqs) - 1,
+					      0, imx682_link_freqs);
+	if (s->link_freq)
+		s->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s->pixel_rate = v4l2_ctrl_new_std(h, NULL, V4L2_CID_PIXEL_RATE,
+					  IMX682_PIXEL_RATE, IMX682_PIXEL_RATE,
+					  1, IMX682_PIXEL_RATE);
+	if (s->pixel_rate)
+		s->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s->hblank = v4l2_ctrl_new_std(h, NULL, V4L2_CID_HBLANK,
+				      m->hts - m->width, m->hts - m->width,
+				      1, m->hts - m->width);
+	if (s->hblank)
+		s->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s->vblank = v4l2_ctrl_new_std(h, &imx682_ctrl_ops, V4L2_CID_VBLANK,
+				      m->vts_min - m->height,
+				      0xffff - m->height,
+				      1, m->vts_def - m->height);
+
+	/*
+	 * EXPOSURE y ANALOGUE_GAIN son los que usa el revelado por software de
+	 * libcamera para su control automatico. Sin ellos llega imagen, pero
+	 * negra o quemada, y parece un fallo de captura cuando no lo es.
+	 */
+	s->exposure = v4l2_ctrl_new_std(h, &imx682_ctrl_ops, V4L2_CID_EXPOSURE,
+					IMX682_EXPOSURE_MIN,
+					m->vts_def - IMX682_EXPOSURE_MARGIN,
+					IMX682_EXPOSURE_STEP,
+					m->vts_def - IMX682_EXPOSURE_MARGIN);
+
+	v4l2_ctrl_new_std(h, &imx682_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX682_ANA_GAIN_MIN, IMX682_ANA_GAIN_MAX,
+			  IMX682_ANA_GAIN_STEP, IMX682_ANA_GAIN_MIN);
+
+	if (h->error) {
+		ret = h->error;
+		dev_err(&s->client->dev, "fallo al crear los controles: %d\n", ret);
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+
+	s->sd.ctrl_handler = h;
+	return 0;
+}
+
+static int imx682_start_streaming(struct imx682 *s)
+{
+	int ret;
+
+	ret = imx682_write_regs(s, imx682_global, ARRAY_SIZE(imx682_global));
+	if (ret)
+		return ret;
+
+	ret = imx682_write_regs(s, s->mode->regs, s->mode->num_regs);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_handler_setup(&s->ctrls);
+	if (ret)
+		return ret;
+
+	return imx682_write(s, IMX682_REG_MODE_SELECT, IMX682_MODE_STREAMING);
+}
+
+static int imx682_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx682 *s = to_imx682(sd);
+	struct device *dev = &s->client->dev;
+	int ret;
+
+	if (!enable) {
+		imx682_write(s, IMX682_REG_MODE_SELECT, IMX682_MODE_STANDBY);
+		pm_runtime_put(dev);
+		return 0;
+	}
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret)
+		return ret;
+
+	ret = imx682_start_streaming(s);
+	if (ret) {
+		dev_err(dev, "no arranca la transmision: %d\n", ret);
+		pm_runtime_put(dev);
+	}
+	return ret;
+}
+
+static void imx682_fill_fmt(const struct imx682_mode *m,
+			    struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = m->width;
+	fmt->height = m->height;
+	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+}
+
+static int imx682_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	imx682_fill_fmt(&imx682_modes[0],
+			v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static int imx682_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	return 0;
+}
+
+static int imx682_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(imx682_modes) ||
+	    fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+
+	fse->min_width = fse->max_width = imx682_modes[fse->index].width;
+	fse->min_height = fse->max_height = imx682_modes[fse->index].height;
+	return 0;
+}
+
+static int imx682_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct imx682 *s = to_imx682(sd);
+
+	/* Un solo modo: se acepta lo que pidan y se devuelve el que hay. */
+	imx682_fill_fmt(s->mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+	return 0;
+}
