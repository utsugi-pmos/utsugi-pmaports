+
+static int imx682_identify(struct imx682 *s)
+{
+	u8 hi, lo;
+	int ret;
+
+	ret = imx682_read(s, IMX682_REG_CHIP_ID, &hi);
+	if (!ret)
+		ret = imx682_read(s, IMX682_REG_CHIP_ID + 1, &lo);
+	if (ret)
+		return dev_err_probe(&s->client->dev, ret,
+				     "no contesta en 0x%02x\n", s->client->addr);
+
+	if (((hi << 8) | lo) != IMX682_CHIP_ID)
+		return dev_err_probe(&s->client->dev, -ENODEV,
+				     "contesta, pero dice 0x%04x y no 0x%04x\n",
+				     (hi << 8) | lo, IMX682_CHIP_ID);
+
+	dev_info(&s->client->dev, "IMX682 detectado (0x%04x)\n", IMX682_CHIP_ID);
+	return 0;
+}
+
+static int imx682_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx682 *s;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+
+	s->client = client;
+	s->mode = &imx682_modes[0];
+
+	s->xvclk = devm_clk_get(dev, "xvclk");
+	if (IS_ERR(s->xvclk))
+		return dev_err_probe(dev, PTR_ERR(s->xvclk), "falta el reloj\n");
+
+	ret = clk_set_rate(s->xvclk, IMX682_XVCLK_HZ);
+	if (ret)
+		return dev_err_probe(dev, ret, "el reloj no acepta %d Hz\n",
+				     IMX682_XVCLK_HZ);
+
+	s->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset))
+		return dev_err_probe(dev, PTR_ERR(s->reset), "falta el reset\n");
+
+	s->dovdd = devm_regulator_get(dev, "dovdd");
+	if (IS_ERR(s->dovdd))
+		return dev_err_probe(dev, PTR_ERR(s->dovdd), "falta dovdd\n");
+	s->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(s->avdd))
+		return dev_err_probe(dev, PTR_ERR(s->avdd), "falta avdd\n");
+	s->dvdd = devm_regulator_get(dev, "dvdd");
+	if (IS_ERR(s->dvdd))
+		return dev_err_probe(dev, PTR_ERR(s->dvdd), "falta dvdd\n");
+
+	v4l2_i2c_subdev_init(&s->sd, client, &imx682_subdev_ops);
+	s->sd.internal_ops = &imx682_internal_ops;
+	dev_set_drvdata(dev, &s->sd);
+
+	ret = imx682_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "no enciende\n");
+
+	ret = imx682_identify(s);
+	if (ret)
+		goto err_power;
+
+	ret = imx682_init_ctrls(s);
+	if (ret)
+		goto err_power;
+
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->sd.entity.ops = &imx682_entity_ops;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret)
+		goto err_ctrls;
+
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_idle(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "no se registra el subdispositivo\n");
+		goto err_pm;
+	}
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&s->sd);
+err_entity:
+	media_entity_cleanup(&s->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&s->ctrls);
+err_power:
+	imx682_power_off(dev);
+	return ret;
+}
+
+static void imx682_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(&client->dev);
+	struct imx682 *s = to_imx682(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx682_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct dev_pm_ops imx682_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx682_power_off, imx682_power_on, NULL)
+};
+
+static const struct of_device_id imx682_of_match[] = {
+	{ .compatible = "sony,imx682" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx682_of_match);
+
+static struct i2c_driver imx682_i2c_driver = {
+	.driver = {
+		.name = "imx682",
+		.of_match_table = imx682_of_match,
+		.pm = &imx682_pm_ops,
+	},
+	.probe = imx682_probe,
+	.remove = imx682_remove,
+};
+module_i2c_driver(imx682_i2c_driver);
+
+MODULE_DESCRIPTION("Sony IMX682 sensor driver");
+MODULE_LICENSE("GPL");
