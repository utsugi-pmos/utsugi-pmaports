maintainer="Danila Tikhonov <danila@jiaxyga.com>"
_flavor="postmarketos-qcom-sm7150"
_orig=linux-$_flavor
pkgname=$_orig-utsugi
pkgver=7.1_rc3
pkgrel=248

# FORK of linux-postmarketos-qcom-sm7150. _flavor is deliberately NOT renamed:
# /boot/vmlinuz, /lib/modules/<release> and /usr/share/kernel/<flavor> must stay
# byte-identical or mkinitfs and boot-deploy stop finding the kernel. Only the
# package name changes, and the versioned provides makes apk refuse to have this
# and upstream's kernel installed at the same time.
provides="$_orig=$pkgver-r$pkgrel"
replaces="$_orig"
pkgdesc="Mainline Kernel fork for SM7150 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/sm7150-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	"
makedepends="
	bison
	clang
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
	zstd
"

_tag="$pkgver"

