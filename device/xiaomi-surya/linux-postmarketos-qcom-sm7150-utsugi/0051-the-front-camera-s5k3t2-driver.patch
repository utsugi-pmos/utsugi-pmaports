+		 * El modo combinado. Va primero a proposito: es el que ya se
+		 * ha visto capturar en este SoC, y 5 MP son un tamano que el
+		 * revelado por software puede seguir. Los 20 MP de abajo
+		 * piden lo mismo al enlace pero cuadruplican el trabajo del
+		 * revelado.
+		 */
+		.width = 2592,
+		.height = 1940,
+		.hts = 10880,
+		.vts = 2064,
+		.exposure = 512,
+		.reg_list = {
+			.regs = s5k3t2_mode_2592x1940,
+			.num_regs = ARRAY_SIZE(s5k3t2_mode_2592x1940),
+		},
+	},
+	{
+		.width = 5184,
+		.height = 3880,
+		.hts = 5440,
+		.vts = 4160,
+		.exposure = 512,
+		.reg_list = {
+			.regs = s5k3t2_mode_5184x3880,
+			.num_regs = ARRAY_SIZE(s5k3t2_mode_5184x3880),
+		},
+	},
+};
+
+/*
+ * El orden del mosaico de Bayer no se puede deducir del fichero de fabrica, y
+ * equivocarse solo estropea el color, no impide la captura. Va como parametro
+ * para poder corregirlo mirando la primera foto, sin recompilar.
+ */
+static const u32 s5k3t2_bayer_codes[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+static int bayer;
+module_param(bayer, int, 0444);
+MODULE_PARM_DESC(bayer, "Orden del mosaico: 0=GRBG 1=RGGB 2=BGGR 3=GBRG");
+
+static u32 s5k3t2_get_format_code(void)
+{
+	return s5k3t2_bayer_codes[clamp(bayer, 0, 3)];
+}
+
+static inline u64 s5k3t2_freq_to_pixel_rate(u64 freq)
+{
+	return div_u64(freq * 2 * S5K3T2_DATA_LANES, S5K3T2_BPP);
+}
+
+static int s5k3t2_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k3t2 *s5k3t2 = container_of(ctrl->handler, struct s5k3t2,
+					     ctrl_handler);
+	const struct s5k3t2_mode *mode = s5k3t2->mode;
+	s64 exposure_max;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* La exposicion no puede pasar del alto total del fotograma. */
+		exposure_max = mode->height + ctrl->val - S5K3T2_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5k3t2->exposure,
+					 s5k3t2->exposure->minimum,
+					 exposure_max, s5k3t2->exposure->step,
+					 min(s5k3t2->exposure->val, exposure_max));
+	}
+
+	if (!pm_runtime_get_if_in_use(s5k3t2->dev))
+		return 0;
+
+	ret = 0;
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s5k3t2->regmap, S5K3T2_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s5k3t2->regmap, S5K3T2_REG_AGAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(s5k3t2->regmap, S5K3T2_REG_VTS,
+			  mode->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(s5k3t2->regmap, S5K3T2_REG_TEST_PATTERN,
+			  ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_mark_last_busy(s5k3t2->dev);
+	pm_runtime_put_autosuspend(s5k3t2->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k3t2_ctrl_ops = {
+	.s_ctrl = s5k3t2_set_ctrl,
+};
+
+static int s5k3t2_init_controls(struct s5k3t2 *s5k3t2)
+{
+	struct v4l2_ctrl_handler *hdl = &s5k3t2->ctrl_handler;
+	const struct s5k3t2_mode *mode = s5k3t2->mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 pixel_rate, hblank, vblank, exposure_max;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	/*
+	 * LINK_FREQ y PIXEL_RATE no son opcionales: sin ellos CAMSS aborta con
+	 * "Cannot get CSI2 transmitter's link frequency" y no se enciende nada.
+	 */
+	s5k3t2->link_freq = v4l2_ctrl_new_int_menu(hdl, &s5k3t2_ctrl_ops,
+						   V4L2_CID_LINK_FREQ, 0, 0,
+						   s5k3t2_link_freq_menu);
+	if (s5k3t2->link_freq)
+		s5k3t2->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	pixel_rate = s5k3t2_freq_to_pixel_rate(S5K3T2_LINK_FREQ);
+	s5k3t2->pixel_rate = v4l2_ctrl_new_std(hdl, &s5k3t2_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       pixel_rate, pixel_rate, 1,
+					       pixel_rate);
+	if (s5k3t2->pixel_rate)
+		s5k3t2->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	hblank = mode->hts - mode->width;
+	s5k3t2->hblank = v4l2_ctrl_new_std(hdl, &s5k3t2_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (s5k3t2->hblank)
+		s5k3t2->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5k3t2->vblank = v4l2_ctrl_new_std(hdl, &s5k3t2_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5K3T2_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	exposure_max = mode->vts - S5K3T2_EXPOSURE_MARGIN;
+	s5k3t2->exposure = v4l2_ctrl_new_std(hdl, &s5k3t2_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K3T2_EXPOSURE_MIN, exposure_max,
+					     S5K3T2_EXPOSURE_STEP,
+					     mode->exposure);
+
+	v4l2_ctrl_new_std(hdl, &s5k3t2_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K3T2_AGAIN_MIN, S5K3T2_AGAIN_MAX,
+			  S5K3T2_AGAIN_STEP, S5K3T2_AGAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &s5k3t2_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k3t2_test_pattern_menu) - 1,
+				     0, 0, s5k3t2_test_pattern_menu);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		dev_err(s5k3t2->dev, "no pude crear los controles: %d\n", ret);
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(s5k3t2->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &s5k3t2_ctrl_ops, &props);
+	if (ret)
+		goto error;
+
+	s5k3t2->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int s5k3t2_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	const struct s5k3t2_reg_list *reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k3t2->dev);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * Reinicio por programa antes de nada. Va aqui y no en la tabla porque
+	 * necesita una espera detras, y las tablas se escriben de un tiron.
+	 */
+	ret = 0;
+	cci_write(s5k3t2->regmap, S5K3T2_REG_PAGE, 0x4000, &ret);
+	cci_write(s5k3t2->regmap, S5K3T2_REG_RESET, 0x0001, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	usleep_range(5000, 6000);
+
+	ret = cci_multi_reg_write(s5k3t2->regmap, s5k3t2_init,
+				  ARRAY_SIZE(s5k3t2_init), NULL);
+	if (ret) {
+		dev_err(s5k3t2->dev, "fallo la tabla de inicializacion\n");
+		goto err_rpm_put;
+	}
+
+	reg_list = &s5k3t2->mode->reg_list;
+	ret = cci_multi_reg_write(s5k3t2->regmap, reg_list->regs,
+				  reg_list->num_regs, NULL);
+	if (ret) {
+		dev_err(s5k3t2->dev, "fallo la tabla del modo\n");
+		goto err_rpm_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(&s5k3t2->ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	/*
+	 * Los dos volteos van puestos, como hace el Android de fabrica: el
+	 * modulo esta montado del reves.
+	 */
+	ret = cci_write(s5k3t2->regmap, S5K3T2_REG_CTRL_MODE,
+			S5K3T2_MODE_STREAMING | S5K3T2_VFLIP | S5K3T2_HFLIP,
+			NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_mark_last_busy(s5k3t2->dev);
+	pm_runtime_put_autosuspend(s5k3t2->dev);
+
+	return ret;
+}
+
+static int s5k3t2_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	int ret;
+
+	ret = cci_write(s5k3t2->regmap, S5K3T2_REG_CTRL_MODE, 0, NULL);
+
+	pm_runtime_mark_last_busy(s5k3t2->dev);
+	pm_runtime_put_autosuspend(s5k3t2->dev);
+
+	return ret;
+}
+
+static void s5k3t2_update_pad_format(const struct s5k3t2_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = s5k3t2_get_format_code();
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k3t2_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	const struct s5k3t2_mode *mode;
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+	s64 exposure_max, hblank, vblank;
+
+	mode = v4l2_find_nearest_size(s5k3t2_supported_modes,
+				      ARRAY_SIZE(s5k3t2_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5k3t2_update_pad_format(mode, &fmt->format);
+
+	format = v4l2_subdev_state_get_format(state, 0);
+	*format = fmt->format;
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		s5k3t2->mode = mode;
+
+		hblank = mode->hts - mode->width;
+		__v4l2_ctrl_modify_range(s5k3t2->hblank, hblank, hblank, 1,
+					 hblank);
+
+		vblank = mode->vts - mode->height;
+		__v4l2_ctrl_modify_range(s5k3t2->vblank, vblank,
+					 S5K3T2_VTS_MAX - mode->height, 1,
+					 vblank);
+		__v4l2_ctrl_s_ctrl(s5k3t2->vblank, vblank);
+
+		exposure_max = mode->vts - S5K3T2_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5k3t2->exposure,
+					 S5K3T2_EXPOSURE_MIN, exposure_max,
+					 S5K3T2_EXPOSURE_STEP, mode->exposure);
+	}
+
+	return 0;
+}
+
+static int s5k3t2_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k3t2_get_format_code();
+
+	return 0;
+}
+
+static int s5k3t2_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(s5k3t2_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k3t2_get_format_code())
+		return -EINVAL;
+
+	fse->min_width = s5k3t2_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k3t2_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5k3t2_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = 5184;
+		sel->r.height = 3880;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int s5k3t2_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = s5k3t2_supported_modes[0].width,
+			.height = s5k3t2_supported_modes[0].height,
+		},
+	};
+
+	return s5k3t2_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops s5k3t2_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k3t2_pad_ops = {
+	.enum_mbus_code = s5k3t2_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = s5k3t2_set_pad_format,
+	.enum_frame_size = s5k3t2_enum_frame_size,
+	.get_selection = s5k3t2_get_selection,
+	.enable_streams = s5k3t2_enable_streams,
+	.disable_streams = s5k3t2_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k3t2_subdev_ops = {
+	.video = &s5k3t2_video_ops,
+	.pad = &s5k3t2_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k3t2_internal_ops = {
+	.init_state = s5k3t2_init_state,
+};
+
+static const struct media_entity_operations s5k3t2_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+/* Lee la identificacion en una direccion concreta, sin usar el regmap. */
+static int s5k3t2_probe_id_at(struct i2c_client *client, u8 addr, u16 *id)
+{
+	u8 reg[2] = { 0x00, 0x00 };
+	u8 val[2];
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0, .len = 2, .buf = reg },
+		{ .addr = addr, .flags = I2C_M_RD, .len = 2, .buf = val },
+	};
+	int ret;
+
+	ret = i2c_transfer(client->adapter, msgs, 2);
+	if (ret != 2)
+		return -ENODEV;
+
+	*id = (val[0] << 8) | val[1];
+
+	return 0;
+}
+
+/*
+ * El fichero de fabrica NO trae la direccion del sensor -su unico slaveAddr es
+ * la EEPROM-, asi que se busca leyendo la identificacion. Es la misma trampa
+ * que con el trasero, donde el 0x50 "documentado" resulto ser la EEPROM y el
+ * sensor estaba en 0x1a.
+ */
+static int s5k3t2_find_sensor(struct s5k3t2 *s5k3t2, struct i2c_client *client)
+{
+	static const u8 probables[] = { 0x10, 0x2d, 0x1a, 0x16, 0x20, 0x36, 0x3c, 0x5a };
+	u16 id;
+	int i;
+
+	if (i2c_addr >= 0) {
+		client->addr = i2c_addr;
+		dev_info(s5k3t2->dev, "direccion forzada por parametro: 0x%02x\n",
+			 i2c_addr);
+		return 0;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(probables); i++) {
+		if (!s5k3t2_probe_id_at(client, probables[i], &id) &&
+		    id == S5K3T2_CHIP_ID) {
+			dev_info(s5k3t2->dev, "S5K3T2 encontrado en 0x%02x\n",
+				 probables[i]);
+			client->addr = probables[i];
+			return 0;
+		}
+	}
+
+	/* Nada en las probables: barrido completo, y se dice quien contesta. */
+	for (i = 0x08; i <= 0x77; i++) {
+		if (s5k3t2_probe_id_at(client, i, &id))
+			continue;
+
+		dev_info(s5k3t2->dev, "contesta 0x%02x, identificacion 0x%04x\n",
+			 i, id);
+
+		if (id == S5K3T2_CHIP_ID) {
+			client->addr = i;
+			return 0;
+		}
+	}
+
+	return -ENODEV;
+}
+
+static int s5k3t2_check_hwcfg(struct s5k3t2 *s5k3t2)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k3t2->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5K3T2_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K3T2_DATA_LANES) {
+		dev_err(s5k3t2->dev, "hacen falta %u carriles, el device tree dice %u\n",
+			S5K3T2_DATA_LANES, bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k3t2->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k3t2_link_freq_menu,
+				       ARRAY_SIZE(s5k3t2_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int s5k3t2_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(S5K3T2_NUM_SUPPLIES, s5k3t2->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(s5k3t2->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 0);
+	usleep_range(10 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_regulators:
+	regulator_bulk_disable(S5K3T2_NUM_SUPPLIES, s5k3t2->supplies);
+
+	return ret;
+}
+
+static int s5k3t2_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 1);
+	clk_disable_unprepare(s5k3t2->mclk);
+	regulator_bulk_disable(S5K3T2_NUM_SUPPLIES, s5k3t2->supplies);
+
+	return 0;
+}
+
+static int s5k3t2_probe(struct i2c_client *client)
+{
+	struct s5k3t2 *s5k3t2;
+	unsigned long freq;
+	unsigned int i;
+	u16 id;
+	int ret;
+
+	s5k3t2 = devm_kzalloc(&client->dev, sizeof(*s5k3t2), GFP_KERNEL);
+	if (!s5k3t2)
+		return -ENOMEM;
+
+	s5k3t2->dev = &client->dev;
+
+	/*
+	 * Esto va lo primero, y no es cosmetico: es lo que deja el subdev
+	 * colgado del device, y s5k3t2_power_on() lo busca ahi con
+	 * dev_get_drvdata(). Encender antes de esta linea es una
+	 * desreferencia a NULL nada mas arrancar.
+	 */
+	v4l2_i2c_subdev_init(&s5k3t2->sd, client, &s5k3t2_subdev_ops);
+
+	s5k3t2->mclk = devm_v4l2_sensor_clk_get(s5k3t2->dev, NULL);
+	if (IS_ERR(s5k3t2->mclk))
+		return dev_err_probe(s5k3t2->dev, PTR_ERR(s5k3t2->mclk),
+				     "no pude coger el MCLK\n");
+
+	freq = clk_get_rate(s5k3t2->mclk);
+	if (freq != S5K3T2_MCLK_FREQ)
+		return dev_err_probe(s5k3t2->dev, -EINVAL,
+				     "el MCLK esta a %lu Hz y las tablas son para %lu\n",
+				     freq, (unsigned long)S5K3T2_MCLK_FREQ);
+
+	ret = s5k3t2_check_hwcfg(s5k3t2);
+	if (ret)
+		return dev_err_probe(s5k3t2->dev, ret,
+				     "el device tree no cuadra\n");
+
+	s5k3t2->reset_gpio = devm_gpiod_get_optional(s5k3t2->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3t2->reset_gpio))
+		return dev_err_probe(s5k3t2->dev, PTR_ERR(s5k3t2->reset_gpio),
+				     "no pude coger el pin de reset\n");
+
+	for (i = 0; i < S5K3T2_NUM_SUPPLIES; i++)
+		s5k3t2->supplies[i].supply = s5k3t2_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k3t2->dev, S5K3T2_NUM_SUPPLIES,
+				      s5k3t2->supplies);
+	if (ret)
+		return dev_err_probe(s5k3t2->dev, ret,
+				     "no pude coger los reguladores\n");
+
+	/*
+	 * El conmutador MIPI que comparten la frontal y el gran angular. Se
+	 * pide como opcional y solo se toca si lo mandan por parametro: no se
+	 * conduce un pin cuya posicion correcta todavia no esta medida.
+	 */
+	s5k3t2->mipi_switch_reg = devm_regulator_get_optional(s5k3t2->dev,
+							      "mipi-switch");
+	if (IS_ERR(s5k3t2->mipi_switch_reg))
+		s5k3t2->mipi_switch_reg = NULL;
+
+	if (s5k3t2->mipi_switch_reg && mipi_switch >= 0) {
+		ret = mipi_switch ?
+			regulator_enable(s5k3t2->mipi_switch_reg) :
+			regulator_disable(s5k3t2->mipi_switch_reg);
+		if (ret)
+			dev_warn(s5k3t2->dev,
+				 "no pude poner el conmutador MIPI a %d: %d\n",
+				 mipi_switch, ret);
+		else
+			dev_info(s5k3t2->dev, "conmutador MIPI puesto a %d\n",
+				 mipi_switch);
+	}
+
+	/* Hay que alimentarlo y darle reloj antes de que conteste por I2C. */
+	ret = s5k3t2_power_on(s5k3t2->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k3t2_find_sensor(s5k3t2, client);
+	if (ret) {
+		dev_err(s5k3t2->dev, "no encuentro el S5K3T2 en el bus\n");
+		goto power_off;
+	}
+
+	s5k3t2->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k3t2->regmap)) {
+		ret = dev_err_probe(s5k3t2->dev, PTR_ERR(s5k3t2->regmap),
+				    "no pude arrancar el CCI\n");
+		goto power_off;
+	}
+
+	ret = s5k3t2_probe_id_at(client, client->addr, &id);
+	if (ret || id != S5K3T2_CHIP_ID) {
+		dev_err(s5k3t2->dev, "identificacion 0x%04x, esperaba 0x%04x\n",
+			id, S5K3T2_CHIP_ID);
+		ret = -ENODEV;
+		goto power_off;
+	}
+
+	dev_info(s5k3t2->dev, "ES UN S5K3T2: identificacion 0x%04x en 0x%02x\n",
+		 id, client->addr);
+
+	s5k3t2->mode = &s5k3t2_supported_modes[0];
+
+	ret = s5k3t2_init_controls(s5k3t2);
+	if (ret) {
+		dev_err_probe(s5k3t2->dev, ret, "fallaron los controles\n");
+		goto power_off;
+	}
+
+	s5k3t2->sd.state_lock = s5k3t2->ctrl_handler.lock;
+	s5k3t2->sd.internal_ops = &s5k3t2_internal_ops;
+	s5k3t2->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3t2->sd.entity.ops = &s5k3t2_subdev_entity_ops;
+	s5k3t2->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k3t2->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k3t2->sd.entity, 1, &s5k3t2->pad);
+	if (ret)
+		goto ctrl_free;
+
+	ret = v4l2_subdev_init_finalize(&s5k3t2->sd);
+	if (ret < 0)
+		goto media_cleanup;
+
+	pm_runtime_set_active(s5k3t2->dev);
+	pm_runtime_enable(s5k3t2->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3t2->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3t2->dev, ret, "no pude registrar el subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5k3t2->dev, 1000);
+	pm_runtime_use_autosuspend(s5k3t2->dev);
+	pm_runtime_idle(s5k3t2->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k3t2->sd);
+	pm_runtime_disable(s5k3t2->dev);
+	pm_runtime_set_suspended(s5k3t2->dev);
+
+media_cleanup:
+	media_entity_cleanup(&s5k3t2->sd.entity);
+
+ctrl_free:
+	v4l2_ctrl_handler_free(&s5k3t2->ctrl_handler);
+
+power_off:
+	s5k3t2_power_off(s5k3t2->dev);
+
+	return ret;
+}
+
+static void s5k3t2_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k3t2->dev);
+
+	if (!pm_runtime_status_suspended(s5k3t2->dev)) {
+		s5k3t2_power_off(s5k3t2->dev);
+		pm_runtime_set_suspended(s5k3t2->dev);
+	}
+}
+
+static const struct dev_pm_ops s5k3t2_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k3t2_power_off, s5k3t2_power_on, NULL)
+};
+
+static const struct of_device_id s5k3t2_of_match[] = {
+	{ .compatible = "samsung,s5k3t2" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5k3t2_of_match);
+
+static struct i2c_driver s5k3t2_i2c_driver = {
+	.driver = {
+		.name = "s5k3t2",
+		.pm = &s5k3t2_pm_ops,
+		.of_match_table = s5k3t2_of_match,
+	},
+	.probe = s5k3t2_probe,
+	.remove = s5k3t2_remove,
+};
+
+module_i2c_driver(s5k3t2_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K3T2 sensor driver");
+MODULE_LICENSE("GPL");
