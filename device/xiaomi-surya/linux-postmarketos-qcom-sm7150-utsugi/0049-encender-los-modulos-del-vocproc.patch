Encender los modulos del vocproc, que vienen apagados

QUE PASA
--------
Con la topologia de surya (0x10010F8B) ya registrada y llegando de verdad a la
llamada, la voz sale al otro lado, pero:

  - la otra persona se oye a si misma;
  - y nos oye con calidad de walkie-talkie.

Medido bajando el volumen del auricular durante una llamada real: el eco BAJA
con el volumen y casi desaparece. O sea que es eco ACUSTICO -el altavoz
colandose por el microfono-, no interno. Y si es acustico, el cancelador de eco
deberia poder quitarlo.

POR QUE NO LO QUITA
-------------------
La sesion se crea con profile_id = VSS_ICOMMON_CAL_NETWORK_ID_NONE, o sea sin
calibracion. Y contando los parametros de la calibracion de fabrica
(QRD_Handset_cal.acdb, seccion VSTICDFT):

    0x00010E00   x117   <- aparece con 26 de los 27 modulos
    0x00010E09   x47
    0x00010E13   x19

Un parametro que acompaña a CASI TODOS los modulos no es un ajuste fino: es el
interruptor de habilitacion. La conclusion es que los modulos del vocproc no
estan "cargados y sin ajustar": estan APAGADOS, porque nunca se les manda el
enable que va dentro de la calibracion.

Eso explica de golpe todo lo observado, incluido lo que no cuadraba: barrer
ec_ref_port y vocproc_mode no cambio NADA en ninguna de las cuatro
combinaciones. Claro: da igual que referencia le des a un modulo apagado.

QUE HACE ESTE PARCHE
--------------------
VSS_ICOMMON_CMD_SET_PARAM_V2 ya estaba implementado y funcionando -se usa para
channel info y media format-, asi que no hace falta implementar la calibracion
entera ni parsear las tablas CDOT/OFST del ACDB: basta con mandar el enable.

Se añade una lista de modulos ajustable EN CALIENTE:

    /sys/module/q6cvp/parameters/encender_modulos

Vacia por defecto, o sea que sin tocarla el comportamiento es el de antes. Se
rellena con una lista separada por comas, en hexadecimal o decimal:

    echo 0x10ee1,0x10ee7,0x10ee9 > /sys/module/q6cvp/parameters/encender_modulos

Los enables se mandan al final de TOPOLOGY_COMMIT, que es justo donde iria la
calibracion: despues de fijar la topologia y antes de habilitar el vocproc.

COMO SE BARRE SIN RECOMPILAR
----------------------------
Los modulos se leen al MONTAR la sesion, asi que hay que rehacer el camino de
voz para que surtan efecto -igual que con vocproc_mode y ec_ref_port-:

    echo <lista> > /sys/module/q6cvp/parameters/encender_modulos
    systemctl restart voz-en-llamada

Con eso se prueban los 26 modulos en una o dos llamadas en vez de una por
llamada, que es lo que estaba frenando el avance.

AVISO HONESTO
-------------
Que 0x00010E00 sea el enable es una DEDUCCION a partir de que acompaña a 26 de
27 modulos en la calibracion de fabrica. No tenemos la cabecera de Qualcomm que
lo confirme. Por eso se traza cada envio con su resultado: si el parametro no es
lo que creemos, el DSP contestara error y se vera enseguida, en vez de quedarnos
con la duda de si se mando bien.

diff -ruN a/sound/soc/qcom/qdsp6/q6cvp.c b/sound/soc/qcom/qdsp6/q6cvp.c
--- a/sound/soc/qcom/qdsp6/q6cvp.c
+++ b/sound/soc/qcom/qdsp6/q6cvp.c
@@ -29,6 +29,35 @@
 #define VSS_ICOMMON_CAL_NETWORK_ID_NONE			0x0001135E
 
 /*
+ * Interruptor de habilitacion de un modulo del vocproc.
+ *
+ * Deducido de la calibracion de fabrica (QRD_Handset_cal.acdb, seccion
+ * VSTICDFT): este parametro acompaña a 26 de los 27 modulos, y uno que sale con
+ * casi todos no es un ajuste fino, es el enable. Sin calibracion nunca se
+ * manda, y por eso los modulos -el cancelador de eco entre ellos- estan
+ * apagados.
+ */
+#define VOICE_PARAM_MOD_ENABLE				0x00010E00
+
+/*
+ * Modulos del vocproc a encender al montar la sesion, ajustable en caliente:
+ *
+ *     echo 0x10ee1,0x10ee7 > /sys/module/q6cvp/parameters/encender_modulos
+ *
+ * Vacio por defecto: sin tocarlo el comportamiento es exactamente el de antes.
+ * Se leen al MONTAR la sesion, asi que para que un cambio surta efecto hay que
+ * rehacer el camino de voz.
+ *
+ * La lista que trae la calibracion de fabrica de surya se saca con
+ * surya/audio/acdb-calibracion-vocproc.py.
+ */
+static char encender_modulos[512];
+module_param_string(encender_modulos, encender_modulos,
+		    sizeof(encender_modulos), 0644);
+MODULE_PARM_DESC(encender_modulos,
+		 "modulos del vocproc a encender, separados por comas");
+
+/*
  * AJUSTABLES EN CALIENTE, para poder barrer configuraciones sin recompilar:
  *
  *   /sys/module/q6cvp/parameters/vocproc_mode
@@ -199,6 +228,7 @@
 	u16 reserved;
 
 	union {
+		u32 valor;
 		struct vss_param_endpoint_media_format_info media_format_info;
 		struct vss_param_vocproc_dev_channel_info channel_info;
 	};
@@ -401,14 +431,103 @@
 }
 EXPORT_SYMBOL_GPL(q6cvp_set_mute);
 
+/*
+ * Manda un parametro de un solo u32 a un modulo del vocproc, por el mismo
+ * SET_PARAM_V2 que ya se usa para channel info y media format.
+ */
+static int q6cvp_set_param_u32(struct q6voice_session *cvp, u32 module_id,
+			       u32 param_id, u32 valor)
+{
+	struct vss_icommon_cmd_set_param_v2_cmd cmd;
+
+	cmd.hdr.pkt_size = offsetof(struct vss_icommon_cmd_set_param_v2_cmd,
+				    param_data.valor)
+			 + sizeof(cmd.param_data.valor);
+	cmd.hdr.opcode = VSS_ICOMMON_CMD_SET_PARAM_V2;
+
+	/* En banda: el dato va en el propio paquete, sin memoria compartida. */
+	cmd.mem_handle = 0;
+	cmd.mem_address = 0;
+	cmd.mem_size = offsetof(struct vss_icommon_param_data, valor)
+		     + sizeof(cmd.param_data.valor);
+
+	cmd.param_data.module_id = module_id;
+	cmd.param_data.param_id = param_id;
+	cmd.param_data.param_size = sizeof(cmd.param_data.valor);
+	cmd.param_data.reserved = 0;
+	cmd.param_data.valor = valor;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+
+/*
+ * Enciende los modulos de la lista, uno a uno.
+ *
+ * Se traza cada uno con su resultado a proposito: si VOICE_PARAM_MOD_ENABLE no
+ * fuera lo que creemos, el DSP contestara error y se vera aqui, en vez de
+ * quedarnos con la duda de si se mando bien.
+ */
+static void q6cvp_encender_modulos(struct q6voice_session *cvp)
+{
+	char lista[sizeof(encender_modulos)];
+	char *p, *tok;
+	int encendidos = 0, fallos = 0;
+
+	if (!encender_modulos[0])
+		return;
+
+	/* strsep() escribe sobre el buffer, y el del parametro no es nuestro. */
+	strscpy(lista, encender_modulos, sizeof(lista));
+	p = lista;
+
+	while ((tok = strsep(&p, ",")) != NULL) {
+		u32 module_id;
+		int ret;
+
+		tok = strim(tok);
+		if (!*tok)
+			continue;
+		if (kstrtou32(tok, 0, &module_id)) {
+			pr_warn("q6cvp: modulo ilegible en la lista: '%s'\n",
+				tok);
+			continue;
+		}
+
+		ret = q6cvp_set_param_u32(cvp, module_id,
+					  VOICE_PARAM_MOD_ENABLE, 1);
+		if (ret < 0) {
+			pr_err("q6cvp: modulo %#x: el DSP lo rechaza (%d)\n",
+			       module_id, ret);
+			fallos++;
+		} else {
+			pr_info("q6cvp: modulo %#x encendido\n", module_id);
+			encendidos++;
+		}
+	}
+
+	pr_info("q6cvp: %d modulos encendidos, %d rechazados\n",
+		encendidos, fallos);
+}
+
 int q6cvp_topology_commit(struct q6voice_session *cvp)
 {
 	struct apr_pkt cmd;
+	int ret;
 
 	cmd.hdr.pkt_size = APR_HDR_SIZE;
 	cmd.hdr.opcode = VSS_IVOCPROC_CMD_TOPOLOGY_COMMIT;
 
-	return q6voice_common_send(cvp, &cmd.hdr);
+	ret = q6voice_common_send(cvp, &cmd.hdr);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * Aqui es donde iria la calibracion del vocproc, que nunca se manda.
+	 * De ella mandamos, de momento, solo el enable de los modulos.
+	 */
+	q6cvp_encender_modulos(cvp);
+
+	return 0;
 }
 EXPORT_SYMBOL_GPL(q6cvp_topology_commit);
 
