@@ -464,3 +464,36 @@
 &wifi {
 	qcom,ath10k-calibration-variant = "xiaomi_surya";
 };
+
+&tlmm {
+	fp_reset_default: fp-reset-default-state {
+		pins = "gpio90";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	fp_irq_default: fp-irq-default-state {
+		pins = "gpio89";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+/ {
+	fingerprint {
+		compatible = "goodix,fingerprint";
+		pinctrl-names = "default";
+		pinctrl-0 = <&fp_reset_default>, <&fp_irq_default>;
+
+		reset-gpios = <&tlmm 90 GPIO_ACTIVE_HIGH>;
+		irq-gpios = <&tlmm 89 GPIO_ACTIVE_HIGH>;
+
+		vdd-supply = <&vreg_l7c_3p0>;
+		vddio-supply = <&vreg_l8c_1p8>;
+
+		clocks = <&gcc GCC_QUPV3_WRAP1_S0_CLK>;
+		clock-names = "se";
+	};
+};
