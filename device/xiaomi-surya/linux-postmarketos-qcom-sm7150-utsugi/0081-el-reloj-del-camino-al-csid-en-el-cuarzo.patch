--- a/drivers/media/platform/qcom/camss/camss-csid.c
+++ b/drivers/media/platform/qcom/camss/camss-csid.c
@@ -27,6 +27,15 @@
 #include "camss-csid-gen1.h"
 #include "camss.h"
 
+/*
+ * Para barrer la frecuencia del camino CSIPHY->CSID sin recompilar.
+ * -1 usa la de la tabla. El SM7150 admite 19200000, 300000000,
+ * 384000000 y 400000000; cualquier otro valor lo redondea el RCG.
+ */
+static int tasa_cphy_rx = -1;
+module_param(tasa_cphy_rx, int, 0644);
+MODULE_PARM_DESC(tasa_cphy_rx, "Hz del reloj cphy_rx del CSID (-1 = tabla)");
+
 /* offset of CSID registers in VFE region for VFE 480 */
 #define VFE_480_CSID_OFFSET 0x4000
 #define VFE_480_LITE_CSID_OFFSET 0x200
@@ -589,6 +598,22 @@
 				dev_err(dev, "clk set rate failed: %d\n", ret);
 				return ret;
 			}
+		} else if (strstr(clock->name, "cphy_rx")) {
+			/*
+			 * Se trata aparte para poder barrerlo en caliente y
+			 * para DEJAR CONSTANCIA del ritmo que queda de
+			 * verdad: pedir una frecuencia no garantiza tenerla,
+			 * y este reloj llevaba desde siempre en el cuarzo sin
+			 * que nada lo dijera.
+			 */
+			unsigned long pedida = tasa_cphy_rx > 0 ? tasa_cphy_rx :
+					       (clock->nfreqs ? clock->freq[0] : 0);
+
+			if (pedida)
+				clk_set_rate(clock->clk, pedida);
+
+			dev_info(dev, "%s: pedido %lu Hz, queda %lu Hz\n",
+				 clock->name, pedida, clk_get_rate(clock->clk));
 		} else if (clock->nfreqs) {
 			clk_set_rate(clock->clk, clock->freq[0]);
 		}
