--- /dev/null
+++ b/drivers/media/i2c/surya-cam-scan.c
@@ -0,0 +1,448 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Buscador de sensores de camara en el bus CCI del Xiaomi POCO X3 NFC.
+ *
+ * POR QUE EXISTE
+ * --------------
+ * El movil tiene cuatro camaras traseras. Dos funcionan; las otras -gran
+ * angular Hi-1337, macro Hi-259 y profundidad- cuelgan de cci1_i2c0, que en el
+ * device tree esta VACIO. Y para escribirles un driver hace falta saber dos
+ * cosas que nadie dice: en que direccion contestan y con que GPIO se les quita
+ * el reset.
+ *
+ * Escanear desde el espacio de usuario NO sirve, y esta medido: con la trasera
+ * alimentada, en ese bus contestan 0x51, 0x54, 0x59 y 0x5c, pero ninguno
+ * responde al registro de identificacion de los SK Hynix (0x0f16, que en el
+ * hi846 de mainline devuelve 46 08). O sea que no son sensores: los sensores
+ * siguen apagados.
+ *
+ * Y no basta con encender rieles a mano, porque un sensor necesita ademas su
+ * MCLK -que solo levanta un driver- y que se le suelte el reset.
+ *
+ * QUE HACE ESTE MODULO
+ * --------------------
+ * Enciende la secuencia entera igual que la haria un driver de verdad
+ * -alimentaciones, reloj, espera- y despues, por cada GPIO candidato de reset:
+ *
+ *     lo suelta, barre el bus entero, y lo vuelve a poner
+ *
+ * De cada direccion que conteste lee el identificador de Hynix y el registro
+ * 0x0000, que es donde lo llevan los Sony y los Samsung. Asi una sola prueba
+ * contesta las dos preguntas a la vez.
+ *
+ * Va como MODULO y no como driver normal a proposito: se carga a mano cuando se
+ * quiere medir, se lee el dmesg, y se descarga. Un fallo aqui no puede dejar el
+ * movil sin arrancar.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+/* Los mismos tres nombres que usa el driver hi846, para poder reutilizar su
+ * device tree tal cual cuando esto se convierta en el driver de verdad. */
+static const char * const surya_supplies[] = { "vddio", "vdda", "vddd" };
+
+/* Tope de candidatos. Ahora la lista trae 36 -el reset, 19 pines libres del
+ * tlmm y 16 de los dos PMIC- y el margen es para poder añadir mas en el device
+ * tree sin tocar el codigo. OJO: si la lista del device tree crece por encima
+ * de esto, el modulo la RECORTA en silencio, asi que los dos numeros que
+ * imprime al arrancar -utiles y totales- son la comprobacion de que se ha
+ * probado todo. */
+#define SURYA_MAX_RESETS 48
+
+/* Lo que hay que apagar al descargar el modulo, y solo se rellena en el camino
+ * de `mantener`, que es el unico que deja el probe enlazado. */
+struct surya_encendido {
+	struct regulator_bulk_data *supplies;
+	struct clk_bulk_data *relojes;
+	int nrelojes;
+	struct gpio_desc *reset;
+	struct gpio_desc *standby;	/* NULL si se dejo sin standby */
+};
+
+/* Con esto puesto al indice de un candidato, el modulo NO apaga al terminar:
+ * deja ese reset suelto, los relojes girando y los rieles encendidos, y se
+ * queda enlazado. Sirve para seguir hurgando desde el espacio de usuario con
+ * i2ctransfer, que es mucho mas rapido que recompilar el kernel por cada
+ * registro que uno quiera leer.
+ *
+ * Lo que queda encendido lo apaga surya_cam_scan_remove() al descargar el
+ * modulo. Hacerlo importa mas de lo que parece: ni clk_bulk_prepare_enable ni
+ * regulator_bulk_enable son devm, asi que sin ese remove devres liberaba los
+ * reguladores con la cuenta de habilitacion en pie -tres WARN en
+ * regulator_bulk_free, uno por riel- y los dejaba encendidos para siempre, con
+ * el kernel ya marcado. Y un kernel marcado es exactamente el estado en el que
+ * aparecio el interbloqueo del UFS.
+ *
+ * Para verlo hay que mirar el DELTA en regulator_summary, no el numero suelto:
+ * cam_avdd1 -el vdda de este nodo- ya sale con uso 1 y open 0 recien arrancado,
+ * asi que ese valor por si solo no dice nada. Lo que delataba la fuga es que
+ * subia a 2 al cargar y se QUEDABA en 2 despues del rmmod. Ahora vuelve a 1. */
+static int mantener = -1;
+module_param(mantener, int, 0644);
+MODULE_PARM_DESC(mantener,
+		 "indice del gpio candidato que queda suelto con todo encendido; -1 apaga y sale");
+
+/*
+ * Registros de identificacion.
+ *
+ * EL FALLO QUE COSTO TODA LA INVESTIGACION: el 0x0f16 se copio del driver
+ * hi846 de mainline -donde HI846_REG_CHIP_ID_L vale 0x0f16 y devuelve 46 08- y
+ * se dio por hecho que el Hi-1337, por ser tambien SK Hynix, lo tendria en el
+ * mismo sitio. NO lo tiene.
+ *
+ * El Hi-1337 pone su identificador en 0x0716, y ahi contesta 1337 limpio. En
+ * 0x0f16 devuelve 0000, que es lo que se estuvo leyendo ronda tras ronda como
+ * "el sensor no despierta". El sensor llevaba despierto desde que se encontro
+ * el reset; lo que no despertaba era la pregunta.
+ *
+ * Se dejan los dos: si algun dia aparece un Hi-846 de verdad en este bus, hay
+ * que poder distinguirlo.
+ */
+#define REG_ID_HI1337	0x0716
+#define REG_ID_HI846	0x0f16
+#define REG_ID_SMIA	0x0000
+
+/* Tamaño de salida a plena resolucion. Sirve de segunda confirmacion: el
+ * Hi-1337 da 0x1070 x 0x0c30, o sea 4208 x 3120, que es justo lo que dicen los
+ * modos extraidos del blob de fabrica. */
+#define REG_ANCHO	0x0b12
+#define REG_ALTO	0x0b14
+
+static int leer16(struct i2c_client *cl, u16 addr, u16 reg, u16 *val)
+{
+	u8 buf[2] = { reg >> 8, reg & 0xff };
+	u8 out[2];
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0, .len = 2, .buf = buf },
+		{ .addr = addr, .flags = I2C_M_RD, .len = 2, .buf = out },
+	};
+
+	if (i2c_transfer(cl->adapter, msgs, 2) != 2)
+		return -EIO;
+	*val = (out[0] << 8) | out[1];
+	return 0;
+}
+
+static bool contesta(struct i2c_client *cl, u16 addr)
+{
+	u8 b;
+	struct i2c_msg m = { .addr = addr, .flags = I2C_M_RD, .len = 1, .buf = &b };
+
+	return i2c_transfer(cl->adapter, &m, 1) == 1;
+}
+
+/* El reset se PULSA, no se suelta y ya: la secuencia de fabrica lo baja, deja
+ * asentar, y lo sube. Si el standby cambia mientras el reset esta suelto, el
+ * sensor no se entera. */
+static int escribir16(struct i2c_client *cl, u16 addr, u16 reg, u8 val)
+{
+	u8 buf[3] = { reg >> 8, reg & 0xff, val };
+	struct i2c_msg m = { .addr = addr, .flags = 0, .len = 3, .buf = buf };
+
+	return i2c_transfer(cl->adapter, &m, 1) == 1 ? 0 : -EIO;
+}
+
+/*
+ * LA SONDA
+ *
+ * Existe por una limitacion medida: en el bus del CCI, i2ctransfer contesta
+ * "Not supported" -el adaptador no hace las transacciones combinadas que usa- y
+ * desde el espacio de usuario solo se llega con i2cget/i2cdump, que son de 8
+ * bits. Pero los sensores de este bus hablan con registros de 16 bits. O sea
+ * que CADA hipotesis de 16 bits costaba recompilar el kernel: diez minutos por
+ * pregunta.
+ *
+ * Con esto, mientras `mantener` sostiene rieles y relojes, se pregunta desde
+ * fuera y sin recompilar nada:
+ *
+ *     echo "21 0f16"      > /sys/module/surya_cam_scan/parameters/sonda
+ *     echo "21 0a00 01"   > /sys/module/surya_cam_scan/parameters/sonda
+ *     dmesg | tail -1
+ *
+ * Dos campos leen dos bytes (el registro y el siguiente); tres escriben un byte
+ * y releen para ver que ha cuajado. La respuesta sale por dmesg y no por el
+ * propio fichero porque el parametro es de solo escritura.
+ */
+static struct i2c_client *sonda_cliente;
+
+static int sonda_set(const char *val, const struct kernel_param *kp)
+{
+	struct i2c_client *cl = READ_ONCE(sonda_cliente);
+	unsigned int addr, reg, dato = 0;
+	u16 leido;
+	int n, ret;
+
+	/* Solo hay bus si el probe se quedo enlazado, o sea con `mantener`. */
+	if (!cl)
+		return -ENODEV;
+
+	n = sscanf(val, "%x %x %x", &addr, &reg, &dato);
+	if (n < 2 || addr > 0x7f || reg > 0xffff || (n >= 3 && dato > 0xff))
+		return -EINVAL;
+
+	if (n >= 3) {
+		ret = escribir16(cl, addr, reg, dato);
+		if (ret) {
+			dev_info(&cl->dev, "sonda: escribir %02x/%04x=%02x fallo\n",
+				 addr, reg, dato);
+			return 0;
+		}
+	}
+
+	ret = leer16(cl, addr, reg, &leido);
+	if (ret)
+		dev_info(&cl->dev, "sonda: %02x/%04x no contesta\n", addr, reg);
+	else
+		dev_info(&cl->dev, "sonda: %02x/%04x = %04x\n", addr, reg, leido);
+	return 0;
+}
+
+static const struct kernel_param_ops sonda_ops = { .set = sonda_set };
+module_param_cb(sonda, &sonda_ops, NULL, 0200);
+MODULE_PARM_DESC(sonda,
+		 "\"dir reg\" lee 16 bits, \"dir reg dato\" escribe 8 y relee; la respuesta sale por dmesg");
+
+static void pulso_reset(struct gpio_desc *rst)
+{
+	gpiod_set_value_cansleep(rst, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(rst, 1);
+	usleep_range(10000, 12000);
+}
+
+static void barrer(struct i2c_client *cl, const char *cuando)
+{
+	unsigned int a;
+	int hallados = 0;
+
+	for (a = 0x08; a <= 0x77; a++) {
+		u16 hi1337 = 0, hi846 = 0, smia = 0, ancho = 0, alto = 0;
+
+		if (a == cl->addr || !contesta(cl, a))
+			continue;
+
+		hallados++;
+		leer16(cl, a, REG_ID_HI1337, &hi1337);
+		leer16(cl, a, REG_ID_HI846, &hi846);
+		leer16(cl, a, REG_ID_SMIA, &smia);
+		leer16(cl, a, REG_ANCHO, &ancho);
+		leer16(cl, a, REG_ALTO, &alto);
+		dev_info(&cl->dev,
+			 "%s: 0x%02x contesta  hi1337(0x0716)=%04x hi846(0x0f16)=%04x smia(0x0000)=%04x  %ux%u\n",
+			 cuando, a, hi1337, hi846, smia, ancho, alto);
+		if (hi1337 == 0x1337)
+			dev_info(&cl->dev, "%s: 0x%02x ES EL Hi-1337, el gran angular\n",
+				 cuando, a);
+	}
+	if (!hallados)
+		dev_info(&cl->dev, "%s: nadie contesta\n", cuando);
+}
+
+static int surya_cam_scan_probe(struct i2c_client *cl)
+{
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *resets[SURYA_MAX_RESETS];
+	unsigned int pin[SURYA_MAX_RESETS];
+	unsigned int nresets = 0;
+	int ncand;
+	struct clk_bulk_data *relojes;
+	int nrelojes;
+	unsigned int i;
+	int ret;
+
+	/* EN EL MONTON, no en la pila: devm_regulator_bulk_get() se QUEDA con el
+	 * puntero a este array y lo vuelve a leer al liberar, que aqui ocurre
+	 * siempre porque el probe termina en -ENODEV a proposito. Con el array
+	 * en la pila de probe() eso es leer memoria muerta: el kernel reventaba
+	 * con un NULL deref en devm_regulator_bulk_release, quedaba marcado, y
+	 * al rato el UFS se interbloqueaba apagando su reloj y el movil se
+	 * quedaba con 35 procesos clavados en espera de disco. */
+	supplies = devm_kcalloc(&cl->dev, ARRAY_SIZE(surya_supplies),
+				sizeof(*supplies), GFP_KERNEL);
+	if (!supplies)
+		return -ENOMEM;
+
+	for (i = 0; i < ARRAY_SIZE(surya_supplies); i++)
+		supplies[i].supply = surya_supplies[i];
+
+	ret = devm_regulator_bulk_get(&cl->dev, ARRAY_SIZE(surya_supplies), supplies);
+	if (ret)
+		return dev_err_probe(&cl->dev, ret, "sin alimentaciones\n");
+
+	nrelojes = devm_clk_bulk_get_all(&cl->dev, &relojes);
+	if (nrelojes < 0)
+		return dev_err_probe(&cl->dev, nrelojes, "sin relojes\n");
+
+	/* La frecuencia se pone AQUI y no con assigned-clocks en el device
+	 * tree: aquello lo aplica el nucleo al registrar el nodo, sin driver
+	 * de por medio, y colgaba el arranque. */
+	/* 19,2 MHz. El device tree generico del QRD dice 24 MHz, pero el
+	 * fichero de fabrica de ESTE modulo -powerSetting del
+	 * com.qti.sensormodule.j20c_sunny_hi1337_ultra.bin- pide
+	 * 0x0124f800 = 19200000. Manda el del modulo. */
+	for (i = 0; i < (unsigned int)nrelojes; i++) {
+		ret = clk_set_rate(relojes[i].clk, 19200000);
+		if (ret)
+			return dev_err_probe(&cl->dev, ret,
+					     "%s no acepta 19,2 MHz\n",
+					     relojes[i].id);
+	}
+
+	/* Los candidatos a reset, como salidas en reposo -activo bajo, o sea el
+	 * sensor EN reset- para no despertar nada antes de tiempo.
+	 *
+	 * Se piden UNO A UNO y se salta el que falle. Pedirlos en bloque con
+	 * devm_gpiod_get_array_optional() hacia que un solo pin con dueño
+	 * abortara el barrido ENTERO con -EINVAL, y eso fue justo lo que paso:
+	 * el gpio27 lo tiene pedido ac4b000.cci porque es su linea de i2c. Un
+	 * instrumento de tanteo no puede caerse porque un tanteo sea malo. */
+	ncand = gpiod_count(&cl->dev, "probe");
+	if (ncand < 0)
+		ncand = 0;
+	if (ncand > SURYA_MAX_RESETS)
+		ncand = SURYA_MAX_RESETS;
+
+	for (i = 0; i < (unsigned int)ncand; i++) {
+		struct gpio_desc *g = devm_gpiod_get_index(&cl->dev, "probe", i,
+							   GPIOD_OUT_LOW);
+		if (IS_ERR(g)) {
+			dev_info(&cl->dev, "candidato %u descartado: %pe\n", i, g);
+			continue;
+		}
+		pin[nresets] = i;
+		resets[nresets++] = g;
+	}
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(surya_supplies), supplies);
+	if (ret)
+		return dev_err_probe(&cl->dev, ret, "no enciende\n");
+
+	ret = clk_bulk_prepare_enable(nrelojes, relojes);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(surya_supplies), supplies);
+		return dev_err_probe(&cl->dev, ret, "no arranca el reloj\n");
+	}
+
+	dev_info(&cl->dev, "alimentado, %d relojes a %lu Hz, %u gpios utiles de %d\n",
+		 nrelojes, nrelojes ? clk_get_rate(relojes[0].clk) : 0,
+		 nresets, ncand);
+	usleep_range(10000, 12000);
+
+	/*
+	 * La secuencia de fabrica del gran angular -powerSetting del
+	 * com.qti.sensormodule del propio movil- es:
+	 *
+	 *     STANDBY=1 -> RESET=0 -> VIO -> MCLK -> RESET=1
+	 *
+	 * O sea que el standby va ANTES del reset. Por eso no vale soltar el
+	 * reset y luego ir probando pines: hay que poner el candidato y
+	 * DESPUES pulsar el reset, que es lo que hace este bucle.
+	 *
+	 * El primer gpio de la lista es el reset, ya encontrado (tlmm 24). Los
+	 * demas son candidatos a standby.
+	 */
+	barrer(cl, "en reset, referencia");
+
+	pulso_reset(resets[0]);
+	barrer(cl, "reset pulsado, sin standby");
+
+	for (i = 1; i < nresets; i++) {
+		char etq[64];
+
+		gpiod_set_value_cansleep(resets[i], 1);
+		usleep_range(5000, 6000);
+		pulso_reset(resets[0]);
+		snprintf(etq, sizeof(etq), "standby en candidato #%u", pin[i]);
+		barrer(cl, etq);
+		gpiod_set_value_cansleep(resets[i], 0);
+		gpiod_set_value_cansleep(resets[0], 0);
+		usleep_range(5000, 6000);
+	}
+
+	if (mantener >= 0 && (unsigned int)mantener < nresets) {
+		struct surya_encendido *e;
+
+		if (mantener > 0)
+			gpiod_set_value_cansleep(resets[mantener], 1);
+		pulso_reset(resets[0]);
+
+		/* Se queda enlazado, asi que hay que dejar apuntado que hay
+		 * cosas encendidas y quien las apaga. */
+		e = devm_kzalloc(&cl->dev, sizeof(*e), GFP_KERNEL);
+		if (!e) {
+			clk_bulk_disable_unprepare(nrelojes, relojes);
+			regulator_bulk_disable(ARRAY_SIZE(surya_supplies), supplies);
+			return -ENOMEM;
+		}
+		e->supplies = supplies;
+		e->relojes = relojes;
+		e->nrelojes = nrelojes;
+		e->reset = resets[0];
+		e->standby = mantener ? resets[mantener] : NULL;
+		i2c_set_clientdata(cl, e);
+		WRITE_ONCE(sonda_cliente, cl);
+
+		dev_info(&cl->dev,
+			 "SE QUEDA DESPIERTO: reset (candidato #%u) pulsado, standby en candidato #%u, todo encendido\n",
+			 pin[0], mantener ? pin[mantener] : pin[0]);
+		return 0;
+	}
+
+	clk_bulk_disable_unprepare(nrelojes, relojes);
+	regulator_bulk_disable(ARRAY_SIZE(surya_supplies), supplies);
+
+	/* Nunca se queda enlazado: es un instrumento de medida, no un driver. */
+	dev_info(&cl->dev, "barrido terminado\n");
+	return -ENODEV;
+}
+
+/* Solo se llama cuando el probe se quedo enlazado, o sea en el camino de
+ * `mantener`. Cuando el barrido termina normal el probe devuelve -ENODEV, no hay
+ * enlace, y esto no corre: por eso no hace falta ninguna bandera. */
+static void surya_cam_scan_remove(struct i2c_client *cl)
+{
+	struct surya_encendido *e = i2c_get_clientdata(cl);
+
+	/* Antes de nada, que la sonda deje de tener un cliente que se va. */
+	WRITE_ONCE(sonda_cliente, NULL);
+
+	if (!e)
+		return;
+
+	/* El mismo orden que la secuencia de apagado de fabrica del gran angular
+	 * (RESET=0 -> MCLK=0 -> VIO=0 -> STANDBY=0): el sensor vuelve a reset
+	 * antes de quitarle reloj y corriente, y el standby se baja al final.
+	 *
+	 * Bajar el standby importa aunque parezca un detalle: al liberar el
+	 * descriptor el pin se queda como estaba, o sea accionado, y eso
+	 * envenena la medida siguiente sin que se vea por ningun lado. */
+	gpiod_set_value_cansleep(e->reset, 0);
+	clk_bulk_disable_unprepare(e->nrelojes, e->relojes);
+	regulator_bulk_disable(ARRAY_SIZE(surya_supplies), e->supplies);
+	if (e->standby)
+		gpiod_set_value_cansleep(e->standby, 0);
+	dev_info(&cl->dev, "apagado: reset y standby abajo, relojes y rieles fuera\n");
+}
+
+static const struct of_device_id surya_cam_scan_of[] = {
+	{ .compatible = "xiaomi,surya-cam-scan" },
+	{ }
+};
+/* A PROPOSITO sin MODULE_DEVICE_TABLE: con ella udev genera el modalias y
+ * carga el modulo solo en cuanto aparece el nodo, y este modulo menea GPIO
+ * de dueño desconocido. Asi solo entra con modprobe. */
+
+static struct i2c_driver surya_cam_scan_driver = {
+	.driver = { .name = "surya-cam-scan", .of_match_table = surya_cam_scan_of },
+	.probe = surya_cam_scan_probe,
+	.remove = surya_cam_scan_remove,
+};
+module_i2c_driver(surya_cam_scan_driver);
+
+MODULE_DESCRIPTION("Buscador de sensores en el bus CCI del surya");
+MODULE_LICENSE("GPL");
