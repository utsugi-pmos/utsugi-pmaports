// The person at the screen, in the phone's own group, may rename the phone and
// set their own full name without typing a password: the first-boot Advanced
// setup asks for both right after they chose that password, and neither gives
// anything the owner could not already do with sudo.
polkit.addRule(function(action, subject) {
    if (action.id == "org.utsugi.surya.identity" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
