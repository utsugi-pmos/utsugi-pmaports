[Unit]
Description=Choose a password before using a phone flashed from the image
# The flag is written by change-the-password.service, which runs as root
# because deciding this means reading /etc/shadow. It lives in /run, so it is
# re-decided on every boot and there is no stale state to clean up.
ConditionPathExists=/run/utsugi-surya/password-is-default
After=plasma-core.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/utsugi-first-password
# If it is dismissed by some means other than setting a password, it comes
# back: this is a step, not a suggestion.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
