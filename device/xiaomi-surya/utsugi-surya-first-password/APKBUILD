maintainer="Dr. Utsugi <cidwel@gmail.com>"
# A full-screen step, shown once, that makes somebody flashing our image choose
# their own password before using the phone.
#
# WHY A STEP AND NOT A NOTIFICATION
# ---------------------------------
# A prebuilt image has to carry a password, and ours is printed on the install
# page -- so anybody who read it knows the password of a phone that has not
# changed it. A notification about that is swiped away and forgotten. This is
# the KDE onboarding step the image does not have, because plasma-welcome is not
# part of a Plasma Mobile install.
#
# WHY IT NEEDS NO PRIVILEGE
# -------------------------
# It only ever runs while the password is STILL the shipped one, which it knows,
# so it drives passwd(1) as the user and answers the old-password prompt itself.
# Nothing is setuid and no helper runs as root. Deciding "still the shipped one"
# does need /etc/shadow, and that half lives in utsugi-surya-plasma, as a system
# unit that leaves a flag in /run.
#
# The exception is the Advanced setup after it: the phone's name and the
# owner's full name need root, and go through pkexec to set-identity, allowed
# for the phone's own user by a polkit rule, like the encryption request.
pkgname=utsugi-surya-first-password
pkgver=1
pkgrel=19
pkgdesc="Choose a password before using a phone flashed from the image"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="aarch64"
license="GPL-2.0-or-later"
# kcmutils/kirigami/plasma-settings are for the Phone encryption System Settings
# module (kcm_phone_encryption), which reaches the same assistant the first-boot
# step offers.
depends="
	shadow
	polkit
	kcmutils
	kirigami
	plasma-settings
	qt6-qtdeclarative
	"
makedepends="
	cmake
	extra-cmake-modules
	kirigami-dev
	ki18n-dev
	kcmutils-dev
	kconfig-dev
	kcoreaddons-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	samurai
	util-linux-dev
	"
subpackages="$pkgname-systemd"
options="!check"
source="CMakeLists.txt
	main.cpp
	passwd.cpp
	passwd.h
	encrypt.cpp
	encrypt.h
	identity.cpp
	identity.h
	set-identity
	rename-user
	rename-user.service
	80-utsugi-surya-rename-user.preset
	org.utsugi.surya.identity.policy
	50-utsugi-surya-identity.rules
	Main.qml
	kcm.cpp
	kcm_phone_encryption.json
	kcm-encryption.qml
	first-password.service
	80-utsugi-surya-first-password.preset
	"
builddir="$srcdir"

build() {
	# kcmutils_add_qml_kcm() GLOB_RECURSEs ui/, but abuild copies every source
	# flat into $srcdir; put the module's QML where the macro looks for it.
	mkdir -p "$builddir"/ui
	cp "$builddir"/kcm-encryption.qml "$builddir"/ui/main.qml

	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	# The Advanced setup's full name and phone name: root through pkexec, the
	# same way the encryption request works.
	install -Dm755 "$srcdir"/set-identity "$srcdir"/rename-user \
		-t "$pkgdir"/usr/libexec/utsugi-surya/
	install -Dm644 "$srcdir"/org.utsugi.surya.identity.policy \
		-t "$pkgdir"/usr/share/polkit-1/actions/
	install -Dm644 "$srcdir"/50-utsugi-surya-identity.rules \
		-t "$pkgdir"/usr/share/polkit-1/rules.d/
}

systemd() {
	pkgdesc="$pkgdesc (session unit)"
	# Without this nothing ever pulls the subpackage in, and the step exists
	# but never starts. Found by trying to start it on the phone.
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/first-password.service \
		-t "$subpkgdir"/usr/lib/systemd/user/
	install -Dm644 "$srcdir"/80-utsugi-surya-first-password.preset \
		-t "$subpkgdir"/usr/lib/systemd/user-preset/
	# The account rename asked for in the Advanced setup, at the next boot.
	install -Dm644 "$srcdir"/rename-user.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/80-utsugi-surya-rename-user.preset \
		-t "$subpkgdir"/usr/lib/systemd/system-preset/
}
