maintainer="Dr. Utsugi <cidwel@gmail.com>"
# The GPS on this phone works. A pmaports bug was blocking it.
#
# modem-gnss.service (device/community/soc-qcom) starts the location engine with
# --loc-set-engine-lock=mt, and with that value the modem firmware rejects any
# session of its own with "QMI protocol error (46)". GeoClue tries once at
# startup, swallows the error and never retries, so maps silently fall back to
# IP-based position.
#
# Measured by alternating five times: none/mi start the engine, mt/all always
# fail. The firmware reads the value as "which type is allowed", with mi and mt
# swapped relative to the QMI spec. 'mi' is used rather than 'none' because it
# still blocks the position requests made by the NETWORK, which is what the
# original value was trying to do.
#
# The bug is upstream and affects every Qualcomm device on postmarketOS.
pkgname=utsugi-surya-gps
pkgver=1
pkgrel=1
pkgdesc="Unlock the GPS engine that pmaports leaves unusable"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
depends="qmi-utils"
subpackages="$pkgname-systemd"
source="gnss-ready
	10-utsugi-surya.conf
	"

package() {
	install -Dm755 "$srcdir"/gnss-ready -t "$pkgdir"/usr/libexec/utsugi-surya/
	# A drop-in, not a replacement unit: soc-qcom keeps owning modem-gnss.service
	# and only the ExecStart chain is overridden.
	install -Dm644 "$srcdir"/10-utsugi-surya.conf \
		-t "$pkgdir"/usr/lib/systemd/system/modem-gnss.service.d/
}

systemd() {
	default_systemd
}
sha512sums="
