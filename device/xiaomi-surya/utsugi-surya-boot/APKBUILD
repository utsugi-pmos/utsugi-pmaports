pkgname=utsugi-surya-boot
pkgver=1
pkgrel=3
pkgdesc="Kernel command line for the Xiaomi POCO X3 NFC"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
source="60-utsugi-surya.conf
	10-utsugi-no-ab-slots.conf
	60-utsugi-ufs-no-clock-scaling.rules
	"

package() {
	install -Dm644 "$srcdir"/60-utsugi-surya.conf \
		-t "$pkgdir"/usr/lib/kernel-cmdline.d/
	install -Dm644 "$srcdir"/10-utsugi-no-ab-slots.conf \
		-t "$pkgdir"/usr/lib/systemd/system/qbootctl.service.d/
	install -Dm644 "$srcdir"/60-utsugi-ufs-no-clock-scaling.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
}
