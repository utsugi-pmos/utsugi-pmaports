maintainer="Dr. Utsugi <cidwel@gmail.com>"
# Autofocus for the rear camera. The sensor has a voice-coil motor but no driver
# closes the loop, so the focus engine runs in user space against a measured
# curve.
pkgname=utsugi-surya-camera
pkgver=1
pkgrel=1
pkgdesc="Rear-camera focus engine for the Xiaomi POCO X3 NFC"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
options="!check"
depends="python3 libcamera-utsugi"
subpackages="$pkgname-systemd"
source="focus-engine
	focus-engine.service
	80-utsugi-surya-camera.preset
	"

package() {
	install -Dm755 "$srcdir"/focus-engine -t "$pkgdir"/usr/libexec/utsugi-surya/
	install -Dm644 "$srcdir"/focus-engine.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/80-utsugi-surya-camera.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}

systemd() {
	default_systemd
}
