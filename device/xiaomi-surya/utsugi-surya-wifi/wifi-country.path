[Unit]
Description=Re-apply the radio rules when the timezone changes
# The country is read from the timezone, and the timezone is picked by a person
# in Settings AFTER the first boot. Without this the radio keeps the rules it
# had at boot -- which for an image that ships UTC means no country at all, and
# 5 GHz stays missing until the next reboot with no hint as to why.
#
# systemd watches the parent directory too, which is what makes this work:
# timedatectl replaces the /etc/localtime symlink rather than editing it.

[Path]
PathChanged=/etc/localtime
Unit=wifi-country.service

[Install]
WantedBy=multi-user.target
