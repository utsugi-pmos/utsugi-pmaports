#!/bin/sh
# Tell the kernel which country's radio rules apply, so 5 GHz works.
#
# WHY A PHONE LOSES 5 GHz WITHOUT THIS
# ------------------------------------
# With no country set, cfg80211 uses the world domain, "00". Under it the
# channels of UNII-1 (36-48) are marked NO-IR: the radio may not transmit on
# them, so an active scan never probes them and the network simply is not in
# the list. It does not look like a regulatory setting from the outside. It
# looks like the phone has no 5 GHz.
#
# Measured on 2026-09-13: the laptop saw the 5 GHz network on channel 44 at
# signal 90 and the phone's own scan did not list it at all.
#
# WHERE THE COUNTRY COMES FROM
# ----------------------------
# From the timezone, which the person picks on first boot in Settings and which
# is therefore the one setting that already says where the phone is. It is a
# heuristic, and it is right for exactly the reason it looks wrong: a phone that
# has been told it is on Madrid time is in Spain.
#
# /etc/utsugi-surya/wifi-country wins over it, for anyone whose clock and radio
# do not agree.
#
# DOES THIS BREAK THE PHONE IN ANOTHER COUNTRY?  No, and it was checked in the
# kernel this package ships against rather than assumed:
#
#   net/wireless/reg.c, __reg_process_hint_country_ie()
#       "if (lr->initiator != NL80211_REGDOM_SET_BY_COUNTRY_IE) return REG_REQ_OK"
#       -- an access point that broadcasts its country (802.11d) is obeyed even
#       when a country was already set here.
#
#   drivers/net/wireless/ath/regd.c
#       sets REGULATORY_STRICT_REG | REGULATORY_CUSTOM_REG, and
#       REGULATORY_COUNTRY_IE_FOLLOW_POWER. It never sets
#       REGULATORY_COUNTRY_IE_IGNORE, so those hints reach it, and STRICT means
#       the radio will not exceed what its own board file allows anyway.
#
# So: the access point wins where it says anything, the timezone answers where
# it does not, and the card refuses to go beyond its own limits either way. The
# only case left is travelling to a country whose access points say nothing AND
# not touching the clock -- and then the rules are one country's instead of
# another's, both of them real.
#
# The image ships UTC, which maps to no country at all. That is correct: an
# image does not know where it is going, and claiming a country it cannot know
# is how a radio ends up transmitting where it may not.
set -u

OVERRIDE=/etc/utsugi-surya/wifi-country

country=""
if [ -r "$OVERRIDE" ]; then
	country="$(tr -d '[:space:]' < "$OVERRIDE" | tr '[:lower:]' '[:upper:]')"
fi

if [ -z "$country" ]; then
	zone="$(readlink -f /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')"
	[ -n "$zone" ] || exit 0
	# zone.tab is country -> zone. UTC is not in it, which is the point.
	country="$(awk -v z="$zone" '$1 !~ /^#/ && $3 == z { print $1; exit }' \
		/usr/share/zoneinfo/zone.tab 2>/dev/null)"
fi

case "$country" in
	[A-Z][A-Z]) ;;
	*) exit 0 ;;                       # nothing sensible to say: say nothing
esac

command -v iw >/dev/null 2>&1 || exit 0
iw reg set "$country" || exit 0
echo "regulatory domain set to $country"
