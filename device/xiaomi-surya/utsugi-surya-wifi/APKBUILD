# Maintainer: Dr. Utsugi <cidwel@gmail.com>
#
# The country's radio rules, so 5 GHz is usable.
#
# With no country set, cfg80211 falls back to the world domain "00", where the
# 5 GHz channels of UNII-1 (36-48) are NO-IR: the radio may not transmit there,
# an active scan never probes them, and the networks are simply absent from the
# list. From the outside that is indistinguishable from a phone with no 5 GHz
# radio at all -- which is how it was read on 2026-09-13, when the laptop saw a
# network on channel 44 at signal 90 and the phone's own scan did not list it.
#
# Nothing in this repository set a country, and 'iw' was not even installed, so
# nothing could have.
pkgname=utsugi-surya-wifi
pkgver=1
pkgrel=1
pkgdesc="Apply the country's radio rules so 5 GHz works"
url="https://github.com/utsugi-pmos/utsugi-pmaports"
arch="noarch"
license="MIT"
# iw applies it; wireless-regdb is the signed database the kernel reads, and
# this kernel is built with CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y, so without
# it every country lookup fails quietly.
depends="iw wireless-regdb"
options="!check"
subpackages="$pkgname-systemd"
source="set-wifi-country
	wifi-country.service
	wifi-country.path
	80-utsugi-surya-wifi.preset"

package() {
	install -Dm755 "$srcdir"/set-wifi-country \
		-t "$pkgdir"/usr/libexec/utsugi-surya/
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	depends=""
	install -Dm644 "$srcdir"/wifi-country.service "$srcdir"/wifi-country.path \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/80-utsugi-surya-wifi.preset \
		-t "$subpkgdir"/usr/lib/systemd/system-preset/
}
sha512sums="
