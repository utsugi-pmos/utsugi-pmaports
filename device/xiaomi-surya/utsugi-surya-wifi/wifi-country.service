[Unit]
Description=Apply the country's radio rules, so 5 GHz is usable
# cfg80211 has to be there to be told anything.
After=systemd-modules-load.service
Before=NetworkManager.service
ConditionPathExists=/usr/share/zoneinfo/zone.tab

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/utsugi-surya/set-wifi-country

[Install]
WantedBy=multi-user.target
